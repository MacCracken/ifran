/target
**/*.rs.bk
*.pdb

# Environment
.env
.env.*
!.env.example

# Database
*.db
*.db-journal

# Build artifacts
/dist
/sbom

# Frontend
node_modules/

# Coverage
/coverage
tarpaulin-report.*
cobertura.xml

# Security reports
vulnerability-report.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Models (too large for git)
*.gguf
*.safetensors
*.bin
*.onnx
*.pt

# ifran runtime artifacts (M1 run store + logs)
ifran.db
runs/

# cyrius local mode (CYRIUS_LOCAL=1 / --local, cyrius >= 6.7.6) vendors the
# ../<dep> checkouts here. Only this subdir: build/ifran etc. are tracked.
/build/local-deps/

# Binaries staged for docker images (Dockerfile.trainer siblings, Dockerfile.release bin/<arch>/)
/docker/siblings/*
!/docker/siblings/README.md
/bin/
