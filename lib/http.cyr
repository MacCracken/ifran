# http.cyr — minimal HTTP/1.0 client
# Usage: include "lib/http.cyr"
# Includes its own definers (6.6.9): result.cyr and net.cyr (which brings syscalls.cyr, alloc.cyr,
# string.cyr and io.cyr) — `include "lib/http.cyr"` alone is a complete build.
# The URL's host is resolved with net.cyr's net_resolve_ipv4 — an IPv4 literal, `localhost`,
# /etc/hosts, then DNS; the system resolver on Windows (v6.6.9; before it no http_* call could
# reach any host). The request is at most _HTTP_REQ_CAP (2048) bytes; a longer one is refused as
# a bad URL (CYRIUS-2026-0010). Every socket is closed with net.cyr's sock_close: on Windows it is a
# Winsock SOCKET, which sys_close (CloseHandle there) does not close (6.6.11). Every call is bounded
# by HTTP_IDLE_TIMEOUT_MS (5 s per wait) and HTTP_TIMEOUT_MS (30 s for the whole exchange) — 6.7.18,
# CYRIUS-2026-0049; see their definitions.

# v5.8.31: Result-returning *_r variant (`http_get_r`) for typed
# error returns. Also v5.8.31 fixes a long-standing bug in the
# back-compat `http_get` — net.cyr's tcp_socket / sock_connect /
# sock_send / sock_recv have returned `Result` (heap pointer) for
# at least the v5.8.x cycle, but http_get treated them as raw fds
# (`var fd = tcp_socket(); if (fd < 0)` — fd is a positive heap
# ptr, so the guard never fires; subsequent syscalls used the
# Result ptr as a kernel fd and silently failed). Fixed below by
# inserting `payload(...)` unwraps and `is_err_result(...)` guards
# in the same shape as lib/sandhi.cyr.
include "lib/result.cyr"
# v6.6.9: SELF-SUFFICIENT for the socket layer. Every http_* call goes through net.cyr
# (net_resolve_ipv4, tcp_socket, sock_connect, sock_send_all, sock_recv), which this file never
# included, so `include "lib/http.cyr"` without net.cyr compiled with `undefined function`
# warnings and a trapping http_get. Include-once, so an existing caller pays nothing.
# CHANGELOG [6.6.9]
include "lib/net.cyr"
# 6.7.18 (CYRIUS-2026-0049): the exchange's deadlines read lib/chrono.cyr's monotonic clock_now_ns.
include "lib/chrono.cyr"
# 6.7.18 (D1): the response parser reads through a fn-local [u8] slice. CHANGELOG [6.7.18]
include "lib/slice.cyr"

# v5.8.31 — HttpError variants. `HttpBadUrl` covers _http_parse_url
# rejection (CRLF/whitespace/empty host/bad port); `HttpNetErr`
# wraps any underlying net.cyr Result-Err (tcp_socket / sock_connect
# / sock_send / sock_recv); `HttpNon2xx` for status codes outside
# the 200-299 range; `HttpOther` is the catch-all. Variant-name
# prefix `Http` keeps these distinct from Io* / Json* / Net* in the
# global enum-variant namespace.
enum HttpError {
    HttpBadUrl;
    HttpNetErr;
    HttpNon2xx;
    HttpOther;
}

# HTTP response: { status_code, body_ptr, body_len, headers_ptr }
var HTTP_OK = 200;
var HTTP_NOT_FOUND = 404;
var HTTP_ERROR = 0 - 1;

# Parse host and port from URL: "http://host:port/path"
# Returns {host, port, path} as 3 values packed in alloc'd struct.
# Returns 0 on malformed or unsafe input (caller must null-check).
#
# CRLF injection hardening (CVE-2019-9741 pattern).
# A URL containing raw CR (0x0D) or LF (0x0A) bytes can otherwise be
# forged to smuggle extra HTTP headers into the request line —
# e.g. `http://host\r\nEvil: x/path` would produce a request that
# looks like two distinct headers to the upstream server. The
# defence is to reject any URL with embedded control bytes *before*
# allocating the host/path pointers. Rejecting early also guards
# against stray tabs/spaces that would split the request line.
# Returning 0 (instead of aborting the process) lets caller-side code
# treat bad URLs as a normal error path.
fn _http_parse_url(url): i64 {
    # Validate the WHOLE URL — host and path both reach the request, and the request-target
    # forbids control bytes too: reject every control byte (0x01-0x1F: CR and LF split headers,
    # TAB splits the request line, the rest have no place in a URL), SPACE (a request-line split)
    # and DEL (0x7F). The URL is NUL-terminated, so the walk ends at its first NUL.
    # ⛔ Until 6.6.11 only CR, LF, TAB and SPACE were refused, though this comment already
    # promised every byte below 0x20 and 0x7F — 29 control bytes went through into the Host
    # header and the request line. CHANGELOG [6.6.11]
    var vi = 0;
    while (load8(url + vi) != 0) {
        var vc = load8(url + vi);
        if (vc <= 32) { return 0; }   # a control byte (CR/LF/TAB among them) or SPACE
        if (vc == 127) { return 0; }  # DEL
        vi += 1;
    }
    var result = alloc(24);
    if (result == 0) { return 0; }
    var p = 0;
    # Skip "http://"
    if (memeq(url, "http://", 7) == 1) { p = 7; }
    # Find host end (: or / or end)
    var host_start = p;
    while (load8(url + p) != 0) {
        if (load8(url + p) == 58) { break; }
        if (load8(url + p) == 47) { break; }
        p += 1;
    }
    var host_len = p - host_start;
    if (host_len == 0) { return 0; }  # empty host
    var host = alloc(host_len + 1);
    if (host == 0) { return 0; }
    memcpy(host, url + host_start, host_len);
    store8(host + host_len, 0);
    store64(result, host);
    # Port
    var port = 80;
    if (load8(url + p) == 58) {
        p += 1;
        port = atoi(url + p);
        while (load8(url + p) >= 48) { if (load8(url + p) > 57) { break; } p = p + 1; }
    }
    if (port <= 0) { return 0; }
    if (port > 65535) { return 0; }
    store64(result + 8, port);
    # Path
    var path = "/";
    if (load8(url + p) == 47) { path = url + p; }
    store64(result + 16, path);
    return result;
}

# The longest request this client sends, NUL included: the request line plus the Host and
# Connection headers. The size of the fixed buffer the builder used to write into unchecked.
const _HTTP_REQ_CAP = 2048;

# Build the HTTP/1.0 request for `method path` to `host`:`port`. Returns it NUL-terminated in a
# buffer of exactly its size, or 0 when it would exceed _HTTP_REQ_CAP. The Host header carries
# `:port` whenever port is not 80 (RFC 9110 §7.2: a Host without a port means the scheme's
# default, so a server on :8080 used to be told :80 — virtual hosting and absolute-URL
# redirects then named the wrong origin). The suffix counts toward the cap. CHANGELOG [6.6.11]
# ⛔ CYRIUS-2026-0010: this used to alloc(2048) and memcpy the method, path and host into it unchecked, so a
# long URL (caller-controlled — a crawled link, a redirect, user input) wrote past the buffer
# into whatever the allocator handed out next; measured, the NEXT alloc() came back full of the
# path's bytes. The length is now computed first and an over-long request is refused before the
# buffer exists. Callers report 0 as a bad URL. CHANGELOG [6.6.9]
fn _http_build_request(method, host, port, path): i64 {
    var mlen = strlen(method);
    var plen = strlen(path);
    var hlen = strlen(host);
    # ":" + the port's decimal digits, when it is not the default.
    var ptxt[8];
    var pdig = 0;
    if (port != 80) {
        var pv = port;
        while (pv > 0 && pdig < 6) { pdig += 1; pv = pv / 10; }
        pv = port;
        var pi = pdig;
        while (pi > 0) { pi -= 1; store8(&ptxt + pi, 48 + pv % 10); pv = pv / 10; }
    }
    var plen2 = 0;
    if (pdig > 0) { plen2 = 1 + pdig; }
    # method SP path " HTTP/1.0\r\nHost: " host [":" port] "\r\nConnection: close\r\n\r\n" NUL
    var need = mlen + 1 + plen + 17 + hlen + plen2 + 23 + 1;
    if (need > _HTTP_REQ_CAP) { return 0; }
    var buf = alloc(need);
    if (buf == 0) { return 0; }
    var pos = 0;
    memcpy(buf + pos, method, mlen); pos += mlen;
    store8(buf + pos, 32); pos += 1;
    memcpy(buf + pos, path, plen); pos += plen;
    memcpy(buf + pos, " HTTP/1.0\r\nHost: ", 17); pos += 17;
    memcpy(buf + pos, host, hlen); pos += hlen;
    if (pdig > 0) {
        store8(buf + pos, 58); pos += 1;
        memcpy(buf + pos, &ptxt, pdig); pos += pdig;
    }
    memcpy(buf + pos, "\r\nConnection: close\r\n\r\n", 23); pos += 23;
    store8(buf + pos, 0);
    return buf;
}

# Build the request for `host`:`port` `path` and resolve `host`, IN THAT ORDER: the request is
# stored at slot[0] and the address at slot[8]. Returns 0, 1 for a request over _HTTP_REQ_CAP
# (CYRIUS-2026-0010), or 2 for a host that does not resolve. slot[8] is written only after a lookup ran, so it is left
# as the caller set it on 1.
# ⛔ WHY THE ORDER: the refusal must cost nothing. Resolving first made an over-long URL read
# /etc/hosts and /etc/resolv.conf and send a DNS datagram for its host before it was refused —
# the three callers each open-coded build + resolve and two of them resolved first. One helper
# now owns the order. CHANGELOG [6.6.9]
fn _http_prepare(host, port, path, slot): i64 {
    var req = _http_build_request("GET", host, port, path);
    if (req == 0) { return 1; }
    store64(slot, req);
    var addr = net_resolve_ipv4(host);
    store64(slot + 8, addr);
    if (addr == 0 - 1) { return 2; }
    return 0;
}

# The http_get family's deadlines, in milliseconds (CYRIUS-2026-0049, 6.7.18). HTTP_IDLE_TIMEOUT_MS
# bounds every wait — the connect, the request's send, and each read for the next bytes of the
# response — and HTTP_TIMEOUT_MS the whole exchange, so a server that never answers ends the call
# after 5 s and one that dribbles a byte at a time after 30 s. A call that runs out of either is a
# failure (HTTP_ERROR, Err(HttpNetErr)), never a truncated response returned as complete. 0
# disables that bound (both 0: the pre-6.7.18 behaviour, where a peer could hold the call for
# ever). Read once per call: set them before calling, e.g. lower both when fetching untrusted URLs.
# ⛔ WHY. The three calls connected and read with no deadline and kept the socket private, so a
# server that accepted and stayed silent pinned the fetching thread for ever, with no way for the
# caller to bound it — the client-side slowloris (the TLS stack's CYRIUS-2026-0017). CHANGELOG [6.7.18]
var HTTP_IDLE_TIMEOUT_MS = 5000;
var HTTP_TIMEOUT_MS = 30000;

# Milliseconds the next wait may take: the idle bound, cut to what is left of the whole-exchange
# deadline `dl` (0 = none). 0 when the deadline has passed; -1 when neither bound is set.
fn _http_wait_ms(dl): i64 {
    var ms = HTTP_IDLE_TIMEOUT_MS;
    if (ms <= 0) { ms = 0 - 1; }
    if (dl != 0) {
        var left = dl - clock_now_ns();
        if (left <= 0) { return 0; }
        var lm = (left + 999999) / 1000000;
        if (ms < 0 || lm < ms) { ms = lm; }
    }
    return ms;
}

# Wait up to `ms` (> 0) for socket `fd` to be readable (`want_write` == 0) or writable. True ready
# (an error or hang-up included: the next call reports it), false the time ran out. Where there is
# no poll (agnos, cx) the socket's own timeout bounds the next call instead, and this answers true.
fn _http_wait(fd, want_write, ms): bool {
    var r = fd_wait_ready(fd, want_write, ms);
    while (r == 0 - 4) { r = fd_wait_ready(fd, want_write, ms); }   # EINTR: wait again
    if (r == 0) { return false; }
    if (r == 0 - 38) {
        if (want_write == 0) { sock_set_recv_timeout(fd, ms / 1000, (ms % 1000) * 1000); }
        else { sock_set_send_timeout(fd, ms / 1000, (ms % 1000) * 1000); }
    }
    return true;
}

# Connect to addr:port, send the NUL-terminated request `req`, and read the response into a 64 KiB
# buffer from allocator `a` (0: alloc), under the deadlines above. Returns (the bytes read, the
# buffer): the read ends at EOF, at 64 KiB, or at a read error after the connect; (-1, 0) when
# there is no socket, the connect or the send failed, or a deadline passed; (-2, 0) when the buffer
# was refused. One body for http_get / http_get_r / http_get_a, which open-coded it three times.
fn _http_exchange(a, addr, port, req): (i64, i64) {
    var dl = 0;
    if (HTTP_TIMEOUT_MS > 0) { dl = clock_now_ns() + HTTP_TIMEOUT_MS * 1000000; }
    var fd_r_tag, fd_r = tcp_socket();
    if (is_err_result(fd_r_tag) == 1) { return (0 - 1, 0); }
    var fd = fd_r;
    var ms = _http_wait_ms(dl);
    if (ms == 0) { sock_close(fd); return (0 - 1, 0); }
    if (ms < 0) {
        var c_r_tag, c_r = sock_connect(fd, addr, port);
        if (is_err_result(c_r_tag) == 1) { sock_close(fd); return (0 - 1, 0); }
    } elif (net_connect_nb(fd, addr, port, ms) != 0) {
        sock_close(fd);
        return (0 - 1, 0);
    }
    # Send the WHOLE request. v6.6.8: this used to call sock_send and drop its count, so a
    # short write (SO_SNDTIMEO, a signal) sent half a request and then waited for a response to
    # it. A failed or short send is now an error. CHANGELOG [6.6.8]
    var qlen = strlen(req);
    ms = _http_wait_ms(dl);
    if (ms == 0) { sock_close(fd); return (0 - 1, 0); }
    if (ms > 0) { sock_set_send_timeout(fd, ms / 1000, (ms % 1000) * 1000); }
    if (sock_send_all(fd, req, qlen) != qlen) { sock_close(fd); return (0 - 1, 0); }
    var rbuf = 0;
    if (a == 0) { rbuf = alloc(65536); }
    else { rbuf = alloc_via(a, 65536); }
    if (rbuf == 0) { sock_close(fd); return (0 - 2, 0); }
    var total = 0;
    loop {
        ms = _http_wait_ms(dl);
        if (ms == 0) { sock_close(fd); return (0 - 1, 0); }
        if (ms > 0 && !_http_wait(fd, 0, ms)) { sock_close(fd); return (0 - 1, 0); }
        var rd_r_tag, rd_r = sock_recv(fd, rbuf + total, 65536 - total);
        if (is_err_result(rd_r_tag) == 1) {
            # Where the socket's own timeout bounded the read (no poll), its expiry (EAGAIN) is a
            # deadline that passed, not the end of the response.
            if (ms > 0 && (rd_r == _NET_EAGAIN || _http_wait_ms(dl) == 0)) { sock_close(fd); return (0 - 1, 0); }
            break;
        }
        if (rd_r <= 0) { break; }
        total += rd_r;
        if (total >= 65536) { break; }
    }
    sock_close(fd);
    return (total, rbuf);
}

# Fill the response struct `result` (status, body pointer, body length — 0, 0, 0 for a response
# too short to carry a status line, no status when it is not HTTP/1.x, no body without a blank
# line) from the `len`-byte response at buf. Returns result. One body for both parse fns below.
# 6.7.18 (D1): every byte is read through a slice of buf[0, len), checked in every build, so a
# bound this fn gets wrong is `slice bounds violation`, never a read past the response.
# CHANGELOG [6.7.18]
fn _http_parse_into(result, buf, len): i64 {
    store64(result, 0);
    store64(result + 8, 0);
    store64(result + 16, 0);
    if (len < 12) { return result; }
    var r: [u8] = 0;
    slice_set(&r, buf, len);
    # Status line: "HTTP/1.x NNN ..."
    var pre: [u8] = 0;
    slice_set(&pre, "HTTP/1.", 7);
    var same = 1;
    var i = 0;
    while (i < 7) {
        if (r[i] != pre[i]) { same = 0; }
        i += 1;
    }
    # The status is three DIGITS: anything else is no status (0), as a response that is not
    # HTTP/1.x is. 6.7.18: the three bytes were taken as digits unchecked, so "HTTP/1.1 2x0"
    # reported 920 and "HTTP/1.1 !!!" -1665 — a negative status no caller tests for. CHANGELOG [6.7.18]
    var code = 0;
    if (same == 1) {
        var d0 = r[9] - 48;
        var d1 = r[10] - 48;
        var d2 = r[11] - 48;
        if (d0 >= 0 && d0 <= 9 && d1 >= 0 && d1 <= 9 && d2 >= 0 && d2 <= 9) { code = d0 * 100 + d1 * 10 + d2; }
    }
    store64(result, code);
    # Find body (after \r\n\r\n)
    var pi = 0;
    while (pi < len - 3) {
        if (r[pi] == 13 && r[pi + 1] == 10 && r[pi + 2] == 13 && r[pi + 3] == 10) {
            store64(result + 8, buf + pi + 4);
            store64(result + 16, len - pi - 4);
            return result;
        }
        pi += 1;
    }
    return result;
}

# v5.8.36 — Allocator-as-first-arg variant of _http_parse_response.
# Allocates the 32-byte response struct via `a`. Returns 0 on OOM.
fn _http_parse_response_a(a, buf, len): i64 {
    var result = alloc_via(a, 32);
    if (result == 0) { return 0; }
    return _http_parse_into(result, buf, len);
}

# Parse HTTP response: extract status code and body. Returns 0 on OOM.
fn _http_parse_response(buf, len): i64 {
    var result = alloc(32);
    if (result == 0) { return 0; }
    return _http_parse_into(result, buf, len);
}

# The response the http_get family answers a failure with: { HTTP_ERROR, 0, 0 } from allocator `a`
# (0: alloc), or 0 when that allocation is refused. Six open-coded copies before 6.7.18.
fn _http_err_resp(a): i64 {
    var r = 0;
    if (a == 0) { r = alloc(24); }
    else { r = alloc_via(a, 24); }
    if (r == 0) { return 0; }
    store64(r, HTTP_ERROR);
    store64(r + 8, 0);
    store64(r + 16, 0);
    return r;
}

# The http_get family's one body: parse `url`, then build its request and resolve its host
# (_http_prepare: an over-long request, CYRIUS-2026-0010, is refused before any lookup, and a host
# that does not resolve before any socket — v6.6.9), then the exchange with allocator `a`
# (_http_exchange, under HTTP_IDLE_TIMEOUT_MS / HTTP_TIMEOUT_MS — CYRIUS-2026-0049). Returns (rc,
# the bytes read, the buffer): rc 0 read; 1 a malformed, unsafe or over-long URL; 2 a host that
# does not resolve; 3 no socket, a failed connect or send, or a deadline that passed; 4 the
# receive buffer was refused. The three callers open-coded it, each with a 16-byte heap slot for
# _http_prepare's results that is now on the stack. CHANGELOG [6.7.18]
fn _http_fetch(a, url): (i64, i64, i64) {
    var parsed = _http_parse_url(url);
    if (parsed == 0) { return (1, 0, 0); }
    var port = load64(parsed + 8);
    var slot[16];
    var prep = _http_prepare(load64(parsed), port, load64(parsed + 16), &slot);
    if (prep != 0) { return (prep, 0, 0); }
    var total, rbuf = _http_exchange(a, load64(&slot + 8), port, load64(&slot));
    if (total == 0 - 2) { return (4, 0, 0); }
    if (total < 0) { return (3, 0, 0); }
    return (0, total, rbuf);
}

# HTTP GET request. Returns response struct {status, body_ptr, body_len}.
# On malformed or unsafe URL (CRLF injection, empty host, out-of-range
# port, embedded whitespace, a request over _HTTP_REQ_CAP bytes), a host
# that does not resolve, a network failure, or a deadline that passed
# (HTTP_IDLE_TIMEOUT_MS / HTTP_TIMEOUT_MS, 6.7.18), returns a response with
# status == HTTP_ERROR so callers can fail fast without a separate validator.
fn http_get(url): i64 {
    var rc, total, rbuf = _http_fetch(0, url);
    if (rc == 4) { return 0; }
    if (rc != 0) { return _http_err_resp(0); }
    return _http_parse_response(rbuf, total);
}

# v5.8.31 — Result variant of http_get. Failures land as typed
# HttpError variants instead of the back-compat HTTP_ERROR sentinel
# in resp.status. Bad URL (or a request over _HTTP_REQ_CAP bytes) →
# Err(HttpBadUrl); a host that does not resolve, a net.cyr Err in
# tcp_socket / the connect / the send, or a deadline that passed (6.7.18) →
# Err(HttpNetErr); 2xx response → Ok(resp); non-2xx → Err(HttpNon2xx).
fn http_get_r(url) : Result {
    var rc, total, rbuf = _http_fetch(0, url);
    if (rc == 1) { return Err(HttpBadUrl); }                  # v6.6.9: over-long (CYRIUS-2026-0010)
    if (rc == 4) { return Err(HttpOther); }
    if (rc != 0) { return Err(HttpNetErr); }                  # unresolved, or CYRIUS-2026-0049
    var resp = _http_parse_response(rbuf, total);
    # 6.7.18: a refused response struct is Err(HttpOther) — it was read through (load64(0)).
    # CHANGELOG [6.7.18]
    if (resp == 0) { return Err(HttpOther); }
    var st = load64(resp);
    if (st < 200) { return Err(HttpNon2xx); }
    if (st >= 300) { return Err(HttpNon2xx); }
    return Ok(resp);
}

# v5.8.36 — Allocator-as-first-arg variant of http_get. Routes the
# big allocations (64KB recv buffer + 32B response struct) through
# the supplied allocator. URL parsing + request-build buffers stay
# on default_alloc — those are smaller, bounded, and shared between
# requests in the typical per-request-arena pattern. Returns the
# response struct (status / body / body_len); status == HTTP_ERROR
# on bad URL / net failure / OOM (caller checks via http_status).
#
# Per-request-arena pattern (cyrius idiom for HTTP):
#   var req_arena = arena_allocator(96 * 1024);   # 96KB headroom
#   var resp = http_get_a(req_arena, "http://x.org/y");
#   ... use resp.status / resp.body ...
#   reset_via(req_arena);                          # frees recv buf + resp
fn http_get_a(a, url): i64 {
    var rc, total, rbuf = _http_fetch(a, url);
    if (rc == 4) { return 0; }
    if (rc != 0) { return _http_err_resp(a); }
    return _http_parse_response_a(a, rbuf, total);
}

# Get status code from response
fn http_status(resp) : i64 { return load64(resp); }
# Get body pointer from response
fn http_body(resp) : i64 { return load64(resp + 8); }
# Get body length from response
fn http_body_len(resp) : i64 { return load64(resp + 16); }
