# cmdit.cyr -- bundled distribution
# Version: 1.2.5
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- cmdit.cyr ---

# cmdit — sovereign CLI / argument-parsing library (getopt-long shaped).
# Re-exported via dist/cmdit.cyr (cyrius distlib); consumers import it as
# `[deps.cmdit] modules = ["dist/cmdit.cyr"]`.
#
# WHY: ~40 AGNOS binaries hand-roll flag/help/version parsing on top of the
# stdlib `args` primitive (argc/argv), and a stdlib parser `lib/flags.cyr`
# already exists but lives in the toolchain (can't grow enum/repeat/verb without
# a cyrius release) and ~31 repos never adopted it. cmdit is `flags.cyr`
# *productized as a standalone distlib + extended*: the proven getopt-long core
# (forked from lib/flags.cyr, byte-compatible type/err codes) PLUS the three
# things every structured consumer copies by hand — the argc/argv -> contiguous
# cstr* materialize bridge, auto `--help`/`--version`, and the 0/1/2 exit
# convention as named constants. 0.1.0 = the faithful extraction; enum / repeat /
# required / range / env (0.2.0), verb dispatch (0.3.0), and the v1.0 completeness
# delta — configurable -h/-V short letters, per-flag metavar + shown defaults,
# max/exact positional gates — round out the frozen surface.
#
# Typical use (single-command tool):
#   fn main(): i64 {
#       var h    = cmdit_new("mytool");                              # auto --help/-h, --version/-V
#       var f_o  = cmdit_str (h, 111, "output", 0, "output file");   # 'o'
#       var f_n  = cmdit_int (h, 110, "count", 1, "repeat count");   # 'n'
#       var r = cmdit_parse(h);                                      # reads /proc argv via the bridge
#       if (r == CMDIT_HELP)    { cmdit_help(h);                 return CMDIT_EXIT_OK; }
#       if (r == CMDIT_VERSION) { cmdit_version(h, "mytool 1.0"); return CMDIT_EXIT_OK; }
#       if (r == CMDIT_RESULT_ERR) { cmdit_print_error(h); cmdit_help(h); return CMDIT_EXIT_USAGE; }
#       var outfile = cmdit_get_str(h, f_o);
#       var count   = cmdit_get_int(h, f_n);
#       var i = 0;
#       while (i < cmdit_positional_count(h)) { ... cmdit_positional(h, i) ...; i = i + 1; }
#       return CMDIT_EXIT_OK;
#   }
#   fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
#   _entry();        # BARE call — NOT `var r = main();` (agnos init-rsp capture; see docs)
#
# Supported syntax (0.1.0):
#   --name              bool flag -> 1
#   --name=value        long with attached value
#   --name value        long with space-separated value
#   -x                  short bool flag -> 1
#   -x value            short with space-separated value (int/str)
#   --                  terminator — everything after is positional
#   -                   lone dash is a positional (stdin convention)
#   positionals accumulated in cmdit_positional(*) in argv order
#
# Flag modifiers (0.2.0): cmdit_enum (choice flags) / cmdit_repeat (accumulate) /
# cmdit_required / cmdit_range (int bounds) / cmdit_env (env-var fallback). The
# env + required checks run in cmdit_finalize (chained by cmdit_parse); the
# cmdit_parse_argv core stays pure (no /proc, no env) for synthetic-argv testing.
#
# Verb dispatch (0.3.0): cmdit_verb / cmdit_verb_alias register subcommands;
# cmdit_dispatch identifies the verb (cmdit_verb_matched, switch on the id),
# resolving global flags before OR after the verb in one pass, and hands the
# caller a globals-removed remainder slice (cmdit_verb_argv) to re-parse in a
# per-verb handle — nested sub-verbs are just re-entry on that slice. The argv[0]
# busybox multiplexer is cmdit_basename + cmdit_raw_argv, caller-side. Like the
# parse core, cmdit_dispatch_argv is pure; cmdit_dispatch adds the impure finalize.
#
# NOT supported (deferred to the v2 backlog — docs/development/roadmap.md and
# docs/adr/0003-v1-freeze.md): bundled short bools -xyz, attached short value
# -xvalue, --no-foo negation, count -vvv. Out of cmdit scope: dynamic/large enum
# lists, cross-field/modulo ranges, pure-env cascades with no associated flag,
# in-core nested-verb trees (use re-entry), interactive/REPL command DSLs.
#
# Consumer deps: needs stdlib "args" (cmdit_argv/cmdit_parse — the /proc argv
# read) and "io" (cmdit_env -> getenv; referenced unconditionally by cmdit_parse
# via finalize). Pure callers that drive cmdit_parse_argv with their own array and
# never call cmdit_finalize still link getenv but never invoke it.

enum CmditType {
    CMDIT_BOOL = 0;
    CMDIT_INT = 1;
    CMDIT_STR = 2;
}

# Byte-compatible with flags.cyr FlagErr; the taxonomy only grows (append-only).
enum CmditErr {
    CMDIT_ERR_NONE = 0;
    CMDIT_ERR_UNKNOWN = 1;
    CMDIT_ERR_MISSING_VALUE = 2;
    CMDIT_ERR_BAD_INT = 3;
    CMDIT_ERR_BUNDLED = 4;
    CMDIT_ERR_REQUIRED_MISSING = 5;   # 0.2.0: a cmdit_required flag absent at finalize
    CMDIT_ERR_BAD_ENUM = 6;           # 0.2.0: a cmdit_enum value outside its choice set
    CMDIT_ERR_OUT_OF_RANGE = 7;       # 0.2.0: a cmdit_range int outside [min, max]
    CMDIT_ERR_UNKNOWN_VERB = 8;       # 0.3.0: a verb token matching no registered verb
    CMDIT_ERR_MISSING_POSITIONAL = 9; # 0.3.0: cmdit_require_positionals count not met
    CMDIT_ERR_TOO_MANY_POSITIONAL = 10; # 1.0.0: cmdit_require_positionals_max/_exact upper bound exceeded
}

# Parse result codes (return of cmdit_parse / cmdit_parse_argv).
var CMDIT_OK = 0;
var CMDIT_HELP = 2;          # --help / -h seen
var CMDIT_VERSION = 3;       # --version / -V seen
var CMDIT_RESULT_ERR = 0 - 1;

# The AGNOS userland exit-code convention — named so consumers stop redefining
# KII_EXIT_* / EXIT_* per repo.
var CMDIT_EXIT_OK = 0;       # success (incl. help / version)
var CMDIT_EXIT_RUN = 1;      # runtime failure
var CMDIT_EXIT_USAGE = 2;    # usage / parse error

var CMDIT_FLAGS_MAX = 64;    # raised from flags.cyr's 32 — attn11 has ~35 flags
var CMDIT_POS_MAX = 128;
var CMDIT_CTX_SIZE = 168;    # 1.2.2: +160 trailing_verbatim (0.3.0 added +104..+152 verb dispatch state; was 104)
var CMDIT_ENTRY_SIZE = 112;  # 1.0.0: grown 104 -> 112 (metavar at +104), append-only (old offsets unchanged)
var CMDIT_REPEAT_MAX = 64;   # per cmdit_repeat flag occurrence cap (silently capped, like positionals)
var CMDIT_VERB_MAX = 128;    # 0.3.0: verb table cap (sit has 25 verbs; aliases are extra rows)
var CMDIT_VERB_SIZE = 32;    # 0.3.0: verb-row stride (+0 name +8 help +16 canonical_id +24 trailing_after)

# Per-entry attribute bitfield (entry +48). Append-only; the byte-compatible
# 0.1.0 type/offset layout (+0..+40) is untouched, so CMDIT_BOOL/INT/STR stay {0,1,2}.
var CMDIT_ATTR_REQUIRED = 1;   # cmdit_required — must be SEEN by finalize
var CMDIT_ATTR_SEEN = 2;       # set by CLI parse or env fallback when a value was applied
var CMDIT_ATTR_RANGE = 4;      # cmdit_range — min/max valid at +72/+80
var CMDIT_ATTR_REPEAT = 8;     # cmdit_repeat — list at +88, count at +96

# Context layout (160 B):
#   +0  entries_ptr      : i64 array of CMDIT_ENTRY_SIZE entries
#   +8  entries_cap      : i64 (= CMDIT_FLAGS_MAX)
#  +16  entries_count    : i64
#  +24  positional_ptr   : i64 array of cstr ptrs (argv-style)
#  +32  positional_cap   : i64 (= CMDIT_POS_MAX)
#  +40  positional_count : i64
#  +48  prog_name        : i64 (cstr; caller-supplied for clean usage lines)
#  +56  last_error       : i64 (CmditErr)
#  +64  raw_argv         : i64 (materialized cstr* array; 0 until cmdit_argv)
#  +72  raw_argc         : i64
#  +80  help_idx         : i64 (auto-registered --help/-h flag index)
#  +88  version_idx      : i64 (auto-registered --version/-V flag index)
#  +96  err_entry        : i64 (0.2.0; entry ptr that produced last_error, 0 = none/UNKNOWN)
#  +104 verbs_ptr        : i64 (0.3.0; CMDIT_VERB_SIZE-row table, 0 until first cmdit_verb — lazy)
#  +112 verbs_cap        : i64 (= CMDIT_VERB_MAX once allocated)
#  +120 verbs_count      : i64
#  +128 verb_matched     : i64 (canonical id of the dispatched verb, -1 = none)
#  +136 verb_argv        : i64 (compacted remainder cstr*; argv[0]=verb name; 0 = none)
#  +144 verb_argc        : i64
#  +152 err_verb         : i64 (cstr; offending token for CMDIT_ERR_UNKNOWN_VERB, 0 = none)
#
# Verb row (32 B): +0 name (cstr)  +8 help (cstr)  +16 canonical_id (own index for a
#   real verb, target index for an alias row)  +24 reserved (future sub-verb table)
#
# Entry layout (112 B). +0..+40 are byte-compatible with flags.cyr; +48..+96 are
# the append-only 0.2.0 modifier fields; +104 is the 1.0.0 metavar:
#   +0 short_ch  +8 long_name  +16 type  +24 value  +32 default_value  +40 help
#  +48 attrs (bitfield)  +56 choices (cstr, "a|b|c"; 0=not enum)  +64 env_name (cstr; 0=none)
#  +72 range_min  +80 range_max  +88 repeat_list (cstr* array; 0 until first append)  +96 repeat_count
# +104 metavar (cstr; 0 = default <int>/<str>/<choices> help placeholder)

fn _cmdit_add(h, short_ch, long_name, type, default_val, help): i64 {
    var count = load64(h + 16);
    if (count >= CMDIT_FLAGS_MAX) { return 0 - 1; }
    var ep = load64(h) + count * CMDIT_ENTRY_SIZE;
    store64(ep, short_ch);
    store64(ep + 8, long_name);
    store64(ep + 16, type);
    store64(ep + 24, default_val);
    store64(ep + 32, default_val);
    store64(ep + 40, help);
    store64(h + 16, count + 1);
    return count;
}

# Register a bool flag (`short_ch` = ASCII byte, 0 = none; `long_name` = cstr, 0 =
# none). Returns the flag index for cmdit_get_*.
fn cmdit_bool(h, short_ch, long_name, help): i64 {
    return _cmdit_add(h, short_ch, long_name, CMDIT_BOOL, 0, help);
}
# Register an int flag (decimal, optional leading minus; strict — rejects garbage).
fn cmdit_int(h, short_ch, long_name, default_val, help): i64 {
    return _cmdit_add(h, short_ch, long_name, CMDIT_INT, default_val, help);
}
# Register a string/path flag (stores the argv token directly, no copy).
fn cmdit_str(h, short_ch, long_name, default_val, help): i64 {
    return _cmdit_add(h, short_ch, long_name, CMDIT_STR, default_val, help);
}

# --- 0.2.0 flag modifiers ----------------------------------------------------
# Each subsumes a pattern the 2026-06-25 ecosystem survey found hand-rolled
# across the consumer repos. All append-only on top of the byte-compatible core.

# Register a choice/enum flag (underlying CMDIT_STR). `choices` is a '|'-delimited
# cstr literal, e.g. "auto|always|never"; the parsed value must be one of them or
# parse fails with CMDIT_ERR_BAD_ENUM. `default_val` is a default-choice cstr (or
# 0). Retrieve the raw choice with cmdit_get_str, or its 0-based index (for
# dispatch) with cmdit_get_enum. Subsumes the nested-streq validation in
# attn11/owl/agnova/cyim/phylax. (A consumer's own non-index mapping — e.g. owl's
# auto=-1/always=1/never=0 sentinels — is a trivial 3-way map on cmdit_get_enum.)
fn cmdit_enum(h, short_ch, long_name, default_val, choices, help): i64 {
    var idx = _cmdit_add(h, short_ch, long_name, CMDIT_STR, default_val, help);
    if (idx < 0) { return idx; }
    store64(_cmdit_entry(h, idx) + 56, choices);
    return idx;
}

# Register a repeatable flag (underlying CMDIT_STR): each `--flag value`
# occurrence appends to a per-flag list (cap CMDIT_REPEAT_MAX, silently capped
# like positionals). Read with cmdit_repeat_count / cmdit_repeat_get; the last
# occurrence is also visible via cmdit_get_str. Subsumes whirl's -H accumulator.
fn cmdit_repeat(h, short_ch, long_name, help): i64 {
    var idx = _cmdit_add(h, short_ch, long_name, CMDIT_STR, 0, help);
    if (idx < 0) { return idx; }
    var ep = _cmdit_entry(h, idx);
    store64(ep + 48, load64(ep + 48) | CMDIT_ATTR_REPEAT);
    return idx;
}

# Mark an already-registered flag (any type, incl. bool) required: absent at
# finalize -> CMDIT_ERR_REQUIRED_MISSING. Presence is tracked by a SEEN bit (set
# by CLI parse or env fallback), so a required bool like agnova --i-mean-it
# distinguishes absent from explicit-false. Returns idx for chaining. Subsumes
# agora --handle / agnova --device/--user/--i-mean-it post-parse sentinel checks.
fn cmdit_required(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    var ep = _cmdit_entry(h, idx);
    store64(ep + 48, load64(ep + 48) | CMDIT_ATTR_REQUIRED);
    return idx;
}

# Constrain an int flag to the inclusive range [min_val, max_val]. Out-of-range
# input is REJECTED (not clamped) -> CMDIT_ERR_OUT_OF_RANGE. Returns idx for
# chaining. Static constant bounds only (cross-field/modulo bounds — attn11
# --rope-dim<=d_model, rope_dim%2 — stay caller-side). Subsumes bannermanor
# --width/--pad, attn11 --layers/--mtp/--bpe caps. (No-op on non-int flags.)
fn cmdit_range(h, idx, min_val, max_val): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    var ep = _cmdit_entry(h, idx);
    store64(ep + 48, load64(ep + 48) | CMDIT_ATTR_RANGE);
    store64(ep + 72, min_val);
    store64(ep + 80, max_val);
    return idx;
}

# Give a flag an environment-variable fallback: if absent from argv, its value
# comes from `env_name` (read at finalize). CLI always wins. Bool flags use
# presence semantics (var set to ANY value, even empty, -> 1; the NO_COLOR
# convention); int/str/enum flags use the value (set-but-empty is ignored).
# Env values are validated NON-FATALLY — a bad int / out-of-range / bad enum
# falls through to the registered default rather than erroring. Returns idx for
# chaining. Subsumes single flag-bound vars (NO_COLOR, CHAKSHU_HOOSH_TOKEN,
# ARK_CONFIG); pure-env cascades with no flag stay caller-side. Needs stdlib "io".
fn cmdit_env(h, idx, env_name): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    store64(_cmdit_entry(h, idx) + 64, env_name);
    return idx;
}

# --- 1.0.0 help-rendering modifier -------------------------------------------

# Override a value flag's generated help placeholder (the auto "<int>"/"<str>"/
# "<a|b|c>" token) with a custom metavar — e.g. cmdit_metavar(h, f_out, "FILE")
# renders "--out <FILE>". Cosmetic (help only); does not affect parsing, and is a
# no-op on bool flags (which take no value). Returns idx for chaining.
fn cmdit_metavar(h, idx, name): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    store64(_cmdit_entry(h, idx) + 104, name);
    return idx;
}

# Allocate-once parser context. Auto-registers --help/-h and --version/-V, so
# every cmdit tool gets them for free. `prog_name` is the clean name printed in
# usage/version lines (pass 0 to fall back to argv[0] at parse).
fn cmdit_new(prog_name): i64 {
    var h = alloc(CMDIT_CTX_SIZE);
    var entries = alloc(CMDIT_FLAGS_MAX * CMDIT_ENTRY_SIZE);
    var positional = alloc(CMDIT_POS_MAX * 8);
    # 1.2.4: stdlib alloc returns 0 on failure (OOM, or a size outside
    # (0, ALLOC_MAX]) — it does not abort. Unchecked, the memzero loop below
    # wrote 7168 bytes from address 0. Returns 0 so the caller can bail; every
    # public entry point tolerates a 0 handle. CHANGELOG [1.2.4].
    # ⚠ NOT covered by a failing test, and deliberately recorded as such: the
    # three sizes here are compile-time constants well inside ALLOC_MAX, so no
    # public API call can drive alloc to return 0. Deleting this line keeps the
    # suite green — it is defence-in-depth against an exhausted heap, not a
    # behaviour any fixture reaches.
    if (h == 0 || entries == 0 || positional == 0) { return 0; }
    var i = 0;
    while (i < CMDIT_FLAGS_MAX * CMDIT_ENTRY_SIZE) { store8(entries + i, 0); i = i + 1; }
    store64(h, entries);
    store64(h + 8, CMDIT_FLAGS_MAX);
    store64(h + 16, 0);
    store64(h + 24, positional);
    store64(h + 32, CMDIT_POS_MAX);
    store64(h + 40, 0);
    store64(h + 48, prog_name);
    store64(h + 56, CMDIT_ERR_NONE);
    store64(h + 64, 0);
    store64(h + 72, 0);
    store64(h + 96, 0);                                                          # err_entry (0.2.0)
    store64(h + 104, 0);                                                         # verbs_ptr (0.3.0; lazy)
    store64(h + 112, 0);                                                         # verbs_cap
    store64(h + 120, 0);                                                         # verbs_count
    store64(h + 128, 0 - 1);                                                     # verb_matched (none)
    store64(h + 136, 0);                                                         # verb_argv
    store64(h + 144, 0);                                                         # verb_argc
    store64(h + 152, 0);                                                         # err_verb
    store64(h + 160, 0);                                                         # trailing_verbatim (1.2.2; 0 = off)
    store64(h + 80, cmdit_bool(h, 104, "help", "show this help and exit"));      # 'h'
    store64(h + 88, cmdit_bool(h, 86, "version", "print version and exit"));     # 'V'
    return h;
}

fn _cmdit_entry(h, idx): i64 { return load64(h) + idx * CMDIT_ENTRY_SIZE; }

# Remap or disable the auto -h / -V short letters (the long --help/--version and
# help/version detection are unaffected — only the single-char alias changes).
# Pass a new ASCII byte to remap, or 0 to drop the short letter entirely, freeing
# e.g. -h for a consumer's own flag (the df -h / ls -h "human-readable" convention
# that hard-binding -h=help fights). Call after cmdit_new, before parse. Returns 0.
fn cmdit_help_short(h, ch): i64 {
    if (h == 0) { return 0; }
    store64(_cmdit_entry(h, load64(h + 80)), ch);
    return 0;
}

# Same, for the auto --version short letter. Pass 0 to drop -V entirely.
fn cmdit_version_short(h, ch): i64 {
    if (h == 0) { return 0; }
    store64(_cmdit_entry(h, load64(h + 88)), ch);
    return 0;
}

# 1 if idx is a valid registered-flag index, else 0. Guards the public typed
# getters so an ignored -1 registration return (cmdit_get_*(h, -1)) or a stray
# out-of-range idx yields a safe sentinel instead of an out-of-bounds entry read
# — mirrors the bounds checks in cmdit_positional / cmdit_repeat_get.
fn _cmdit_idx_ok(h, idx): i64 {
    if (h == 0) { return 0; }
    if (idx < 0) { return 0; }
    if (idx >= load64(h + 16)) { return 0; }
    return 1;
}

# Typed accessors by flag index (parsed value, else registered default; a bad
# idx returns the type's zero sentinel rather than reading out of bounds).
fn cmdit_get_bool(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0; }
    return load64(_cmdit_entry(h, idx) + 24);
}

# Parsed int value, else the registered default. 0 for a bad idx.
fn cmdit_get_int(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0; }
    return load64(_cmdit_entry(h, idx) + 24);
}

# Parsed string value (an interior pointer into argv, not a copy), else the
# registered default. 0 for a bad idx.
fn cmdit_get_str(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0; }
    return load64(_cmdit_entry(h, idx) + 24);
}

# Enum flag's 0-based matched-choice index (the dispatch the survey found every
# consumer re-deriving) — order of the '|'-delimited choices, -1 if unset/none or
# the stored value is not in the set. Cache it once after parse; it re-walks the
# choices cstr per call.
fn cmdit_get_enum(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    var ep = _cmdit_entry(h, idx);
    return _cmdit_enum_index(load64(ep + 56), load64(ep + 24));
}

# 1 if the flag was provided (CLI or env fallback), 0 if still at its default.
# The presence query cmdit_required relies on — also enables bespoke confirmation
# messages, conditional-required, and duplicate detection in caller code. (SEEN
# does not distinguish CLI-set from env-set.)
fn cmdit_seen(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0; }
    if ((load64(_cmdit_entry(h, idx) + 48) & CMDIT_ATTR_SEEN) != 0) { return 1; }
    return 0;
}

# Repeatable flag accessors: count of accumulated occurrences, and the i-th value
# (cstr) in argv order (0 if out of range).
fn cmdit_repeat_count(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0; }
    return load64(_cmdit_entry(h, idx) + 96);
}
# The i-th accumulated value (cstr) in argv order, or 0 when `idx` names no
# registered flag or `i` is outside [0, cmdit_repeat_count).
fn cmdit_repeat_get(h, idx, i): i64 {
    # 1.2.4: `idx` is guarded too. It used to compute _cmdit_entry(h, idx)
    # unchecked and then DEREFERENCE the list pointer read from that address —
    # a bad idx did not merely read out of bounds, it followed whatever those
    # bytes happened to be. CHANGELOG [1.2.4].
    if (_cmdit_idx_ok(h, idx) == 0) { return 0; }
    var ep = _cmdit_entry(h, idx);
    if (i < 0) { return 0; }
    # The count test above also covers a null list: the list is allocated on the
    # first push, which is also what makes the count non-zero, so count == 0
    # whenever the pointer is 0 and no i can get past the line above. (A null
    # check here is unreachable — mutation-verified, not assumed.)
    if (i >= load64(ep + 96)) { return 0; }
    return load64(load64(ep + 88) + i * 8);
}

# Positional (non-flag) args in argv order, including everything after `--`.
fn cmdit_positional_count(h): i64 { return load64(h + 40); }
# The idx-th positional (cstr, an interior pointer into argv), or 0 when idx is
# outside [0, cmdit_positional_count).
fn cmdit_positional(h, idx): i64 {
    if (idx < 0) { return 0; }
    if (idx >= load64(h + 40)) { return 0; }
    return load64(load64(h + 24) + idx * 8);
}

# Last parse error (CmditErr). Checked after a CMDIT_RESULT_ERR return.
fn cmdit_error(h): i64 { return load64(h + 56); }

# Index of the flag that produced the last error (for consumer-rendered messages),
# or -1 if none / the error names no registered flag (UNKNOWN/BUNDLED). The same
# flag cmdit_print_error names. Matches the registration index from cmdit_*.
fn cmdit_err_flag(h): i64 {
    var ep = load64(h + 96);
    if (ep == 0) { return 0 - 1; }
    return (ep - load64(h)) / CMDIT_ENTRY_SIZE;
}

# Verb dispatch accessors (0.3.0). cmdit_verb_matched is the identify-and-return
# key the caller switches on (mirrors cmdit_get_enum): the canonical id of the
# dispatched verb, or -1 if no verb token was present (distinct from a
# CMDIT_RESULT_ERR / UNKNOWN_VERB, where a token matched nothing). verb_argc/argv
# are the globals-removed remainder slice (argv[0] = verb name) to feed a child
# handle's cmdit_parse_argv (also how nested sub-verbs work — re-enter on it).
fn cmdit_verb_matched(h): i64 { return load64(h + 128); }
# Token count of the remainder slice (>= 1 once a verb matched: argv[0] is the
# verb name). Feed it, with cmdit_verb_argv, to the child handle's parse.
fn cmdit_verb_argc(h): i64 { return load64(h + 144); }
# The remainder slice itself: a NULL-terminated cstr* array whose [0] is the
# matched verb name, shaped like a real argv so cmdit_parse_argv accepts it.
fn cmdit_verb_argv(h): i64 { return load64(h + 136); }

# Escape hatch: the materialized argv array + count, for non-getopt grammars
# (e.g. dig's @server / +opt) that hand-tokenize but still want help/version.
fn cmdit_raw_argv(h): i64 { return load64(h + 64); }
# Token count of that array (0 until cmdit_argv has materialized it).
fn cmdit_raw_argc(h): i64 { return load64(h + 72); }

# --- parser internals (forked from flags.cyr, byte-compatible) ---------------

fn _cmdit_streq_bounded(a, b, len): i64 {
    var i = 0;
    while (i < len) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    if (load8(b + len) != 0) { return 0; }
    return 1;
}

fn _cmdit_find_long(h, name, len): i64 {
    var count = load64(h + 16);
    var i = 0;
    while (i < count) {
        var ep = _cmdit_entry(h, i);
        var ep_name = load64(ep + 8);
        if (ep_name != 0) {
            if (_cmdit_streq_bounded(name, ep_name, len) == 1) { return ep; }
        }
        i = i + 1;
    }
    return 0;
}

fn _cmdit_find_short(h, ch): i64 {
    var count = load64(h + 16);
    var i = 0;
    while (i < count) {
        var ep = _cmdit_entry(h, i);
        if (load64(ep) == ch && ch != 0) { return ep; }
        i = i + 1;
    }
    return 0;
}

var _cmdit_pint_ok = 0;
# Strict signed-decimal parse; sets _cmdit_pint_ok 1/0, rejects trailing garbage.
# Overflow is also rejected (not wrapped): a value whose magnitude exceeds i64 max
# leaves _cmdit_pint_ok 0 -> CMDIT_ERR_BAD_INT, so a giant digit string cannot
# silently wrap past a cmdit_range bound. (INT64_MIN's exact magnitude is rejected
# too — an accepted edge; range-bounded ints are never that large.)
fn _cmdit_parse_int(s): i64 {
    _cmdit_pint_ok = 0;
    if (s == 0) { return 0; }
    var i = 0;
    var neg = 0;
    if (load8(s) == 45) { neg = 1; i = 1; }
    var n = 0;
    var seen = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c < 48) { return 0; }
        if (c > 57) { return 0; }
        var d = c - 48;
        if (n > (9223372036854775807 - d) / 10) { return 0; }   # would overflow i64 -> reject
        n = n * 10 + d;
        seen = 1;
        i = i + 1;
    }
    if (seen == 0) { return 0; }
    _cmdit_pint_ok = 1;
    if (neg == 1) { return 0 - n; }
    return n;
}

# 0-based index of `value` among the '|'-delimited tokens in `choices`, else -1.
# Tokens are compared by exact length + bytes (no NUL inside choices between
# delimiters). Used for both enum validation (>= 0 == valid) and cmdit_get_enum.
fn _cmdit_enum_index(choices, value): i64 {
    if (choices == 0) { return 0 - 1; }
    if (value == 0) { return 0 - 1; }
    var vlen = strlen(value);
    var ts = 0;          # current token start in choices
    var i = 0;
    var idx = 0;
    var done = 0;
    while (done == 0) {
        var c = load8(choices + i);
        if (c == 0) { done = 1; }
        if (c == 124 || c == 0) {       # '|' (124) or end of string
            var tlen = i - ts;
            if (tlen == vlen) {
                var k = 0;
                var hit = 1;
                while (k < vlen) {
                    if (load8(choices + ts + k) != load8(value + k)) { hit = 0; break; }
                    k = k + 1;
                }
                if (hit == 1) { return idx; }
            }
            idx = idx + 1;
            ts = i + 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Append a value to a repeat flag's per-entry list (alloc'd lazily). The value is
# also written to +24 so cmdit_get_str yields a last-wins scalar view. Silently
# caps the LIST at CMDIT_REPEAT_MAX (same drop-past-cap contract as positionals);
# the last-wins view keeps tracking past the cap.
fn _cmdit_repeat_push(ep, value_ptr): i64 {
    store64(ep + 24, value_ptr);
    var list = load64(ep + 88);
    if (list == 0) {
        list = alloc(CMDIT_REPEAT_MAX * 8);
        if (list == 0) { return CMDIT_ERR_NONE; }                 # 1.2.4: OOM -> same drop-past-cap contract
        store64(ep + 88, list);
    }
    var c = load64(ep + 96);
    if (c >= CMDIT_REPEAT_MAX) { return CMDIT_ERR_NONE; }
    store64(list + c * 8, value_ptr);
    store64(ep + 96, c + 1);
    return CMDIT_ERR_NONE;
}

# Apply a value to an entry. Does NOT set the SEEN bit — callers (parse loop /
# env fallback) set SEEN only on success, so a non-fatal env failure leaves the
# default untouched and un-SEEN. Repeat appends; enum/range validate before store.
fn _cmdit_apply(ep, value_ptr): i64 {
    var type = load64(ep + 16);
    var attrs = load64(ep + 48);
    if ((attrs & CMDIT_ATTR_REPEAT) != 0) {
        if (value_ptr == 0) { return CMDIT_ERR_MISSING_VALUE; }
        return _cmdit_repeat_push(ep, value_ptr);
    }
    if (type == CMDIT_BOOL) { store64(ep + 24, 1); return CMDIT_ERR_NONE; }
    if (value_ptr == 0) { return CMDIT_ERR_MISSING_VALUE; }
    if (type == CMDIT_INT) {
        var n = _cmdit_parse_int(value_ptr);
        if (_cmdit_pint_ok == 0) { return CMDIT_ERR_BAD_INT; }
        if ((attrs & CMDIT_ATTR_RANGE) != 0) {
            if (n < load64(ep + 72)) { return CMDIT_ERR_OUT_OF_RANGE; }
            if (n > load64(ep + 80)) { return CMDIT_ERR_OUT_OF_RANGE; }
        }
        store64(ep + 24, n);
        return CMDIT_ERR_NONE;
    }
    var choices = load64(ep + 56);              # CMDIT_STR (incl. enum)
    if (choices != 0) {
        if (_cmdit_enum_index(choices, value_ptr) < 0) { return CMDIT_ERR_BAD_ENUM; }
    }
    store64(ep + 24, value_ptr);
    return CMDIT_ERR_NONE;
}

fn _cmdit_push_positional(h, tok): i64 {
    var pc = load64(h + 40);
    if (pc >= load64(h + 32)) { return 0; }
    store64(load64(h + 24) + pc * 8, tok);
    store64(h + 40, pc + 1);
    return 0;
}

# Parse a passed cstr* array (argv + i*8). PURE — never reads /proc, so tests
# drive synthetic argv. Returns CMDIT_OK / CMDIT_HELP / CMDIT_VERSION /
# CMDIT_RESULT_ERR (cmdit_error reports which on the last).
fn cmdit_parse_argv(h, argc, argv): i64 {
    # 1.2.4: reset the per-parse error trio. Without this a handle parsed a
    # second time carried the FIRST parse's err_entry, and cmdit_print_error /
    # cmdit_err_flag name a flag from an error that has nothing to do with the
    # one being reported. CHANGELOG [1.2.4].
    store64(h + 56, CMDIT_ERR_NONE);
    store64(h + 96, 0);
    store64(h + 152, 0);
    if (load64(h + 48) == 0) { if (argc > 0) { store64(h + 48, load64(argv)); } }
    var i = 1;
    var in_positional = 0;
    # 1.2.2: trailing-verbatim, propagated from the dispatcher by
    # cmdit_parse_verb. -1 = off. Once this many positionals have been pushed,
    # every remaining token is a positional whatever it looks like.
    var trail = load64(h + 160);
    while (i < argc) {
        var tok = load64(argv + i * 8);
        if (tok == 0) { i = i + 1; continue; }
        if (trail > 0) {
            if (cmdit_positional_count(h) >= trail - 1) { in_positional = 1; }
        }
        if (in_positional == 1) { _cmdit_push_positional(h, tok); i = i + 1; continue; }
        if (load8(tok) != 45) { _cmdit_push_positional(h, tok); i = i + 1; continue; }
        if (load8(tok + 1) == 0) { _cmdit_push_positional(h, tok); i = i + 1; continue; }
        if (load8(tok + 1) == 45 && load8(tok + 2) == 0) { in_positional = 1; i = i + 1; continue; }

        var ep = 0;
        var value_ptr = 0;
        if (load8(tok + 1) == 45) {
            var name_start = tok + 2;
            var j = 0;
            var eq = 0 - 1;
            while (load8(name_start + j) != 0) {
                if (load8(name_start + j) == 61) { eq = j; break; }
                j = j + 1;
            }
            var name_len = j;
            if (eq >= 0) { name_len = eq; }
            ep = _cmdit_find_long(h, name_start, name_len);
            if (ep == 0) { store64(h + 56, CMDIT_ERR_UNKNOWN); return CMDIT_RESULT_ERR; }
            if (eq >= 0) { value_ptr = name_start + eq + 1; }
            if (value_ptr == 0 && load64(ep + 16) != CMDIT_BOOL) {
                if (i + 1 >= argc) {
                    store64(h + 56, CMDIT_ERR_MISSING_VALUE);
                    store64(h + 96, ep);
                    return CMDIT_RESULT_ERR;
                }
                value_ptr = load64(argv + (i + 1) * 8);
                i = i + 1;
            }
        } else {
            if (load8(tok + 2) != 0) { store64(h + 56, CMDIT_ERR_BUNDLED); return CMDIT_RESULT_ERR; }
            ep = _cmdit_find_short(h, load8(tok + 1));
            if (ep == 0) { store64(h + 56, CMDIT_ERR_UNKNOWN); return CMDIT_RESULT_ERR; }
            if (load64(ep + 16) != CMDIT_BOOL) {
                if (i + 1 >= argc) {
                    store64(h + 56, CMDIT_ERR_MISSING_VALUE);
                    store64(h + 96, ep);
                    return CMDIT_RESULT_ERR;
                }
                value_ptr = load64(argv + (i + 1) * 8);
                i = i + 1;
            }
        }
        var ar = _cmdit_apply(ep, value_ptr);
        if (ar != CMDIT_ERR_NONE) { store64(h + 56, ar); store64(h + 96, ep); return CMDIT_RESULT_ERR; }
        store64(ep + 48, load64(ep + 48) | CMDIT_ATTR_SEEN);   # mark provided (for required/env)
        i = i + 1;
    }
    if (cmdit_get_bool(h, load64(h + 80)) == 1) { return CMDIT_HELP; }
    if (cmdit_get_bool(h, load64(h + 88)) == 1) { return CMDIT_VERSION; }
    return CMDIT_OK;
}

# Materialize argc()/argv(i) into a contiguous, NULL-terminated cstr* array once,
# cached on the ctx. Absorbs the build_argv_array / _materialize_argv boilerplate
# every structured consumer copies. Calls args_init() once (guarded). Needs
# stdlib "args".
fn cmdit_argv(h): i64 {
    if (load64(h + 64) != 0) { return load64(h + 72); }
    args_init();
    var n = argc();
    var arr = alloc((n + 1) * 8);
    if (arr == 0) { return 0; }                                  # 1.2.4: OOM -> no argv, not a null write
    var i = 0;
    while (i < n) { store64(arr + i * 8, argv(i)); i = i + 1; }
    store64(arr + n * 8, 0);             # NULL terminator (execve-passthrough safe)
    store64(h + 64, arr);
    store64(h + 72, n);
    return n;
}

# --- 0.2.0 finalize: env fallback + required check (the impure post-stage) ---
# Kept OUT of cmdit_parse_argv so that pure core stays /proc- and env-free and
# the synthetic-argv test suite is deterministic. cmdit_parse runs it; tests can
# call it directly (with no env_name set, getenv is never reached -> still pure).

# For every un-SEEN flag with an env_name, apply the env var as a fallback value.
# NON-FATAL: a bad int / out-of-range / bad enum / set-but-empty value is ignored
# (default preserved, flag stays un-SEEN) — only CLI input is fatal. Bool flags
# use presence semantics (var set to ANY value, even empty, -> 1; NO_COLOR-style).
fn _cmdit_apply_env(h): i64 {
    var count = load64(h + 16);
    var i = 0;
    while (i < count) {
        var ep = _cmdit_entry(h, i);
        var env_name = load64(ep + 64);
        if (env_name != 0 && (load64(ep + 48) & CMDIT_ATTR_SEEN) == 0) {
            var val = getenv(env_name);
            if (val != 0) {
                if (load64(ep + 16) == CMDIT_BOOL) {
                    store64(ep + 24, 1);                                          # presence -> true
                    store64(ep + 48, load64(ep + 48) | CMDIT_ATTR_SEEN);
                } else {
                    if (load8(val) != 0) {                                        # ignore set-but-empty
                        if (_cmdit_apply(ep, val) == CMDIT_ERR_NONE) {
                            store64(ep + 48, load64(ep + 48) | CMDIT_ATTR_SEEN);
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return CMDIT_ERR_NONE;
}

# Every cmdit_required flag must be SEEN (by CLI or env); else the first such flag
# yields CMDIT_ERR_REQUIRED_MISSING + err_entry.
fn _cmdit_check_required(h): i64 {
    var count = load64(h + 16);
    var i = 0;
    while (i < count) {
        var ep = _cmdit_entry(h, i);
        var attrs = load64(ep + 48);
        if ((attrs & CMDIT_ATTR_REQUIRED) != 0) {
            if ((attrs & CMDIT_ATTR_SEEN) == 0) { store64(h + 96, ep); return CMDIT_ERR_REQUIRED_MISSING; }
        }
        i = i + 1;
    }
    return CMDIT_ERR_NONE;
}

# Run the post-parse stage: env fallback FIRST (so env can satisfy required),
# then the required check. Returns CMDIT_OK or CMDIT_RESULT_ERR (cmdit_error =
# REQUIRED_MISSING). Call only on a CMDIT_OK parse (help/version short-circuit
# before this). Idempotent enough for one finalize per parse.
fn cmdit_finalize(h): i64 {
    _cmdit_apply_env(h);
    var rq = _cmdit_check_required(h);
    if (rq != CMDIT_ERR_NONE) { store64(h + 56, rq); return CMDIT_RESULT_ERR; }
    return CMDIT_OK;
}

# Convenience: materialize the process argv, parse it, then finalize (env +
# required). The form most single-tool consumers call. help/version/parse-error
# results propagate untouched — finalize runs only on a clean CMDIT_OK parse.
fn cmdit_parse(h): i64 {
    var n = cmdit_argv(h);
    var r = cmdit_parse_argv(h, n, load64(h + 64));
    if (r != CMDIT_OK) { return r; }
    return cmdit_finalize(h);
}

# Require at least `min` positional args (top-level or any verb child handle);
# count < min -> CMDIT_ERR_MISSING_POSITIONAL. Deferred from 0.2.0, shipped in
# 0.3.0 (CHANGELOG [0.3.0]);
# subsumes cyim's `if (r_npos < 3)` guards. Call after parse/dispatch.
fn cmdit_require_positionals(h, min): i64 {
    if (load64(h + 40) >= min) { return CMDIT_OK; }
    store64(h + 56, CMDIT_ERR_MISSING_POSITIONAL);
    store64(h + 96, 0);
    return CMDIT_RESULT_ERR;
}

# Require AT MOST `max` positionals; count > max -> CMDIT_ERR_TOO_MANY_POSITIONAL.
# The upper-bound mirror of cmdit_require_positionals (top-level or any verb handle).
fn cmdit_require_positionals_max(h, max): i64 {
    if (load64(h + 40) <= max) { return CMDIT_OK; }
    store64(h + 56, CMDIT_ERR_TOO_MANY_POSITIONAL);
    store64(h + 96, 0);
    return CMDIT_RESULT_ERR;
}

# Require EXACTLY `n` positionals: fewer -> CMDIT_ERR_MISSING_POSITIONAL, more ->
# CMDIT_ERR_TOO_MANY_POSITIONAL (the both-bounds gate, argparse nargs=N).
fn cmdit_require_positionals_exact(h, n): i64 {
    var c = load64(h + 40);
    if (c < n) { store64(h + 56, CMDIT_ERR_MISSING_POSITIONAL); store64(h + 96, 0); return CMDIT_RESULT_ERR; }
    if (c > n) { store64(h + 56, CMDIT_ERR_TOO_MANY_POSITIONAL); store64(h + 96, 0); return CMDIT_RESULT_ERR; }
    return CMDIT_OK;
}

# --- 0.3.0 verb / subcommand dispatch ---------------------------------------
# IDENTIFY-and-return (not handler fn-ptrs): cmdit_dispatch resolves argv to a
# matched verb id (cmdit_verb_matched) + a globals-removed remainder slice
# (cmdit_verb_argv) that the caller re-parses with a fresh per-verb handle. The
# pure cmdit_parse_argv core is untouched; cmdit_dispatch_argv is a new pure
# sibling. Nested sub-verbs are re-entry on the remainder; the argv[0]
# multiplexer is cmdit_basename + the raw-argv escape, caller-side.

fn _cmdit_verb_row(h, i): i64 { return load64(h + 104) + i * CMDIT_VERB_SIZE; }

# Whole-cstr equality (both NUL-terminated).
fn _cmdit_cstr_eq(a, b): i64 {
    var i = 0;
    while (load8(a + i) != 0) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    if (load8(b + i) != 0) { return 0; }
    return 1;
}

# Append a verb/alias row (lazy-allocating + zeroing the table on first use).
# canonical < 0 means "self" (a real verb -> canonical = own index). Returns the
# new row index, or -1 if the table is full.
fn _cmdit_verb_add(h, name, help, canonical): i64 {
    var vp = load64(h + 104);
    if (vp == 0) {
        vp = alloc(CMDIT_VERB_MAX * CMDIT_VERB_SIZE);
        if (vp == 0) { return 0 - 1; }                            # 1.2.4: OOM -> "table full", not a null memzero
        var z = 0;
        while (z < CMDIT_VERB_MAX * CMDIT_VERB_SIZE) { store8(vp + z, 0); z = z + 1; }
        store64(h + 104, vp);
        store64(h + 112, CMDIT_VERB_MAX);
        store64(h + 120, 0);
    }
    var count = load64(h + 120);
    if (count >= CMDIT_VERB_MAX) { return 0 - 1; }
    var row = vp + count * CMDIT_VERB_SIZE;
    store64(row, name);
    store64(row + 8, help);
    var canon = canonical;
    if (canon < 0) { canon = count; }
    store64(row + 16, canon);
    store64(row + 24, 0);
    store64(h + 120, count + 1);
    return count;
}

# Register a top-level verb. Returns its id (>= 0; the cmdit_verb_matched key), or
# -1 if the verb table is full.
fn cmdit_verb(h, name, help): i64 { return _cmdit_verb_add(h, name, help, 0 - 1); }

# 1.2.2: mark a verb as taking a VERBATIM trailing argument list after its first
# `n` positionals. Everything past that point is a positional, whatever it looks
# like — no flag parsing, at either the dispatcher or the verb level.
#
# This exists because a container runtime's `exec`, and anything else that
# forwards a command line to another program, cannot work without it:
#
#   stiva exec c1 ls -l          -> "unknown flag", the command never runs
#   stiva exec c1 -- ls -l       -> the SAME error (see the fix below)
#   stiva exec c1 mycmd --root /x -> silently retargets the CALLER's --root
#
# The last one is why this is a correctness fix and not a convenience: a global
# flag appearing inside the forwarded command was being applied to the host tool,
# changing where it wrote, with no diagnostic.
#
# `n` counts positionals AFTER the verb name. For `exec <container> <cmd>...`
# that is 1: the container id is ours, everything after belongs to the payload.
# Returns verb_id for chaining, or -1.
fn cmdit_verb_trailing_after(h, verb_id, n): i64 {
    if (h == 0) { return 0 - 1; }
    if (verb_id < 0) { return 0 - 1; }
    # 1.2.4: n < 0 stored n+1, so n == -1 silently meant "not marked" and
    # n < -1 stored a negative that cmdit_verb_trailing_at's `v == 0` test did
    # not catch, handing the dispatcher a nonsense threshold. CHANGELOG [1.2.4].
    if (n < 0) { return 0 - 1; }
    if (load64(h + 104) == 0) { return 0 - 1; }
    if (verb_id >= load64(h + 120)) { return 0 - 1; }
    # +1 so the stored value is always non-zero for a marked verb, keeping 0 as
    # "not marked" in a field that older callers left zeroed.
    store64(_cmdit_verb_row(h, verb_id) + 24, n + 1);
    return verb_id;
}

# Positionals-after-the-verb before trailing-verbatim kicks in, or -1 when the
# verb is not marked.
#[must_use]
fn cmdit_verb_trailing_at(h, verb_id): i64 {
    if (verb_id < 0) { return 0 - 1; }
    if (h == 0) { return 0 - 1; }
    if (load64(h + 104) == 0) { return 0 - 1; }
    if (verb_id >= load64(h + 120)) { return 0 - 1; }
    var v = load64(_cmdit_verb_row(h, verb_id) + 24);
    if (v == 0) { return 0 - 1; }
    return v - 1;
}

# Add an alias for an existing verb (an extra row resolving to verb_id). Returns
# verb_id for chaining, or -1 on error.
fn cmdit_verb_alias(h, verb_id, alias): i64 {
    if (verb_id < 0) { return 0 - 1; }
    if (_cmdit_verb_add(h, alias, 0, verb_id) < 0) { return 0 - 1; }
    return verb_id;
}

# Canonical id of the verb (or alias) named `name`, else -1.
fn _cmdit_find_verb(h, name): i64 {
    if (load64(h + 104) == 0) { return 0 - 1; }
    var count = load64(h + 120);
    var i = 0;
    while (i < count) {
        var row = _cmdit_verb_row(h, i);
        var rn = load64(row);
        if (rn != 0) { if (_cmdit_cstr_eq(rn, name) == 1) { return load64(row + 16); } }
        i = i + 1;
    }
    return 0 - 1;
}

# Resolve a flag token (--long, --long=val, or -x) to its registered global entry,
# else 0. Sets _cmdit_disp_val to the attached =value (or 0). A bundled short
# (-xy) resolves to 0 (not a recognized global).
var _cmdit_disp_val = 0;
fn _cmdit_disp_find(h, tok): i64 {
    _cmdit_disp_val = 0;
    if (load8(tok + 1) == 45) {
        var name_start = tok + 2;
        var j = 0;
        var eq = 0 - 1;
        while (load8(name_start + j) != 0) {
            if (load8(name_start + j) == 61) { eq = j; break; }
            j = j + 1;
        }
        var name_len = j;
        if (eq >= 0) { name_len = eq; }
        var ep = _cmdit_find_long(h, name_start, name_len);
        if (ep != 0) { if (eq >= 0) { _cmdit_disp_val = name_start + eq + 1; } }
        return ep;
    }
    if (load8(tok + 2) != 0) { return 0; }
    return _cmdit_find_short(h, load8(tok + 1));
}

# 1 if ep is the auto-registered --help or --version entry, which the dispatcher
# hands to the verb's scope rather than applying itself. #skip-lint ("deferred"
# here is this loop's runtime behaviour, not a backlog item).
fn _cmdit_is_auto(h, ep): i64 {
    if (ep == _cmdit_entry(h, load64(h + 80))) { return 1; }
    if (ep == _cmdit_entry(h, load64(h + 88))) { return 1; }
    return 0;
}

# Apply the global flag at argv[i] (resolving + consuming a value if needed) and
# mark it SEEN. Returns the resume index (i+1, or i+2 if a value token was taken),
# or -1 on error (last_error + err_entry set).
fn _cmdit_disp_apply_flag(h, argc, argv, i): i64 {
    var tok = load64(argv + i * 8);
    var ep = _cmdit_disp_find(h, tok);
    if (ep == 0) { store64(h + 56, CMDIT_ERR_UNKNOWN); return 0 - 1; }
    var value_ptr = _cmdit_disp_val;
    var ni = i + 1;
    if (value_ptr == 0) {
        if (load64(ep + 16) != CMDIT_BOOL) {
            if (i + 1 >= argc) { store64(h + 56, CMDIT_ERR_MISSING_VALUE); store64(h + 96, ep); return 0 - 1; }
            value_ptr = load64(argv + (i + 1) * 8);
            ni = i + 2;
        }
    }
    var ar = _cmdit_apply(ep, value_ptr);
    if (ar != CMDIT_ERR_NONE) { store64(h + 56, ar); store64(h + 96, ep); return 0 - 1; }
    store64(ep + 48, load64(ep + 48) | CMDIT_ATTR_SEEN);
    return ni;
}

# PURE verb-dispatch loop (no /proc, no env). Single pass: registered GLOBAL flags
# are applied wherever they appear (before OR after the verb — the ark double-scan
# fix); the first non-flag token is matched against the verb table; everything
# else (the verb name, unknown flags, positionals, and a --help/--version that
# follows the verb, which is deferred into the verb's own scope) #skip-lint
# is compacted into a remainder slice (argv[0] = verb name) for the caller to
# re-parse in a per-verb handle. Before the verb an unknown flag
# is a hard CMDIT_ERR_UNKNOWN; an unmatched non-flag token is CMDIT_ERR_UNKNOWN_VERB.
# Returns CMDIT_OK / CMDIT_HELP / CMDIT_VERSION / CMDIT_RESULT_ERR.
fn cmdit_dispatch_argv(h, argc, argv): i64 {
    # 1.2.4: reset the per-parse error trio. Without this a handle parsed a
    # second time carried the FIRST parse's err_entry, and cmdit_print_error /
    # cmdit_err_flag name a flag from an error that has nothing to do with the
    # one being reported. CHANGELOG [1.2.4].
    store64(h + 56, CMDIT_ERR_NONE);
    store64(h + 96, 0);
    store64(h + 152, 0);
    if (load64(h + 48) == 0) { if (argc > 0) { store64(h + 48, load64(argv)); } }
    if (argc < 0) { argc = 0; }                                   # 1.2.4: else alloc(<=0) -> 0 -> null write below
    var rem = alloc((argc + 1) * 8);
    if (rem == 0) { return CMDIT_RESULT_ERR; }                    # 1.2.4: OOM
    var rn = 0;
    var verb_found = 0;
    var no_more_flags = 0;
    var trailing_at = 0 - 1;        # 1.2.2: positionals before verbatim, or -1
    var post_positionals = 0;
    var i = 1;
    while (i < argc) {
        var tok = load64(argv + i * 8);
        if (tok == 0) { i = i + 1; continue; }
        var is_flag = 0;
        if (no_more_flags == 0) { if (load8(tok) == 45) { if (load8(tok + 1) != 0) { is_flag = 1; } } }
        if (is_flag == 1 && load8(tok + 1) == 45 && load8(tok + 2) == 0) {
            no_more_flags = 1;
            # 1.2.2 FIX: forward the terminator when it lands AFTER the verb.
            # It used to be consumed here and never copied into `rem`, so the
            # verb's own `cmdit_parse_argv` — which handles '--' perfectly well
            # — never saw one. The documented escape hatch for a command with
            # flags (`prog verb -- cmd -x`) therefore did nothing, and failed
            # identically to omitting it.
            #
            # Before the verb it is still consumed: `rem[0]` must be the verb
            # name, and a '--' there means "no more GLOBAL flags", which this
            # loop has already applied by setting no_more_flags.
            if (verb_found == 1) { store64(rem + rn * 8, tok); rn = rn + 1; }
            i = i + 1; continue;
        }
        if (verb_found == 0) {
            if (is_flag == 1) {
                var r = _cmdit_disp_apply_flag(h, argc, argv, i);
                if (r < 0) { return CMDIT_RESULT_ERR; }
                i = r; continue;
            }
            var vid = _cmdit_find_verb(h, tok);
            if (vid < 0) { store64(h + 152, tok); store64(h + 56, CMDIT_ERR_UNKNOWN_VERB); return CMDIT_RESULT_ERR; }
            store64(h + 128, vid);
            store64(rem + rn * 8, tok); rn = rn + 1;          # remainder[0] = verb name
            verb_found = 1;
            # Resolve through the alias to the canonical row, so an alias
            # inherits the trailing behaviour of the verb it names.
            trailing_at = cmdit_verb_trailing_at(h, load64(_cmdit_verb_row(h, vid) + 16));
            i = i + 1; continue;
        }
        # after the verb
        #
        # 1.2.2: for a verb marked `cmdit_verb_trailing_after(n)`, stop treating
        # anything as a flag once n positionals have been seen. Without this a
        # GLOBAL flag appearing inside a forwarded command line is applied to the
        # host tool — `exec c1 mycmd --root /x` silently retargeted the caller's
        # data root, with no diagnostic and the payload none the wiser.
        if (trailing_at >= 0) {
            if (post_positionals >= trailing_at) { no_more_flags = 1; is_flag = 0; }
        }
        if (is_flag == 1) {
            var ep = _cmdit_disp_find(h, tok);
            if (ep != 0) { if (_cmdit_is_auto(h, ep) == 0) {
                    var r2 = _cmdit_disp_apply_flag(h, argc, argv, i);
                    if (r2 < 0) { return CMDIT_RESULT_ERR; }
                    i = r2; continue;
                } }
        }
        store64(rem + rn * 8, tok); rn = rn + 1;              # defer to the verb's scope
        if (verb_found == 1) { post_positionals = post_positionals + 1; }
        i = i + 1;
    }
    store64(rem + rn * 8, 0);                                 # NULL-terminate the slice
    store64(h + 136, rem);
    store64(h + 144, rn);
    if (cmdit_get_bool(h, load64(h + 80)) == 1) { return CMDIT_HELP; }       # global help (pre-verb)
    if (cmdit_get_bool(h, load64(h + 88)) == 1) { return CMDIT_VERSION; }
    return CMDIT_OK;
}

# Convenience: materialize the process argv, run the pure dispatch loop, then
# finalize the GLOBAL scope (so global env/required modifiers work). The verb
# analogue of cmdit_parse. help/version/error results propagate untouched.
fn cmdit_dispatch(h): i64 {
    var n = cmdit_argv(h);
    var r = cmdit_dispatch_argv(h, n, load64(h + 64));
    if (r != CMDIT_OK) { return r; }
    return cmdit_finalize(h);
}

# Sugar: re-enter a verb (or sub-verb) scope — parse the parent's remainder slice
# with the child handle `vh`, then finalize it. Saves the argc/argv/finalize
# triple and is how nested sub-verbs dispatch (build vh with its own verbs, call
# cmdit_dispatch_argv(vh, cmdit_verb_argc(h), cmdit_verb_argv(h)) instead).
fn cmdit_parse_verb(vh, h): i64 {
    # 1.2.2: carry the dispatcher's trailing-verbatim mark onto the verb handle,
    # so the consumer declares it ONCE (on the top-level handle, where the verb
    # is registered) rather than having to repeat it per verb handle — and so it
    # cannot drift between the two parses.
    var vid = load64(h + 128);
    if (vid >= 0) {
        var t = cmdit_verb_trailing_at(h, load64(_cmdit_verb_row(h, vid) + 16));
        if (t >= 0) { store64(vh + 160, t + 1); }
    }
    var r = cmdit_parse_argv(vh, load64(h + 144), load64(h + 136));
    if (r != CMDIT_OK) { return r; }
    return cmdit_finalize(vh);
}

# Return an interior pointer to the basename of `path` (the char after the final
# '/'), or the whole string if no '/'. No alloc, no NUL written. For the argv[0]
# busybox multiplexer (with cmdit_raw_argv): caller compares cmdit_basename(argv0)
# against verb names. A trailing-slash path yields the empty tail (argv[0] never
# has one); str_from the result if a clean owned copy is needed.
fn cmdit_basename(path): i64 {
    if (path == 0) { return 0; }
    var last = path;
    var i = 0;
    while (load8(path + i) != 0) {
        if (load8(path + i) == 47) { last = path + i + 1; }
        i = i + 1;
    }
    return last;
}

# --- output: generated help / version / error -------------------------------

fn _cmdit_eprint(s): i64 { syscall(1, 2, s, strlen(s)); return 0; }   # write -> stderr
fn _cmdit_oprint(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }   # write -> stdout

# Generated flag-list rows to stderr — just the "  -x, --long <type>\thelp" lines,
# with NO "Usage:" / "Options:" header and NO verb list. For tools that frame their
# own help (a brand intro / custom usage synopsis / an Examples block) around a
# *generated* flag list: print your prose yourself and call this for the rows.
# `cmdit_help` is the standard "Usage… Options:" wrapper around this. (1.1.0 — the
# table-only renderer the rich-help consumer cohort, e.g. anuenue, needs.)
fn cmdit_help_flags(h): i64 {
    var count = load64(h + 16);
    var i = 0;
    while (i < count) {
        var ep = _cmdit_entry(h, i);
        var short_ch = load64(ep);
        var long_name = load64(ep + 8);
        var type = load64(ep + 16);
        var help = load64(ep + 40);
        _cmdit_eprint("  ");
        if (short_ch != 0) {
            var sbuf[2];
            store8(&sbuf, short_ch);
            store8(&sbuf + 1, 0);
            _cmdit_eprint("-");
            syscall(1, 2, &sbuf, 1);
            if (long_name != 0) { _cmdit_eprint(", "); }
        } else {
            _cmdit_eprint("    ");
        }
        if (long_name != 0) { _cmdit_eprint("--"); _cmdit_eprint(long_name); }
        var choices = load64(ep + 56);
        var attrs = load64(ep + 48);
        var metavar = load64(ep + 104);
        # 1.0.0 metavar wins over the auto placeholder.
        if (metavar != 0 && type != CMDIT_BOOL) {
            _cmdit_eprint(" <"); _cmdit_eprint(metavar); _cmdit_eprint(">");
        }
        elif (choices != 0) { _cmdit_eprint(" <"); _cmdit_eprint(choices); _cmdit_eprint(">"); }   # enum set
        elif (type == CMDIT_INT) { _cmdit_eprint(" <int>"); }
        elif (type == CMDIT_STR) { _cmdit_eprint(" <str>"); }
        if ((attrs & CMDIT_ATTR_REPEAT) != 0) { _cmdit_eprint("..."); }           # repeatable
        if (help != 0) { _cmdit_eprint("\t"); _cmdit_eprint(help); }
        # 1.0.0 shown default — cstr only; ints would need fmt, which the
        # output path deliberately does not link.
        if (type == CMDIT_STR) {
            var dv = load64(ep + 32);
            if (dv != 0) { _cmdit_eprint(" (default: "); _cmdit_eprint(dv); _cmdit_eprint(")"); }
        }
        if ((attrs & CMDIT_ATTR_REQUIRED) != 0) { _cmdit_eprint(" (required)"); }
        _cmdit_eprint("\n");
        i = i + 1;
    }
    return 0;
}

# Generated usage to stderr: "Usage: <prog> [options]" + the auto-enumerated flag
# list (kills hand-written-help drift) + any verb list. Output is unchanged from
# 1.0.0; it now composes `cmdit_help_flags` for the rows. Callers wanting custom
# framing call `cmdit_help_flags` directly instead of this.
fn cmdit_help(h): i64 {
    var prog = load64(h + 48);
    _cmdit_eprint("Usage: ");
    if (prog != 0) { _cmdit_eprint(prog); }
    _cmdit_eprint(" [options] [args]\n\nOptions:\n");
    cmdit_help_flags(h);
    if (load64(h + 104) != 0) { cmdit_verbs_help(h); }     # append the verb list, if any
    return 0;
}

# Generated verb listing to stderr ("Commands:\n  <name>\t<help>\n..."), skipping
# alias rows. Appended by cmdit_help and printed by cmdit_print_error on an
# unknown verb, so the command list never drifts from registration.
fn cmdit_verbs_help(h): i64 {
    var vp = load64(h + 104);
    if (vp == 0) { return 0; }
    var count = load64(h + 120);
    _cmdit_eprint("\nCommands:\n");
    var i = 0;
    while (i < count) {
        var row = _cmdit_verb_row(h, i);
        if (load64(row + 16) == i) {                       # real verb (alias rows: canonical < own index)
            var nm = load64(row);
            var hp = load64(row + 8);
            _cmdit_eprint("  ");
            if (nm != 0) { _cmdit_eprint(nm); }
            if (hp != 0) { _cmdit_eprint("\t"); _cmdit_eprint(hp); }
            _cmdit_eprint("\n");
        }
        i = i + 1;
    }
    return 0;
}

# Standard --version output to STDOUT: "<prog> <version_str>\n" (machine-readable
# first line). Returns CMDIT_EXIT_OK for direct `return`.
fn cmdit_version(h, version_str): i64 {
    var prog = load64(h + 48);
    if (prog != 0) { _cmdit_oprint(prog); _cmdit_oprint(" "); }
    if (version_str != 0) { _cmdit_oprint(version_str); }
    _cmdit_oprint("\n");
    return CMDIT_EXIT_OK;
}

# Print the offending flag's name ("--long" preferred, else "-x") to stderr, if
# err_entry names one. The flag-naming the survey found near-universal on
# validation errors (agora/bannermanor/cyim/attn11).
fn _cmdit_eprint_flag(ep): i64 {
    if (ep == 0) { return 0; }
    var ln = load64(ep + 8);
    if (ln != 0) { _cmdit_eprint("--"); _cmdit_eprint(ln); _cmdit_eprint(": "); return 0; }
    var sc = load64(ep);
    if (sc != 0) {
        var sb[2];
        store8(&sb, sc);
        store8(&sb + 1, 0);
        _cmdit_eprint("-");
        syscall(1, 2, &sb, 1);
        _cmdit_eprint(": ");
    }
    return 0;
}

# Decode the last error into a standard "<prog>: [<flag>: ]<message>" stderr line.
# Absorbs the FlagErr->message switch kii/anuenue/bannermanor copy verbatim, and
# (0.2.0) names the offending flag for value/modifier errors + lists the enum set.
# UNKNOWN stays generic (the token is, by definition, not a registered flag).
# Returns CMDIT_EXIT_USAGE for direct `return`.
fn cmdit_print_error(h): i64 {
    var prog = load64(h + 48);
    var e = load64(h + 56);
    var ep = load64(h + 96);
    if (prog != 0) { _cmdit_eprint(prog); _cmdit_eprint(": "); }
    if (e != CMDIT_ERR_UNKNOWN) { _cmdit_eprint_flag(ep); }
    if (e == CMDIT_ERR_UNKNOWN) { _cmdit_eprint("unknown flag"); }
    elif (e == CMDIT_ERR_MISSING_VALUE) { _cmdit_eprint("missing value"); }
    elif (e == CMDIT_ERR_BAD_INT) { _cmdit_eprint("invalid integer value"); }
    elif (e == CMDIT_ERR_BUNDLED) { _cmdit_eprint("bundled/attached short flags not supported (use -x -y)"); }
    elif (e == CMDIT_ERR_REQUIRED_MISSING) { _cmdit_eprint("required flag missing"); }
    elif (e == CMDIT_ERR_BAD_ENUM) {
        _cmdit_eprint("invalid value");
        if (ep != 0) {
            var ch = load64(ep + 56);
            if (ch != 0) { _cmdit_eprint(" (expected "); _cmdit_eprint(ch); _cmdit_eprint(")"); }
        }
    }
    elif (e == CMDIT_ERR_OUT_OF_RANGE) { _cmdit_eprint("value out of range"); }
    elif (e == CMDIT_ERR_UNKNOWN_VERB) {
        _cmdit_eprint("unknown command");
        var ev = load64(h + 152);
        if (ev != 0) { _cmdit_eprint(": "); _cmdit_eprint(ev); }
    }
    elif (e == CMDIT_ERR_MISSING_POSITIONAL) { _cmdit_eprint("missing required argument"); }
    elif (e == CMDIT_ERR_TOO_MANY_POSITIONAL) { _cmdit_eprint("too many arguments"); }
    else { _cmdit_eprint("argument error"); }
    _cmdit_eprint("\n");
    if (e == CMDIT_ERR_UNKNOWN_VERB) { cmdit_verbs_help(h); }     # list the valid commands
    return CMDIT_EXIT_USAGE;
}

# ══ Verb introspection + shell completions (1.2.0) ═══════
#
# The verb table already drove `cmdit_verbs_help`, but nothing exposed it, so a
# consumer could not generate shell completions from the very verbs it had just
# registered — it had to keep a second, hand-maintained list that drifts. These
# accessors plus `cmdit_completions` close that: the completion script is a
# projection of the parser's own state, so it cannot disagree with it.

# Total verb rows, INCLUDING alias rows. Iterate 0..count and filter with
# cmdit_verb_is_alias when you want canonical verbs only.
#[must_use]
fn cmdit_verb_count(h): i64 {
    if (h == 0) { return 0; }
    if (load64(h + 104) == 0) { return 0; }
    return load64(h + 120);
}

#[must_use]
fn cmdit_verb_name_at(h, i): i64 {
    if (i < 0 || i >= cmdit_verb_count(h)) { return 0; }
    return load64(_cmdit_verb_row(h, i));
}

# An alias row carries no help text of its own; this returns the CANONICAL
# verb's help, so a caller listing aliases still has something to show.
#[must_use]
fn cmdit_verb_help_at(h, i): i64 {
    if (i < 0 || i >= cmdit_verb_count(h)) { return 0; }
    var row = _cmdit_verb_row(h, i);
    var help = load64(row + 8);
    if (help != 0) { return help; }
    var canon = load64(row + 16);
    if (canon == i) { return 0; }
    return load64(_cmdit_verb_row(h, canon) + 8);
}

# 1 when row `i` is an alias of another verb (its canonical id is not its own
# index — the same test cmdit_verbs_help uses to skip alias rows).
#[must_use]
fn cmdit_verb_is_alias(h, i): i64 {
    if (i < 0 || i >= cmdit_verb_count(h)) { return 0; }
    if (load64(_cmdit_verb_row(h, i) + 16) == i) { return 0; }
    return 1;
}

#[must_use]
fn cmdit_verb_canonical_at(h, i): i64 {
    if (i < 0 || i >= cmdit_verb_count(h)) { return 0 - 1; }
    return load64(_cmdit_verb_row(h, i) + 16);
}

# Emit `s` to stdout with every `'` escaped for a single-quoted shell string.
# Help text is caller-supplied prose, and an apostrophe in it would otherwise
# terminate the quoting and inject the remainder into the generated script.
fn _cmdit_oprint_sq(s): i64 {
    if (s == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c == 39) { _cmdit_oprint("'\\''"); }
        else {
            var b[2];
            store8(&b, c);
            store8(&b + 1, 0);
            _cmdit_oprint(&b);
        }
        i = i + 1;
    }
    return 0;
}

# Emit `s` with everything outside [A-Za-z0-9_] replaced by '_' — a shell
# function name has to be an identifier, and a prog_name may be a path or carry
# a dash.
fn _cmdit_oprint_ident(s): i64 {
    if (s == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        var ok = 0;
        if (c >= 48 && c <= 57) { ok = 1; }
        if (c >= 65 && c <= 90) { ok = 1; }
        if (c >= 97 && c <= 122) { ok = 1; }
        if (c == 95) { ok = 1; }
        var b[2];
        if (ok == 1) { store8(&b, c); } else { store8(&b, 95); }
        store8(&b + 1, 0);
        _cmdit_oprint(&b);
        i = i + 1;
    }
    return 0;
}

# Emit `s` as a shell COMMAND WORD: every byte outside [A-Za-z0-9_.-] is replaced
# by '_'. The surviving alphabet contains no shell metacharacter, no quote, no
# whitespace and no newline, so the result is always exactly one inert word.
#
# ⚠ This guards the PROGRAM NAME, which is attacker-controlled on the documented
# `cmdit_new(0)` path: prog_name there is adopted from argv[0] (see
# cmdit_parse_argv / cmdit_dispatch_argv), and argv[0] is chosen by whoever
# execs the tool. Before 1.2.4 `prog` was interpolated RAW into every emitter —
# `# bash completion for <prog>`, `complete -F _<x>_complete <prog>`,
# `#compdef <prog>`, `complete -c <prog>` — so an argv[0] of
# "tool\ntouch /tmp/x\n#" closed the comment and left a bare command line in a
# script whose whole purpose is to be sourced. Verified: the generated file
# passed `bash -n` and ran the injected command on `source`. CHANGELOG [1.2.4].
#
# 1.2.1 whitelisted verb and long-flag names for the same class of reason and
# named the program name in its own notes, but only ever routed it through
# `_cmdit_oprint_ident` for the FUNCTION name — the command-word occurrences
# were left raw. Dropping the name entirely (the 1.2.1 verb-name remedy) is not
# an option here: a completion script with no command to attach to is useless,
# so this maps rather than drops. '.' and '-' are kept because real program
# names carry them (`cmdit-smoke`, `foo.sh`) and neither is a shell
# metacharacter in command-word position.
# 1 when byte `c` may appear verbatim in an emitted shell command word.
# The alphabet is [A-Za-z0-9_.-] — deliberately a whitelist, so a byte that is
# not enumerated here cannot reach a generated script whatever it is. Split out
# from the emitter so the suite can assert it over all 256 byte values rather
# than eyeballing a generated script for the metacharacters someone thought of.
#[must_use]
fn _cmdit_is_cmdname_byte(c): i64 {
    if (c >= 48 && c <= 57) { return 1; }     # 0-9
    if (c >= 65 && c <= 90) { return 1; }     # A-Z
    if (c >= 97 && c <= 122) { return 1; }    # a-z
    if (c == 95) { return 1; }                # _
    if (c == 46) { return 1; }                # .
    if (c == 45) { return 1; }                # -
    return 0;
}

fn _cmdit_oprint_cmdname(s): i64 {
    if (s == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        var b[2];
        if (_cmdit_is_cmdname_byte(c) == 1) { store8(&b, c); } else { store8(&b, 95); }
        store8(&b + 1, 0);
        _cmdit_oprint(&b);
        i = i + 1;
    }
    return 0;
}

# 1 when every byte of `s` is in [A-Za-z0-9_.-] — the shape a verb or flag name
# actually takes.
#
# This is a WHITELIST, not an escape, because `compgen -W "$verbs"` re-expands
# each word: a `$(...)` or a backtick inside a name executes at TAB time even
# when the surrounding single-quoting is correct. Escaping cannot fix that;
# only refusing the byte can. A name that fails is dropped from the completion
# rather than emitted — a missing completion is a papercut, a command
# substitution running in the user's shell is not.
#[must_use]
fn _cmdit_name_is_safe(s): i64 {
    if (s == 0) { return 0; }
    if (load8(s) == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        # 1.2.4: same alphabet as the command-word sanitiser, one definition.
        if (_cmdit_is_cmdname_byte(load8(s + i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Space-separated canonical verb names (aliases included — a user who types an
# alias should still get it completed). Unsafe names are omitted.
fn _cmdit_oprint_verb_words(h): i64 {
    var count = cmdit_verb_count(h);
    var i = 0;
    var first = 1;
    while (i < count) {
        var nm = cmdit_verb_name_at(h, i);
        if (nm != 0 && _cmdit_name_is_safe(nm) == 1) {
            if (first == 0) { _cmdit_oprint(" "); }
            _cmdit_oprint(nm);
            first = 0;
        }
        i = i + 1;
    }
    return 0;
}

# Space-separated `--long` names of the flags that TAKE A VALUE, so the
# completion can skip the word after them when locating the verb position.
fn _cmdit_oprint_valueflag_words(h): i64 {
    var count = load64(h + 16);
    var i = 0;
    var first = 1;
    while (i < count) {
        var ep = _cmdit_entry(h, i);
        var ln = load64(ep + 8);
        if (ln != 0 && load64(ep + 16) != CMDIT_BOOL && _cmdit_name_is_safe(ln) == 1) {
            if (first == 0) { _cmdit_oprint(" "); }
            _cmdit_oprint("--");
            _cmdit_oprint(ln);
            first = 0;
        }
        i = i + 1;
    }
    return 0;
}

# Space-separated `--long` flags registered on `h`.
fn _cmdit_oprint_flag_words(h): i64 {
    var count = load64(h + 16);
    var i = 0;
    var first = 1;
    while (i < count) {
        var ln = load64(_cmdit_entry(h, i) + 8);
        if (ln != 0 && _cmdit_name_is_safe(ln) == 1) {
            if (first == 0) { _cmdit_oprint(" "); }
            _cmdit_oprint("--");
            _cmdit_oprint(ln);
            first = 0;
        }
        i = i + 1;
    }
    return 0;
}

fn _cmdit_completions_bash(h, prog): i64 {
    _cmdit_oprint("# bash completion for ");
    _cmdit_oprint_cmdname(prog);
    _cmdit_oprint("\n_");
    _cmdit_oprint_ident(prog);
    _cmdit_oprint("_complete() {\n");
    _cmdit_oprint("    local cur i w seen_verb=0 skip=0\n");
    _cmdit_oprint("    cur=\"${COMP_WORDS[COMP_CWORD]}\"\n");
    _cmdit_oprint("    local verbs='");
    _cmdit_oprint_verb_words(h);
    _cmdit_oprint("'\n    local flags='");
    _cmdit_oprint_flag_words(h);
    _cmdit_oprint("'\n    local valueflags='");
    _cmdit_oprint_valueflag_words(h);
    _cmdit_oprint("'\n");
    _cmdit_oprint("    if [[ \"$cur\" == -* ]]; then\n");
    _cmdit_oprint("        COMPREPLY=( $(compgen -W \"$flags\" -- \"$cur\") )\n");
    _cmdit_oprint("        return 0\n    fi\n");
    # Walk the words before the cursor looking for the first non-flag token.
    # A value-taking flag consumes the word after it, so `--root /x` must not
    # make /x look like the verb.
    _cmdit_oprint("    for (( i=1; i<COMP_CWORD; i++ )); do\n");
    _cmdit_oprint("        w=\"${COMP_WORDS[i]}\"\n");
    _cmdit_oprint("        if [[ $skip -eq 1 ]]; then skip=0; continue; fi\n");
    _cmdit_oprint("        if [[ \" $valueflags \" == *\" $w \"* ]]; then skip=1; continue; fi\n");
    _cmdit_oprint("        if [[ \"$w\" == -* ]]; then continue; fi\n");
    _cmdit_oprint("        seen_verb=1; break\n");
    _cmdit_oprint("    done\n");
    _cmdit_oprint("    if [[ $seen_verb -eq 0 ]]; then\n");
    _cmdit_oprint("        COMPREPLY=( $(compgen -W \"$verbs\" -- \"$cur\") )\n");
    _cmdit_oprint("        return 0\n    fi\n");
    _cmdit_oprint("    COMPREPLY=( $(compgen -f -- \"$cur\") )\n");
    _cmdit_oprint("}\ncomplete -F _");
    _cmdit_oprint_ident(prog);
    _cmdit_oprint("_complete ");
    _cmdit_oprint_cmdname(prog);
    _cmdit_oprint("\n");
    return 0;
}

fn _cmdit_completions_zsh(h, prog): i64 {
    _cmdit_oprint("#compdef ");
    _cmdit_oprint_cmdname(prog);
    _cmdit_oprint("\n_");
    _cmdit_oprint_ident(prog);
    _cmdit_oprint("() {\n    local -a verbs\n    verbs=(\n");
    var count = cmdit_verb_count(h);
    var i = 0;
    while (i < count) {
        # Canonical rows only: zsh's _describe shows the description beside the
        # name, and an alias would duplicate the entry under a second name.
        if (cmdit_verb_is_alias(h, i) == 0) {
            var nm = cmdit_verb_name_at(h, i);
            if (nm != 0) {
                _cmdit_oprint("        '");
                _cmdit_oprint_sq(nm);
                _cmdit_oprint(":");
                _cmdit_oprint_sq(cmdit_verb_help_at(h, i));
                _cmdit_oprint("'\n");
            }
        }
        i = i + 1;
    }
    _cmdit_oprint("    )\n");
    _cmdit_oprint("    local -a valueflags\n    valueflags=(");
    var vi = 0;
    var vcount = load64(h + 16);
    while (vi < vcount) {
        var vep = _cmdit_entry(h, vi);
        var vln = load64(vep + 8);
        if (vln != 0 && load64(vep + 16) != CMDIT_BOOL && _cmdit_name_is_safe(vln) == 1) {
            _cmdit_oprint(" --");
            _cmdit_oprint(vln);
        }
        vi = vi + 1;
    }
    _cmdit_oprint(" )\n");
    # Same walk as the bash emitter: find the first non-flag word, skipping the
    # argument of any value-taking flag, rather than assuming position 2.
    _cmdit_oprint("    local i seen=0 skip=0 w\n");
    _cmdit_oprint("    for (( i=2; i<CURRENT; i++ )); do\n");
    _cmdit_oprint("        w=$words[$i]\n");
    _cmdit_oprint("        if (( skip )); then skip=0; continue; fi\n");
    _cmdit_oprint("        if (( ${valueflags[(I)$w]} )); then skip=1; continue; fi\n");
    _cmdit_oprint("        if [[ $w == -* ]]; then continue; fi\n");
    _cmdit_oprint("        seen=1; break\n");
    _cmdit_oprint("    done\n");
    _cmdit_oprint("    if (( ! seen )); then\n");
    _cmdit_oprint("        _describe -t commands 'command' verbs\n");
    _cmdit_oprint("    else\n        _files\n    fi\n}\n_");
    _cmdit_oprint_ident(prog);
    _cmdit_oprint(" \"$@\"\n");
    return 0;
}

fn _cmdit_completions_fish(h, prog): i64 {
    _cmdit_oprint("# fish completion for ");
    _cmdit_oprint_cmdname(prog);
    _cmdit_oprint("\ncomplete -c ");
    _cmdit_oprint_cmdname(prog);
    _cmdit_oprint(" -f\n");
    var count = cmdit_verb_count(h);
    var i = 0;
    while (i < count) {
        if (cmdit_verb_is_alias(h, i) == 0) {
            var nm = cmdit_verb_name_at(h, i);
            if (nm != 0) {
                _cmdit_oprint("complete -c ");
                _cmdit_oprint_cmdname(prog);
                _cmdit_oprint(" -n __fish_use_subcommand -a '");
                _cmdit_oprint_sq(nm);
                _cmdit_oprint("'");
                var hp = cmdit_verb_help_at(h, i);
                if (hp != 0) {
                    _cmdit_oprint(" -d '");
                    _cmdit_oprint_sq(hp);
                    _cmdit_oprint("'");
                }
                _cmdit_oprint("\n");
            }
        }
        i = i + 1;
    }
    return 0;
}

# Write a shell completion script for `h`'s registered verbs and flags to
# STDOUT — stdout, not stderr, because the output is meant to be redirected
# into a completions file or eval'd.
#
# `shell` is "bash", "zsh" or "fish". Returns 0 on success, -1 for an
# unrecognised shell (nothing is printed in that case, so a caller can report
# the error itself without a half-written script on stdout).
fn cmdit_completions(h, shell): i64 {
    if (h == 0 || shell == 0) { return 0 - 1; }
    var prog = load64(h + 48);
    if (prog == 0) { prog = "prog"; }
    if (_cmdit_cstr_eq(shell, "bash") == 1) { return _cmdit_completions_bash(h, prog); }
    if (_cmdit_cstr_eq(shell, "zsh") == 1) { return _cmdit_completions_zsh(h, prog); }
    if (_cmdit_cstr_eq(shell, "fish") == 1) { return _cmdit_completions_fish(h, prog); }
    return 0 - 1;
}
