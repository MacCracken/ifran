# cmdit.cyr -- bundled distribution
# Version: 1.5.0
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# Requires (compile-verified; the leaves of dist/cmdit.deps):
include "lib/args.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/io.cyr"

# --- cmdit.cyr ---

# cmdit — sovereign CLI / argument-parsing library (getopt-long shaped).
# Re-exported via dist/cmdit.cyr (cyrius distlib); consumers import it as
# `[deps.cmdit] modules = ["dist/cmdit.cyr"]`.
#
# WHY: ~40 AGNOS binaries hand-roll flag/help/version parsing on top of the
# stdlib `args` primitive (argc/argv), and a stdlib parser `lib/flags.cyr`
# already exists but lives in the toolchain (can't grow enum/repeat/verb without
# a cyrius release) and ~31 repos never adopted it. cmdit is `flags.cyr`
# *productized as a standalone distlib + extended*: the proven getopt-long core
# (forked from lib/flags.cyr; types and error codes 0..4 byte-compatible) PLUS the three
# things every structured consumer copies by hand — the argc/argv -> contiguous
# cstr* materialize bridge, auto `--help`/`--version`, and the 0/1/2 exit
# convention as named constants. 0.1.0 = the faithful extraction; enum / repeat /
# required / range / env (0.2.0), verb dispatch (0.3.0), and the v1.0 completeness
# delta — configurable -h/-V short letters, per-flag metavar + shown defaults,
# max/exact positional gates — round out the frozen surface.
#
# Typical use (single-command tool):
#   fn main(): i64 {
#       var h    = cmdit_new("mytool");                              # auto --help/-h, --version/-V
#       var f_o  = cmdit_str (h, 111, "output", 0, "output file");   # 'o'
#       var f_n  = cmdit_int (h, 110, "count", 1, "repeat count");   # 'n'
#       var r = cmdit_parse(h);                                      # reads /proc argv via the bridge
#       if (r == CMDIT_HELP)    { cmdit_help(h);                 return CMDIT_EXIT_OK; }
#       if (r == CMDIT_VERSION) { cmdit_version(h, "mytool 1.0"); return CMDIT_EXIT_OK; }
#       if (r == CMDIT_RESULT_ERR) { cmdit_print_error(h); cmdit_help(h); return CMDIT_EXIT_USAGE; }
#       var outfile = cmdit_get_str(h, f_o);
#       var count   = cmdit_get_int(h, f_n);
#       var i = 0;
#       while (i < cmdit_positional_count(h)) { ... cmdit_positional(h, i) ...; i = i + 1; }
#       return CMDIT_EXIT_OK;
#   }
#   fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
#   _entry();        # BARE call — NOT `var r = main();` (agnos init-rsp capture; see docs)
#
# Supported syntax (0.1.0):
#   --name              bool flag -> 1
#   --name=value        long with attached value (a bool given =value is an
#                       error, CMDIT_ERR_UNEXPECTED_VALUE, 1.3.1)
#   --name value        long with space-separated value
#   -x                  short bool flag -> 1
#   -x value            short with space-separated value (int/str)
#   --                  terminator — everything after is positional
#   -                   lone dash is a positional (stdin convention)
#   positionals accumulated in cmdit_positional(*) in argv order
#
# Flag modifiers (0.2.0): cmdit_enum (choice flags) / cmdit_repeat (accumulate) /
# cmdit_required / cmdit_range (int bounds) / cmdit_env (env-var fallback). The
# env + required checks run in cmdit_finalize (chained by cmdit_parse); the
# cmdit_parse_argv core stays pure (no /proc, no env) for synthetic-argv testing.
#
# Verb dispatch (0.3.0): cmdit_verb / cmdit_verb_alias register subcommands;
# cmdit_dispatch identifies the verb (cmdit_verb_matched, switch on the id),
# resolving global flags before OR after the verb in one pass, and hands the
# caller a globals-removed remainder slice (cmdit_verb_argv) to re-parse in a
# per-verb handle — nested sub-verbs are just re-entry on that slice. The argv[0]
# busybox multiplexer is cmdit_basename + cmdit_raw_argv, caller-side. Like the
# parse core, cmdit_dispatch_argv is pure; cmdit_dispatch adds the impure finalize.
#
# NOT supported (deferred to the v2 backlog — docs/development/roadmap.md and
# docs/adr/0003-v1-freeze.md): bundled short bools -xyz, attached short value
# -xvalue or -x=value, optional-value flags, float flags, --no-foo negation,
# count -vvv. Out of cmdit scope: dynamic/large enum
# lists, cross-field/modulo ranges, pure-env cascades with no associated flag,
# in-core nested-verb trees (use re-entry), interactive/REPL command DSLs.
#
# Consumer deps: needs stdlib "args" (cmdit_argv/cmdit_parse — the /proc argv
# read) and "io" (cmdit_env -> getenv; referenced unconditionally by cmdit_parse
# via finalize). Pure callers that drive cmdit_parse_argv with their own array and
# never call cmdit_finalize still link getenv but never invoke it.

enum CmditType {
    CMDIT_BOOL = 0;
    CMDIT_INT = 1;
    CMDIT_STR = 2;
}

# Codes 0..4 are byte-compatible with flags.cyr FlagErr, the fork point. From 5 the
# two taxonomies diverged: cmdit's 5 is REQUIRED_MISSING (0.2.0), the stdlib's 5 is
# UNEXPECTED_VALUE (6.6.5). The taxonomy only grows (append-only).
enum CmditErr {
    CMDIT_ERR_NONE = 0;
    CMDIT_ERR_UNKNOWN = 1;
    CMDIT_ERR_MISSING_VALUE = 2;
    CMDIT_ERR_BAD_INT = 3;
    CMDIT_ERR_BUNDLED = 4;
    CMDIT_ERR_REQUIRED_MISSING = 5;   # 0.2.0: a cmdit_required flag absent at finalize
    CMDIT_ERR_BAD_ENUM = 6;           # 0.2.0: a cmdit_enum value outside its choice set
    CMDIT_ERR_OUT_OF_RANGE = 7;       # 0.2.0: a cmdit_range int outside [min, max]
    CMDIT_ERR_UNKNOWN_VERB = 8;       # 0.3.0: a verb token matching no registered verb
    CMDIT_ERR_MISSING_POSITIONAL = 9; # 0.3.0: cmdit_require_positionals count not met
    CMDIT_ERR_TOO_MANY_POSITIONAL = 10; # 1.0.0: cmdit_require_positionals_max/_exact upper bound exceeded
    CMDIT_ERR_UNEXPECTED_VALUE = 11;  # 1.3.1: a bool flag given `--flag=value` (stdlib's code 5, 6.6.5)
    CMDIT_ERR_NOMEM = 12;             # 1.3.1: a positional or repeat list could not grow (stdlib's 6, 6.6.7)
    CMDIT_ERR_ARGV = 13;              # 1.3.2: the process command line could not be read in full
    CMDIT_ERR_REPEATED = 14;          # 1.3.6: a cmdit_once flag given a second time
}

# Parse result codes (return of cmdit_parse / cmdit_parse_argv).
var CMDIT_OK = 0;
var CMDIT_HELP = 2;          # --help / -h seen
var CMDIT_VERSION = 3;       # --version / -V seen
var CMDIT_RESULT_ERR = 0 - 1;

# The AGNOS userland exit-code convention — named so consumers stop redefining
# KII_EXIT_* / EXIT_* per repo.
var CMDIT_EXIT_OK = 0;       # success (incl. help / version)
var CMDIT_EXIT_RUN = 1;      # runtime failure
var CMDIT_EXIT_USAGE = 2;    # usage / parse error

# Layout and capacity constants. 1.3.2: the code sizes storage ONLY from these
# (an enum, so a program cannot assign them) and from the caps each handle
# stores. The public CMDIT_*_MAX / _SIZE vars below were read live before 1.3.2,
# so raising one after a table was allocated overflowed the heap, and setting
# CMDIT_REPEAT_MAX to 0 hung the next repeat push. They keep their values for
# readers and are now read-only in effect, the model stdlib 6.7.9 adopted for
# its own public bound vars. CHANGELOG [1.3.2].
enum CmditLayout {
    _CMDIT_FLAGS_CAP = 64;      # raised from flags.cyr's 32 — attn11 has ~35 flags
    _CMDIT_FLAGS_INIT = 16;     # 1.4.0: entries the table starts with; doubles up to _CMDIT_FLAGS_CAP
    _CMDIT_POS_INIT = 128;      # initial positional capacity; doubles (1.3.1)
    _CMDIT_CTX_SZ = 192;        # 1.3.4: +184 stop_at_positional (1.3.3: +176 err_value)
    _CMDIT_ENTRY_SZ = 120;      # 1.3.6: +112 long_alias (1.0.0: +104 metavar), append-only
    _CMDIT_REPEAT_INIT = 64;    # initial per-flag repeat-list capacity; doubles (1.3.1)
    _CMDIT_VERB_CAP = 128;      # verb table rows (sit has 25 verbs; aliases are extra rows)
    _CMDIT_VERB_INIT = 16;      # 1.4.0: rows the table starts with; doubles up to _CMDIT_VERB_CAP
    _CMDIT_VERB_SZ = 48;        # verb-row stride; 1.3.7: 40 -> 48 for +40 flags (1.3.5: 32 -> 40)
    # The most pointer slots whose byte size (slots * 8) cannot wrap an i64, 2^60 - 1.
    # Every slot count that becomes an alloc size is checked against it: past it,
    # `n * 8` wraps, and it can wrap to a SMALL POSITIVE size (2^61 + 1 slots is 8
    # bytes) that alloc happily grants and the caller then writes past (1.3.2).
    _CMDIT_SLOTS_MAX = 1152921504606846975;
}

# Field offsets (1.4.0). Every load and store names its field instead of a literal: a
# literal is how 1.3.5's verb-help renderer kept reading +32 after the row grew. The
# offsets are the layouts documented below and are append-only. An offset-0 field is read
# bare, `load64(h)` / `load64(ep)` / `load64(row)`, because `+ 0` costs an instruction.
enum CmditOffset {
    # handle (ctx)
    _CMDIT_H_ENTRIES = 0;
    _CMDIT_H_ENTRIES_CAP = 8;
    _CMDIT_H_COUNT = 16;
    _CMDIT_H_POS = 24;
    _CMDIT_H_POS_CAP = 32;
    _CMDIT_H_POS_COUNT = 40;
    _CMDIT_H_PROG = 48;
    _CMDIT_H_ERR = 56;
    _CMDIT_H_RAW_ARGV = 64;
    _CMDIT_H_RAW_ARGC = 72;
    _CMDIT_H_HELP_IDX = 80;
    _CMDIT_H_VERSION_IDX = 88;
    _CMDIT_H_ERR_ENTRY = 96;
    _CMDIT_H_VERBS = 104;
    _CMDIT_H_VERBS_CAP = 112;
    _CMDIT_H_VERBS_COUNT = 120;
    _CMDIT_H_VERB_MATCHED = 128;
    _CMDIT_H_VERB_ARGV = 136;
    _CMDIT_H_VERB_ARGC = 144;
    _CMDIT_H_ERR_TOKEN = 152;
    _CMDIT_H_TRAILING = 160;
    _CMDIT_H_HELP_HANDOFF = 168;
    _CMDIT_H_ERR_VALUE = 176;
    _CMDIT_H_STOP = 184;
    # flag entry
    _CMDIT_E_SHORT = 0;
    _CMDIT_E_LONG = 8;
    _CMDIT_E_TYPE = 16;
    _CMDIT_E_VALUE = 24;
    _CMDIT_E_DEFAULT = 32;
    _CMDIT_E_HELP = 40;
    _CMDIT_E_ATTRS = 48;
    _CMDIT_E_CHOICES = 56;
    _CMDIT_E_ENV = 64;
    _CMDIT_E_MIN = 72;
    _CMDIT_E_MAX = 80;
    _CMDIT_E_REPEAT = 88;
    _CMDIT_E_REPEAT_COUNT = 96;
    _CMDIT_E_METAVAR = 104;
    _CMDIT_E_ALIAS = 112;
    # verb row
    _CMDIT_V_NAME = 0;
    _CMDIT_V_HELP = 8;
    _CMDIT_V_CANON = 16;
    _CMDIT_V_TRAILING = 24;
    _CMDIT_V_HIDDEN = 32;
    _CMDIT_V_FLAGS = 40;
}

# Informational copies of the layout above (internal, not API — ADR-0003).
var CMDIT_FLAGS_MAX = 64;
var CMDIT_POS_MAX = 128;     # INITIAL positional capacity; the array doubles, never drops
var CMDIT_CTX_SIZE = 192;
var CMDIT_ENTRY_SIZE = 120;
var CMDIT_REPEAT_MAX = 64;   # INITIAL per-flag repeat-list capacity; doubles, never drops
var CMDIT_VERB_MAX = 128;
var CMDIT_VERB_SIZE = 48;

# Per-entry attribute bitfield (entry +48). Append-only; the byte-compatible
# 0.1.0 type/offset layout (+0..+40) is untouched, so CMDIT_BOOL/INT/STR stay {0,1,2}.
var CMDIT_ATTR_REQUIRED = 1;   # cmdit_required — must be SEEN by finalize
var CMDIT_ATTR_SEEN = 2;       # set by CLI parse or env fallback when a value was applied
var CMDIT_ATTR_RANGE = 4;      # cmdit_range — min/max valid at +72/+80
var CMDIT_ATTR_REPEAT = 8;     # cmdit_repeat — list at +88, count at +96
var CMDIT_ATTR_ONCE = 16;      # 1.3.6: cmdit_once — a second occurrence is CMDIT_ERR_REPEATED
var CMDIT_ATTR_NOCASE = 32;    # 1.3.6: cmdit_enum_nocase — choices match ASCII case-insensitively
var CMDIT_ATTR_NOFLAGVAL = 64; # 1.3.6: cmdit_reject_flag_value — a flag-shaped separate value is refused

# Context layout (192 B):
#   +0  entries_ptr      : i64 array of _CMDIT_ENTRY_SZ entries
#   +8  entries_cap      : i64 (entries allocated; 1.4.0: 16, doubling to _CMDIT_FLAGS_CAP)
#  +16  entries_count    : i64
#  +24  positional_ptr   : i64 array of cstr ptrs (argv-style)
#  +32  positional_cap   : i64 (starts at _CMDIT_POS_INIT; doubles as needed, 1.3.1)
#  +40  positional_count : i64
#  +48  prog_name        : i64 (cstr; caller-supplied for clean usage lines)
#  +56  last_error       : i64 (CmditErr)
#  +64  raw_argv         : i64 (materialized cstr* array; 0 until cmdit_argv)
#  +72  raw_argc         : i64
#  +80  help_idx         : i64 (auto-registered --help/-h flag index)
#  +88  version_idx      : i64 (auto-registered --version/-V flag index)
#  +96  err_entry        : i64 (0.2.0; entry ptr that produced last_error, 0 = none/UNKNOWN)
#  +104 verbs_ptr        : i64 (0.3.0; _CMDIT_VERB_SZ-row table, 0 until first cmdit_verb — lazy)
#  +112 verbs_cap        : i64 (rows allocated; 1.4.0: 16, doubling to _CMDIT_VERB_CAP)
#  +120 verbs_count      : i64
#  +128 verb_matched     : i64 (canonical id of the dispatched verb, -1 = none)
#  +136 verb_argv        : i64 (compacted remainder cstr*; argv[0]=verb name; 0 = none)
#  +144 verb_argc        : i64
#  +152 err_token        : i64 (cstr; the argv token behind last_error, 0 = none. 0.3.0 kept
#                               only CMDIT_ERR_UNKNOWN_VERB's here; 1.3.3 every error's)
#  +160 trailing_verbatim: i64 (1.2.2; a verb handle's threshold as n + 1, 0 = off)
#  +168 help_handoff     : i64 (1.3.2; 1 when dispatch handed an auto --help/--version to
#                               the verb, so finalize skips the required check)
#  +176 err_value        : i64 (1.3.3; cstr — the value last_error rejected, 0 = none)
#  +184 stop_at_pos      : i64 (1.3.4; 1 = POSIX stop at the first positional, 0 = off)
#
# Verb row (48 B): +0 name (cstr)  +8 help (cstr)  +16 canonical_id (own index for a
#   real verb, target index for an alias row)  +24 trailing_after (1.2.2; n + 1, 0 = none)
#   +32 hidden (1.3.5; 1 = dispatches, but is left out of help and completions)
#   +40 flags (1.3.7; the verb's own cmdit handle, from cmdit_verb_flags, 0 = none)
#
# Entry layout (120 B). +0..+40 are byte-compatible with flags.cyr; +48..+96 are
# the append-only 0.2.0 modifier fields; +104 is the 1.0.0 metavar; +112 the 1.3.6
# second long name:
#   +0 short_ch  +8 long_name  +16 type  +24 value  +32 default_value  +40 help
#  +48 attrs (bitfield)  +56 choices (cstr, "a|b|c"; 0=not enum)  +64 env_name (cstr; 0=none)
#  +72 range_min  +80 range_max  +88 repeat_list (cstr* array; 0 until first append)  +96 repeat_count
# +104 metavar (cstr; 0 = default <int>/<str>/<choices> help placeholder)
# +112 long_alias (cstr; 1.3.6 — a second long name, 0 = none)

fn _cmdit_add(h, short_ch, long_name, type, default_val, help): i64 {
    if (h == 0) { return 0 - 1; }                                 # 1.3.2: see _cmdit_h0
    var count = load64(h + _CMDIT_H_COUNT);
    var cap = load64(h + _CMDIT_H_ENTRIES_CAP);
    if (count >= cap) {
        # 1.4.0: the table starts at _CMDIT_FLAGS_INIT entries and doubles. cmdit_new
        # used to allocate and zero all 64 (7,680 B, most of its ~2 µs) for tools that
        # register a handful.
        if (cap >= _CMDIT_FLAGS_CAP) { return 0 - 1; }            # the handle's own cap (1.3.2)
        var ncap = cap * 2;
        if (ncap > _CMDIT_FLAGS_CAP) { ncap = _CMDIT_FLAGS_CAP; }
        var ew = _CMDIT_ENTRY_SZ / 8;                             # words per entry
        var old = load64(h);
        var ne = _cmdit_grow(old, count * ew, ncap * ew);
        if (ne == 0) { return 0 - 1; }
        # This function writes only an entry's first six fields; the modifiers' fields
        # must start at 0. The stdlib's alloc already returns zeroed memory (fresh
        # pages, and alloc_reset scrubs what it reuses), so no test can see this, but
        # cmdit does not rely on that.
        _cmdit_zero(ne + count * _CMDIT_ENTRY_SZ, (ncap - count) * _CMDIT_ENTRY_SZ);
        # err_entry is the one entry pointer the handle keeps; it moves with the table,
        # so cmdit_err_flag still names the flag after a registration that follows a
        # failed parse. Everything else addresses entries by index.
        var ee = load64(h + _CMDIT_H_ERR_ENTRY);
        if (ee != 0) { store64(h + _CMDIT_H_ERR_ENTRY, ne + (ee - old)); }
        store64(h, ne);
        store64(h + _CMDIT_H_ENTRIES_CAP, ncap);
    }
    var ep = load64(h) + count * _CMDIT_ENTRY_SZ;
    store64(ep, short_ch);
    store64(ep + _CMDIT_E_LONG, long_name);
    store64(ep + _CMDIT_E_TYPE, type);
    store64(ep + _CMDIT_E_VALUE, default_val);
    store64(ep + _CMDIT_E_DEFAULT, default_val);
    store64(ep + _CMDIT_E_HELP, help);
    store64(h + _CMDIT_H_COUNT, count + 1);
    return count;
}

# Register a bool flag (`short_ch` = ASCII byte, 0 = none; `long_name` = cstr, 0 =
# none). Returns the flag index for cmdit_get_*.
fn cmdit_bool(h, short_ch, long_name, help): i64 {
    return _cmdit_add(h, short_ch, long_name, CMDIT_BOOL, 0, help);
}
# Register an int flag (decimal, optional leading minus; strict — rejects garbage).
fn cmdit_int(h, short_ch, long_name, default_val, help): i64 {
    return _cmdit_add(h, short_ch, long_name, CMDIT_INT, default_val, help);
}
# Register a string/path flag (stores the argv token directly, no copy).
fn cmdit_str(h, short_ch, long_name, default_val, help): i64 {
    return _cmdit_add(h, short_ch, long_name, CMDIT_STR, default_val, help);
}

# --- 0.2.0 flag modifiers ----------------------------------------------------
# Each subsumes a pattern the 2026-06-25 ecosystem survey found hand-rolled
# across the consumer repos. All append-only on top of the byte-compatible core.

# Register a choice/enum flag (underlying CMDIT_STR). `choices` is a '|'-delimited
# cstr literal, e.g. "auto|always|never"; the parsed value must be one of them or
# parse fails with CMDIT_ERR_BAD_ENUM. `default_val` is a default-choice cstr (or
# 0). Retrieve the raw choice with cmdit_get_str, or its 0-based index (for
# dispatch) with cmdit_get_enum. Subsumes the nested-streq validation in
# attn11/owl/agnova/cyim/phylax. (A consumer's own non-index mapping — e.g. owl's
# auto=-1/always=1/never=0 sentinels — is a trivial 3-way map on cmdit_get_enum.)
fn cmdit_enum(h, short_ch, long_name, default_val, choices, help): i64 {
    var idx = _cmdit_add(h, short_ch, long_name, CMDIT_STR, default_val, help);
    if (idx < 0) { return idx; }
    store64(_cmdit_entry(h, idx) + _CMDIT_E_CHOICES, choices);
    return idx;
}

# Register a repeatable flag (underlying CMDIT_STR): each `--flag value`
# occurrence appends to a per-flag list that grows as needed (1.3.1; it was
# silently capped at 64 before). Read with cmdit_repeat_count / cmdit_repeat_get; the last
# occurrence is also visible via cmdit_get_str. Subsumes whirl's -H accumulator.
fn cmdit_repeat(h, short_ch, long_name, help): i64 {
    var idx = _cmdit_add(h, short_ch, long_name, CMDIT_STR, 0, help);
    if (idx < 0) { return idx; }
    var ep = _cmdit_entry(h, idx);
    store64(ep + _CMDIT_E_ATTRS, load64(ep + _CMDIT_E_ATTRS) | CMDIT_ATTR_REPEAT);
    return idx;
}

# Mark an already-registered flag (any type, incl. bool) required: absent at
# finalize -> CMDIT_ERR_REQUIRED_MISSING. Presence is tracked by a SEEN bit (set
# by CLI parse or env fallback), so a required bool like agnova --i-mean-it
# distinguishes absent from explicit-false. Returns idx for chaining. Subsumes
# agora --handle / agnova --i-mean-it post-parse sentinel checks. (agnova's
# --device check also rejects an empty value, which presence alone cannot.)
fn cmdit_required(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    var ep = _cmdit_entry(h, idx);
    store64(ep + _CMDIT_E_ATTRS, load64(ep + _CMDIT_E_ATTRS) | CMDIT_ATTR_REQUIRED);
    return idx;
}

# Constrain an int flag to the inclusive range [min_val, max_val]. Out-of-range
# input is REJECTED (not clamped) -> CMDIT_ERR_OUT_OF_RANGE. Returns idx for
# chaining. Static constant bounds only (cross-field/modulo bounds — attn11
# --rope-dim<=d_model, rope_dim%2 — stay caller-side). Subsumes bannermanor
# --width/--pad, attn11 --layers/--mtp/--bpe caps. (No-op on non-int flags.)
fn cmdit_range(h, idx, min_val, max_val): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    var ep = _cmdit_entry(h, idx);
    store64(ep + _CMDIT_E_ATTRS, load64(ep + _CMDIT_E_ATTRS) | CMDIT_ATTR_RANGE);
    store64(ep + _CMDIT_E_MIN, min_val);
    store64(ep + _CMDIT_E_MAX, max_val);
    return idx;
}

# Give a flag an environment-variable fallback: if absent from argv, its value
# comes from `env_name` (read at finalize). CLI always wins. Bool flags use
# presence semantics (var set to ANY value, even empty, -> 1; the NO_COLOR
# convention); int/str/enum flags use the value (set-but-empty is ignored).
# Env values are validated NON-FATALLY — a bad int / out-of-range / bad enum
# falls through to the registered default rather than erroring. Returns idx for
# chaining. Subsumes single flag-bound vars (NO_COLOR, CHAKSHU_HOOSH_TOKEN,
# ARK_CONFIG); pure-env cascades with no flag stay caller-side. Needs stdlib "io".
fn cmdit_env(h, idx, env_name): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    store64(_cmdit_entry(h, idx) + _CMDIT_E_ENV, env_name);
    return idx;
}

# --- 1.0.0 help-rendering modifier -------------------------------------------

# Override a value flag's generated help placeholder (the auto "<int>"/"<str>"/
# "<a|b|c>" token) with a custom metavar — e.g. cmdit_metavar(h, f_out, "FILE")
# renders "--out <FILE>". Cosmetic (help only); does not affect parsing, and is a
# no-op on bool flags (which take no value). Returns idx for chaining.
fn cmdit_metavar(h, idx, name): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    store64(_cmdit_entry(h, idx) + _CMDIT_E_METAVAR, name);
    return idx;
}

# --- 1.3.6 small modifiers -----------------------------------------------------
# Each one asked for by one tool in the 2026-10-14 adoption survey. Set a bit (or,
# for the alias, a name) on an already-registered flag; return idx for chaining,
# or -1 for a bad handle / idx.

# The flag may appear at most once on the command line: a second occurrence fails
# the parse with CMDIT_ERR_REPEATED, naming the flag (cmdit_err_flag) and the
# repeated token (cmdit_err_token). Last-wins stays the default. For cyim, whose
# smoke tests refuse `--context=1 --context=2`, `--wc --wc` and friends with exit 2.
# The env fallback never counts as an occurrence.
fn cmdit_once(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    var ep = _cmdit_entry(h, idx);
    store64(ep + _CMDIT_E_ATTRS, load64(ep + _CMDIT_E_ATTRS) | CMDIT_ATTR_ONCE);
    return idx;
}

# An enum flag's choices match ASCII case-insensitively: `--severity HIGH`,
# `High` and `high` all select "high". cmdit_get_enum gives the choice's index;
# cmdit_get_str keeps the text as the user typed it. No-op on a non-enum flag. For
# phylax `--severity-threshold`, which lowercased the value itself.
fn cmdit_enum_nocase(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    var ep = _cmdit_entry(h, idx);
    store64(ep + _CMDIT_E_ATTRS, load64(ep + _CMDIT_E_ATTRS) | CMDIT_ATTR_NOCASE);
    return idx;
}

# Give the flag a second long name, matched exactly like the first by both parse
# cores (`--marketplace` / `--market`). Help shows it beside the first; bash
# completion offers it. One alias per flag; a later call replaces it. `name` must
# be a non-empty cstr. For ark `list --marketplace|--market`, `--system|--apt`.
fn cmdit_long_alias(h, idx, name): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    if (name == 0) { return 0 - 1; }
    if (load8(name) == 0) { return 0 - 1; }
    store64(_cmdit_entry(h, idx) + _CMDIT_E_ALIAS, name);
    return idx;
}

# A value flag refuses a SEPARATE value that looks like a flag: `--root --dry-run`
# is CMDIT_ERR_MISSING_VALUE, not root = "--dry-run". A lone "-" (stdin) and, on
# an int flag, a number such as -5 are still values, and an attached
# `--root=--dry-run` is taken as written. For hapi audit F-019, where
# `--root --dry-run pkg` created `$HOME/--dry-run/` at exit 0 on a run the user
# asked to be a no-op.
fn cmdit_reject_flag_value(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    var ep = _cmdit_entry(h, idx);
    store64(ep + _CMDIT_E_ATTRS, load64(ep + _CMDIT_E_ATTRS) | CMDIT_ATTR_NOFLAGVAL);
    return idx;
}

# 1 when `v`, offered as `ep`'s separate value, must be refused under
# cmdit_reject_flag_value: it starts with '-', is not a lone "-", and is not a
# number for an int flag. 0 otherwise (and always without the modifier).
fn _cmdit_flaglike_value(ep, v): i64 {
    if ((load64(ep + _CMDIT_E_ATTRS) & CMDIT_ATTR_NOFLAGVAL) == 0) { return 0; }
    if (v == 0) { return 0; }
    if (load8(v) != 45 || load8(v + 1) == 0) { return 0; }
    if (load64(ep + _CMDIT_E_TYPE) == CMDIT_INT) {
        _cmdit_parse_int(v);
        if (_cmdit_pint_ok == 1) { return 0; }
    }
    return 1;
}

# Allocate-once parser context. Auto-registers --help/-h and --version/-V, so
# every cmdit tool gets them for free. `prog_name` is the clean name printed in
# usage/version lines (pass 0 to fall back to argv[0] at parse).
fn cmdit_new(prog_name): i64 {
    var h = alloc(_CMDIT_CTX_SZ);
    var entries = alloc(_CMDIT_FLAGS_INIT * _CMDIT_ENTRY_SZ);    # 1.4.0: grows on demand
    var positional = alloc(_CMDIT_POS_INIT * 8);
    # 1.2.4: stdlib alloc returns 0 on failure (OOM, or a size outside
    # (0, ALLOC_MAX]) — it does not abort. Unchecked, the memzero loop below
    # wrote 7168 bytes from address 0. Returns 0 so the caller can bail.
    #
    # _cmdit_h0 — 1.3.2: every public entry point now tolerates a 0 handle, which
    # 1.2.4 claimed here but only the getters and modifiers honoured. Registration
    # returns -1, the parse family returns CMDIT_RESULT_ERR, cmdit_error(0) is
    # CMDIT_ERR_NOMEM, and cmdit_print_error(0) says "out of memory". So a caller
    # that never checks this return still fails closed with the right message,
    # instead of crashing in the first cmdit_bool. CHANGELOG [1.3.2].
    # ⚠ NOT covered by a failing test, and deliberately recorded as such: the
    # three sizes here are compile-time constants well inside ALLOC_MAX, so no
    # public API call can drive alloc to return 0. Deleting this line keeps the
    # suite green — it is defence-in-depth against an exhausted heap, not a
    # behaviour any fixture reaches.
    if (h == 0 || entries == 0 || positional == 0) { return 0; }
    # 1.3.0: zero the entry table a word at a time. Not observable by a test:
    # alloc's memory is already zero (poison mode fills only the redzones), so
    # this is defence-in-depth, like the alloc check above. CHANGELOG [1.3.0].
    _cmdit_zero(entries, _CMDIT_FLAGS_INIT * _CMDIT_ENTRY_SZ);
    store64(h, entries);
    store64(h + _CMDIT_H_ENTRIES_CAP, _CMDIT_FLAGS_INIT);
    store64(h + _CMDIT_H_COUNT, 0);
    store64(h + _CMDIT_H_POS, positional);
    store64(h + _CMDIT_H_POS_CAP, _CMDIT_POS_INIT);
    store64(h + _CMDIT_H_POS_COUNT, 0);
    store64(h + _CMDIT_H_PROG, prog_name);
    store64(h + _CMDIT_H_ERR, CMDIT_ERR_NONE);
    store64(h + _CMDIT_H_RAW_ARGV, 0);
    store64(h + _CMDIT_H_RAW_ARGC, 0);
    store64(h + _CMDIT_H_ERR_ENTRY, 0);                           # 0.2.0
    store64(h + _CMDIT_H_VERBS, 0);                               # 0.3.0; the first cmdit_verb allocates
    store64(h + _CMDIT_H_VERBS_CAP, 0);
    store64(h + _CMDIT_H_VERBS_COUNT, 0);
    store64(h + _CMDIT_H_VERB_MATCHED, 0 - 1);                    # none
    store64(h + _CMDIT_H_VERB_ARGV, 0);
    store64(h + _CMDIT_H_VERB_ARGC, 0);
    store64(h + _CMDIT_H_ERR_TOKEN, 0);
    store64(h + _CMDIT_H_TRAILING, 0);                            # 1.2.2; 0 = off
    store64(h + _CMDIT_H_HELP_HANDOFF, 0);                        # 1.3.2
    store64(h + _CMDIT_H_ERR_VALUE, 0);                           # 1.3.3
    store64(h + _CMDIT_H_STOP, 0);                                # 1.3.4
    store64(h + _CMDIT_H_HELP_IDX, cmdit_bool(h, 104, "help", "show this help and exit"));      # 'h'
    store64(h + _CMDIT_H_VERSION_IDX, cmdit_bool(h, 86, "version", "print version and exit"));  # 'V'
    return h;
}

# Zero `n` bytes at `p` a word at a time (alloc is 8-aligned); a byte loop finishes any
# tail if `n` stops being a multiple of 8. 1.4.0: the one copy of what cmdit_new and the
# verb table each had.
fn _cmdit_zero(p, n): i64 {
    var i = 0;
    while (i + 8 <= n) { store64(p + i, 0); i = i + 8; }
    while (i < n) { store8(p + i, 0); i = i + 1; }
    return 0;
}

fn _cmdit_entry(h, idx): i64 { return load64(h) + idx * _CMDIT_ENTRY_SZ; }

# Remap or disable the auto -h / -V short letters (the long --help/--version and
# help/version detection are unaffected — only the single-char alias changes).
# Pass a new ASCII byte to remap, or 0 to drop the short letter entirely, freeing
# e.g. -h for a consumer's own flag (the df -h / ls -h "human-readable" convention
# that hard-binding -h=help fights). Call after cmdit_new, before parse. Returns 0.
fn cmdit_help_short(h, ch): i64 {
    if (h == 0) { return 0; }
    store64(_cmdit_entry(h, load64(h + _CMDIT_H_HELP_IDX)), ch);
    return 0;
}

# Same, for the auto --version short letter. Pass 0 to drop -V entirely.
fn cmdit_version_short(h, ch): i64 {
    if (h == 0) { return 0; }
    store64(_cmdit_entry(h, load64(h + _CMDIT_H_VERSION_IDX)), ch);
    return 0;
}

# POSIX stop-at-first-positional (`on` = 1; 0 = the default, flags anywhere).
# Option recognition stops at the first positional — a token that does not
# start with `-`, a lone `-` included. That token and EVERY later one are
# positionals, flags, `--` and all. A `--` before it still ends the options and
# is consumed. For tools whose operands are another command line: sudo-shaped
# (`shakti -u bob ls -la`), xargs, env, nice, timeout. Value flags before the
# boundary still take their value, so `-u bob cmd` puts it at `cmd`.
#
# On a handle with verbs, the verb IS the first positional: globals are applied
# only before it, and a global flag after it goes to the verb's scope.
#
# Not the per-verb `cmdit_verb_trailing_after`, which consumes a `--` at its
# threshold (kubectl-style, 1.3.2). Here a `--` after the boundary is DATA: kriya
# found `ls -1 | xargs rm --` deleting a directory once its `--` guard was eaten.
# Returns 0, or -1 for a 0 handle. Matches stdlib flags_set_stop_at_positional,
# except that a lone `-` also stops, as POSIX says. 1.3.4.
fn cmdit_stop_at_positional(h, on): i64 {
    if (h == 0) { return 0 - 1; }
    var v = 0;
    if (on != 0) { v = 1; }
    store64(h + _CMDIT_H_STOP, v);
    return 0;
}

# 1 if idx is a valid registered-flag index, else 0. Guards the public typed
# getters so an ignored -1 registration return (cmdit_get_*(h, -1)) or a stray
# out-of-range idx yields a safe sentinel instead of an out-of-bounds entry read
# — mirrors the bounds checks in cmdit_positional / cmdit_repeat_get.
fn _cmdit_idx_ok(h, idx): i64 {
    if (h == 0) { return 0; }
    if (idx < 0) { return 0; }
    if (idx >= load64(h + _CMDIT_H_COUNT)) { return 0; }
    return 1;
}

# Typed accessors by flag index (parsed value, else registered default; a bad
# idx returns the type's zero sentinel rather than reading out of bounds).
fn cmdit_get_bool(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0; }
    return load64(_cmdit_entry(h, idx) + _CMDIT_E_VALUE);
}

# Parsed int value, else the registered default. 0 for a bad idx.
fn cmdit_get_int(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0; }
    return load64(_cmdit_entry(h, idx) + _CMDIT_E_VALUE);
}

# Parsed string value (an interior pointer into argv, not a copy), else the
# registered default. 0 for a bad idx.
fn cmdit_get_str(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0; }
    return load64(_cmdit_entry(h, idx) + _CMDIT_E_VALUE);
}

# Enum flag's 0-based matched-choice index (the dispatch the survey found every
# consumer re-deriving) — order of the '|'-delimited choices, -1 if unset/none or
# the stored value is not in the set. Cache it once after parse; it re-walks the
# choices cstr per call.
fn cmdit_get_enum(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0 - 1; }
    var ep = _cmdit_entry(h, idx);
    var nocase = 0;
    if ((load64(ep + _CMDIT_E_ATTRS) & CMDIT_ATTR_NOCASE) != 0) { nocase = 1; }
    return _cmdit_enum_find(load64(ep + _CMDIT_E_CHOICES), load64(ep + _CMDIT_E_VALUE), nocase);
}

# 1 if the flag was provided (CLI or env fallback), 0 if still at its default.
# The presence query cmdit_required relies on — also enables bespoke confirmation
# messages, conditional-required, and duplicate detection in caller code. (SEEN
# does not distinguish CLI-set from env-set.)
fn cmdit_seen(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0; }
    if ((load64(_cmdit_entry(h, idx) + _CMDIT_E_ATTRS) & CMDIT_ATTR_SEEN) != 0) { return 1; }
    return 0;
}

# Repeatable flag accessors: count of accumulated occurrences, and the i-th value
# (cstr) in argv order (0 if out of range).
fn cmdit_repeat_count(h, idx): i64 {
    if (_cmdit_idx_ok(h, idx) == 0) { return 0; }
    return load64(_cmdit_entry(h, idx) + _CMDIT_E_REPEAT_COUNT);
}
# The i-th accumulated value (cstr) in argv order, or 0 when `idx` names no
# registered flag or `i` is outside [0, cmdit_repeat_count).
fn cmdit_repeat_get(h, idx, i): i64 {
    # 1.2.4: `idx` is guarded too. It used to compute _cmdit_entry(h, idx)
    # unchecked and then DEREFERENCE the list pointer read from that address —
    # a bad idx did not merely read out of bounds, it followed whatever those
    # bytes happened to be. CHANGELOG [1.2.4].
    if (_cmdit_idx_ok(h, idx) == 0) { return 0; }
    var ep = _cmdit_entry(h, idx);
    if (i < 0) { return 0; }
    # The count test above also covers a null list: the list is allocated on the
    # first push, which is also what makes the count non-zero, so count == 0
    # whenever the pointer is 0 and no i can get past the line above. (A null
    # check here is unreachable — mutation-verified, not assumed.)
    if (i >= load64(ep + _CMDIT_E_REPEAT_COUNT)) { return 0; }
    return load64(load64(ep + _CMDIT_E_REPEAT) + i * 8);
}

# Positional (non-flag) args in argv order, including everything after `--`.
fn cmdit_positional_count(h): i64 {
    if (h == 0) { return 0; }                                     # 1.3.2: see _cmdit_h0
    return load64(h + _CMDIT_H_POS_COUNT);
}
# The idx-th positional (cstr, an interior pointer into argv), or 0 when idx is
# outside [0, cmdit_positional_count).
fn cmdit_positional(h, idx): i64 {
    if (h == 0) { return 0; }                                     # 1.3.2: see _cmdit_h0
    if (idx < 0) { return 0; }
    if (idx >= load64(h + _CMDIT_H_POS_COUNT)) { return 0; }
    return load64(load64(h + _CMDIT_H_POS) + idx * 8);
}

# Last parse error (CmditErr). Checked after a CMDIT_RESULT_ERR return. A 0 handle
# reports CMDIT_ERR_NOMEM: cmdit_new returns 0 only when alloc refused (1.3.2).
fn cmdit_error(h): i64 {
    if (h == 0) { return CMDIT_ERR_NOMEM; }
    return load64(h + _CMDIT_H_ERR);
}

# Index of the flag that produced the last error (for consumer-rendered messages),
# or -1 if none / the error names no registered flag (UNKNOWN / BUNDLED /
# UNKNOWN_VERB, and NOMEM from the positional array). UNEXPECTED_VALUE and a
# repeat-list NOMEM name their flag (1.3.1). The same flag cmdit_print_error
# names. Matches the registration index from cmdit_*.
fn cmdit_err_flag(h): i64 {
    if (h == 0) { return 0 - 1; }                                 # 1.3.2: see _cmdit_h0
    var ep = load64(h + _CMDIT_H_ERR_ENTRY);
    if (ep == 0) { return 0 - 1; }
    return (ep - load64(h)) / _CMDIT_ENTRY_SZ;
}

# The argv token behind the last error, exactly as typed (an interior pointer into
# argv, not a copy), or 0. The unknown flag (`--bogus`, `--bogus=1`), the bundled
# short (`-vx`), the unknown verb, the flag whose value was missing or rejected
# (`--count` in `--count abc`, `--count=abc` attached), the positional that could
# not be stored, the first positional past cmdit_require_positionals_max / _exact.
# 0 for REQUIRED_MISSING, MISSING_POSITIONAL, ARGV and an allocation NOMEM. Mirrors
# stdlib flags_error_arg. 1.3.3: the survey found seven tools echoing this.
fn cmdit_err_token(h): i64 {
    if (h == 0) { return 0; }
    return load64(h + _CMDIT_H_ERR_TOKEN);
}

# The value the last error rejected (cstr, an interior pointer into argv), or 0:
# set for BAD_INT, BAD_ENUM, OUT_OF_RANGE and UNEXPECTED_VALUE only — `abc` in
# `--count abc` or `--count=abc`, `0` in `--loud=0`. Lets a tool say "unknown key
# 'zzz'" without re-scanning argv (chakshu). 1.3.3.
fn cmdit_err_value(h): i64 {
    if (h == 0) { return 0; }
    return load64(h + _CMDIT_H_ERR_VALUE);
}

# Record the last error: its code, the entry it names (0 = none), the argv token
# behind it and the value it rejected (0 = none). Every error path goes through
# here so none can leave a field from an earlier error behind. Returns
# CMDIT_RESULT_ERR for direct `return`. 1.3.3.
fn _cmdit_fail(h, code, ep, tok, val): i64 {
    store64(h + _CMDIT_H_ERR, code);
    store64(h + _CMDIT_H_ERR_ENTRY, ep);
    store64(h + _CMDIT_H_ERR_TOKEN, tok);
    store64(h + _CMDIT_H_ERR_VALUE, val);
    return CMDIT_RESULT_ERR;
}

# 1 when `code` rejects a VALUE a flag was given (so cmdit_err_value is set).
fn _cmdit_is_value_err(code): i64 {
    if (code == CMDIT_ERR_BAD_INT || code == CMDIT_ERR_BAD_ENUM) { return 1; }
    if (code == CMDIT_ERR_OUT_OF_RANGE || code == CMDIT_ERR_UNEXPECTED_VALUE) { return 1; }
    return 0;
}

# Verb dispatch accessors (0.3.0). cmdit_verb_matched is the identify-and-return
# key the caller switches on (mirrors cmdit_get_enum): the canonical id of the
# dispatched verb, or -1 if no verb token was present (distinct from a
# CMDIT_RESULT_ERR / UNKNOWN_VERB, where a token matched nothing). verb_argc/argv
# are the globals-removed remainder slice (argv[0] = verb name) to feed a child
# handle's cmdit_parse_argv (also how nested sub-verbs work — re-enter on it).
fn cmdit_verb_matched(h): i64 {
    if (h == 0) { return 0 - 1; }                                 # 1.3.2: see _cmdit_h0
    return load64(h + _CMDIT_H_VERB_MATCHED);
}
# Token count of the remainder slice (>= 1 once a verb matched: argv[0] is the
# verb name). Feed it, with cmdit_verb_argv, to the child handle's parse.
fn cmdit_verb_argc(h): i64 {
    if (h == 0) { return 0; }                                     # 1.3.2: see _cmdit_h0
    return load64(h + _CMDIT_H_VERB_ARGC);
}
# The remainder slice itself: a NULL-terminated cstr* array whose [0] is the
# matched verb name, shaped like a real argv so cmdit_parse_argv accepts it.
fn cmdit_verb_argv(h): i64 {
    if (h == 0) { return 0; }                                     # 1.3.2: see _cmdit_h0
    return load64(h + _CMDIT_H_VERB_ARGV);
}

# Escape hatch: the materialized argv array + count, for non-getopt grammars
# (e.g. dig's @server / +opt) that hand-tokenize but still want help/version.
fn cmdit_raw_argv(h): i64 {
    if (h == 0) { return 0; }                                     # 1.3.2: see _cmdit_h0
    return load64(h + _CMDIT_H_RAW_ARGV);
}
# Token count of that array (0 until cmdit_argv has materialized it).
fn cmdit_raw_argc(h): i64 {
    if (h == 0) { return 0; }                                     # 1.3.2: see _cmdit_h0
    return load64(h + _CMDIT_H_RAW_ARGC);
}

# --- parser internals (forked from flags.cyr, byte-compatible) ---------------

fn _cmdit_streq_bounded(a, b, len): i64 {
    var i = 0;
    while (i < len) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    if (load8(b + len) != 0) { return 0; }
    return 1;
}

# 1.4.0: a name's first byte is compared before the call that compares the rest, and
# the scan walks a pointer instead of calling _cmdit_entry per row, so a lookup over
# attn11's 36 flags makes 3 calls, not 76. The span's first byte, or 0 for an empty
# span (which matches only an empty name), is a necessary condition for
# _cmdit_streq_bounded, so the result is unchanged.
fn _cmdit_find_long(h, name, len): i64 {
    var count = load64(h + _CMDIT_H_COUNT);
    var c0 = 0;
    if (len > 0) { c0 = load8(name); }
    var ep = load64(h);
    var i = 0;
    while (i < count) {
        var ep_name = load64(ep + _CMDIT_E_LONG);
        if (ep_name != 0) {
            if (load8(ep_name) == c0) {
                if (_cmdit_streq_bounded(name, ep_name, len) == 1) { return ep; }
            }
        }
        var ep_alias = load64(ep + _CMDIT_E_ALIAS);                          # 1.3.6: cmdit_long_alias
        if (ep_alias != 0) {
            if (load8(ep_alias) == c0) {
                if (_cmdit_streq_bounded(name, ep_alias, len) == 1) { return ep; }
            }
        }
        ep = ep + _CMDIT_ENTRY_SZ;
        i = i + 1;
    }
    return 0;
}

fn _cmdit_find_short(h, ch): i64 {
    if (ch == 0) { return 0; }                                    # 0 is never a letter
    var count = load64(h + _CMDIT_H_COUNT);
    var ep = load64(h);                                           # 1.4.0: walk, no call per row
    var i = 0;
    while (i < count) {
        if (load64(ep) == ch) { return ep; }
        ep = ep + _CMDIT_ENTRY_SZ;
        i = i + 1;
    }
    return 0;
}

var _cmdit_pint_ok = 0;
# Strict signed-decimal parse; sets _cmdit_pint_ok 1/0, rejects trailing garbage.
# Overflow is also rejected (not wrapped): a value whose magnitude exceeds i64 max
# leaves _cmdit_pint_ok 0 -> CMDIT_ERR_BAD_INT, so a giant digit string cannot
# silently wrap past a cmdit_range bound. (INT64_MIN's exact magnitude is rejected
# too — an accepted edge; range-bounded ints are never that large.)
fn _cmdit_parse_int(s): i64 {
    _cmdit_pint_ok = 0;
    if (s == 0) { return 0; }
    var i = 0;
    var neg = 0;
    if (load8(s) == 45) { neg = 1; i = 1; }
    var n = 0;
    var seen = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c < 48) { return 0; }
        if (c > 57) { return 0; }
        var d = c - 48;
        if (n > (9223372036854775807 - d) / 10) { return 0; }   # would overflow i64 -> reject
        n = n * 10 + d;
        seen = 1;
        i = i + 1;
    }
    if (seen == 0) { return 0; }
    _cmdit_pint_ok = 1;
    if (neg == 1) { return 0 - n; }
    return n;
}

# 0-based index of `value` among the '|'-delimited tokens in `choices`, else -1.
# Tokens are compared by exact length + bytes (no NUL inside choices between
# delimiters). Used for both enum validation (>= 0 == valid) and cmdit_get_enum.
fn _cmdit_enum_index(choices, value): i64 { return _cmdit_enum_find(choices, value, 0); }

# ASCII lower-case of byte `c` (1.3.6).
fn _cmdit_lower(c): i64 {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

# _cmdit_enum_index, with `nocase` = 1 comparing ASCII case-insensitively (1.3.6).
fn _cmdit_enum_find(choices, value, nocase): i64 {
    if (choices == 0) { return 0 - 1; }
    if (value == 0) { return 0 - 1; }
    var vlen = strlen(value);
    var ts = 0;          # current token start in choices
    var i = 0;
    var idx = 0;
    var done = 0;
    while (done == 0) {
        var c = load8(choices + i);
        if (c == 0) { done = 1; }
        if (c == 124 || c == 0) {       # '|' (124) or end of string
            var tlen = i - ts;
            if (tlen == vlen) {
                var k = 0;
                var hit = 1;
                while (k < vlen) {
                    var a = load8(choices + ts + k);
                    var b = load8(value + k);
                    if (nocase == 1) { a = _cmdit_lower(a); b = _cmdit_lower(b); }
                    if (a != b) { hit = 0; break; }
                    k = k + 1;
                }
                if (hit == 1) { return idx; }
            }
            idx = idx + 1;
            ts = i + 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Copy the first `n` pointer slots of `old` into a fresh array of `newcap` slots.
# Returns the new array, or 0 if alloc refused (OOM, or a size past ALLOC_MAX).
fn _cmdit_grow(old, n, newcap): i64 {
    if (newcap < n) { return 0; }                                 # 1.3.2: also catches a wrapped (negative) cap
    if (newcap > _CMDIT_SLOTS_MAX) { return 0; }                  # 1.3.2: newcap * 8 would wrap
    var grown = alloc(newcap * 8);
    if (grown == 0) { return 0; }
    var i = 0;
    while (i < n) { store64(grown + i * 8, load64(old + i * 8)); i = i + 1; }
    return grown;
}

# A repeat list's capacity, derived from its count: CMDIT_REPEAT_MAX, doubled
# until it covers `c`. Derived rather than stored, so the 112 B entry is unchanged.
fn _cmdit_repeat_cap(c): i64 {
    var cap = _CMDIT_REPEAT_INIT;
    while (cap < c) {
        # 1.3.2: past 2^62 another doubling wraps negative, then to 0, and the loop
        # never ends. Return c itself: the caller's grow to c * 2 then overflows,
        # alloc refuses it, and the push fails with NOMEM. Unreachable from argv.
        if (cap > 4611686018427387903) { return c; }
        cap = cap * 2;
    }
    return cap;
}

# Append a value to a repeat flag's per-entry list (alloc'd lazily). On success the
# value is also written to +24 so cmdit_get_str yields a last-wins scalar view.
#
# 1.3.1: the list GROWS (doubling) instead of silently dropping occurrences past
# CMDIT_REPEAT_MAX = 64, and a refused alloc is CMDIT_ERR_NOMEM instead of a
# silent drop. The stdlib parser cmdit was forked from made the same change in
# 6.6.5 / 6.6.7. CHANGELOG [1.3.1].
fn _cmdit_repeat_push(ep, value_ptr): i64 {
    var list = load64(ep + _CMDIT_E_REPEAT);
    var c = load64(ep + _CMDIT_E_REPEAT_COUNT);
    if (list == 0) {
        list = alloc(_CMDIT_REPEAT_INIT * 8);
        if (list == 0) { return CMDIT_ERR_NOMEM; }
        store64(ep + _CMDIT_E_REPEAT, list);
    }
    var cap = _cmdit_repeat_cap(c);
    if (c >= cap) {
        list = _cmdit_grow(list, c, cap * 2);
        if (list == 0) { return CMDIT_ERR_NOMEM; }
        store64(ep + _CMDIT_E_REPEAT, list);
    }
    store64(list + c * 8, value_ptr);
    store64(ep + _CMDIT_E_REPEAT_COUNT, c + 1);
    # 1.3.2: the last-wins view is set only once the push succeeded, so a refused
    # list alloc leaves the flag as it was, as an env fallback must. CHANGELOG [1.3.2].
    store64(ep + _CMDIT_E_VALUE, value_ptr);
    return CMDIT_ERR_NONE;
}

# Apply a value to an entry. Does NOT set the SEEN bit — callers (parse loop /
# env fallback) set SEEN only on success, so a non-fatal env failure leaves the
# default untouched and un-SEEN. Repeat appends; enum/range validate before store.
fn _cmdit_apply(ep, value_ptr): i64 {
    var type = load64(ep + _CMDIT_E_TYPE);
    var attrs = load64(ep + _CMDIT_E_ATTRS);
    # 1.3.6: cmdit_once — SEEN here can only be an earlier command-line occurrence,
    # because the env fallback runs after the parse and only on an unseen flag.
    if ((attrs & CMDIT_ATTR_ONCE) != 0) {
        if ((attrs & CMDIT_ATTR_SEEN) != 0) { return CMDIT_ERR_REPEATED; }
    }
    if ((attrs & CMDIT_ATTR_REPEAT) != 0) {
        if (value_ptr == 0) { return CMDIT_ERR_MISSING_VALUE; }
        return _cmdit_repeat_push(ep, value_ptr);
    }
    if (type == CMDIT_BOOL) {
        # 1.3.1: `--flag=value` on a bool used to be accepted with the value
        # discarded, so `--verbose=0` turned the flag ON — the opposite of what was
        # typed. The stdlib parser rejects it since 6.6.5. The env fallback never
        # reaches here for a bool (presence semantics), so NO_COLOR-style vars work.
        if (value_ptr != 0) { return CMDIT_ERR_UNEXPECTED_VALUE; }
        store64(ep + _CMDIT_E_VALUE, 1);
        return CMDIT_ERR_NONE;
    }
    if (value_ptr == 0) { return CMDIT_ERR_MISSING_VALUE; }
    if (type == CMDIT_INT) {
        var n = _cmdit_parse_int(value_ptr);
        if (_cmdit_pint_ok == 0) { return CMDIT_ERR_BAD_INT; }
        if ((attrs & CMDIT_ATTR_RANGE) != 0) {
            if (n < load64(ep + _CMDIT_E_MIN)) { return CMDIT_ERR_OUT_OF_RANGE; }
            if (n > load64(ep + _CMDIT_E_MAX)) { return CMDIT_ERR_OUT_OF_RANGE; }
        }
        store64(ep + _CMDIT_E_VALUE, n);
        return CMDIT_ERR_NONE;
    }
    var choices = load64(ep + _CMDIT_E_CHOICES);              # CMDIT_STR (incl. enum)
    if (choices != 0) {
        var nocase = 0;
        if ((attrs & CMDIT_ATTR_NOCASE) != 0) { nocase = 1; }
        if (_cmdit_enum_find(choices, value_ptr, nocase) < 0) { return CMDIT_ERR_BAD_ENUM; }
    }
    store64(ep + _CMDIT_E_VALUE, value_ptr);
    return CMDIT_ERR_NONE;
}

# Append a positional, doubling the array when it is full. Returns CMDIT_ERR_NONE,
# or CMDIT_ERR_NOMEM if the growth alloc was refused.
#
# 1.3.1: positionals past CMDIT_POS_MAX = 128 used to be dropped silently, and the
# caller could not tell: `tool *.txt` over 200 files saw 128. The 1.0.0 audit
# accepted that (SEC-3) because it matched the stdlib parser; the stdlib has grown
# its array since 6.6.5. CHANGELOG [1.3.1].
fn _cmdit_push_positional(h, tok): i64 {
    var pc = load64(h + _CMDIT_H_POS_COUNT);
    var cap = load64(h + _CMDIT_H_POS_CAP);
    if (pc >= cap) {
        var grown = _cmdit_grow(load64(h + _CMDIT_H_POS), pc, cap * 2);
        if (grown == 0) { return CMDIT_ERR_NOMEM; }
        store64(h + _CMDIT_H_POS, grown);
        store64(h + _CMDIT_H_POS_CAP, cap * 2);
    }
    store64(load64(h + _CMDIT_H_POS) + pc * 8, tok);
    store64(h + _CMDIT_H_POS_COUNT, pc + 1);
    return CMDIT_ERR_NONE;
}

# --- 1.4.0: one token-to-flag path -------------------------------------------------
# Both parse cores apply a flag token here: resolve it, take its value, apply it. Until
# 1.4.0 the parse core did this at two sites (long and short) and the dispatcher at a
# third, and they drifted: 1.3.2 fixed a BUNDLED/UNKNOWN divergence between them, and 1.3.6
# had to add its flag-shaped-value refusal three times. One call per flag token, because
# a second call per token measured +8% on a 32-flag parse.

# Apply the flag token argv[i]: `--long`, `--long=value` or `-x`. A flag that needs a
# value and has none attached takes the next token, unless cmdit_reject_flag_value
# refuses it; the flag is then applied and marked SEEN. Returns the index to resume at
# (i + 1, or i + 2 after taking the next token), or -1 with the error recorded.
#
# `after_verb` = 1 is the dispatcher after the verb, where a token that is not a global
# flag belongs to the verb's scope. It returns -2, applying nothing, for an unregistered
# flag, for the auto --help / --version (recording the hand-off, so the verb's own help
# wins) and, under cmdit_stop_at_positional, for every flag.
fn _cmdit_take_flag(h, argc, argv, i, after_verb): i64 {
    var tok = load64(argv + i * 8);
    var ep = 0;
    var value_ptr = 0;
    if (load8(tok + 1) == 45) {
        var name_start = tok + 2;
        var j = 0;
        var eq = 0 - 1;
        while (load8(name_start + j) != 0) {
            if (load8(name_start + j) == 61) { eq = j; break; }
            j = j + 1;
        }
        var name_len = j;
        if (eq >= 0) { name_len = eq; }
        ep = _cmdit_find_long(h, name_start, name_len);
        if (ep != 0) { if (eq >= 0) { value_ptr = name_start + eq + 1; } }
    } elif (load8(tok + 2) == 0) {
        ep = _cmdit_find_short(h, load8(tok + 1));
    }
    if (after_verb == 1) {
        if (ep == 0) { return 0 - 2; }
        if (_cmdit_is_auto(h, ep) == 1) {
            store64(h + _CMDIT_H_HELP_HANDOFF, 1);                # 1.3.2: help/version go to the verb
            return 0 - 2;
        }
        # 1.3.4: under POSIX stop-at-positional the verb is the first operand, so a
        # global after it is not applied; it goes to the verb's scope like any token.
        if (load64(h + _CMDIT_H_STOP) != 0) { return 0 - 2; }
    }
    if (ep == 0) {
        # A short token with more after its letter (`-vx`, `-ofile`) is BUNDLED. Until
        # 1.3.2 the dispatcher reported UNKNOWN for it, even for a registered -o.
        if (load8(tok + 1) != 45 && load8(tok + 2) != 0) { _cmdit_fail(h, CMDIT_ERR_BUNDLED, 0, tok, 0); return 0 - 1; }
        _cmdit_fail(h, CMDIT_ERR_UNKNOWN, 0, tok, 0);
        return 0 - 1;
    }
    var ni = i + 1;
    if (value_ptr == 0) {
        if (load64(ep + _CMDIT_E_TYPE) != CMDIT_BOOL) {
            if (i + 1 >= argc) { _cmdit_fail(h, CMDIT_ERR_MISSING_VALUE, ep, tok, 0); return 0 - 1; }
            value_ptr = load64(argv + (i + 1) * 8);
            # 1.3.6: cmdit_reject_flag_value. The bit is tested here first so the
            # common flag, without the modifier, makes no call.
            if ((load64(ep + _CMDIT_E_ATTRS) & CMDIT_ATTR_NOFLAGVAL) != 0) {
                if (_cmdit_flaglike_value(ep, value_ptr) == 1) {
                    _cmdit_fail(h, CMDIT_ERR_MISSING_VALUE, ep, tok, 0);
                    return 0 - 1;
                }
            }
            ni = i + 2;
        }
    }
    var ar = _cmdit_apply(ep, value_ptr);
    if (ar != CMDIT_ERR_NONE) {
        var bad = 0;
        if (_cmdit_is_value_err(ar) == 1) { bad = value_ptr; }
        _cmdit_fail(h, ar, ep, tok, bad);
        return 0 - 1;
    }
    # Mark it provided, for the required check and the env fallback.
    store64(ep + _CMDIT_E_ATTRS, load64(ep + _CMDIT_E_ATTRS) | CMDIT_ATTR_SEEN);
    return ni;
}

# Parse a passed cstr* array (argv + i*8). PURE — never reads /proc, so tests
# drive synthetic argv. Returns CMDIT_OK / CMDIT_HELP / CMDIT_VERSION /
# CMDIT_RESULT_ERR (cmdit_error reports which on the last).
fn cmdit_parse_argv(h, argc, argv): i64 {
    if (h == 0) { return CMDIT_RESULT_ERR; }                      # 1.3.2: see _cmdit_h0
    # 1.2.4: reset the per-parse error trio. Without this a handle parsed a
    # second time carried the FIRST parse's err_entry, and cmdit_print_error /
    # cmdit_err_flag name a flag from an error that has nothing to do with the
    # one being reported. CHANGELOG [1.2.4].
    _cmdit_fail(h, CMDIT_ERR_NONE, 0, 0, 0);                    # 1.3.3: + err_token / err_value
    if (load64(h + _CMDIT_H_PROG) == 0) { if (argc > 0) { store64(h + _CMDIT_H_PROG, load64(argv)); } }
    var i = 1;
    var in_positional = 0;
    # 1.2.2: trailing-verbatim, propagated from the dispatcher by
    # cmdit_parse_verb as n + 1; 0 = off. Once n positionals have been pushed,
    # every remaining token is a positional whatever it looks like.
    var trail = load64(h + _CMDIT_H_TRAILING);
    while (i < argc) {
        var tok = load64(argv + i * 8);
        if (tok == 0) { i = i + 1; continue; }
        if (trail > 0 && in_positional == 0) {
            if (cmdit_positional_count(h) >= trail - 1) {
                in_positional = 1;
                # 1.3.2: a `--` exactly at the threshold separates, kubectl-style,
                # and is consumed. Before, `exec c1 -- ls -l` (1.2.2's documented
                # escape hatch) ran the command `--` once exec was marked. A second
                # `--` is data. CHANGELOG [1.3.2].
                if (load8(tok) == 45 && load8(tok + 1) == 45 && load8(tok + 2) == 0) { i = i + 1; continue; }
            }
        }
        var as_pos = in_positional;
        if (load8(tok) != 45 || load8(tok + 1) == 0) { as_pos = 1; }   # a non-flag, or a lone "-"
        if (as_pos == 1) {
            if (_cmdit_push_positional(h, tok) != CMDIT_ERR_NONE) {
                return _cmdit_fail(h, CMDIT_ERR_NOMEM, 0, tok, 0);
            }
            if (load64(h + _CMDIT_H_STOP) == 1) { in_positional = 1; }      # 1.3.4: POSIX stop
            i = i + 1;
            continue;
        }
        if (load8(tok + 1) == 45 && load8(tok + 2) == 0) { in_positional = 1; i = i + 1; continue; }

        var nx = _cmdit_take_flag(h, argc, argv, i, 0);
        if (nx < 0) { return CMDIT_RESULT_ERR; }
        i = nx;
    }
    if (cmdit_get_bool(h, load64(h + _CMDIT_H_HELP_IDX)) == 1) { return CMDIT_HELP; }
    if (cmdit_get_bool(h, load64(h + _CMDIT_H_VERSION_IDX)) == 1) { return CMDIT_VERSION; }
    return CMDIT_OK;
}

# Split `n` NUL-terminated strings laid end to end at `base` (the Linux
# /proc/self/cmdline layout; an empty argument is a bare NUL) into out[0..n), in
# one pass over the bytes. Pure, so the suite drives it with synthetic buffers.
fn _cmdit_split_flat(base, n, out): i64 {
    var p = base;
    var i = 0;
    while (i < n) {
        store64(out + i * 8, p);
        p = p + strlen(p) + 1;
        i = i + 1;
    }
    return n;
}

# The process argv, materialized once per PROCESS and shared by every handle
# (1.3.2: it was once per handle, and each repeat re-ran args_init and its 2 MiB
# buffer). 0 until the first successful _cmdit_argv_load.
var _cmdit_argv_arr = 0;
var _cmdit_argv_n = 0;

# 1 when a read of `n` arguments from a `len`-byte buffer can be trusted whole.
# Pure, so the suite can drive it. n <= 0: no argv[0], which a real exec never
# lacks (Linux >= 5.18 supplies an empty one), so the command line could not be
# read (no /proc mounted, or args_init's alloc failed). len == 2 MiB: before
# cyrius 6.7.12, stdlib args_init read /proc/self/cmdline ONCE into a fixed 2 MiB
# buffer, but ARG_MAX rises with `ulimit -s`, so a longer command line came back
# as its first 2 MiB with every whole token past the cut gone. That read can never
# return MORE than 2 MiB, and from 6.7.12 args_init reads to EOF, so a longer len
# is whole under either stdlib. Only a read of exactly 2 MiB is ambiguous, and the
# bundle still compiles on pins that truncate, so that one length stays refused
# (1.4.2; it was len >= 2 MiB). Pass len 0 where it is not known. CHANGELOG [1.4.2].
fn _cmdit_argv_whole(n, len): i64 {
    if (n <= 0) { return 0; }
    if (len == 2097152) { return 0; }
    return 1;
}

# Read the process argv into _cmdit_argv_arr / _n. Returns CMDIT_ERR_NONE, or the
# error code that explains why not (nothing is cached on failure).
fn _cmdit_argv_load(): i64 {
    args_init();
    var n = argc();
    var len = 0;
    #ifdef CYRIUS_TARGET_LINUX
    len = _args_len;
    #endif
    if (_cmdit_argv_whole(n, len) == 0) { return CMDIT_ERR_ARGV; }
    if (n >= _CMDIT_SLOTS_MAX) { return CMDIT_ERR_NOMEM; }       # (n + 1) * 8 must not wrap
    var arr = alloc((n + 1) * 8);
    if (arr == 0) { return CMDIT_ERR_NOMEM; }                     # 1.2.4: OOM -> no argv, not a null write
    # 1.3.0: on Linux stdlib argv(i) re-walks /proc/self/cmdline from byte 0 on
    # every call, so asking for each index in turn was quadratic: 20,000
    # arguments cost ~2.6 s before parsing began. The arguments sit end to end in
    # that buffer, so one walk finds them all. Other targets keep argv(i): agnos
    # reads a pointer table (already O(1)) whose strings need not be adjacent.
    # CHANGELOG [1.3.0].
    #ifdef CYRIUS_TARGET_LINUX
    _cmdit_split_flat(argv(0), n, arr);
    #endif
    #ifndef CYRIUS_TARGET_LINUX
    var i = 0;
    while (i < n) { store64(arr + i * 8, argv(i)); i = i + 1; }
    #endif
    store64(arr + n * 8, 0);             # NULL terminator (execve-passthrough safe)
    _cmdit_argv_arr = arr;
    _cmdit_argv_n = n;
    return CMDIT_ERR_NONE;
}

# Materialize argc()/argv(i) into a contiguous, NULL-terminated cstr* array and
# cache it on the handle. Absorbs the build_argv_array / _materialize_argv
# boilerplate every structured consumer copies. Needs stdlib "args". Returns the
# count. On failure returns 0, stores no array, and sets cmdit_error:
# CMDIT_ERR_ARGV when the command line could not be read in full, CMDIT_ERR_NOMEM
# when the array could not be allocated (1.3.2; before, both parsed as an EMPTY
# argv and the tool ran ignoring every flag it was given). CHANGELOG [1.3.2].
fn cmdit_argv(h): i64 {
    if (h == 0) { return 0; }                                     # 1.3.2: see _cmdit_h0
    if (load64(h + _CMDIT_H_RAW_ARGV) != 0) { return load64(h + _CMDIT_H_RAW_ARGC); }
    if (_cmdit_argv_arr == 0) {
        var e = _cmdit_argv_load();
        if (e != CMDIT_ERR_NONE) { _cmdit_fail(h, e, 0, 0, 0); return 0; }
    }
    store64(h + _CMDIT_H_RAW_ARGV, _cmdit_argv_arr);
    store64(h + _CMDIT_H_RAW_ARGC, _cmdit_argv_n);
    return _cmdit_argv_n;
}

# --- 0.2.0 finalize: env fallback + required check (the impure post-stage) ---
# Kept OUT of cmdit_parse_argv so that pure core stays /proc- and env-free and
# the synthetic-argv test suite is deterministic. cmdit_parse runs it; tests can
# call it directly (with no env_name set, getenv is never reached -> still pure).

# For every un-SEEN flag with an env_name, apply the env var as a fallback value.
# NON-FATAL: a bad int / out-of-range / bad enum / set-but-empty value is ignored
# (default preserved, flag stays un-SEEN) — only CLI input is fatal. Bool flags
# use presence semantics (var set to ANY value, even empty, -> 1; NO_COLOR-style).
fn _cmdit_apply_env(h): i64 {
    var count = load64(h + _CMDIT_H_COUNT);
    var i = 0;
    while (i < count) {
        var ep = _cmdit_entry(h, i);
        var env_name = load64(ep + _CMDIT_E_ENV);
        if (env_name != 0 && (load64(ep + _CMDIT_E_ATTRS) & CMDIT_ATTR_SEEN) == 0) {
            var val = getenv(env_name);
            if (val != 0) {
                if (load64(ep + _CMDIT_E_TYPE) == CMDIT_BOOL) {
                    store64(ep + _CMDIT_E_VALUE, 1);                                          # presence -> true
                    store64(ep + _CMDIT_E_ATTRS, load64(ep + _CMDIT_E_ATTRS) | CMDIT_ATTR_SEEN);
                } else {
                    if (load8(val) != 0) {                                        # ignore set-but-empty
                        if (_cmdit_apply(ep, val) == CMDIT_ERR_NONE) {
                            store64(ep + _CMDIT_E_ATTRS, load64(ep + _CMDIT_E_ATTRS) | CMDIT_ATTR_SEEN);
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return CMDIT_ERR_NONE;
}

# Every cmdit_required flag must be SEEN (by CLI or env); else the first such flag
# yields CMDIT_ERR_REQUIRED_MISSING + err_entry.
fn _cmdit_check_required(h): i64 {
    var count = load64(h + _CMDIT_H_COUNT);
    var i = 0;
    while (i < count) {
        var ep = _cmdit_entry(h, i);
        var attrs = load64(ep + _CMDIT_E_ATTRS);
        if ((attrs & CMDIT_ATTR_REQUIRED) != 0) {
            if ((attrs & CMDIT_ATTR_SEEN) == 0) {
                store64(h + _CMDIT_H_ERR_ENTRY, ep);
                return CMDIT_ERR_REQUIRED_MISSING;
            }
        }
        i = i + 1;
    }
    return CMDIT_ERR_NONE;
}

# Run the post-parse stage: env fallback FIRST (so env can satisfy required),
# then the required check. Returns CMDIT_OK or CMDIT_RESULT_ERR (cmdit_error =
# REQUIRED_MISSING). Call only on a CMDIT_OK parse (help/version short-circuit
# before this). Idempotent enough for one finalize per parse.
#
# 1.3.2: after a dispatch that handed `--help` / `--version` to the verb
# (`tool add --help`), the required check is skipped: the user asked for help,
# and a missing required global turned that into "required flag missing", against
# README's promise that `tool add --help` shows the subcommand's help. The env
# fallback still runs. CHANGELOG [1.3.2].
fn cmdit_finalize(h): i64 {
    if (h == 0) { return CMDIT_RESULT_ERR; }                      # 1.3.2: see _cmdit_h0
    _cmdit_apply_env(h);
    if (load64(h + _CMDIT_H_HELP_HANDOFF) == 1) { return CMDIT_OK; }
    var rq = _cmdit_check_required(h);
    if (rq != CMDIT_ERR_NONE) { return _cmdit_fail(h, rq, load64(h + _CMDIT_H_ERR_ENTRY), 0, 0); }
    return CMDIT_OK;
}

# Convenience: materialize the process argv, parse it, then finalize (env +
# required). The form most single-tool consumers call. help/version/parse-error
# results propagate untouched — finalize runs only on a clean CMDIT_OK parse.
fn cmdit_parse(h): i64 {
    if (h == 0) { return CMDIT_RESULT_ERR; }                      # 1.3.2: see _cmdit_h0
    var n = cmdit_argv(h);
    if (load64(h + _CMDIT_H_RAW_ARGV) == 0) { return CMDIT_RESULT_ERR; }         # 1.3.2: cmdit_argv set ARGV / NOMEM
    var r = cmdit_parse_argv(h, n, load64(h + _CMDIT_H_RAW_ARGV));
    if (r != CMDIT_OK) { return r; }
    return cmdit_finalize(h);
}

# Require at least `min` positional args (top-level or any verb child handle);
# count < min -> CMDIT_ERR_MISSING_POSITIONAL.
# Deferred from 0.2.0, shipped in 0.3.0 (CHANGELOG [0.3.0]);
# subsumes cyim's `if (r_npos < 3)` guards. Call after parse/dispatch.
fn cmdit_require_positionals(h, min): i64 {
    if (h == 0) { return CMDIT_RESULT_ERR; }                      # 1.3.2: see _cmdit_h0
    if (load64(h + _CMDIT_H_POS_COUNT) >= min) { return CMDIT_OK; }
    return _cmdit_fail(h, CMDIT_ERR_MISSING_POSITIONAL, 0, 0, 0);
}

# Require AT MOST `max` positionals; count > max -> CMDIT_ERR_TOO_MANY_POSITIONAL.
# The upper-bound mirror of cmdit_require_positionals (top-level or any verb handle).
fn cmdit_require_positionals_max(h, max): i64 {
    if (h == 0) { return CMDIT_RESULT_ERR; }                      # 1.3.2: see _cmdit_h0
    if (load64(h + _CMDIT_H_POS_COUNT) <= max) { return CMDIT_OK; }
    return _cmdit_fail(h, CMDIT_ERR_TOO_MANY_POSITIONAL, 0, cmdit_positional(h, max), 0);   # 1.3.3: first extra
}

# Require EXACTLY `n` positionals: fewer -> CMDIT_ERR_MISSING_POSITIONAL, more ->
# CMDIT_ERR_TOO_MANY_POSITIONAL (the both-bounds gate, argparse nargs=N).
fn cmdit_require_positionals_exact(h, n): i64 {
    if (h == 0) { return CMDIT_RESULT_ERR; }                      # 1.3.2: see _cmdit_h0
    var c = load64(h + _CMDIT_H_POS_COUNT);
    if (c < n) { return _cmdit_fail(h, CMDIT_ERR_MISSING_POSITIONAL, 0, 0, 0); }
    if (c > n) { return _cmdit_fail(h, CMDIT_ERR_TOO_MANY_POSITIONAL, 0, cmdit_positional(h, n), 0); }
    return CMDIT_OK;
}

# --- 0.3.0 verb / subcommand dispatch ---------------------------------------
# IDENTIFY-and-return (not handler fn-ptrs): cmdit_dispatch resolves argv to a
# matched verb id (cmdit_verb_matched) + a globals-removed remainder slice
# (cmdit_verb_argv) that the caller re-parses with a fresh per-verb handle. The
# pure cmdit_parse_argv core is untouched; cmdit_dispatch_argv is a new pure
# sibling. Nested sub-verbs are re-entry on the remainder; the argv[0]
# multiplexer is cmdit_basename + the raw-argv escape, caller-side.

fn _cmdit_verb_row(h, i): i64 { return load64(h + _CMDIT_H_VERBS) + i * _CMDIT_VERB_SZ; }

# Whole-cstr equality (both NUL-terminated).
fn _cmdit_cstr_eq(a, b): i64 {
    var i = 0;
    while (load8(a + i) != 0) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    if (load8(b + i) != 0) { return 0; }
    return 1;
}

# Append a verb/alias row (lazy-allocating + zeroing the table on first use).
# canonical < 0 means "self" (a real verb -> canonical = own index). Returns the
# new row index, or -1 if the table is full.
fn _cmdit_verb_add(h, name, help, canonical): i64 {
    if (h == 0) { return 0 - 1; }                                 # 1.3.2: see _cmdit_h0
    var vp = load64(h + _CMDIT_H_VERBS);
    var count = load64(h + _CMDIT_H_VERBS_COUNT);
    var cap = load64(h + _CMDIT_H_VERBS_CAP);
    if (count >= cap) {
        # 1.4.0: the table starts at _CMDIT_VERB_INIT rows and doubles, as positionals
        # have since 1.3.1. Before, the first cmdit_verb allocated and zeroed all 128
        # rows (6,144 B, ~1.3 µs) for tools with 5 to 36 verbs. Rows are only ever
        # addressed by index from the handle, so moving the table leaves nothing behind.
        if (cap >= _CMDIT_VERB_CAP) { return 0 - 1; }             # the handle's own cap (1.3.2)
        var ncap = _CMDIT_VERB_INIT;
        if (cap > 0) { ncap = cap * 2; }
        if (ncap > _CMDIT_VERB_CAP) { ncap = _CMDIT_VERB_CAP; }
        var rw = _CMDIT_VERB_SZ / 8;                              # words per row
        var nvp = _cmdit_grow(vp, count * rw, ncap * rw);
        if (nvp == 0) { return 0 - 1; }                           # 1.2.4: OOM -> "table full", not a null write
        # Defence-in-depth, as since 1.3.0: _cmdit_verb_add writes every field of a new
        # row, so nothing reads this zero, but a field added later cannot start as junk.
        _cmdit_zero(nvp + count * _CMDIT_VERB_SZ, (ncap - count) * _CMDIT_VERB_SZ);
        store64(h + _CMDIT_H_VERBS, nvp);
        store64(h + _CMDIT_H_VERBS_CAP, ncap);
        vp = nvp;
    }
    var row = vp + count * _CMDIT_VERB_SZ;
    store64(row, name);
    store64(row + _CMDIT_V_HELP, help);
    var canon = canonical;
    if (canon < 0) { canon = count; }
    store64(row + _CMDIT_V_CANON, canon);
    store64(row + _CMDIT_V_TRAILING, 0);
    store64(row + _CMDIT_V_HIDDEN, 0);                                         # 1.3.5: hidden
    store64(row + _CMDIT_V_FLAGS, 0);                                         # 1.3.7: flags handle
    store64(h + _CMDIT_H_VERBS_COUNT, count + 1);
    return count;
}

# Register a top-level verb. Returns its id (>= 0; the cmdit_verb_matched key), or
# -1 if the verb table is full.
fn cmdit_verb(h, name, help): i64 { return _cmdit_verb_add(h, name, help, 0 - 1); }

# 1.2.2: mark a verb as taking a VERBATIM trailing argument list after its first
# `n` positionals. Everything past that point is a positional, whatever it looks
# like — no flag parsing, at either the dispatcher or the verb level.
#
# This exists because a container runtime's `exec`, and anything else that
# forwards a command line to another program, cannot work without it:
#
#   stiva exec c1 ls -l          -> "unknown flag", the command never runs
#   stiva exec c1 -- ls -l       -> the SAME error (see the fix below)
#   stiva exec c1 mycmd --root /x -> silently retargets the CALLER's --root
#
# The last one is why this is a correctness fix and not a convenience: a global
# flag appearing inside the forwarded command was being applied to the host tool,
# changing where it wrote, with no diagnostic.
#
# `n` counts positionals AFTER the verb name. For `exec <container> <cmd>...`
# that is 1: the container id is ours, everything after belongs to the payload.
# Returns verb_id for chaining, or -1.
fn cmdit_verb_trailing_after(h, verb_id, n): i64 {
    # 1.2.4: n < 0 stored n+1, so n == -1 silently meant "not marked" and
    # n < -1 stored a negative that cmdit_verb_trailing_at's `v == 0` test did
    # not catch, handing the dispatcher a nonsense threshold. CHANGELOG [1.2.4].
    if (n < 0) { return 0 - 1; }
    # 1.3.2: resolve an alias row to its verb. Marking the alias row "succeeded"
    # but stored the mark where the dispatcher never reads it. CHANGELOG [1.3.2].
    verb_id = cmdit_verb_canonical_at(h, verb_id);                # -1 for a bad handle or id
    if (verb_id < 0) { return 0 - 1; }
    # +1 so the stored value is always non-zero for a marked verb, keeping 0 as
    # "not marked" in a field that older callers left zeroed.
    store64(_cmdit_verb_row(h, verb_id) + _CMDIT_V_TRAILING, n + 1);
    return verb_id;
}

# Positionals-after-the-verb before trailing-verbatim kicks in, or -1 when the
# verb is not marked.
#[must_use]
fn cmdit_verb_trailing_at(h, verb_id): i64 {
    verb_id = cmdit_verb_canonical_at(h, verb_id);                # 1.3.2: through an alias row
    if (verb_id < 0) { return 0 - 1; }
    var v = load64(_cmdit_verb_row(h, verb_id) + _CMDIT_V_TRAILING);
    if (v == 0) { return 0 - 1; }
    return v - 1;
}

# Add an alias for an existing verb (an extra row resolving to verb_id). Returns
# verb_id for chaining, or -1 on error.
fn cmdit_verb_alias(h, verb_id, alias): i64 {
    if (verb_id < 0) { return 0 - 1; }
    # 1.3.2: verb_id must name a registered verb, not an alias. Unchecked, an alias
    # of a missing id dispatched to a cmdit_verb_matched no caller registered, and
    # an id equal to the alias's own row made it render as a real verb in help and
    # completions. CHANGELOG [1.3.2].
    if (verb_id >= cmdit_verb_count(h)) { return 0 - 1; }
    if (cmdit_verb_is_alias(h, verb_id) == 1) { return 0 - 1; }
    if (_cmdit_verb_add(h, alias, 0, verb_id) < 0) { return 0 - 1; }
    return verb_id;
}

# Canonical id of the verb (or alias) named `name`, else -1.
fn _cmdit_find_verb(h, name): i64 {
    if (load64(h + _CMDIT_H_VERBS) == 0) { return 0 - 1; }
    var count = load64(h + _CMDIT_H_VERBS_COUNT);
    var i = 0;
    while (i < count) {
        var row = _cmdit_verb_row(h, i);
        var rn = load64(row);
        if (rn != 0) { if (_cmdit_cstr_eq(rn, name) == 1) { return load64(row + _CMDIT_V_CANON); } }
        i = i + 1;
    }
    return 0 - 1;
}

# 1 if ep is the auto-registered --help or --version entry, which the dispatcher
# hands to the verb's scope rather than applying itself. #skip-lint ("deferred"
# here is this loop's runtime behaviour, not a backlog item).
fn _cmdit_is_auto(h, ep): i64 {
    if (ep == _cmdit_entry(h, load64(h + _CMDIT_H_HELP_IDX))) { return 1; }
    if (ep == _cmdit_entry(h, load64(h + _CMDIT_H_VERSION_IDX))) { return 1; }
    return 0;
}

# PURE verb-dispatch loop (no /proc, no env). Single pass: registered GLOBAL flags
# are applied wherever they appear (before OR after the verb — the ark double-scan
# fix); the first non-flag token is matched against the verb table; everything
# else (the verb name, unknown flags, positionals, and a --help/--version that
# follows the verb, which is deferred into the verb's own scope) #skip-lint
# is compacted into a remainder slice (argv[0] = verb name) for the caller to
# re-parse in a per-verb handle. Before the verb an unknown flag
# is a hard CMDIT_ERR_UNKNOWN; an unmatched non-flag token is CMDIT_ERR_UNKNOWN_VERB.
# Returns CMDIT_OK / CMDIT_HELP / CMDIT_VERSION / CMDIT_RESULT_ERR.
fn cmdit_dispatch_argv(h, argc, argv): i64 {
    if (h == 0) { return CMDIT_RESULT_ERR; }                      # 1.3.2: see _cmdit_h0
    # 1.2.4: reset the per-parse error trio. Without this a handle parsed a
    # second time carried the FIRST parse's err_entry, and cmdit_print_error /
    # cmdit_err_flag name a flag from an error that has nothing to do with the
    # one being reported. CHANGELOG [1.2.4].
    _cmdit_fail(h, CMDIT_ERR_NONE, 0, 0, 0);                    # 1.3.3: + err_token / err_value
    store64(h + _CMDIT_H_HELP_HANDOFF, 0);                                          # 1.3.2: help_handoff
    if (load64(h + _CMDIT_H_PROG) == 0) { if (argc > 0) { store64(h + _CMDIT_H_PROG, load64(argv)); } }
    if (argc < 0) { argc = 0; }                                   # 1.2.4: else alloc(<=0) -> 0 -> null write below
    # 1.3.2: and an argc so large that (argc + 1) * 8 wraps. 2^61 wrapped to an
    # 8-byte remainder that the loop then wrote past. CHANGELOG [1.3.2].
    if (argc >= _CMDIT_SLOTS_MAX) { return _cmdit_fail(h, CMDIT_ERR_NOMEM, 0, 0, 0); }
    var rem = alloc((argc + 1) * 8);
    # 1.2.4: OOM. 1.3.2: it returned RESULT_ERR with cmdit_error still NONE, the
    # one error path that set no code; it is CMDIT_ERR_NOMEM now. CHANGELOG [1.3.2].
    if (rem == 0) { return _cmdit_fail(h, CMDIT_ERR_NOMEM, 0, 0, 0); }
    var rn = 0;
    var verb_found = 0;
    var no_more_flags = 0;
    var trailing_at = 0 - 1;        # 1.2.2: positionals before verbatim, or -1
    var post_positionals = 0;
    var i = 1;
    while (i < argc) {
        var tok = load64(argv + i * 8);
        if (tok == 0) { i = i + 1; continue; }
        var is_flag = 0;
        if (no_more_flags == 0) { if (load8(tok) == 45) { if (load8(tok + 1) != 0) { is_flag = 1; } } }
        if (is_flag == 1 && load8(tok + 1) == 45 && load8(tok + 2) == 0) {
            no_more_flags = 1;
            # 1.2.2 FIX: forward the terminator when it lands AFTER the verb.
            # It used to be consumed here and never copied into `rem`, so the
            # verb's own `cmdit_parse_argv` — which handles '--' perfectly well
            # — never saw one. The documented escape hatch for a command with
            # flags (`prog verb -- cmd -x`) therefore did nothing, and failed
            # identically to omitting it.
            #
            # Before the verb it is still consumed: `rem[0]` must be the verb
            # name, and a '--' there means "no more GLOBAL flags", which this
            # loop has already applied by setting no_more_flags.
            if (verb_found == 1) { store64(rem + rn * 8, tok); rn = rn + 1; }
            i = i + 1; continue;
        }
        if (verb_found == 0) {
            if (is_flag == 1) {
                var r = _cmdit_take_flag(h, argc, argv, i, 0);
                if (r < 0) { return CMDIT_RESULT_ERR; }
                i = r; continue;
            }
            var vid = _cmdit_find_verb(h, tok);
            if (vid < 0) { return _cmdit_fail(h, CMDIT_ERR_UNKNOWN_VERB, 0, tok, 0); }
            store64(h + _CMDIT_H_VERB_MATCHED, vid);
            store64(rem + rn * 8, tok); rn = rn + 1;          # remainder[0] = verb name
            verb_found = 1;
            # vid is the verb's id even when an alias matched, so an alias
            # inherits the trailing behaviour of the verb it names.
            trailing_at = cmdit_verb_trailing_at(h, vid);
            i = i + 1; continue;
        }
        # after the verb
        #
        # 1.2.2: for a verb marked `cmdit_verb_trailing_after(n)`, stop treating
        # anything as a flag once n positionals have been seen. Without this a
        # GLOBAL flag appearing inside a forwarded command line is applied to the
        # host tool — `exec c1 mycmd --root /x` silently retargeted the caller's
        # data root, with no diagnostic and the payload none the wiser.
        if (trailing_at >= 0) {
            if (post_positionals >= trailing_at) { no_more_flags = 1; is_flag = 0; }
        }
        if (is_flag == 1) {
            # A global after the verb is applied here in one pass; anything else, the
            # auto --help / --version included, goes to the verb's scope (-2).
            var r2 = _cmdit_take_flag(h, argc, argv, i, 1);
            if (r2 == 0 - 1) { return CMDIT_RESULT_ERR; }
            if (r2 >= 0) { i = r2; continue; }
        }
        store64(rem + rn * 8, tok); rn = rn + 1;              # defer to the verb's scope
        # 1.3.2: only a non-flag token counts toward the trailing threshold. A
        # verb-scoped flag used to count, so in `exec --tty --root /x c1 ls` the
        # --tty met exec's one positional and the global --root fell into the
        # payload. A verb flag's separate value (`-w /app`) still counts, which
        # can only start the payload EARLIER than the verb's own parse does; a
        # global is never applied inside it. CHANGELOG [1.3.2].
        if (is_flag == 0) { post_positionals = post_positionals + 1; }
        i = i + 1;
    }
    store64(rem + rn * 8, 0);                                 # NULL-terminate the slice
    store64(h + _CMDIT_H_VERB_ARGV, rem);
    store64(h + _CMDIT_H_VERB_ARGC, rn);
    if (cmdit_get_bool(h, load64(h + _CMDIT_H_HELP_IDX)) == 1) { return CMDIT_HELP; }       # global help (pre-verb)
    if (cmdit_get_bool(h, load64(h + _CMDIT_H_VERSION_IDX)) == 1) { return CMDIT_VERSION; }
    return CMDIT_OK;
}

# Convenience: materialize the process argv, run the pure dispatch loop, then
# finalize the GLOBAL scope (so global env/required modifiers work). The verb
# analogue of cmdit_parse. help/version/error results propagate untouched.
fn cmdit_dispatch(h): i64 {
    if (h == 0) { return CMDIT_RESULT_ERR; }                      # 1.3.2: see _cmdit_h0
    var n = cmdit_argv(h);
    if (load64(h + _CMDIT_H_RAW_ARGV) == 0) { return CMDIT_RESULT_ERR; }         # 1.3.2: cmdit_argv set ARGV / NOMEM
    var r = cmdit_dispatch_argv(h, n, load64(h + _CMDIT_H_RAW_ARGV));
    if (r != CMDIT_OK) { return r; }
    return cmdit_finalize(h);
}

# Sugar: re-enter a verb (or sub-verb) scope — parse the parent's remainder slice
# with the child handle `vh`, then finalize it. Saves the argc/argv/finalize
# triple and is how nested sub-verbs dispatch (build vh with its own verbs, call
# cmdit_dispatch_argv(vh, cmdit_verb_argc(h), cmdit_verb_argv(h)) instead).
fn cmdit_parse_verb(vh, h): i64 {
    if (vh == 0) { return CMDIT_RESULT_ERR; }                     # 1.3.2: see _cmdit_h0
    if (h == 0) { return _cmdit_fail(vh, CMDIT_ERR_NOMEM, 0, 0, 0); }
    # 1.2.2: carry the dispatcher's trailing-verbatim mark onto the verb handle,
    # so the consumer declares it ONCE (on the top-level handle, where the verb
    # is registered) rather than having to repeat it per verb handle — and so it
    # cannot drift between the two parses.
    var vid = load64(h + _CMDIT_H_VERB_MATCHED);
    if (vid >= 0) {
        var t = cmdit_verb_trailing_at(h, vid);
        if (t >= 0) { store64(vh + _CMDIT_H_TRAILING, t + 1); }
    }
    var r = cmdit_parse_argv(vh, load64(h + _CMDIT_H_VERB_ARGC), load64(h + _CMDIT_H_VERB_ARGV));
    if (r != CMDIT_OK) { return r; }
    return cmdit_finalize(vh);
}

# Return an interior pointer to the basename of `path` (the char after the final
# '/'), or the whole string if no '/'. No alloc, no NUL written. For the argv[0]
# busybox multiplexer (with cmdit_raw_argv): caller compares cmdit_basename(argv0)
# against verb names. A trailing-slash path yields the empty tail (argv[0] never
# has one); str_from the result if a clean owned copy is needed.
fn cmdit_basename(path): i64 {
    if (path == 0) { return 0; }
    var last = path;
    var i = 0;
    while (load8(path + i) != 0) {
        if (load8(path + i) == 47) { last = path + i + 1; }
        i = i + 1;
    }
    return last;
}

# --- output: generated help / version / error -------------------------------

# --- 1.4.0: buffered output ---------------------------------------------------------
# Every renderer used to make one write(2) per fragment: 93 for one --help, 13 for one
# error line, and one per byte of quoted help in a completion script. Each public
# renderer now opens an output session; its fragments collect in this buffer, and the
# session ends with as few writes as the text needs, before the renderer returns, so
# the output still lands ahead of anything the caller writes next. An error line now
# reaches a pipe in one write, so a second process's stderr cannot split it.
# The buffer is allocated on the first session, not declared as a global array: a
# global `var b[4096]` adds 32 KB to every consumer's binary. If that allocation is
# refused, every write goes straight out, as before 1.4.0.
var _cmdit_ob = 0;
var _cmdit_ob_n = 0;
var _cmdit_ob_fd = 0 - 1;     # the open session's stream, -1 when there is none
var _cmdit_ob_depth = 0;

# Write all `n` bytes at `p` to `fd`. A pipe or terminal may take fewer per write(2),
# and an interrupted write (EINTR) is retried; any other error stops it, as an ignored
# write result always has. Returns 0, or -1 on that error.
fn _cmdit_write_all(fd, p, n): i64 {
    while (n > 0) {
        var w = syscall(1, fd, p, n);
        if (w == 0 - 4) { continue; }                             # EINTR
        if (w <= 0) { return 0 - 1; }
        p = p + w;
        n = n - w;
    }
    return 0;
}

# Write out what the session has collected.
fn _cmdit_flush(): i64 {
    if (_cmdit_ob_n > 0) {
        _cmdit_write_all(_cmdit_ob_fd, _cmdit_ob, _cmdit_ob_n);
        _cmdit_ob_n = 0;
    }
    return 0;
}

# Write `n` bytes at `p` to `fd`: into the buffer when a session is open on that
# stream, straight out otherwise. A piece larger than the buffer goes straight out
# after what is buffered, so the order holds.
fn _cmdit_write(fd, p, n): i64 {
    if (_cmdit_ob_depth == 0 || fd != _cmdit_ob_fd) { return _cmdit_write_all(fd, p, n); }
    if (_cmdit_ob == 0) { return _cmdit_write_all(fd, p, n); }
    if (_cmdit_ob_n + n > 4096) {
        _cmdit_flush();
        if (n > 4096) { return _cmdit_write_all(fd, p, n); }
    }
    var d = _cmdit_ob + _cmdit_ob_n;
    var i = 0;
    while (i < n) { store8(d + i, load8(p + i)); i = i + 1; }
    _cmdit_ob_n = _cmdit_ob_n + n;
    return 0;
}

# Open an output session on `fd`. Sessions nest (cmdit_help_fd renders through
# cmdit_help_flags_fd, cmdit_print_error through cmdit_verbs_help). Returns the
# enclosing session's stream, which _cmdit_out_end takes back.
fn _cmdit_out_begin(fd): i64 {
    if (_cmdit_ob == 0) { _cmdit_ob = alloc(4096); }
    var prev = _cmdit_ob_fd;
    if (_cmdit_ob_depth > 0 && prev != fd) { _cmdit_flush(); }
    _cmdit_ob_fd = fd;
    _cmdit_ob_depth = _cmdit_ob_depth + 1;
    return prev;
}

# Close the session `_cmdit_out_begin` opened, flushing it unless the enclosing session
# continues on the same stream. The outermost session's `prev` is -1, never a stream,
# so it always flushes.
fn _cmdit_out_end(prev): i64 {
    _cmdit_ob_depth = _cmdit_ob_depth - 1;
    if (prev != _cmdit_ob_fd) { _cmdit_flush(); }
    _cmdit_ob_fd = prev;
    return 0;
}

fn _cmdit_eprint(s): i64 { _cmdit_write(2, s, strlen(s)); return 0; }   # -> stderr
fn _cmdit_oprint(s): i64 { _cmdit_write(1, s, strlen(s)); return 0; }   # -> stdout

# Write an argv-derived string to `fd` with every control byte (< 0x20) and DEL
# shown as '?', so a token cannot put terminal escape sequences into whatever reads
# the output (a terminal, a log, CI). UTF-8 bytes (>= 0x80) pass through, so
# non-ASCII names stay legible. The convention owl adopted for its own error lines
# (its audit FINDING-002). Runs of safe bytes go out in one write. 1.3.3.
fn _cmdit_print_esc(fd, s): i64 {
    if (s == 0) { return 0; }
    var i = 0;
    var run = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c < 32 || c == 127) {
            if (i > run) { _cmdit_write(fd, s + run, i - run); }
            _cmdit_write(fd, "?", 1);
            run = i + 1;
        }
        i = i + 1;
    }
    if (i > run) { _cmdit_write(fd, s + run, i - run); }
    return 0;
}

# ": <text>" to stderr, escaped, when `s` is set — the offending-token tail.
fn _cmdit_eprint_tail(s): i64 {
    if (s == 0) { return 0; }
    _cmdit_eprint(": ");
    _cmdit_print_esc(2, s);
    return 0;
}

# " '<text>'" to stderr, escaped, when `s` is set — a rejected value, quoted.
fn _cmdit_eprint_quoted(s): i64 {
    if (s == 0) { return 0; }
    _cmdit_eprint(" '");
    _cmdit_print_esc(2, s);
    _cmdit_eprint("'");
    return 0;
}

# Write a cstr to `fd` (1.3.5: the renderers take their stream).
fn _cmdit_fprint(fd, s): i64 { _cmdit_write(fd, s, strlen(s)); return 0; }

# Generated flag-list rows to `fd` — just the "  -x, --long <type>\thelp" lines,
# with NO "Usage:" / "Options:" header and NO verb list. For tools that frame their
# own help (a brand intro / custom usage synopsis / an Examples block) around a
# *generated* flag list: print your prose yourself and call this for the rows.
# (1.1.0 — the table-only renderer the rich-help consumer cohort, e.g. anuenue,
# needs.) 1.3.5: `fd` selects the stream. The survey found 14 of 18 candidate tools
# printing --help on stdout, the GNU convention, so pass 1 for that.
# cmdit_help_flags(h) is this on stderr, unchanged.
fn cmdit_help_flags_fd(h, fd): i64 {
    if (h == 0) { return 0; }                                     # 1.3.2: see _cmdit_h0
    var prev = _cmdit_out_begin(fd);                              # 1.4.0
    var count = load64(h + _CMDIT_H_COUNT);
    var i = 0;
    while (i < count) {
        var ep = _cmdit_entry(h, i);
        var short_ch = load64(ep);
        var long_name = load64(ep + _CMDIT_E_LONG);
        var type = load64(ep + _CMDIT_E_TYPE);
        var help = load64(ep + _CMDIT_E_HELP);
        var alias = load64(ep + _CMDIT_E_ALIAS);                             # 1.3.6: cmdit_long_alias
        _cmdit_fprint(fd, "  ");
        if (short_ch != 0) {
            var sbuf[2];
            store8(&sbuf, short_ch);
            store8(&sbuf + 1, 0);
            _cmdit_fprint(fd, "-");
            _cmdit_write(fd, &sbuf, 1);
            if (long_name != 0 || alias != 0) { _cmdit_fprint(fd, ", "); }
        } else {
            _cmdit_fprint(fd, "    ");
        }
        if (long_name != 0) { _cmdit_fprint(fd, "--"); _cmdit_fprint(fd, long_name); }
        if (alias != 0) {
            if (long_name != 0) { _cmdit_fprint(fd, ", "); }
            _cmdit_fprint(fd, "--");
            _cmdit_fprint(fd, alias);
        }
        var choices = load64(ep + _CMDIT_E_CHOICES);
        var attrs = load64(ep + _CMDIT_E_ATTRS);
        var metavar = load64(ep + _CMDIT_E_METAVAR);
        # 1.0.0 metavar wins over the auto placeholder.
        if (metavar != 0 && type != CMDIT_BOOL) {
            _cmdit_fprint(fd, " <"); _cmdit_fprint(fd, metavar); _cmdit_fprint(fd, ">");
        }
        elif (choices != 0) { _cmdit_fprint(fd, " <"); _cmdit_fprint(fd, choices); _cmdit_fprint(fd, ">"); }
        elif (type == CMDIT_INT) { _cmdit_fprint(fd, " <int>"); }
        elif (type == CMDIT_STR) { _cmdit_fprint(fd, " <str>"); }
        if ((attrs & CMDIT_ATTR_REPEAT) != 0) { _cmdit_fprint(fd, "..."); }       # repeatable
        if (help != 0) { _cmdit_fprint(fd, "\t"); _cmdit_fprint(fd, help); }
        # 1.0.0 shown default — cstr only; ints would need fmt, which the
        # output path deliberately does not link.
        if (type == CMDIT_STR) {
            var dv = load64(ep + _CMDIT_E_DEFAULT);
            if (dv != 0) { _cmdit_fprint(fd, " (default: "); _cmdit_fprint(fd, dv); _cmdit_fprint(fd, ")"); }
        }
        if ((attrs & CMDIT_ATTR_REQUIRED) != 0) { _cmdit_fprint(fd, " (required)"); }
        _cmdit_fprint(fd, "\n");
        i = i + 1;
    }
    _cmdit_out_end(prev);
    return 0;
}

# The flag rows on stderr (1.1.0). Same output as cmdit_help_flags_fd(h, 2).
fn cmdit_help_flags(h): i64 { return cmdit_help_flags_fd(h, 2); }

# Generated usage to `fd`: "Usage: <prog> [options]" + the auto-enumerated flag list
# (kills hand-written-help drift) + the visible verb list. Callers wanting custom
# framing call `cmdit_help_flags_fd` directly instead. 1.3.5: `fd` selects the
# stream; for `--help` on stdout, pass 1.
fn cmdit_help_fd(h, fd): i64 {
    if (h == 0) { return 0; }                                     # 1.3.2: see _cmdit_h0
    var prev = _cmdit_out_begin(fd);                              # 1.4.0
    var prog = load64(h + _CMDIT_H_PROG);
    _cmdit_fprint(fd, "Usage: ");
    _cmdit_print_esc(fd, prog);                                   # 1.3.3: argv[0] on the cmdit_new(0) path
    _cmdit_fprint(fd, " [options] [args]\n\nOptions:\n");
    cmdit_help_flags_fd(h, fd);
    if (load64(h + _CMDIT_H_VERBS) != 0) { cmdit_verbs_help_fd(h, fd); }      # append the verb list, if any
    _cmdit_out_end(prev);
    return 0;
}

# The usage block on stderr. Output unchanged since 1.0.0; same as cmdit_help_fd(h, 2).
fn cmdit_help(h): i64 { return cmdit_help_fd(h, 2); }

# Generated verb listing to `fd` ("\nCommands:\n  <name>\t<help>\n..."), skipping
# alias rows and (1.3.5) hidden verbs. Nothing is printed when no verb is visible.
# Appended by cmdit_help_fd, and printed by cmdit_print_error on an unknown verb,
# so the command list never drifts from registration.
fn cmdit_verbs_help_fd(h, fd): i64 {
    if (h == 0) { return 0; }                                     # 1.3.2: see _cmdit_h0
    var vp = load64(h + _CMDIT_H_VERBS);
    if (vp == 0) { return 0; }
    var prev = _cmdit_out_begin(fd);                              # 1.4.0
    var count = load64(h + _CMDIT_H_VERBS_COUNT);
    var shown = 0;
    var i = 0;
    while (i < count) {
        var row = _cmdit_verb_row(h, i);
        # A real verb (alias rows' canonical id is an earlier row) that is not hidden.
        if (load64(row + _CMDIT_V_CANON) == i && load64(row + _CMDIT_V_HIDDEN) == 0) {
            if (shown == 0) { _cmdit_fprint(fd, "\nCommands:\n"); }
            shown = 1;
            var nm = load64(row);
            var hp = load64(row + _CMDIT_V_HELP);
            _cmdit_fprint(fd, "  ");
            if (nm != 0) { _cmdit_fprint(fd, nm); }
            if (hp != 0) { _cmdit_fprint(fd, "\t"); _cmdit_fprint(fd, hp); }
            _cmdit_fprint(fd, "\n");
        }
        i = i + 1;
    }
    _cmdit_out_end(prev);
    return 0;
}

# The verb listing on stderr; same as cmdit_verbs_help_fd(h, 2).
fn cmdit_verbs_help(h): i64 { return cmdit_verbs_help_fd(h, 2); }

# Standard --version output to STDOUT: "<prog> <version_str>\n" (machine-readable
# first line). Returns CMDIT_EXIT_OK for direct `return`.
fn cmdit_version(h, version_str): i64 {
    var prog = 0;
    if (h != 0) { prog = load64(h + _CMDIT_H_PROG); }                        # 1.3.2: see _cmdit_h0
    var prev = _cmdit_out_begin(1);                               # 1.4.0
    if (prog != 0) { _cmdit_print_esc(1, prog); _cmdit_oprint(" "); }   # 1.3.3: escaped (argv[0])
    if (version_str != 0) { _cmdit_oprint(version_str); }
    _cmdit_oprint("\n");
    _cmdit_out_end(prev);
    return CMDIT_EXIT_OK;
}

# Print the offending flag's name ("--long" preferred, else "-x") to stderr, if
# err_entry names one. The flag-naming the survey found near-universal on
# validation errors (agora/bannermanor/cyim/attn11).
fn _cmdit_eprint_flag(ep): i64 {
    if (ep == 0) { return 0; }
    var ln = load64(ep + _CMDIT_E_LONG);
    if (ln != 0) { _cmdit_eprint("--"); _cmdit_eprint(ln); _cmdit_eprint(": "); return 0; }
    var sc = load64(ep);
    if (sc != 0) {
        var sb[2];
        store8(&sb, sc);
        store8(&sb + 1, 0);
        _cmdit_eprint("-");
        _cmdit_write(2, &sb, 1);
        _cmdit_eprint(": ");
    }
    return 0;
}

# Decode the last error into a standard "<prog>: [<flag>: ]<message>" stderr line.
# Absorbs the FlagErr->message switch kii/anuenue/bannermanor copy verbatim, and
# (0.2.0) names the offending flag for value/modifier errors + lists the enum set.
#
# 1.3.3: the line also carries what the user typed (cmdit_err_token /
# cmdit_err_value): `unknown flag: --bogus`, `--count: invalid integer value
# 'abc'`, `-vx: bundled/...`, `too many arguments: extra`. Every argv-derived byte
# (the program name on the cmdit_new(0) path, the token, the value) is written
# through _cmdit_print_esc. CHANGELOG [1.3.3]. Returns CMDIT_EXIT_USAGE for direct
# `return`.
fn cmdit_print_error(h): i64 {
    var prog = 0;
    var e = CMDIT_ERR_NOMEM;                                      # 1.3.2: a 0 handle is cmdit_new's OOM
    var ep = 0;
    var tok = 0;
    var val = 0;
    if (h != 0) {
        prog = load64(h + _CMDIT_H_PROG);
        e = load64(h + _CMDIT_H_ERR);
        ep = load64(h + _CMDIT_H_ERR_ENTRY);
        tok = load64(h + _CMDIT_H_ERR_TOKEN);
        val = load64(h + _CMDIT_H_ERR_VALUE);
    }
    var prev = _cmdit_out_begin(2);                               # 1.4.0: one write per line
    if (prog != 0) { _cmdit_print_esc(2, prog); _cmdit_eprint(": "); }
    if (e == CMDIT_ERR_BUNDLED) {
        if (tok != 0) { _cmdit_print_esc(2, tok); _cmdit_eprint(": "); }   # the token is the subject
    } elif (e != CMDIT_ERR_UNKNOWN) { _cmdit_eprint_flag(ep); }
    if (e == CMDIT_ERR_UNKNOWN) { _cmdit_eprint("unknown flag"); _cmdit_eprint_tail(tok); }
    elif (e == CMDIT_ERR_MISSING_VALUE) { _cmdit_eprint("missing value"); }
    elif (e == CMDIT_ERR_BAD_INT) { _cmdit_eprint("invalid integer value"); _cmdit_eprint_quoted(val); }
    elif (e == CMDIT_ERR_BUNDLED) { _cmdit_eprint("bundled/attached short flags not supported (use -x -y)"); }
    elif (e == CMDIT_ERR_REQUIRED_MISSING) { _cmdit_eprint("required flag missing"); }
    elif (e == CMDIT_ERR_BAD_ENUM) {
        _cmdit_eprint("invalid value");
        _cmdit_eprint_quoted(val);
        if (ep != 0) {
            var ch = load64(ep + _CMDIT_E_CHOICES);
            if (ch != 0) { _cmdit_eprint(" (expected "); _cmdit_eprint(ch); _cmdit_eprint(")"); }
        }
    }
    elif (e == CMDIT_ERR_OUT_OF_RANGE) {
        _cmdit_eprint("value");
        _cmdit_eprint_quoted(val);
        _cmdit_eprint(" out of range");
    }
    elif (e == CMDIT_ERR_UNKNOWN_VERB) { _cmdit_eprint("unknown command"); _cmdit_eprint_tail(tok); }
    elif (e == CMDIT_ERR_MISSING_POSITIONAL) { _cmdit_eprint("missing required argument"); }
    elif (e == CMDIT_ERR_TOO_MANY_POSITIONAL) { _cmdit_eprint("too many arguments"); _cmdit_eprint_tail(tok); }
    elif (e == CMDIT_ERR_UNEXPECTED_VALUE) {
        _cmdit_eprint("option takes no value");
        if (val != 0) { _cmdit_eprint(" (got"); _cmdit_eprint_quoted(val); _cmdit_eprint(")"); }
    }
    elif (e == CMDIT_ERR_NOMEM) { _cmdit_eprint("out of memory"); }
    elif (e == CMDIT_ERR_ARGV) { _cmdit_eprint("could not read the full command line"); }
    elif (e == CMDIT_ERR_REPEATED) { _cmdit_eprint("may be given only once"); }
    else { _cmdit_eprint("argument error"); }
    _cmdit_eprint("\n");
    if (e == CMDIT_ERR_UNKNOWN_VERB) { cmdit_verbs_help(h); }     # list the valid commands
    _cmdit_out_end(prev);
    return CMDIT_EXIT_USAGE;
}

# ══ Verb introspection + shell completions (1.2.0) ═══════
#
# The verb table already drove `cmdit_verbs_help`, but nothing exposed it, so a
# consumer could not generate shell completions from the very verbs it had just
# registered — it had to keep a second, hand-maintained list that drifts. These
# accessors plus `cmdit_completions` close that: the completion script is a
# projection of the parser's own state, so it cannot disagree with it.

# Total verb rows, INCLUDING alias rows. Iterate 0..count and filter with
# cmdit_verb_is_alias when you want canonical verbs only.
#[must_use]
fn cmdit_verb_count(h): i64 {
    if (h == 0) { return 0; }
    if (load64(h + _CMDIT_H_VERBS) == 0) { return 0; }
    return load64(h + _CMDIT_H_VERBS_COUNT);
}

#[must_use]
fn cmdit_verb_name_at(h, i): i64 {
    if (i < 0 || i >= cmdit_verb_count(h)) { return 0; }
    return load64(_cmdit_verb_row(h, i));
}

# An alias row carries no help text of its own; this returns the CANONICAL
# verb's help, so a caller listing aliases still has something to show.
#[must_use]
fn cmdit_verb_help_at(h, i): i64 {
    if (i < 0 || i >= cmdit_verb_count(h)) { return 0; }
    var row = _cmdit_verb_row(h, i);
    var help = load64(row + _CMDIT_V_HELP);
    if (help != 0) { return help; }
    var canon = load64(row + _CMDIT_V_CANON);
    if (canon == i) { return 0; }
    return load64(_cmdit_verb_row(h, canon) + _CMDIT_V_HELP);
}

# 1 when row `i` is an alias of another verb (its canonical id is not its own
# index — the same test cmdit_verbs_help uses to skip alias rows).
#[must_use]
fn cmdit_verb_is_alias(h, i): i64 {
    if (i < 0 || i >= cmdit_verb_count(h)) { return 0; }
    if (load64(_cmdit_verb_row(h, i) + _CMDIT_V_CANON) == i) { return 0; }
    return 1;
}

#[must_use]
fn cmdit_verb_canonical_at(h, i): i64 {
    if (i < 0 || i >= cmdit_verb_count(h)) { return 0 - 1; }
    return load64(_cmdit_verb_row(h, i) + _CMDIT_V_CANON);
}

# Hide a verb (1.3.5): it still dispatches (cmdit_verb_matched, its aliases, its
# trailing mark), but it is left out of cmdit_help / cmdit_verbs_help, out of the
# command list cmdit_print_error shows for an unknown verb, and out of all three
# completion scripts. Its aliases are hidden with it. For maintenance or
# diagnostic commands a tool keeps out of its advertised surface (hoosh `bench`).
# An alias row resolves to its verb. Returns the verb's id for chaining, or -1.
fn cmdit_verb_hidden(h, verb_id): i64 {
    verb_id = cmdit_verb_canonical_at(h, verb_id);
    if (verb_id < 0) { return 0 - 1; }
    store64(_cmdit_verb_row(h, verb_id) + _CMDIT_V_HIDDEN, 1);
    return verb_id;
}

# 1 when verb row `i` is hidden, or is an alias of a hidden verb; else 0.
#[must_use]
fn cmdit_verb_is_hidden(h, i): i64 {
    var canon = cmdit_verb_canonical_at(h, i);
    if (canon < 0) { return 0; }
    return load64(_cmdit_verb_row(h, canon) + _CMDIT_V_HIDDEN);
}

# Attach a verb's own flag handle (1.3.7): `vh` is the cmdit_new handle the caller
# re-parses cmdit_verb_argv with once this verb is matched. cmdit_completions then
# completes that verb's flags after its name, the per-verb lists ark kept by hand in
# completions/ark.bash. Dispatch is unchanged: cmdit stores the handle and never
# parses with it. cmdit_verb_flags_at reads it back, so a tool can build its verb
# handles up front and take the matched one after dispatch. One level only: verbs
# registered on `vh` are not completed. An alias row resolves to its verb, and
# `vh` = 0 detaches. Returns the verb's id for chaining, or -1.
fn cmdit_verb_flags(h, verb_id, vh): i64 {
    verb_id = cmdit_verb_canonical_at(h, verb_id);
    if (verb_id < 0) { return 0 - 1; }
    store64(_cmdit_verb_row(h, verb_id) + _CMDIT_V_FLAGS, vh);
    return verb_id;
}

# The flag handle attached to verb row `i` (through an alias row to its verb), or 0.
#[must_use]
fn cmdit_verb_flags_at(h, i): i64 {
    var canon = cmdit_verb_canonical_at(h, i);
    if (canon < 0) { return 0; }
    return load64(_cmdit_verb_row(h, canon) + _CMDIT_V_FLAGS);
}

# ══ Flag-table introspection (1.3.7) ═══════
#
# The flag-table twin of the verb accessors above: read back what was registered,
# for a tool that renders its own help (kriya's OPTIONS page and `--help=json`) or
# scans argv before cmdit parses it (kriya's `-n5` cluster expander). kriya read the
# stdlib flags table's memory layout to do both; these read the table the parser
# reads, through a supported surface. `i` runs over 0..cmdit_flag_count in
# registration order, and cmdit_new registers the auto --help and --version first,
# as rows 0 and 1. A bad handle or index gives 0, or -1 where 0 is a real answer.
# Each accessor returns what was REGISTERED; the parsed values stay with cmdit_get_*.

# Registered flags, the auto --help and --version included.
#[must_use]
fn cmdit_flag_count(h): i64 {
    if (h == 0) { return 0; }
    return load64(h + _CMDIT_H_COUNT);
}

# The short letter as an ASCII byte, or 0 for none.
#[must_use]
fn cmdit_flag_short_at(h, i): i64 {
    if (_cmdit_idx_ok(h, i) == 0) { return 0; }
    return load64(_cmdit_entry(h, i));
}

# The long name (cstr, without the `--`), or 0 for none.
#[must_use]
fn cmdit_flag_long_at(h, i): i64 {
    if (_cmdit_idx_ok(h, i) == 0) { return 0; }
    return load64(_cmdit_entry(h, i) + _CMDIT_E_LONG);
}

# The second long name from cmdit_long_alias, or 0 for none.
#[must_use]
fn cmdit_flag_long_alias_at(h, i): i64 {
    if (_cmdit_idx_ok(h, i) == 0) { return 0; }
    return load64(_cmdit_entry(h, i) + _CMDIT_E_ALIAS);
}

# CMDIT_BOOL, CMDIT_INT or CMDIT_STR, or -1 for a bad index. An enum or repeat
# flag is CMDIT_STR; cmdit_flag_choices_at and cmdit_flag_is_repeat tell them apart.
#[must_use]
fn cmdit_flag_type_at(h, i): i64 {
    if (_cmdit_idx_ok(h, i) == 0) { return 0 - 1; }
    return load64(_cmdit_entry(h, i) + _CMDIT_E_TYPE);
}

# The help text, or 0 for none.
#[must_use]
fn cmdit_flag_help_at(h, i): i64 {
    if (_cmdit_idx_ok(h, i) == 0) { return 0; }
    return load64(_cmdit_entry(h, i) + _CMDIT_E_HELP);
}

# The registered default: an int for CMDIT_INT, a cstr (or 0) for CMDIT_STR, 0 for
# a bool. Not the parsed value, which cmdit_get_* gives.
#[must_use]
fn cmdit_flag_default_at(h, i): i64 {
    if (_cmdit_idx_ok(h, i) == 0) { return 0; }
    return load64(_cmdit_entry(h, i) + _CMDIT_E_DEFAULT);
}

# The choice list of a cmdit_enum flag as registered ("a|b|c"), or 0 when the flag
# is not an enum.
#[must_use]
fn cmdit_flag_choices_at(h, i): i64 {
    if (_cmdit_idx_ok(h, i) == 0) { return 0; }
    return load64(_cmdit_entry(h, i) + _CMDIT_E_CHOICES);
}

# The help placeholder from cmdit_metavar, or 0 for the default one.
#[must_use]
fn cmdit_flag_metavar_at(h, i): i64 {
    if (_cmdit_idx_ok(h, i) == 0) { return 0; }
    return load64(_cmdit_entry(h, i) + _CMDIT_E_METAVAR);
}

# 1 when the flag was marked cmdit_required, else 0.
#[must_use]
fn cmdit_flag_is_required(h, i): i64 {
    if (_cmdit_idx_ok(h, i) == 0) { return 0; }
    if ((load64(_cmdit_entry(h, i) + _CMDIT_E_ATTRS) & CMDIT_ATTR_REQUIRED) != 0) { return 1; }
    return 0;
}

# 1 when the flag was registered with cmdit_repeat, else 0.
#[must_use]
fn cmdit_flag_is_repeat(h, i): i64 {
    if (_cmdit_idx_ok(h, i) == 0) { return 0; }
    if ((load64(_cmdit_entry(h, i) + _CMDIT_E_ATTRS) & CMDIT_ATTR_REPEAT) != 0) { return 1; }
    return 0;
}

# Index of the flag the parser resolves `-<ch>` to, or -1. The first registration
# wins when two flags share a letter, as it does in the parser, and 0 is never a
# letter (_cmdit_find_short refuses it), so it does not find a flag without one.
#[must_use]
fn cmdit_flag_find_short(h, ch): i64 {
    if (h == 0) { return 0 - 1; }
    var ep = _cmdit_find_short(h, ch);
    if (ep == 0) { return 0 - 1; }
    return (ep - load64(h)) / _CMDIT_ENTRY_SZ;
}

# Index of the flag whose long name, or second long name, is the `len` bytes at
# `name`, or -1. This is the parser's own `--name` lookup, so the span of
# `--name=value` up to the '=' finds the flag, with no copy. `len` is a byte count
# the caller vouches for: a NUL inside it matches nothing, and a negative one is -1.
#[must_use]
fn cmdit_flag_find_long(h, name, len): i64 {
    if (h == 0) { return 0 - 1; }
    if (name == 0) { return 0 - 1; }
    if (len < 0) { return 0 - 1; }
    # The span must hold no NUL. _cmdit_streq_bounded compares `len` bytes before it
    # checks the registered name's end, so an embedded NUL would let it read past a
    # shorter name; with none, the compare fails at that name's terminator.
    var j = 0;
    while (j < len) {
        if (load8(name + j) == 0) { return 0 - 1; }
        j = j + 1;
    }
    var ep = _cmdit_find_long(h, name, len);
    if (ep == 0) { return 0 - 1; }
    return (ep - load64(h)) / _CMDIT_ENTRY_SZ;
}

# Emit `s` to stdout with every `'` escaped for a single-quoted shell string.
# Help text is caller-supplied prose, and an apostrophe in it would otherwise
# terminate the quoting and inject the remainder into the generated script.
fn _cmdit_oprint_sq(s): i64 {
    if (s == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c == 39) { _cmdit_oprint("'\\''"); }
        else {
            var b[2];
            store8(&b, c);
            store8(&b + 1, 0);
            _cmdit_write(1, &b, 1);
        }
        i = i + 1;
    }
    return 0;
}

# Emit `s` for a single-quoted FISH string (1.3.7). fish, unlike the POSIX shells,
# reads two escapes inside single quotes, `\'` and `\\`, so a help text ending in a
# backslash turned the closing quote into a literal one and left everything after
# it to be parsed as script, up to the next quote. The backslash is doubled; the
# apostrophe takes the `'\''` form _cmdit_oprint_sq uses, which fish reads the same.
fn _cmdit_oprint_fish_sq(s): i64 {
    if (s == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c == 39) { _cmdit_oprint("'\\''"); }
        elif (c == 92) { _cmdit_oprint("\\\\"); }
        else {
            var b[2];
            store8(&b, c);
            store8(&b + 1, 0);
            _cmdit_write(1, &b, 1);
        }
        i = i + 1;
    }
    return 0;
}

# Emit `s` with everything outside [A-Za-z0-9_] replaced by '_' — a shell
# function name has to be an identifier, and a prog_name may be a path or carry
# a dash.
fn _cmdit_oprint_ident(s): i64 {
    if (s == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        var ok = 0;
        if (c >= 48 && c <= 57) { ok = 1; }
        if (c >= 65 && c <= 90) { ok = 1; }
        if (c >= 97 && c <= 122) { ok = 1; }
        if (c == 95) { ok = 1; }
        var b[2];
        if (ok == 1) { store8(&b, c); } else { store8(&b, 95); }
        store8(&b + 1, 0);
        _cmdit_write(1, &b, 1);
        i = i + 1;
    }
    return 0;
}

# Emit `s` as a shell COMMAND WORD: every byte outside [A-Za-z0-9_.-] is replaced
# by '_'. The surviving alphabet contains no shell metacharacter, no quote, no
# whitespace and no newline, so the result is always exactly one inert word.
#
# ⚠ This guards the PROGRAM NAME, which is attacker-controlled on the documented
# `cmdit_new(0)` path: prog_name there is adopted from argv[0] (see
# cmdit_parse_argv / cmdit_dispatch_argv), and argv[0] is chosen by whoever
# execs the tool. Before 1.2.4 `prog` was interpolated RAW into every emitter —
# `# bash completion for <prog>`, `complete -F _<x>_complete <prog>`,
# `#compdef <prog>`, `complete -c <prog>` — so an argv[0] of
# "tool\ntouch /tmp/x\n#" closed the comment and left a bare command line in a
# script whose whole purpose is to be sourced. Verified: the generated file
# passed `bash -n` and ran the injected command on `source`. CHANGELOG [1.2.4].
#
# 1.2.1 whitelisted verb and long-flag names for the same class of reason and
# named the program name in its own notes, but only ever routed it through
# `_cmdit_oprint_ident` for the FUNCTION name — the command-word occurrences
# were left raw. Dropping the name entirely (the 1.2.1 verb-name remedy) is not
# an option here: a completion script with no command to attach to is useless,
# so this maps rather than drops. '.' and '-' are kept because real program
# names carry them (`cmdit-smoke`, `foo.sh`) and neither is a shell
# metacharacter in command-word position.
# 1 when byte `c` may appear verbatim in an emitted shell command word.
# The alphabet is [A-Za-z0-9_.-] — deliberately a whitelist, so a byte that is
# not enumerated here cannot reach a generated script whatever it is. Split out
# from the emitter so the suite can assert it over all 256 byte values rather
# than eyeballing a generated script for the metacharacters someone thought of.
#[must_use]
fn _cmdit_is_cmdname_byte(c): i64 {
    if (c >= 48 && c <= 57) { return 1; }     # 0-9
    if (c >= 65 && c <= 90) { return 1; }     # A-Z
    if (c >= 97 && c <= 122) { return 1; }    # a-z
    if (c == 95) { return 1; }                # _
    if (c == 46) { return 1; }                # .
    if (c == 45) { return 1; }                # -
    return 0;
}

#
# 1.3.2 SECURITY: a LEADING '-' is mapped too. '-' is inert mid-word, but as the
# first byte of the name it is read as OPTIONS by bash's `complete`, fish's
# `complete -c` and zsh's `#compdef`. With argv[0] = "-DCtrue", 1.3.1 emitted
# `complete -F __DCtrue_complete -DCtrue`; sourcing it bundled to `-D -C true` and
# replaced the user's DEFAULT completion with a PATH command run at every TAB.
# Verified: `complete -p -D` printed `complete -C 'true' -F __DCtrue_complete -D`.
# Real program names never start with '-'. CHANGELOG [1.3.2].
fn _cmdit_oprint_cmdname(s): i64 {
    if (s == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        var b[2];
        if (_cmdit_is_cmdname_byte(c) == 1) { store8(&b, c); } else { store8(&b, 95); }
        if (i == 0 && c == 45) { store8(&b, 95); }
        store8(&b + 1, 0);
        _cmdit_write(1, &b, 1);
        i = i + 1;
    }
    return 0;
}

# 1 when every byte of `s` is in [A-Za-z0-9_.-] — the shape a verb or flag name
# actually takes.
#
# This is a WHITELIST, not an escape, because `compgen -W "$verbs"` re-expands
# each word: a `$(...)` or a backtick inside a name executes at TAB time even
# when the surrounding single-quoting is correct. Escaping cannot fix that;
# only refusing the byte can. A name that fails is dropped from the completion
# rather than emitted — a missing completion is a papercut, a command
# substitution running in the user's shell is not.
#[must_use]
fn _cmdit_name_is_safe(s): i64 {
    if (s == 0) { return 0; }
    if (load8(s) == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        # 1.2.4: same alphabet as the command-word sanitiser, one definition.
        if (_cmdit_is_cmdname_byte(load8(s + i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Space-separated verb names, aliases included (a user who types an alias should
# still get it completed). Unsafe names and (1.3.5) hidden verbs are omitted.
fn _cmdit_oprint_verb_words(h): i64 {
    var count = cmdit_verb_count(h);
    var i = 0;
    var first = 1;
    while (i < count) {
        var nm = cmdit_verb_name_at(h, i);
        if (nm != 0 && _cmdit_name_is_safe(nm) == 1 && cmdit_verb_is_hidden(h, i) == 0) {
            if (first == 0) { _cmdit_oprint(" "); }
            _cmdit_oprint(nm);
            first = 0;
        }
        i = i + 1;
    }
    return 0;
}

# 1 when `c` is [A-Za-z0-9], the bytes a short flag may be emitted as.
fn _cmdit_is_alnum(c): i64 {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    return 0;
}

# Emit, space-separated, every spelling of a value-taking flag: `--long` and `-x`.
# The completion skips the word after any of them when locating the verb.
# 1.3.2: the short form is included. Without it, `tool -j 5 <TAB>` took 5 for the
# verb, the short-flag twin of the long-flag bug 1.2.1 fixed. `sep` is 1 when a
# separator is owed before the first word. Returns the updated `sep`.
fn _cmdit_oprint_value_spellings(ep, sep): i64 {
    var ln = load64(ep + _CMDIT_E_LONG);
    if (ln != 0 && _cmdit_name_is_safe(ln) == 1) {
        if (sep == 1) { _cmdit_oprint(" "); }
        _cmdit_oprint("--");
        _cmdit_oprint(ln);
        sep = 1;
    }
    var al = load64(ep + _CMDIT_E_ALIAS);                                    # 1.3.6: the second long name
    if (al != 0 && _cmdit_name_is_safe(al) == 1) {
        if (sep == 1) { _cmdit_oprint(" "); }
        _cmdit_oprint("--");
        _cmdit_oprint(al);
        sep = 1;
    }
    var sc = load64(ep);
    if (_cmdit_is_alnum(sc) == 1) {
        var b[2];
        store8(&b, sc);
        store8(&b + 1, 0);
        if (sep == 1) { _cmdit_oprint(" "); }
        _cmdit_oprint("-");
        _cmdit_write(1, &b, 1);
        sep = 1;
    }
    return sep;
}

# Space-separated spellings of the flags that TAKE A VALUE (see above).
fn _cmdit_oprint_valueflag_words(h): i64 {
    var count = load64(h + _CMDIT_H_COUNT);
    var i = 0;
    var sep = 0;
    while (i < count) {
        var ep = _cmdit_entry(h, i);
        if (load64(ep + _CMDIT_E_TYPE) != CMDIT_BOOL) { sep = _cmdit_oprint_value_spellings(ep, sep); }
        i = i + 1;
    }
    return 0;
}

# One `--name` word for the flag-word list below, when `nm` passes the whitelist.
# `n` is the count so far (a separator is owed when it is > 0). Writes only when
# `emit` is 1. Returns the new count.
fn _cmdit_flag_word(nm, n, emit): i64 {
    if (_cmdit_name_is_safe(nm) == 0) { return n; }
    if (emit == 1) {
        if (n > 0) { _cmdit_oprint(" "); }
        _cmdit_oprint("--");
        _cmdit_oprint(nm);
    }
    return n + 1;
}

# Space-separated `--long` words registered on `h`, both long names of each flag.
# 1.3.7: `skip_auto` leaves out h's own --help and --version, and `emit` = 0 only
# counts, so a caller can decide whether to open a completion arm before writing it.
# Returns the number of words.
fn _cmdit_flag_words(h, skip_auto, emit): i64 {
    var count = load64(h + _CMDIT_H_COUNT);
    var n = 0;
    var i = 0;
    while (i < count) {
        var ep = _cmdit_entry(h, i);
        if (skip_auto == 0 || _cmdit_is_auto(h, ep) == 0) {
            n = _cmdit_flag_word(load64(ep + _CMDIT_E_LONG), n, emit);
            n = _cmdit_flag_word(load64(ep + _CMDIT_E_ALIAS), n, emit);       # 1.3.6: the second long name
        }
        i = i + 1;
    }
    return n;
}

# Space-separated `--long` flags registered on `h`.
fn _cmdit_oprint_flag_words(h): i64 {
    _cmdit_flag_words(h, 0, 1);
    return 0;
}

# --- 1.3.7 per-verb flags in completions ---------------------------------------
# A verb with cmdit_verb_flags attached gets its own flag list after its name. A
# handle on which no visible verb has one emits exactly the 1.3.6 scripts.

# The flag handle verb row `i` opens a completion arm for, or 0: a visible verb
# with cmdit_verb_flags attached. An alias row never has one of its own, because
# cmdit_verb_flags stores on the verb's row, so its aliases join that verb's arm.
fn _cmdit_verb_arm(h, i): i64 {
    if (cmdit_verb_is_hidden(h, i) == 1) { return 0; }
    return load64(_cmdit_verb_row(h, i) + _CMDIT_V_FLAGS);
}

# 1 when some row opens an arm, which switches the bash and zsh emitters to the
# layout that remembers the verb.
fn _cmdit_has_verb_flags(h): i64 {
    var count = cmdit_verb_count(h);
    var i = 0;
    while (i < count) {
        if (_cmdit_verb_arm(h, i) != 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The whitelisted names that select verb `v`, its own and then its aliases' in row
# order, joined by the cstr `sep`. Writes only when `emit` is 1. Returns how many.
fn _cmdit_verb_selectors(h, v, sep, emit): i64 {
    var count = cmdit_verb_count(h);
    var n = 0;
    var i = 0;
    while (i < count) {
        var row = _cmdit_verb_row(h, i);
        if (load64(row + _CMDIT_V_CANON) == v && _cmdit_name_is_safe(load64(row)) == 1) {
            if (emit == 1) {
                if (n > 0) { _cmdit_oprint(sep); }
                _cmdit_oprint(load64(row));
            }
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

# bash: the `case` that adds the typed verb's flags to $flags. On a handle with
# cmdit_stop_at_positional, globals are not applied after the verb, so the verb's
# list REPLACES the global one there and keeps the verb's own --help and --version.
fn _cmdit_bash_verb_cases(h): i64 {
    var stop = load64(h + _CMDIT_H_STOP);
    var skip_auto = 1;
    if (stop != 0) { skip_auto = 0; }
    _cmdit_oprint("        case \"$verb\" in\n");
    var count = cmdit_verb_count(h);
    var i = 0;
    while (i < count) {
        var vh = _cmdit_verb_arm(h, i);
        if (vh != 0) {
            if (_cmdit_flag_words(vh, skip_auto, 0) > 0 && _cmdit_verb_selectors(h, i, "|", 0) > 0) {
                _cmdit_oprint("            ");
                _cmdit_verb_selectors(h, i, "|", 1);
                if (stop != 0) { _cmdit_oprint(") flags='"); }
                else { _cmdit_oprint(") flags=\"$flags "); }
                _cmdit_flag_words(vh, skip_auto, 1);
                if (stop != 0) { _cmdit_oprint("' ;;\n"); }
                else { _cmdit_oprint("\" ;;\n"); }
            }
        }
        i = i + 1;
    }
    _cmdit_oprint("        esac\n");
    return 0;
}

# bash: walk the words before the cursor for the first non-flag token. A
# value-taking flag consumes the word after it, so `--root /x` must not make /x
# look like the verb. `pv` = 1 also keeps the token in $verb.
fn _cmdit_bash_walk(pv): i64 {
    _cmdit_oprint("    for (( i=1; i<COMP_CWORD; i++ )); do\n");
    _cmdit_oprint("        w=\"${COMP_WORDS[i]}\"\n");
    _cmdit_oprint("        if [[ $skip -eq 1 ]]; then skip=0; continue; fi\n");
    _cmdit_oprint("        if [[ \" $valueflags \" == *\" $w \"* ]]; then skip=1; continue; fi\n");
    _cmdit_oprint("        if [[ \"$w\" == -* ]]; then continue; fi\n");
    if (pv == 1) { _cmdit_oprint("        seen_verb=1; verb=\"$w\"; break\n"); }
    else { _cmdit_oprint("        seen_verb=1; break\n"); }
    _cmdit_oprint("    done\n");
    return 0;
}

# bash: complete a word that starts with `-` from the flag list.
fn _cmdit_bash_flag_branch(h, pv): i64 {
    _cmdit_oprint("    if [[ \"$cur\" == -* ]]; then\n");
    if (pv == 1) { _cmdit_bash_verb_cases(h); }
    _cmdit_oprint("        COMPREPLY=( $(compgen -W \"$flags\" -- \"$cur\") )\n");
    _cmdit_oprint("        return 0\n    fi\n");
    return 0;
}

# zsh: the arms that offer the typed verb's flags. zsh completes no global flags,
# so each list is the verb handle's whole one, its --help and --version included,
# which is also why no list is empty.
fn _cmdit_zsh_verb_cases(h): i64 {
    _cmdit_oprint("    elif [[ $PREFIX == -* ]]; then\n");
    _cmdit_oprint("        case $verb in\n");
    var count = cmdit_verb_count(h);
    var i = 0;
    while (i < count) {
        var vh = _cmdit_verb_arm(h, i);
        if (vh != 0) {
            if (_cmdit_verb_selectors(h, i, "|", 0) > 0) {
                _cmdit_oprint("            ");
                _cmdit_verb_selectors(h, i, "|", 1);
                _cmdit_oprint(") compadd -- ");
                _cmdit_flag_words(vh, 0, 1);
                _cmdit_oprint(" ;;\n");
            }
        }
        i = i + 1;
    }
    _cmdit_oprint("            *) _files ;;\n");
    _cmdit_oprint("        esac\n");
    return 0;
}

# fish: the start of one per-verb flag line, conditioned on verb `v` being typed.
fn _cmdit_fish_flag_head(h, prog, v): i64 {
    _cmdit_oprint("complete -c ");
    _cmdit_oprint_cmdname(prog);
    _cmdit_oprint(" -n '__fish_seen_subcommand_from ");
    _cmdit_verb_selectors(h, v, " ", 1);
    _cmdit_oprint("'");
    return 0;
}

# fish: the end of a per-verb flag line. `-r` marks a flag that takes a value.
fn _cmdit_fish_flag_tail(ep): i64 {
    if (load64(ep + _CMDIT_E_TYPE) != CMDIT_BOOL) { _cmdit_oprint(" -r"); }
    var hp = load64(ep + _CMDIT_E_HELP);
    if (hp != 0) {
        _cmdit_oprint(" -d '");
        _cmdit_oprint_fish_sq(hp);
        _cmdit_oprint("'");
    }
    _cmdit_oprint("\n");
    return 0;
}

# fish: one `complete` line per flag of verb `v`'s handle `vh` (short letter and
# long name together), and one more for a second long name.
fn _cmdit_fish_verb_flags(h, prog, v, vh): i64 {
    var count = load64(vh + _CMDIT_H_COUNT);
    var i = 0;
    while (i < count) {
        var ep = _cmdit_entry(vh, i);
        var sc = load64(ep);
        var has_s = _cmdit_is_alnum(sc);
        var has_l = _cmdit_name_is_safe(load64(ep + _CMDIT_E_LONG));
        if (has_s == 1 || has_l == 1) {
            _cmdit_fish_flag_head(h, prog, v);
            if (has_s == 1) {
                var b[2];
                store8(&b, sc);
                store8(&b + 1, 0);
                _cmdit_oprint(" -s ");
                _cmdit_write(1, &b, 1);
            }
            if (has_l == 1) {
                _cmdit_oprint(" -l ");
                _cmdit_oprint(load64(ep + _CMDIT_E_LONG));
            }
            _cmdit_fish_flag_tail(ep);
        }
        if (_cmdit_name_is_safe(load64(ep + _CMDIT_E_ALIAS)) == 1) {
            _cmdit_fish_flag_head(h, prog, v);
            _cmdit_oprint(" -l ");
            _cmdit_oprint(load64(ep + _CMDIT_E_ALIAS));
            _cmdit_fish_flag_tail(ep);
        }
        i = i + 1;
    }
    return 0;
}

fn _cmdit_completions_bash(h, prog): i64 {
    var pv = _cmdit_has_verb_flags(h);                            # 1.3.7
    _cmdit_oprint("# bash completion for ");
    _cmdit_oprint_cmdname(prog);
    _cmdit_oprint("\n_");
    _cmdit_oprint_ident(prog);
    _cmdit_oprint("_complete() {\n");
    if (pv == 1) { _cmdit_oprint("    local cur i w seen_verb=0 skip=0 verb=\n"); }
    else { _cmdit_oprint("    local cur i w seen_verb=0 skip=0\n"); }
    _cmdit_oprint("    cur=\"${COMP_WORDS[COMP_CWORD]}\"\n");
    _cmdit_oprint("    local verbs='");
    _cmdit_oprint_verb_words(h);
    _cmdit_oprint("'\n    local flags='");
    _cmdit_oprint_flag_words(h);
    _cmdit_oprint("'\n    local valueflags='");
    _cmdit_oprint_valueflag_words(h);
    _cmdit_oprint("'\n");
    # 1.3.7: with per-verb flags the walk runs first, because the flag list then
    # depends on the verb. Without them the 1.3.6 order is kept, byte for byte.
    if (pv == 1) {
        _cmdit_bash_walk(1);
        _cmdit_bash_flag_branch(h, 1);
    } else {
        _cmdit_bash_flag_branch(h, 0);
        _cmdit_bash_walk(0);
    }
    _cmdit_oprint("    if [[ $seen_verb -eq 0 ]]; then\n");
    _cmdit_oprint("        COMPREPLY=( $(compgen -W \"$verbs\" -- \"$cur\") )\n");
    _cmdit_oprint("        return 0\n    fi\n");
    # 1.5.0: one candidate per line of compgen's output. `COMPREPLY=( $(compgen -f) )`
    # word-split "my file.txt" into two candidates and globbed a file named `g*` (sit
    # L11). A read loop rather than mapfile, so bash 3.2 still completes; compopt -o
    # filenames (bash 4+, silenced where missing) makes readline quote the name it
    # inserts. Here, not on `complete`, so a verb never gets a directory's trailing /.
    # CHANGELOG [1.5.0].
    _cmdit_oprint("    compopt -o filenames 2>/dev/null\n");
    _cmdit_oprint("    COMPREPLY=()\n");
    _cmdit_oprint("    while IFS= read -r w; do COMPREPLY+=( \"$w\" ); done < <(compgen -f -- \"$cur\")\n");
    _cmdit_oprint("}\ncomplete -F _");
    _cmdit_oprint_ident(prog);
    _cmdit_oprint("_complete ");
    _cmdit_oprint_cmdname(prog);
    _cmdit_oprint("\n");
    return 0;
}

fn _cmdit_completions_zsh(h, prog): i64 {
    _cmdit_oprint("#compdef ");
    _cmdit_oprint_cmdname(prog);
    _cmdit_oprint("\n_");
    _cmdit_oprint_ident(prog);
    _cmdit_oprint("() {\n    local -a verbs\n    verbs=(\n");
    var count = cmdit_verb_count(h);
    var i = 0;
    while (i < count) {
        # Canonical rows only: zsh's _describe shows the description beside the
        # name, and an alias would duplicate the entry under a second name.
        if (cmdit_verb_is_alias(h, i) == 0) {
            var nm = cmdit_verb_name_at(h, i);
            # 1.3.2: the 1.2.1 whitelist, which only the bash emitter applied. A ':'
            # in a name splits zsh's name:description pair; see the fish emitter for
            # the worse case. CHANGELOG [1.3.2].
            if (nm != 0 && _cmdit_name_is_safe(nm) == 1 && cmdit_verb_is_hidden(h, i) == 0) {
                _cmdit_oprint("        '");
                _cmdit_oprint_sq(nm);
                _cmdit_oprint(":");
                _cmdit_oprint_sq(cmdit_verb_help_at(h, i));
                _cmdit_oprint("'\n");
            }
        }
        i = i + 1;
    }
    _cmdit_oprint("    )\n");
    _cmdit_oprint("    local -a valueflags\n    valueflags=( ");
    _cmdit_oprint_valueflag_words(h);
    _cmdit_oprint(" )\n");
    # Same walk as the bash emitter: find the first non-flag word, skipping the
    # argument of any value-taking flag, rather than assuming position 2.
    var pv = _cmdit_has_verb_flags(h);                            # 1.3.7
    if (pv == 1) { _cmdit_oprint("    local i seen=0 skip=0 w verb\n"); }
    else { _cmdit_oprint("    local i seen=0 skip=0 w\n"); }
    _cmdit_oprint("    for (( i=2; i<CURRENT; i++ )); do\n");
    _cmdit_oprint("        w=$words[$i]\n");
    _cmdit_oprint("        if (( skip )); then skip=0; continue; fi\n");
    _cmdit_oprint("        if (( ${valueflags[(I)$w]} )); then skip=1; continue; fi\n");
    _cmdit_oprint("        if [[ $w == -* ]]; then continue; fi\n");
    if (pv == 1) { _cmdit_oprint("        seen=1; verb=$w; break\n"); }
    else { _cmdit_oprint("        seen=1; break\n"); }
    _cmdit_oprint("    done\n");
    _cmdit_oprint("    if (( ! seen )); then\n");
    _cmdit_oprint("        _describe -t commands 'command' verbs\n");
    if (pv == 1) { _cmdit_zsh_verb_cases(h); }
    _cmdit_oprint("    else\n        _files\n    fi\n}\n_");
    _cmdit_oprint_ident(prog);
    _cmdit_oprint(" \"$@\"\n");
    return 0;
}

fn _cmdit_completions_fish(h, prog): i64 {
    _cmdit_oprint("# fish completion for ");
    _cmdit_oprint_cmdname(prog);
    _cmdit_oprint("\ncomplete -c ");
    _cmdit_oprint_cmdname(prog);
    _cmdit_oprint(" -f\n");
    # 1.5.0: files come back once a verb is typed. The global -f above keeps them out
    # of the verb position, and nothing turned them on again, so fish completed no
    # file argument at all (sit L11). -F wins over another applicable -f. CHANGELOG [1.5.0].
    _cmdit_oprint("complete -c ");
    _cmdit_oprint_cmdname(prog);
    _cmdit_oprint(" -n 'not __fish_use_subcommand' -F\n");
    var count = cmdit_verb_count(h);
    var i = 0;
    while (i < count) {
        if (cmdit_verb_is_alias(h, i) == 0) {
            var nm = cmdit_verb_name_at(h, i);
            # 1.3.2: the 1.2.1 whitelist, which only the bash emitter applied. fish
            # expands a `complete -a` argument each time it completes, so a `(cmd)` in
            # a verb name would run at TAB time inside correct single quotes, the same
            # class `compgen -W` forced on bash. CHANGELOG [1.3.2].
            if (nm != 0 && _cmdit_name_is_safe(nm) == 1 && cmdit_verb_is_hidden(h, i) == 0) {
                _cmdit_oprint("complete -c ");
                _cmdit_oprint_cmdname(prog);
                _cmdit_oprint(" -n __fish_use_subcommand -a '");
                _cmdit_oprint_sq(nm);
                _cmdit_oprint("'");
                var hp = cmdit_verb_help_at(h, i);
                if (hp != 0) {
                    _cmdit_oprint(" -d '");
                    _cmdit_oprint_fish_sq(hp);                    # 1.3.7: was the POSIX quoter
                    _cmdit_oprint("'");
                }
                _cmdit_oprint("\n");
            }
        }
        i = i + 1;
    }
    # 1.3.7: each verb's own flags, offered once the verb has been typed.
    i = 0;
    while (i < count) {
        var vh = _cmdit_verb_arm(h, i);
        if (vh != 0) {
            if (_cmdit_verb_selectors(h, i, " ", 0) > 0) { _cmdit_fish_verb_flags(h, prog, i, vh); }
        }
        i = i + 1;
    }
    return 0;
}

# Write a shell completion script for `h`'s registered verbs to STDOUT — stdout,
# not stderr, because the output is meant to be redirected into a completions
# file or eval'd. All three complete verbs, then files; bash also completes the
# long flags. A file name is one candidate, spaces and glob characters included
# (bash since 1.5.0; before 1.5.0 fish completed no files at all). Every emitted
# name passes the [A-Za-z0-9_.-] whitelist (1.2.1; zsh and fish since 1.3.2).
#
# 1.3.7: a verb with cmdit_verb_flags attached also completes its own long flags
# once it has been typed, in all three shells. bash offers them beside the global
# flags (in place of them under cmdit_stop_at_positional); zsh and fish, which
# complete no global flags, offer the verb handle's whole list. Without an attached
# handle on any visible verb, the script is byte-for-byte the 1.3.6 one.
#
# `shell` is "bash", "zsh" or "fish". Returns 0 on success, -1 for an
# unrecognised shell (nothing is printed in that case, so a caller can report
# the error itself without a half-written script on stdout).
fn cmdit_completions(h, shell): i64 {
    if (h == 0 || shell == 0) { return 0 - 1; }
    var prog = load64(h + _CMDIT_H_PROG);
    # 1.3.2: an EMPTY name too, not only a null one; it emitted `complete -F
    # __complete ` with no command, which errors when sourced.
    if (prog == 0) { prog = "prog"; }
    if (load8(prog) == 0) { prog = "prog"; }
    var r = 0 - 1;
    var prev = _cmdit_out_begin(1);                               # 1.4.0
    if (_cmdit_cstr_eq(shell, "bash") == 1) { r = _cmdit_completions_bash(h, prog); }
    elif (_cmdit_cstr_eq(shell, "zsh") == 1) { r = _cmdit_completions_zsh(h, prog); }
    elif (_cmdit_cstr_eq(shell, "fish") == 1) { r = _cmdit_completions_fish(h, prog); }
    _cmdit_out_end(prev);
    return r;
}
