# --- mcp.cyr ---

# sandhi/rpc/mcp — MCP-over-HTTP transport dialect.
#
# MCP (Model Context Protocol) wire format is JSON-RPC 2.0 over HTTP
# POST. sandhi owns the transport: envelope construction, request-ID
# counter, error extraction. **Protocol semantics — tool discovery,
# prompt schemas, sampling responses — stay in bote + t-ron** per
# ADR 0001. Consumers of this module get "sent a JSON-RPC call; got
# a response"; the payload-shape negotiation is above sandhi's layer.
#
# Reference: https://modelcontextprotocol.io/specification/basic/transports#http

# ================================================================
# Request-ID counter — one per process. JSON-RPC 2.0 requires a
# unique ID per outstanding request; for the HTTP-one-shot case
# (sync request/response), monotonic counter is sufficient.
# ================================================================

var _sandhi_mcp_next_id = 1;

fn _sandhi_mcp_alloc_id(): i64 {
    var id = _sandhi_mcp_next_id;
    _sandhi_mcp_next_id = _sandhi_mcp_next_id + 1;
    return id;
}

# ================================================================
# Envelope build — JSON-RPC 2.0 request.
# ================================================================
#
# Shape:  {"jsonrpc":"2.0","id":N,"method":"<name>","params":{...}}
# `params_json` is a pre-built cstr including braces (or 0 for none).
# Return value: wire-ready request body (cstr).

fn _sandhi_mcp_build_request_a(a, method, params_json): i64 {
    var id = _sandhi_mcp_alloc_id();
    var o = sandhi_json_obj_new_a(a);
    # 1.2.6 OOM guard. Returning 0 here is propagated through the
    # callers (sandhi_rpc_mcp_call_a etc.) — they pass the (possibly
    # 0) build result as `body_json` to `sandhi_rpc_call_a`, which
    # already null-checks and sends bodyless on 0.
    if (o == 0) { return 0; }
    sandhi_json_add_string_a(a, o, "jsonrpc", "2.0");
    sandhi_json_add_int_a(a, o, "id", id);
    sandhi_json_add_string_a(a, o, "method", method);
    if (params_json != 0) {
        sandhi_json_add_raw_a(a, o, "params", params_json);
    }
    return sandhi_json_build_a(a, o);
}

fn _sandhi_mcp_build_request(method, params_json): i64 {
    return _sandhi_mcp_build_request_a(default_alloc(), method, params_json);
}

# ================================================================
# Call — POST the envelope, return rpc-response.
# ================================================================

# sandhi_rpc_mcp_call(endpoint_url, method_name, params_json)
#   - endpoint_url: full URL of the MCP endpoint (e.g.
#     "http://daimon.local:9000/mcp")
#   - method_name: JSON-RPC method name ("tools/list", "resources/read", …)
#   - params_json: cstr of pre-built params object (including braces),
#     or 0 if the method takes no params.
#
# Returns an rpc-response struct. sandhi_rpc_ok(r) == 1 on success.
# The response body is the full JSON-RPC response — caller navigates
# `result.<field>` or `error.<field>` per protocol spec.
fn sandhi_rpc_mcp_call_a(a, endpoint_url, method_name, params_json): i64 {
    var body = _sandhi_mcp_build_request_a(a, method_name, params_json);
    return sandhi_rpc_call_a(a, endpoint_url, "POST", body, SANDHI_RPC_DIALECT_JSONRPC);
}

fn sandhi_rpc_mcp_call(endpoint_url, method_name, params_json): i64 {
    return sandhi_rpc_mcp_call_a(default_alloc(), endpoint_url, method_name, params_json);
}

# Variant accepting caller-supplied headers (auth tokens etc.).
fn sandhi_rpc_mcp_call_with_headers_a(a, endpoint_url, method_name, params_json, user_headers): i64 {
    var body = _sandhi_mcp_build_request_a(a, method_name, params_json);
    return sandhi_rpc_call_with_headers_a(a, endpoint_url, "POST", body, user_headers, SANDHI_RPC_DIALECT_JSONRPC);
}

fn sandhi_rpc_mcp_call_with_headers(endpoint_url, method_name, params_json, user_headers): i64 {
    return sandhi_rpc_mcp_call_with_headers_a(default_alloc(), endpoint_url, method_name, params_json, user_headers);
}

# ================================================================
# Response helpers — transport-level only.
# ================================================================

# Extract the `result` value as a raw JSON cstr (may be an object).
# Returns 0 if the response didn't contain a result (e.g. was an error).
# Callers doing protocol-level work (bote / t-ron) re-parse this into
# the typed shape they want.
fn sandhi_rpc_mcp_result_raw_a(a, resp): i64 {
    var body = sandhi_rpc_body(resp);
    if (body == 0) { return 0; }
    return sandhi_json_get_string_a(a, body, "result");
}

fn sandhi_rpc_mcp_result_raw(resp): i64 {
    return sandhi_rpc_mcp_result_raw_a(default_alloc(), resp);
}

# Extract the JSON-RPC error code. Returns 0 on success (no error).
# (A legitimate error code of 0 is not defined by JSON-RPC 2.0 —
# standard codes are -32600/-32601/-32602/-32603/-32700 plus
# -32000..-32099 for implementation-defined.)
fn sandhi_rpc_mcp_error_code(resp): i64 {
    var body = sandhi_rpc_body(resp);
    if (body == 0) { return 0; }
    return sandhi_json_get_int(body, "error.code");
}

# Extract the JSON-RPC error message. Returns 0 if no error envelope.
fn sandhi_rpc_mcp_error_message_a(a, resp): i64 {
    var body = sandhi_rpc_body(resp);
    if (body == 0) { return 0; }
    return sandhi_json_get_string_a(a, body, "error.message");
}

fn sandhi_rpc_mcp_error_message(resp): i64 {
    return sandhi_rpc_mcp_error_message_a(default_alloc(), resp);
}

# ================================================================
# Streaming — SSE-wrapped JSON-RPC notifications
# ================================================================
#
# Some MCP servers expose long-lived endpoints that stream
# JSON-RPC notifications (tools/progress updates, resource change
# events) as Server-Sent Events. `sandhi_rpc_mcp_stream` sends the
# initial request and drives the SSE-feeding callback loop until
# the callback stops it or the stream closes.
#
# Callback signature: fn cb(ctx, sse_event) -> int (1 = continue, 0 = stop).
# The callback receives `sandhi_sse_event` structs; `sandhi_sse_event_data(e)`
# is the raw JSON payload the server pushed.

fn sandhi_rpc_mcp_stream_a(a, endpoint_url, method_name, params_json, cb, ctx): i64 {
    var body = _sandhi_mcp_build_request_a(a, method_name, params_json);
    # 1.2.6 OOM guard. `strlen(0)` would walk past 0; if the JSON
    # build OOM'd, bail. `sandhi_http_stream_a` returns a stream-
    # result struct so we mirror its err shape via the helper that
    # `_sandhi_stream_result_a` exposes (or 0 fallback if even that
    # OOMs in the same allocator).
    if (body == 0) { return _sandhi_stream_result_a(a, 0, 0, SANDHI_ERR_INTERNAL, 0); }
    var body_len = strlen(body);
    var headers = sandhi_headers_new_a(a);
    if (headers == 0) { return _sandhi_stream_result_a(a, 0, 0, SANDHI_ERR_INTERNAL, 0); }
    sandhi_headers_set_a(a, headers, "Content-Type", "application/json");
    sandhi_headers_set_a(a, headers, "Accept", "text/event-stream");
    # 1.6.3: carry the endpoint-keyed default TLS policy (if any) onto
    # the long-lived SSE stream too, so a pinned MCP endpoint stays
    # pinned for its notification channel — not just its unary calls.
    var policy = _sandhi_rpc_resolve_policy(endpoint_url);
    if (policy != 0) {
        var opts = sandhi_http_options_new_a(a);
        if (opts != 0) {
            sandhi_http_options_tls_policy(opts, policy);
            return sandhi_http_stream_opts_a(a, endpoint_url, "POST", headers, body, body_len, cb, ctx, opts);
        }
    }
    return sandhi_http_stream_a(a, endpoint_url, "POST", headers, body, body_len, cb, ctx);
}

fn sandhi_rpc_mcp_stream(endpoint_url, method_name, params_json, cb, ctx): i64 {
    return sandhi_rpc_mcp_stream_a(default_alloc(), endpoint_url, method_name, params_json, cb, ctx);
}

# --- mod.cyr ---

# sandhi/rpc — JSON-RPC dialect index.
#
# Composes:
#   rpc/json     — nested JSON build + dotted-path extract
#   rpc/dispatch — JSON-over-HTTP transport + dialect-aware error envelopes
#
# Dialects (one file each per CLAUDE.md "one dialect per file"):
#   rpc/webdriver — W3C WebDriver wire (Firefox, WebKit via geckodriver)
#   rpc/appium    — Appium UiAutomator2 / XCUITest extensions on top of WebDriver
#   rpc/mcp       — MCP-over-HTTP transport; protocol semantics stay in bote/t-ron per ADR 0001
#
# Adding a new dialect is a new file + a cyrius.cyml entry; don't grow
# an existing dialect file.

# --- service.cyr ---

# sandhi/discovery/service — types shared across resolvers.
#
# A `service` names an endpoint inside an AGNOS deployment. Any
# resolver that claims to resolve returns one of these (or 0 on miss).
#
# Struct layout (32 bytes):
#   +0   name  (cstr — logical service name, may be 0 for unnamed)
#   +8   host  (cstr — hostname OR dotted-quad IP; non-0)
#   +16  port  (int — 1..65535)
#   +24  ipv4  (int — pre-resolved address in sock_connect format, or 0
#               if the caller should resolve the host themselves)

enum SandhiServiceOff {
    SANDHI_SERVICE_OFF_NAME = 0;
    SANDHI_SERVICE_OFF_HOST = 8;
    SANDHI_SERVICE_OFF_PORT = 16;
    SANDHI_SERVICE_OFF_IPV4 = 24;
}

var SANDHI_SERVICE_STRUCT_SIZE = 32;

# Allocate a service struct from `a`. Returns 0 on OOM.
fn sandhi_service_new_a(a, name, host, port, ipv4): i64 {
    var s = alloc_via(a, SANDHI_SERVICE_STRUCT_SIZE);
    if (s == 0) { return 0; }
    store64(s + SANDHI_SERVICE_OFF_NAME, name);
    store64(s + SANDHI_SERVICE_OFF_HOST, host);
    store64(s + SANDHI_SERVICE_OFF_PORT, port);
    store64(s + SANDHI_SERVICE_OFF_IPV4, ipv4);
    return s;
}

fn sandhi_service_new(name, host, port, ipv4): i64 {
    return sandhi_service_new_a(default_alloc(), name, host, port, ipv4);
}

fn sandhi_service_name(s): i64 { return load64(s + SANDHI_SERVICE_OFF_NAME); }
fn sandhi_service_host(s): i64 { return load64(s + SANDHI_SERVICE_OFF_HOST); }
fn sandhi_service_port(s): i64 { return load64(s + SANDHI_SERVICE_OFF_PORT); }
fn sandhi_service_ipv4(s): i64 { return load64(s + SANDHI_SERVICE_OFF_IPV4); }

# ================================================================
# Resolver — a function pointer + opaque context.
# ================================================================
#
# Contract: `lookup_fn(ctx, name)` returns an alloc'd sandhi_service or 0 on miss.
# Resolvers MUST NOT abort on network failure — return 0 so the chain
# can try the next backend.
#
# Struct layout (16 bytes):
#   +0   lookup_fn  (fn pointer, matches fncall2 signature: (ctx, name))
#   +8   ctx        (ptr, resolver-specific)

enum SandhiResolverOff {
    SANDHI_RESOLVER_OFF_FN  = 0;
    SANDHI_RESOLVER_OFF_CTX = 8;
}

var SANDHI_RESOLVER_STRUCT_SIZE = 16;

# Allocate a resolver wrapper from `a`. Returns 0 on OOM.
fn sandhi_resolver_new_a(a, lookup_fn, ctx): i64 {
    var r = alloc_via(a, SANDHI_RESOLVER_STRUCT_SIZE);
    if (r == 0) { return 0; }
    store64(r + SANDHI_RESOLVER_OFF_FN, lookup_fn);
    store64(r + SANDHI_RESOLVER_OFF_CTX, ctx);
    return r;
}

fn sandhi_resolver_new(lookup_fn, ctx): i64 {
    return sandhi_resolver_new_a(default_alloc(), lookup_fn, ctx);
}

fn sandhi_resolver_fn(r): i64 { return load64(r + SANDHI_RESOLVER_OFF_FN); }
fn sandhi_resolver_ctx(r): i64 { return load64(r + SANDHI_RESOLVER_OFF_CTX); }

# Invoke a resolver directly. Chain + consumers use this shape.
fn sandhi_resolver_lookup(r, name): i64 {
    if (r == 0) { return 0; }
    var fp = sandhi_resolver_fn(r);
    if (fp == 0) { return 0; }
    return fncall2(fp, sandhi_resolver_ctx(r), name);
}

# --- chain.cyr ---

# sandhi/discovery/chain — fallback sequence of resolvers.
#
# A chain holds an ordered list of resolvers. On resolve, it asks
# each in turn and returns the first non-null service. No resolver
# is load-bearing — if daimon is down, the chain falls through to
# the next backend (mDNS, static config, …) without the caller
# having to notice.
#
# Usage:
#   var c = sandhi_discovery_chain_new();
#   sandhi_discovery_chain_add(c, sandhi_discovery_daimon_resolver("http://127.0.0.1:9000"));
#   sandhi_discovery_chain_add(c, sandhi_discovery_local_resolver());
#   var svc = sandhi_discovery_chain_resolve(c, "yantra-worker");

# Chain is just a vec of resolver pointers. Kept as a typed alias so
# the API documents intent rather than leaking "vec".
fn sandhi_discovery_chain_new(): i64 {
    return vec_new();
}

# Append a resolver. Resolvers run in insertion order on lookup.
fn sandhi_discovery_chain_add(chain, resolver): i64 {
    if (chain == 0 || resolver == 0) { return 0; }
    vec_push(chain, resolver);
    return 0;
}

# Count of resolvers in the chain. Handy for diagnostics.
fn sandhi_discovery_chain_count(chain): i64 {
    if (chain == 0) { return 0; }
    return vec_len(chain);
}

# Resolve `name` by trying each resolver. Returns the first non-null
# service, or 0 if every resolver misses.
fn sandhi_discovery_chain_resolve(chain, name): i64 {
    if (chain == 0 || name == 0) { return 0; }
    var n = vec_len(chain);
    var i = 0;
    while (i < n) {
        var r = vec_get(chain, i);
        var svc = sandhi_resolver_lookup(r, name);
        if (svc != 0) { return svc; }
        i = i + 1;
    }
    return 0;
}

# Wrap a chain as a resolver itself, so one chain can nest another.
# The caller passes the chain as ctx; the adapter calls chain_resolve.
fn _sandhi_discovery_chain_adapter(ctx, name): i64 {
    return sandhi_discovery_chain_resolve(ctx, name);
}

# Adapt a discovery chain into a `sandhi_resolver` handle (fn-ptr +
# context), so a chain can be passed wherever a single resolver is
# expected. Resolving through the handle runs the chain's fallback order.
fn sandhi_discovery_chain_as_resolver(chain): i64 {
    return sandhi_resolver_new(&_sandhi_discovery_chain_adapter, chain);
}

# --- daimon.cyr ---

# sandhi/discovery/daimon — resolver backed by the daimon service registry.
#
# Daimon is AGNOS's local agent orchestrator; when a sandhi consumer
# runs alongside daimon, daimon knows which services are alive and
# where they live. This resolver speaks a minimal HTTP contract
# against daimon's registry endpoint; daimon implements it.
#
# Contract (this file is the reference):
#
#   GET  {base}/services/{name}
#       200 → {"host":"...","port":N}  (service found)
#       404 → miss
#       any other response → miss (safe fail-open so chain falls through)
#
#   POST {base}/services/{name}  body: {"host":"...","port":N}
#       2xx → registered
#       non-2xx → caller should surface as SANDHI_ERR_DISCOVERY
#
#   DELETE {base}/services/{name}
#       2xx → deregistered
#       non-2xx → see above
#
# Base URL is whatever daimon is listening on — typically
# "http://127.0.0.1:9000" for a local daimon. Chain-resolver users
# can make daimon one backend among many; daimon outages fall through.

# Context struct (24 bytes):
#   +0   base_url  (cstr)
#   +8   reserved  (held 0 — future: auth token, timeouts; roadmap
#                   wait-for-consumer-ask "Daimon resolver context:
#                   auth token + timeouts")
#   +16  alloc     (Allocator handed to the resolver-fn-pointer
#                   callback; the (ctx, name) shape can't take an
#                   extra arg, so the allocator rides on the ctx)
enum SandhiDaimonCtxOff {
    SANDHI_DAIMON_CTX_OFF_BASE  = 0;
    SANDHI_DAIMON_CTX_OFF_RES   = 8;
    SANDHI_DAIMON_CTX_OFF_ALLOC = 16;
}

var SANDHI_DAIMON_CTX_SIZE = 24;

# Build a daimon resolver context backed by `a`. Returns 0 on OOM.
fn _sandhi_discovery_daimon_ctx_new_a(a, base_url): i64 {
    var c = alloc_via(a, SANDHI_DAIMON_CTX_SIZE);
    if (c == 0) { return 0; }
    store64(c + SANDHI_DAIMON_CTX_OFF_BASE, base_url);
    store64(c + SANDHI_DAIMON_CTX_OFF_RES, 0);
    store64(c + SANDHI_DAIMON_CTX_OFF_ALLOC, a);
    return c;
}

fn _sandhi_discovery_daimon_ctx_new(base_url): i64 {
    return _sandhi_discovery_daimon_ctx_new_a(default_alloc(), base_url);
}

# Build "{base}/services/{name}" with trailing-slash normalization,
# allocating the trimmed copy from `a`. The str_builder used to
# concatenate the final URL still goes through the global bump
# (str_builder lacks `_a` variants in the pinned stdlib); only the
# trim-copy and the final cstr land in `a`.
fn _sandhi_daimon_url_a(a, base, name): i64 {
    var sb = str_builder_new();
    var blen = strlen(base);
    if (blen > 0 && load8(base + blen - 1) == 47) {
        # Trim trailing slash.
        var trimmed = alloc_via(a, blen);
        if (trimmed == 0) { return 0; }
        memcpy(trimmed, base, blen - 1);
        store8(trimmed + blen - 1, 0);
        str_builder_add_cstr(sb, trimmed);
    } else {
        str_builder_add_cstr(sb, base);
    }
    str_builder_add_cstr(sb, "/services/");
    str_builder_add_cstr(sb, name);
    return str_data(str_builder_build(sb));
}

fn _sandhi_daimon_url(base, name): i64 {
    return _sandhi_daimon_url_a(default_alloc(), base, name);
}

# The resolver callback. Matches fn(ctx, name) → *service. The
# allocator stored on ctx (slot +16, 0 = process default) drives
# every alloc on the resolved-service path.
fn _sandhi_daimon_lookup(ctx, name): i64 {
    if (ctx == 0 || name == 0) { return 0; }
    var base = load64(ctx + SANDHI_DAIMON_CTX_OFF_BASE);
    if (base == 0) { return 0; }
    var a = load64(ctx + SANDHI_DAIMON_CTX_OFF_ALLOC);
    if (a == 0) { a = default_alloc(); }
    var url = _sandhi_daimon_url_a(a, base, name);
    if (url == 0) { return 0; }
    var resp = sandhi_http_get(url, 0);
    # Any non-2xx or transport error → miss (fall-through for chain).
    if (sandhi_http_err_kind(resp) != SANDHI_OK) { return 0; }
    var status = sandhi_http_status(resp);
    if (status < 200 || status >= 300) { return 0; }
    var body = sandhi_http_body(resp);
    if (body == 0) { return 0; }
    return _sandhi_daimon_parse_service_a(a, body, name);
}

# Parse daimon's {"host":"...","port":N} response into a service
# allocated from `a`. Returns 0 on missing fields, malformed input,
# or OOM.
fn _sandhi_daimon_parse_service_a(a, body, name): i64 {
    var host = sandhi_json_get_string(body, "host");
    if (host == 0) { return 0; }
    var port = sandhi_json_get_int(body, "port");
    if (port <= 0) { return 0; }
    if (port > 65535) { return 0; }
    # Daimon might also include a pre-resolved "address" field.
    var ipv4 = 0;
    var addr_str = sandhi_json_get_string(body, "address");
    if (addr_str != 0) {
        var av4 = sandhi_net_parse_ipv4(addr_str);
        if (av4 != 0 - 1) { ipv4 = av4; }
    }
    # Dup the caller-passed name so the service is self-contained.
    var name_copy = 0;
    if (name != 0) {
        var nlen = strlen(name);
        name_copy = alloc_via(a, nlen + 1);
        if (name_copy == 0) { return 0; }
        memcpy(name_copy, name, nlen);
        store8(name_copy + nlen, 0);
    }
    return sandhi_service_new_a(a, name_copy, host, port, ipv4);
}

fn _sandhi_daimon_parse_service(body, name): i64 {
    return _sandhi_daimon_parse_service_a(default_alloc(), body, name);
}

# Build a resolver for the given daimon base URL, owned by `a`.
# Returns 0 on OOM.
fn sandhi_discovery_daimon_resolver_a(a, base_url): i64 {
    if (base_url == 0) { return 0; }
    var ctx = _sandhi_discovery_daimon_ctx_new_a(a, base_url);
    if (ctx == 0) { return 0; }
    return sandhi_resolver_new_a(a, &_sandhi_daimon_lookup, ctx);
}

fn sandhi_discovery_daimon_resolver(base_url): i64 {
    return sandhi_discovery_daimon_resolver_a(default_alloc(), base_url);
}

# --- local.cyr ---

# sandhi/discovery/local — mDNS / link-local resolver (RFC 6762).
#
# Resolves `<name>.local` over IPv4 mDNS (224.0.0.251:5353). Both resolver
# flavours use the TWO-SOCKET receive split (1.5.5 for the opt-in QM, 1.6.12 for
# the default QU): an UNCONNECTED, group-joined RX socket sees the answer from
# ANY source, dodging the Linux connect()-source-filter that makes a single
# connect()ed socket drop every reply (the answer arrives from the responder's
# own unicast IP, not the group — the 1.5.4 bug).
#
#   - Default (QU — `sandhi_discovery_local_resolver`): sets the QU bit (RFC 6762
#     §5.4 — request a unicast answer to our source port) and binds the TX to
#     5353, so the unicast reply lands on the RX's port (the connect()-filter on
#     the TX rejects it — source != group — so it falls to the unconnected RX);
#     the group-join means it ALSO catches a multicast answer.
#   - Opt-in (QM — `sandhi_discovery_local_mc_resolver`, 1.5.5): plain-IN query;
#     the responder multicasts its answer to the group, caught on the RX.
#
# Both bounded by SO_RCVTIMEO (500 ms) so a missing responder doesn't hang the
# chain. Query ID = 0 (RFC 6762 §18.1 — responses carry ID 0; match by name).
# QTYPE = A. IP_MULTICAST_TTL for the outgoing query is 255 (RFC 6762 §11;
# link-scope is enforced by the group address, not the TTL).
#
# Reference: RFC 6762 (Multicast DNS). RFC 6763 (DNS-SD service-by-type
# browsing) is a distinct feature class; this is a `<name>.local` name resolver
# only, not a service-by-type resolver.

# 224.0.0.251 packed as a network-byte-order uint32 in little-endian-host repr
# (bytes 224, 0, 0, 251 across the int).
var _SANDHI_MDNS_GROUP = 0;
var _SANDHI_MDNS_PORT  = 5353;
var _SANDHI_MDNS_TIMEOUT_MS = 500;
# MC_TTL: IP multicast hop limit for the outgoing query — RFC 6762 §11 sets 255
# (link-scope is enforced by the group address, not the TTL). MC_MAX_RECV: hard
# cap on the recv-loop, since a group-joined socket sees all group traffic and the
# loop filters by name; the total-time bound is the SO_RCVTIMEO deadline.
var _SANDHI_MDNS_MC_TTL = 255;
var _SANDHI_MDNS_MC_MAX_RECV = 8;

# Build a `<name>.local` cstr in `a`. If `name` already ends in
# `.local` (case-insensitive), the input is dup'd into `a`; otherwise
# the suffix is appended. Returns 0 on OOM.
fn _sandhi_local_qname_a(a, name): i64 {
    var nlen = strlen(name);
    var has_suffix = 0;
    if (nlen >= 6) {
        var s = name + nlen - 6;
        var c0 = load8(s + 0);
        var c1 = load8(s + 1);
        var c2 = load8(s + 2);
        var c3 = load8(s + 3);
        var c4 = load8(s + 4);
        var c5 = load8(s + 5);
        if (c0 == 46) {  # '.'
            if ((c1 == 108 || c1 == 76) && (c2 == 111 || c2 == 79)
              && (c3 == 99 || c3 == 67) && (c4 == 97 || c4 == 65)
              && (c5 == 108 || c5 == 76)) {
                has_suffix = 1;
            }
        }
    }
    if (has_suffix == 1) {
        var dup = alloc_via(a, nlen + 1);
        if (dup == 0) { return 0; }
        memcpy(dup, name, nlen);
        store8(dup + nlen, 0);
        return dup;
    }
    var out = alloc_via(a, nlen + 7);
    if (out == 0) { return 0; }
    memcpy(out, name, nlen);
    store8(out + nlen + 0, 46);   # '.'
    store8(out + nlen + 1, 108);  # 'l'
    store8(out + nlen + 2, 111);  # 'o'
    store8(out + nlen + 3, 99);   # 'c'
    store8(out + nlen + 4, 97);   # 'a'
    store8(out + nlen + 5, 108);  # 'l'
    store8(out + nlen + 6, 0);
    return out;
}

fn _sandhi_local_qname(name): i64 {
    return _sandhi_local_qname_a(default_alloc(), name);
}

# Build the mDNS query packet. Same wire format as the unicast DNS
# resolver in net/resolve.cyr. `qclass_hi` is the QCLASS high byte:
# 0x80 = IN | QU-bit (RFC 6762 §5.4 — request a unicast response; the
# default fast path) or 0x00 = plain IN (QM — the responder multicasts
# its answer; used by the 1.5.5 multicast-listen resolver).
fn _sandhi_local_build_query_cls(id, qname, out, qclass_hi): i64 {
    store8(out + 0, (id >> 8) & 0xFF);
    store8(out + 1, id & 0xFF);
    store8(out + 2, 0x00);  # mDNS queries: QR=0, Opcode=0, AA=0, TC=0, RD=0
    store8(out + 3, 0x00);
    store8(out + 4, 0x00); store8(out + 5, 0x01);  # QDCOUNT = 1
    store8(out + 6, 0x00); store8(out + 7, 0x00);  # ANCOUNT
    store8(out + 8, 0x00); store8(out + 9, 0x00);  # NSCOUNT
    store8(out + 10, 0x00); store8(out + 11, 0x00); # ARCOUNT

    var qname_len = _sandhi_resolve_encode_labels(qname, out + 12);
    if (qname_len < 0) { return 0 - 1; }
    var qi = 12 + qname_len;
    store8(out + qi + 0, 0x00); store8(out + qi + 1, 0x01);  # QTYPE = A
    store8(out + qi + 2, qclass_hi); store8(out + qi + 3, 0x01);  # QCLASS = IN (| QU if hi=0x80)
    return qi + 4;
}

# Back-compat / default: QU-bit query (0x8001).
fn _sandhi_local_build_query(id, qname, out): i64 {
    return _sandhi_local_build_query_cls(id, qname, out, 0x80);
}

# Local resolver context (8 bytes):
#   +0  alloc  (Allocator handle the lookup callback uses; 0 → default)
# Carried so the resolver-fn-pointer `(ctx, name)` shape can pull an
# Allocator without growing the callback signature — same approach as
# daimon's ctx struct.
var _SANDHI_LOCAL_CTX_SIZE = 8;

fn _sandhi_discovery_local_ctx_new_a(a): i64 {
    var c = alloc_via(a, _SANDHI_LOCAL_CTX_SIZE);
    if (c == 0) { return 0; }
    store64(c, a);
    return c;
}

# ================================================================
# Two-socket mDNS receive (the 1.5.4 bug fix) — shared by QU + QM
# ================================================================
# CRITICAL DESIGN NOTE (the 1.5.4 bug, fixed here): you CANNOT use one
# `connect()`ed UDP socket for both send and receive. On Linux, connect()
# installs a source-address filter, so a socket connected to the group
# drops every answer (responders send from their own unicast IP, not the
# group). The fix is a TWO-SOCKET split:
#   - RX socket: UNCONNECTED, bound to 5353 + SO_REUSEPORT + group-joined.
#     `sock_recv` (sys_read) on an unconnected bound socket delivers the
#     next datagram from ANY source — so it sees the answer.
#   - TX socket: connected to the group, used only to send the query
#     (sys_write needs a connected socket).
# 1.6.12 extends this to the default QU resolver: for a QU query the answer
# is UNICAST to the query's source port, so the TX is bound to 5353 (the RX
# port, via SO_REUSEPORT) — the reply lands on 5353 where the unconnected RX
# listens; the connected TX's source-filter rejects it (source != group), so
# it falls to RX. Loopback live tests (tests/sandhi.tcyr discovery/local/mc_qm
# + qu_unicast) exercise both RX paths end-to-end so this can't silently
# regress again.

# Open the RX (receive) socket: unconnected, SO_REUSEPORT, bound to `port`,
# joined to `group` on interface `iface` (0 = INADDR_ANY = default iface).
# Parametrized so the loopback live test can drive the exact same code on an
# isolated group/port over the loopback interface. Returns the fd, or -1 on
# any failure (incl. AGNOS, where the net multicast helpers return -1).
fn _sandhi_local_mc_rx_open(group, port, iface): i64 {
    var fd_tag, fd = udp_socket();
    if (is_err_result(fd_tag) == 1) { return 0 - 1; }
    if (sock_reuseport(fd) < 0) { sock_close(fd); return 0 - 1; }
    if (is_err_result(sock_bind(fd, 0, port)) == 1) { sock_close(fd); return 0 - 1; }
    if (net_join_multicast(fd, group, iface) < 0) { sock_close(fd); return 0 - 1; }
    _sandhi_conn_set_timeout_ms(fd, _SANDHI_MDNS_TIMEOUT_MS, _SANDHI_SO_RCVTIMEO);
    return fd;
}

# Recv-loop on an already-open RX socket: read datagrams (unconnected → from
# any source), parse each with `expected_id`, return the first A record whose
# answer-name matches the question (the parser enforces both). Bounded by the
# SO_RCVTIMEO deadline + a hard attempt cap (a group-joined socket can see
# unrelated group traffic). Returns the IPv4 address or 0 on miss/OOM.
fn _sandhi_local_mc_recv_match(a, fd, expected_id): i64 {
    var rbuf = alloc_via(a, _SANDHI_RESOLVE_BUF_SIZE);
    if (rbuf == 0) { return 0; }
    var deadline = clock_now_ns() + _SANDHI_MDNS_TIMEOUT_MS * 1000000;
    var ip = 0;
    var done = 0;
    var attempts = 0;
    while ((done == 0) && (attempts < _SANDHI_MDNS_MC_MAX_RECV)) {
        attempts = attempts + 1;
        if (clock_now_ns() >= deadline) {
            done = 1;
        } else {
            var rr_tag, rlen = sock_recv(fd, rbuf, _SANDHI_RESOLVE_BUF_SIZE);
            if (is_err_result(rr_tag) == 1) {
                done = 1;
            } else {
                if (rlen > 0) {
                    var got = _sandhi_resolve_parse_response(rbuf, rlen, expected_id);
                    if (got != (0 - 1)) { ip = got; done = 1; }
                }
            }
        }
    }
    return ip;
}

# 1.6.12 — shared two-socket mDNS query. RX is UNCONNECTED (bound 5353 +
# SO_REUSEPORT + group-joined) so it sees the answer from ANY source; TX is
# connected to the group, send-only (sock_send/sys_write needs a connected
# socket). `qclass_hi` picks QU (0x80 — request a unicast answer) or QM (0x00 —
# responder multicasts). `tx_port` binds the TX source port: 5353 (REUSEPORT,
# alongside RX) for QU so the unicast reply lands on RX's port; 0 = ephemeral for
# QM (whose reply is multicast to the group regardless). id=0 per RFC 6762 §18.1.
# Returns the IPv4 address, or 0 on miss / OOM / unsupported (AGNOS → rx_open -1).
fn _sandhi_local_query_2sock_a(a, name, qclass_hi, tx_port): i64 {
    if (name == 0) { return 0; }
    if (_SANDHI_MDNS_GROUP == 0) {
        _SANDHI_MDNS_GROUP = 224 | (0 << 8) | (0 << 16) | (251 << 24);
    }
    var qname = _sandhi_local_qname_a(a, name);
    if (qname == 0) { return 0; }
    var qbuf = alloc_via(a, _SANDHI_RESOLVE_BUF_SIZE);
    if (qbuf == 0) { return 0; }
    var qlen = _sandhi_local_build_query_cls(0, qname, qbuf, qclass_hi);
    if (qlen < 0) { return 0; }

    var rx = _sandhi_local_mc_rx_open(_SANDHI_MDNS_GROUP, _SANDHI_MDNS_PORT, 0);
    if (rx < 0) { return 0; }

    var tx_tag, tx = udp_socket();
    if (is_err_result(tx_tag) == 1) {
        net_drop_multicast(rx, _SANDHI_MDNS_GROUP, 0); sock_close(rx); return 0;
    }
    # QU binds TX to 5353 (REUSEPORT, alongside RX) so the responder's unicast
    # reply lands on port 5353 where the unconnected RX listens. QM (tx_port=0)
    # leaves TX ephemeral — its reply is multicast to the group → RX sees it anyway.
    if (tx_port != 0) {
        if (sock_reuseport(tx) < 0) {
            sock_close(tx); net_drop_multicast(rx, _SANDHI_MDNS_GROUP, 0); sock_close(rx); return 0;
        }
        if (is_err_result(sock_bind(tx, 0, tx_port)) == 1) {
            sock_close(tx); net_drop_multicast(rx, _SANDHI_MDNS_GROUP, 0); sock_close(rx); return 0;
        }
    }
    net_set_multicast_ttl(tx, _SANDHI_MDNS_MC_TTL);
    var cr_tag, cr = sock_connect(tx, _SANDHI_MDNS_GROUP, _SANDHI_MDNS_PORT);
    if (is_err_result(cr_tag) == 1) {
        sock_close(tx); net_drop_multicast(rx, _SANDHI_MDNS_GROUP, 0); sock_close(rx); return 0;
    }
    var sr_tag, sr = sock_send(tx, qbuf, qlen);
    sock_close(tx);
    if (is_err_result(sr_tag) == 1) {
        net_drop_multicast(rx, _SANDHI_MDNS_GROUP, 0); sock_close(rx); return 0;
    }

    var ip = _sandhi_local_mc_recv_match(a, rx, 0);
    net_drop_multicast(rx, _SANDHI_MDNS_GROUP, 0);
    sock_close(rx);
    return ip;
}

# ================================================================
# Default (QU) resolver
# ================================================================

# Issue a QU mDNS query (request a unicast answer), allocating scratch into `a`.
# 1.6.12: was a single connect()ed socket that source-filtered out the
# responder's unicast reply (the 1.5.4 bug) AND used a random TXID that mDNS
# responses (ID=0) never matched. Now routes through the two-socket helper with
# the QU bit + TX bound to 5353, so the unicast reply lands on the unconnected
# RX; the group-join also catches a multicast answer. Returns the IPv4 address
# or 0 on any failure / OOM.
fn _sandhi_local_query_a(a, name): i64 {
    return _sandhi_local_query_2sock_a(a, name, 0x80, _SANDHI_MDNS_PORT);
}

fn _sandhi_local_query(name): i64 {
    return _sandhi_local_query_a(default_alloc(), name);
}

# Resolver callback. Reads the Allocator from ctx (0 → default) and
# threads it through the query + service-build path.
fn _sandhi_local_lookup(ctx, name): i64 {
    if (name == 0) { return 0; }
    var a = default_alloc();
    if (ctx != 0) {
        var stored = load64(ctx);
        if (stored != 0) { a = stored; }
    }
    var ip = _sandhi_local_query_a(a, name);
    if (ip == 0) { return 0; }
    var qname = _sandhi_local_qname_a(a, name);
    if (qname == 0) { return 0; }
    return sandhi_service_new_a(a, name, qname, 0, ip);
}

# Build the mDNS resolver backed by `a`. Both the resolver wrapper and
# its ctx are allocated from `a`; the lookup callback also routes its
# transient + service-struct allocations through `a`. Returns 0 on OOM.
fn sandhi_discovery_local_resolver_a(a): i64 {
    var ctx = _sandhi_discovery_local_ctx_new_a(a);
    if (ctx == 0) { return 0; }
    return sandhi_resolver_new_a(a, &_sandhi_local_lookup, ctx);
}

fn sandhi_discovery_local_resolver(): i64 {
    return sandhi_discovery_local_resolver_a(default_alloc());
}

# 1 where IPv4 multicast setsockopt is available (Linux/macOS), 0 on AGNOS.
# 1.6.12: the default resolver now joins the multicast group (two-socket
# receive — the 1.5.4 connect()-filter fix), so it shares the QM resolver's
# AGNOS limitation; report unavailable there (it would always miss). Linux/macOS
# unchanged (1, wired since 0.9.3).
fn sandhi_discovery_local_available(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 1;
    #endif
}

# ================================================================
# Opt-in multicast (QM) resolver (1.5.5) — for responders that ignore the QU
# bit and multicast their answer to 224.0.0.251:5353.
# ================================================================

# Multicast (QM) query: plain-IN ID=0 query (responder multicasts), TX ephemeral.
# Byte-identical to the 1.5.5 implementation — now shares the two-socket helper
# with the default QU path. Returns the IPv4 address or 0 on miss / OOM /
# unsupported (AGNOS → rx_open -1).
fn _sandhi_local_query_mc_a(a, name): i64 {
    return _sandhi_local_query_2sock_a(a, name, 0x00, 0);
}

fn _sandhi_local_query_mc(name): i64 {
    return _sandhi_local_query_mc_a(default_alloc(), name);
}

# Multicast (QM) resolver callback — mirrors `_sandhi_local_lookup` but uses
# the join-and-listen query path.
fn _sandhi_local_lookup_mc(ctx, name): i64 {
    if (name == 0) { return 0; }
    var a = default_alloc();
    if (ctx != 0) {
        var stored = load64(ctx);
        if (stored != 0) { a = stored; }
    }
    var ip = _sandhi_local_query_mc_a(a, name);
    if (ip == 0) { return 0; }
    var qname = _sandhi_local_qname_a(a, name);
    if (qname == 0) { return 0; }
    return sandhi_service_new_a(a, name, qname, 0, ip);
}

# Opt-in multicast (QM) mDNS resolver (1.5.5). Same resolver/ctx shape as
# `sandhi_discovery_local_resolver_a`, but the lookup sends a plain-IN query and
# relies on the responder multicasting its answer. Use this — or chain it after
# the default QU resolver — for responders that only multicast. Returns 0 on OOM.
fn sandhi_discovery_local_mc_resolver_a(a): i64 {
    var ctx = _sandhi_discovery_local_ctx_new_a(a);
    if (ctx == 0) { return 0; }
    return sandhi_resolver_new_a(a, &_sandhi_local_lookup_mc, ctx);
}

fn sandhi_discovery_local_mc_resolver(): i64 {
    return sandhi_discovery_local_mc_resolver_a(default_alloc());
}

# 1 where IPv4 multicast setsockopt is available (Linux/macOS), 0 on AGNOS
# (the net multicast helpers return -1; the QM resolver degrades to a clean
# miss).
fn sandhi_discovery_local_mc_available(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 1;
    #endif
}

# --- register.cyr ---

# sandhi/discovery/register — publish / withdraw services via daimon.
#
# Pairs with discovery/daimon.cyr. Uses the same REST contract:
#   POST   {base}/services/{name}   body: {"host":"...","port":N}
#   DELETE {base}/services/{name}
#
# mDNS publishing (a continuous-responder loop) is not in M4 scope —
# see discovery/local.cyr for the rationale. Register/deregister
# against daimon is the primary path for AGNOS services.

# Register a service with the daimon registry. `base_url` is daimon's
# listening endpoint (e.g. "http://127.0.0.1:9000"). `host` + `port`
# are the published location of the service being registered.
#
# Returns SANDHI_OK on success, or one of:
#   SANDHI_ERR_CONNECT    — daimon unreachable
#   SANDHI_ERR_REMOTE     — daimon answered but refused (non-2xx)
#   SANDHI_ERR_INTERNAL   — malformed input
fn sandhi_discovery_register(base_url, name, host, port): i64 {
    if (base_url == 0 || name == 0 || host == 0) { return SANDHI_ERR_INTERNAL; }
    if (port <= 0 || port > 65535) { return SANDHI_ERR_INTERNAL; }

    var url = _sandhi_daimon_url(base_url, name);
    var body_obj = sandhi_json_obj_new();
    sandhi_json_add_string(body_obj, "host", host);
    sandhi_json_add_int(body_obj, "port", port);
    var body = sandhi_json_build(body_obj);
    var body_len = strlen(body);

    var headers = sandhi_headers_new();
    sandhi_headers_set(headers, "Content-Type", "application/json");

    var resp = sandhi_http_post(url, headers, body, body_len);
    var ek = sandhi_http_err_kind(resp);
    if (ek != SANDHI_OK) { return ek; }
    var status = sandhi_http_status(resp);
    if (status < 200 || status >= 300) { return SANDHI_ERR_REMOTE; }
    return SANDHI_OK;
}

# Withdraw a previously-registered service.
fn sandhi_discovery_deregister(base_url, name): i64 {
    if (base_url == 0 || name == 0) { return SANDHI_ERR_INTERNAL; }
    var url = _sandhi_daimon_url(base_url, name);
    var resp = sandhi_http_delete(url, 0);
    var ek = sandhi_http_err_kind(resp);
    if (ek != SANDHI_OK) { return ek; }
    var status = sandhi_http_status(resp);
    if (status < 200 || status >= 300) { return SANDHI_ERR_REMOTE; }
    return SANDHI_OK;
}

# --- mod.cyr ---

# sandhi/discovery — service discovery index.
#
# Composes:
#   discovery/service   — service struct + resolver (fn-ptr + ctx) shape
#   discovery/chain     — fallback sequence of resolvers
#   discovery/daimon    — HTTP-backed resolver against daimon's registry
#   discovery/local     — mDNS resolver (RFC 6762 link-local query against 224.0.0.251:5353)
#   discovery/register  — publish/withdraw against daimon
#
# Typical consumer shape:
#   var c = sandhi_discovery_chain_new();
#   sandhi_discovery_chain_add(c, sandhi_discovery_daimon_resolver("http://127.0.0.1:9000"));
#   sandhi_discovery_chain_add(c, sandhi_discovery_local_resolver());
#   var svc = sandhi_discovery_chain_resolve(c, "yantra-worker");
#   if (svc != 0) {
#       # svc_host(svc) / svc_port(svc) / svc_ipv4(svc)
#   }
#
# No resolver in the chain is load-bearing — a missing daimon falls
# through to the next backend silently.

# --- mod.cyr ---

# sandhi/server — HTTP server surface.
#
# Lift-and-shift landing site for lib/http_server.cyr per M1 of the
# sandhi roadmap. Content below is the verbatim stdlib file as of the
# 5.6.22 toolchain pin; no behavior change, structural move only.
# Routing, middleware, and auth primitives layer on top in later
# milestones — ADR 0001 is strict about staying lift-first-then-enhance.
#
# During the migration window, stdlib lib/http_server.cyr is expected
# to alias these symbols so existing consumers keep building; the alias
# retires at fold-into-stdlib (M6).
#
# Requires: alloc.cyr, string.cyr, fmt.cyr, str.cyr, net.cyr,
# tagged.cyr, syscalls.cyr (all pulled in via stdlib deps).

# ================================================================
# Status codes
# ================================================================
var HTTP_OK                  = 200;
var HTTP_NO_CONTENT          = 204;
var HTTP_MOVED_PERMANENTLY   = 301;
var HTTP_FOUND               = 302;
var HTTP_NOT_MODIFIED        = 304;
var HTTP_BAD_REQUEST         = 400;
var HTTP_UNAUTHORIZED        = 401;
var HTTP_FORBIDDEN           = 403;
var HTTP_NOT_FOUND           = 404;
var HTTP_METHOD_NOT_ALLOWED  = 405;
var HTTP_REQUEST_TIMEOUT     = 408;
var HTTP_PAYLOAD_TOO_LARGE   = 413;
var HTTP_INTERNAL            = 500;
var HTTP_NOT_IMPLEMENTED     = 501;  #skip-lint: HTTP 501 status-code constant
var HTTP_SERVICE_UNAVAILABLE = 503;

# ================================================================
# Internal byte-search + ASCII helpers
# ================================================================

# Find the first occurrence of `needle[0..nlen]` in `haystack[0..hlen]`.
# Returns the offset, or 0 - 1 if not found.
fn _hsv_find(haystack, hlen, needle, nlen): i64 {
    if (nlen == 0) { return 0; }
    if (nlen > hlen) { return 0 - 1; }
    var i = 0;
    while (i <= hlen - nlen) {
        if (memeq(haystack + i, needle, nlen) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn _hsv_to_lower(c): i64 {
    if (c >= 65) { if (c <= 90) { return c + 32; } }
    return c;
}

fn _hsv_iceq(a, b, n): i64 {
    var i = 0;
    while (i < n) {
        if (_hsv_to_lower(load8(a + i)) != _hsv_to_lower(load8(b + i))) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _hsv_next_nl(buf, start, end): i64 {
    var i = start;
    while (i < end) {
        if (load8(buf + i) == 10) { return i; }
        i = i + 1;
    }
    return end;
}

# ================================================================
# Request parsing — read-only on the buffer, only allocates returned cstrs
# ================================================================

# Method from the request line — "GET", "POST", etc. Returns "" on malformed.
# Extract the request method into `a`. Returns "" on malformed; 0 on
# OOM (caller can distinguish by null-checking; "" is non-zero).
fn sandhi_server_get_method_a(a, buf, blen): i64 {
    var sp = _hsv_find(buf, blen, " ", 1);
    if (sp < 0) { return ""; }
    var out = alloc_via(a, sp + 1);
    if (out == 0) { return 0; }
    memcpy(out, buf, sp);
    store8(out + sp, 0);
    return out;
}

fn sandhi_server_get_method(buf, blen): i64 {
    return sandhi_server_get_method_a(default_alloc(), buf, blen);
}

fn sandhi_server_get_path_a(a, buf, blen): i64 {
    var sp1 = _hsv_find(buf, blen, " ", 1);
    if (sp1 < 0) { return ""; }
    var sp2 = _hsv_find(buf + sp1 + 1, blen - sp1 - 1, " ", 1);
    if (sp2 < 0) { return ""; }
    var out = alloc_via(a, sp2 + 1);
    if (out == 0) { return 0; }
    memcpy(out, buf + sp1 + 1, sp2);
    store8(out + sp2, 0);
    return out;
}

fn sandhi_server_get_path(buf, blen): i64 {
    return sandhi_server_get_path_a(default_alloc(), buf, blen);
}

# Offset of the body start (after \r\n\r\n) — 0 - 1 if no headers terminator.
fn sandhi_server_body_offset(buf, blen): i64 {
    var off = _hsv_find(buf, blen, "\r\n\r\n", 4);
    if (off < 0) { return 0 - 1; }
    return off + 4;
}

# Case-insensitive header lookup. Returns the value cstr (trimmed of leading
# SP and trailing CR), or 0 if the header is absent.
fn sandhi_server_find_header_a(a, buf, blen, name): i64 {
    var nlen = strlen(name);
    var headers_end = _hsv_find(buf, blen, "\r\n\r\n", 4);
    if (headers_end < 0) { headers_end = blen; }
    var line_start = _hsv_next_nl(buf, 0, headers_end);
    if (line_start >= headers_end) { return 0; }
    line_start = line_start + 1;
    while (line_start < headers_end) {
        var line_end = _hsv_next_nl(buf, line_start, headers_end);
        if (line_start + nlen + 1 <= line_end
          && _hsv_iceq(buf + line_start, name, nlen) == 1
          && load8(buf + line_start + nlen) == 58) {
            var vs = line_start + nlen + 1;
            while (vs < line_end && load8(buf + vs) == 32) { vs = vs + 1; }
            var ve = line_end;
            if (ve > vs && load8(buf + ve - 1) == 13) { ve = ve - 1; }
            var vlen = ve - vs;
            var out = alloc_via(a, vlen + 1);
            if (out == 0) { return 0; }
            memcpy(out, buf + vs, vlen);
            store8(out + vlen, 0);
            return out;
        }
        line_start = line_end + 1;
    }
    return 0;
}

fn sandhi_server_find_header(buf, blen, name): i64 {
    return sandhi_server_find_header_a(default_alloc(), buf, blen, name);
}

# Largest Content-Length this server will represent. Same bound the response
# side has applied to chunk sizes since the 0.9.0 P0 sweep
# (`_SANDHI_RESP_CHUNK_MAX`), and far above any request `max_request` allows.
var _HSV_CL_MAX = 0x7FFFFFFF;

# Content-Length value — 0 if header absent or malformed, `0 - 1` if the value
# is well-formed digits but too large to represent (see below).
#
# 0.9.1 P1 — strict per RFC 7230 §3.3.2: pure decimal digits (with
# optional leading/trailing whitespace) only. Previously skipped
# non-digits silently, so "10, 20" parsed as 1020 — CL.CL smuggling.
# Returns 0 on any malformed value (including non-digit characters
# embedded in the number); the existing accept loop reads body up
# to the parsed length so 0 means "no body" which is a safe fail
# closed for malformed input.
#
# 1.9.12 P1 — the digit accumulator had no bound, so `n = n * 10 + d` over a
# 20-digit value overflowed i64 and WRAPPED NEGATIVE. `seen_digit` was set and
# the trailing-whitespace check passed, so the negative value was returned as
# if valid. Both recv loops then computed `need_body = bo + clen`, which went
# negative, making `have >= need_body` true on the very first pass: a
# headers-only request was framed as COMPLETE and dispatched, and a handler
# calling this verb to size the body got a negative length.
#
# Overflow now answers `0 - 1`, distinct from the `0` used for "absent or
# malformed". The distinction matters: 0 means "no body", and answering 0 for a
# huge-but-declared Content-Length would leave the promised body bytes unread in
# the socket, where a keep-alive connection would parse them as the NEXT
# request — smuggling. Both recv loops map `0 - 1` onto
# SANDHI_SERVER_ERR_TOO_LARGE, which answers 413, drains and closes. Per ADR
# 0004: refuse the message, do not pick an interpretation.
fn sandhi_server_content_length(buf, blen): i64 {
    var v = sandhi_server_find_header(buf, blen, "Content-Length");
    if (v == 0) { return 0; }
    var i = 0;
    while (load8(v + i) == 32 || load8(v + i) == 9) { i = i + 1; }
    if (load8(v + i) == 0) { return 0; }
    var n = 0;
    var seen_digit = 0;
    while (load8(v + i) >= 48 && load8(v + i) <= 57) {
        n = n * 10 + (load8(v + i) - 48);
        if (n > _HSV_CL_MAX) { return 0 - 1; }
        seen_digit = 1;
        i = i + 1;
    }
    if (seen_digit == 0) { return 0; }
    while (load8(v + i) == 32 || load8(v + i) == 9) { i = i + 1; }
    if (load8(v + i) != 0) { return 0; }
    return n;
}

# 0.9.1 P1 — count occurrences of a given header name in the
# request. Used to detect Host.Host / CL.CL / TE.TE duplicate
# conditions that are malformed per RFC 7230. Case-insensitive
# match. We don't have to be perfect about line boundaries here
# because sandhi_server_find_header / `_hsv_find` already understand the
# request format — we just iterate all body offsets and use them.
fn _sandhi_server_count_header_occurrences(buf, blen, name): i64 {
    var count = 0;
    var pos = 0;
    var name_len = strlen(name);
    var line_start = 0;
    while (line_start < blen) {
        # Find end of line.
        var line_end = line_start;
        while (line_end < blen && load8(buf + line_end) != 10) { line_end = line_end + 1; }
        if (line_end == line_start) { return count; }  # blank line ends headers
        if (line_end == line_start + 1 && load8(buf + line_start) == 13) {
            return count;
        }
        # Compare line prefix against `name:` (case-insensitive).
        if (line_end > line_start + name_len) {
            if (_hsv_iceq(buf + line_start, name, name_len) == 1) {
                if (load8(buf + line_start + name_len) == 58) {
                    count = count + 1;
                }
            }
        }
        line_start = line_end + 1;
    }
    return count;
}

# 0.9.1 P1 — 1 if the request has multiple Host / Content-Length /
# Transfer-Encoding headers (CL.CL / Host.Host / TE.TE smuggling
# vector per RFC 7230 §3.3.2 + §5.4). Server replies 400 on truthy
# rather than dispatching to the handler.
fn sandhi_server_request_has_dup_smuggling_header(buf, blen): i64 {
    if (_sandhi_server_count_header_occurrences(buf, blen, "Host") > 1)              { return 1; }
    if (_sandhi_server_count_header_occurrences(buf, blen, "Content-Length") > 1)    { return 1; }
    if (_sandhi_server_count_header_occurrences(buf, blen, "Transfer-Encoding") > 1) { return 1; }
    return 0;
}

# 1.9.4 — 1 if the request declares ANY `Transfer-Encoding`. sandhi has no
# inbound transfer-coding decoder (the chunked helpers in this module are
# response-side only: send_chunked_start / send_chunk / send_chunked_end), so
# it cannot frame such a body.
#
# This closes the third silent-truncation path found alongside the body cap.
# `has_cl_te_conflict` below returns 0 the moment Content-Length is ABSENT, and
# `has_dup_smuggling_header` only fires on a REPEATED header — so a plain
# `Transfer-Encoding: chunked` request with no Content-Length passed both
# guards. `sandhi_server_content_length` then returned 0, making need_body
# equal to the header terminator, and the recv loop returned the instant the
# headers landed. The handler was dispatched with an EMPTY body while the
# chunked bytes sat unread in the socket: not a truncated body, a discarded
# one, with nothing anywhere reporting it.
#
# RFC 9112 §7.1: a server that receives a transfer coding it cannot process
# SHOULD answer 501. Decoding inbound chunked is a feature for a minor release;
# refusing to pretend the body was empty is the patch.
fn sandhi_server_request_has_unsupported_te(buf, blen): i64 {
    if (sandhi_server_find_header(buf, blen, "Transfer-Encoding") == 0) { return 0; }
    return 1;
}

# 0.9.0 P0 #2 — 1 if the request carries both `Content-Length` AND
# `Transfer-Encoding: chunked`, which is malformed per RFC 7230
# §3.3.3 and the canonical CL.TE smuggling vector. The accept-loop
# in `sandhi_server_run_opts` checks this and replies 400 before
# handing the request to the user's handler.
fn sandhi_server_request_has_cl_te_conflict(buf, blen): i64 {
    if (sandhi_server_find_header(buf, blen, "Content-Length") == 0) { return 0; }
    var te = sandhi_server_find_header(buf, blen, "Transfer-Encoding");
    if (te == 0) { return 0; }
    # Tolerant case-insensitive substring match for "chunked".
    var i = 0;
    while (load8(te + i) != 0) {
        var c0 = load8(te + i);
        if (c0 >= 65 && c0 <= 90) { c0 = c0 + 32; }
        if (c0 == 99) {
            var j = 1;
            var matched = 1;
            var want = "hunked";
            while (matched == 1 && j < 7) {
                var ch = load8(te + i + j);
                if (ch >= 65 && ch <= 90) { ch = ch + 32; }
                if (ch != load8(want + j - 1)) { matched = 0; }
                j = j + 1;
            }
            if (matched == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Path + query helpers
# ================================================================

# "/foo?bar=baz" → "/foo". Returns the input unchanged if there's no '?'.
fn sandhi_server_path_only_a(a, path): i64 {
    if (path == 0) { return path; }
    var i = 0;
    while (load8(path + i) != 0) {
        if (load8(path + i) == 63) {
            var out = alloc_via(a, i + 1);
            if (out == 0) { return 0; }
            memcpy(out, path, i);
            store8(out + i, 0);
            return out;
        }
        i = i + 1;
    }
    return path;
}

fn sandhi_server_path_only(path): i64 {
    return sandhi_server_path_only_a(default_alloc(), path);
}

fn sandhi_server_url_decode_a(a, s): i64 {
    if (s == 0) { return ""; }
    var slen = strlen(s);
    var out = alloc_via(a, slen + 1);
    if (out == 0) { return 0; }
    var si = 0;
    var oi = 0;
    while (si < slen) {
        var c = load8(s + si);
        if (c == 37 && si + 2 < slen) {
            var h1 = load8(s + si + 1);
            var h2 = load8(s + si + 2);
            var v1 = 0;
            var v2 = 0;
            if (h1 >= 48 && h1 <= 57) { v1 = h1 - 48; }
            elif (h1 >= 65 && h1 <= 70) { v1 = h1 - 55; }
            elif (h1 >= 97 && h1 <= 102) { v1 = h1 - 87; }
            if (h2 >= 48 && h2 <= 57) { v2 = h2 - 48; }
            elif (h2 >= 65 && h2 <= 70) { v2 = h2 - 55; }
            elif (h2 >= 97 && h2 <= 102) { v2 = h2 - 87; }
            store8(out + oi, v1 * 16 + v2);
            si = si + 3;
        } elif (c == 43) {
            store8(out + oi, 32);
            si = si + 1;
        } else {
            store8(out + oi, c);
            si = si + 1;
        }
        oi = oi + 1;
    }
    store8(out + oi, 0);
    return out;
}

fn sandhi_server_url_decode(s): i64 {
    return sandhi_server_url_decode_a(default_alloc(), s);
}

# Query parameter value, percent-decoded. 0 if not found.
# Example: sandhi_server_get_param("/a?foo=1&bar=hello%20world", "bar") → "hello world"
fn sandhi_server_get_param_a(a, path, name): i64 {
    if (path == 0) { return 0; }
    var plen = strlen(path);
    var qmark = 0 - 1;
    var pi = 0;
    while (pi < plen) {
        if (load8(path + pi) == 63) { qmark = pi + 1; pi = plen; }
        pi = pi + 1;
    }
    if (qmark < 0) { return 0; }
    var nlen = strlen(name);
    pi = qmark;
    while (pi < plen) {
        if (pi + nlen + 1 <= plen
          && memeq(path + pi, name, nlen) == 1
          && load8(path + pi + nlen) == 61) {
            var vs = pi + nlen + 1;
            var ve = vs;
            while (ve < plen && load8(path + ve) != 38) { ve = ve + 1; }
            var raw = alloc_via(a, ve - vs + 1);
            if (raw == 0) { return 0; }
            memcpy(raw, path + vs, ve - vs);
            store8(raw + ve - vs, 0);
            return sandhi_server_url_decode_a(a, raw);
        }
        while (pi < plen && load8(path + pi) != 38) { pi = pi + 1; }
        pi = pi + 1;
    }
    return 0;
}

fn sandhi_server_get_param(path, name): i64 {
    return sandhi_server_get_param_a(default_alloc(), path, name);
}

fn sandhi_server_path_segment_a(a, path, n): i64 {
    if (path == 0) { return 0; }
    var path_only = sandhi_server_path_only_a(a, path);
    var plen = strlen(path_only);
    var seg = 0;
    var ss = 0;
    var pi = 0;
    if (pi < plen && load8(path_only + pi) == 47) { pi = pi + 1; ss = pi; }
    while (pi <= plen) {
        var c = 0;
        if (pi < plen) { c = load8(path_only + pi); }
        if (c == 47 || c == 0) {
            if (seg == n) {
                var slen = pi - ss;
                var out = alloc_via(a, slen + 1);
                if (out == 0) { return 0; }
                memcpy(out, path_only + ss, slen);
                store8(out + slen, 0);
                return out;
            }
            seg = seg + 1;
            ss = pi + 1;
        }
        pi = pi + 1;
    }
    return 0;
}

fn sandhi_server_path_segment(path, n): i64 {
    return sandhi_server_path_segment_a(default_alloc(), path, n);
}

# ================================================================
# Response builders
# ================================================================

# Minimal status response with Content-Length: 0.
# e.g. sandhi_server_send_status(cfd, HTTP_NOT_FOUND, "Not Found");
# 1.2.7 Batch G: each `_send_*` gains an `_a` variant that threads
# `a` through `str_builder_*_a`. Bare versions stay as back-compat
# wrappers passing `default_alloc()`. Return shape: `_a` returns 0
# on success, `-1` on OOM (str_builder_new_a returned 0). Bare
# versions return whatever `_a` returns — under default_alloc that's
# always 0 in practice. Closes the SIGSEGV-on-OOM gap that mirrored
# the 1.2.6 RPC dialect findings.
fn sandhi_server_send_status_a(a, cfd, code, msg): i64 {
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0 - 1; }
    str_builder_add_cstr_a(a, sb, "HTTP/1.1 ");
    str_builder_add_int_a(a, sb, code);
    str_builder_add_cstr_a(a, sb, " ");
    str_builder_add_cstr_a(a, sb, msg);
    str_builder_add_cstr_a(a, sb, "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
    # 1.9.13 P2 — `str_builder_build_a` answers 0 on OOM and its result went
    # straight into `str_data()`, which dereferences it. `str_builder_new_a` at
    # the top of each of these builders IS guarded (a comment there records
    # closing that gap), so this was the remaining half. It sits on the REFUSAL
    # path — 400/413/501 — which is precisely the arena-pressure path 1.9.6 built
    # the reject arena for, so "only under OOM" is not reassuring here.
    # `0 - 1` is the OOM return these builders already document.
    var _bld = str_builder_build_a(a, sb);
    if (_bld == 0) { return 0 - 1; }
    var s = str_data(_bld);
    sock_send(cfd, s, strlen(s));
    return 0;
}

fn sandhi_server_send_status(cfd, code, msg): i64 {
    return sandhi_server_send_status_a(default_alloc(), cfd, code, msg);
}

# Full response. extra_headers is a cstr (each line CRLF-terminated) or 0.
# e.g. sandhi_server_send_response(cfd, 200, "OK", "application/json", body, len, 0);
fn sandhi_server_send_response_a(a, cfd, code, msg, content_type, body, body_len, extra_headers): i64 {
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0 - 1; }
    str_builder_add_cstr_a(a, sb, "HTTP/1.1 ");
    str_builder_add_int_a(a, sb, code);
    str_builder_add_cstr_a(a, sb, " ");
    str_builder_add_cstr_a(a, sb, msg);
    str_builder_add_cstr_a(a, sb, "\r\nContent-Type: ");
    str_builder_add_cstr_a(a, sb, content_type);
    str_builder_add_cstr_a(a, sb, "\r\nContent-Length: ");
    str_builder_add_int_a(a, sb, body_len);
    str_builder_add_cstr_a(a, sb, "\r\n");
    if (extra_headers != 0) { str_builder_add_cstr_a(a, sb, extra_headers); }
    str_builder_add_cstr_a(a, sb, "Connection: close\r\n\r\n");
    var _bld = str_builder_build_a(a, sb);
    if (_bld == 0) { return 0 - 1; }
    var head = str_data(_bld);
    sock_send(cfd, head, strlen(head));
    if (body_len > 0) { sock_send(cfd, body, body_len); }
    return 0;
}

fn sandhi_server_send_response(cfd, code, msg, content_type, body, body_len, extra_headers): i64 {
    return sandhi_server_send_response_a(default_alloc(), cfd, code, msg,
      content_type, body, body_len, extra_headers);
}

# 204 No Content with optional extra headers (CRLF-terminated cstr or 0).
fn sandhi_server_send_204_a(a, cfd, extra_headers): i64 {
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0 - 1; }
    str_builder_add_cstr_a(a, sb, "HTTP/1.1 204 No Content\r\n");
    if (extra_headers != 0) { str_builder_add_cstr_a(a, sb, extra_headers); }
    str_builder_add_cstr_a(a, sb, "Content-Length: 0\r\nConnection: close\r\n\r\n");
    var _bld = str_builder_build_a(a, sb);
    if (_bld == 0) { return 0 - 1; }
    var s = str_data(_bld);
    sock_send(cfd, s, strlen(s));
    return 0;
}

fn sandhi_server_send_204(cfd, extra_headers): i64 {
    return sandhi_server_send_204_a(default_alloc(), cfd, extra_headers);
}

# ================================================================
# Chunked / streaming responses (Transfer-Encoding: chunked)
# ================================================================
# Use this for SSE, large bodies, or any long-running response.
# Sequence:
#   sandhi_server_send_chunked_start(cfd, 200, "text/event-stream", 0);
#   sandhi_server_send_chunk(cfd, "data: hello\n\n", 13);
#   sandhi_server_send_chunk(cfd, "data: world\n\n", 13);
#   sandhi_server_send_chunked_end(cfd);

# Begin a chunked / SSE response. Sends the HTTP/1.1 status line plus
# Transfer-Encoding: chunked. Follow with repeated sandhi_server_send_chunk calls
# and finish with sandhi_server_send_chunked_end. extra_headers is a cstr of
# CRLF-terminated header lines or 0.
fn sandhi_server_send_chunked_start_a(a, cfd, code, content_type, extra_headers): i64 {
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0 - 1; }
    str_builder_add_cstr_a(a, sb, "HTTP/1.1 ");
    str_builder_add_int_a(a, sb, code);
    str_builder_add_cstr_a(a, sb, " OK\r\nContent-Type: ");
    str_builder_add_cstr_a(a, sb, content_type);
    str_builder_add_cstr_a(a, sb, "\r\nTransfer-Encoding: chunked\r\n");
    if (extra_headers != 0) { str_builder_add_cstr_a(a, sb, extra_headers); }
    str_builder_add_cstr_a(a, sb, "Connection: close\r\n\r\n");
    var _bld = str_builder_build_a(a, sb);
    if (_bld == 0) { return 0 - 1; }
    var head = str_data(_bld);
    sock_send(cfd, head, strlen(head));
    return 0;
}

fn sandhi_server_send_chunked_start(cfd, code, content_type, extra_headers): i64 {
    return sandhi_server_send_chunked_start_a(default_alloc(), cfd, code, content_type, extra_headers);
}

# Send one chunk of a chunked-transfer response. Emits the chunk-length
# as lowercase hex followed by CRLF, then `len` bytes of `data`, then
# another CRLF. Use between sandhi_server_send_chunked_start and sandhi_server_send_chunked_end.
fn sandhi_server_send_chunk(cfd, data, len): i64 {
    var hexbuf[32];
    var hi = 0;
    var n = len;
    if (n == 0) { store8(&hexbuf, 48); hi = 1; }
    else {
        var tmp[32];
        var ti = 0;
        while (n > 0) {
            var d = n & 15;
            if (d < 10) { store8(&tmp + ti, 48 + d); }
            else { store8(&tmp + ti, 87 + d); }
            n = n >> 4;
            ti = ti + 1;
        }
        var ri = ti;
        while (ri > 0) {
            ri = ri - 1;
            store8(&hexbuf + hi, load8(&tmp + ri));
            hi = hi + 1;
        }
    }
    store8(&hexbuf + hi, 13);
    store8(&hexbuf + hi + 1, 10);
    sock_send(cfd, &hexbuf, hi + 2);
    if (len > 0) { sock_send(cfd, data, len); }
    sock_send(cfd, "\r\n", 2);
    return 0;
}

# Terminate a chunked-transfer response. Sends the zero-length chunk
# that tells the client the body is complete ("0\r\n\r\n").
fn sandhi_server_send_chunked_end(cfd): i64 {
    sock_send(cfd, "0\r\n\r\n", 5);
    return 0;
}

# ================================================================
# Request reading — Content-Length aware
# ================================================================

# Request-read outcomes (1.9.4). Before 1.9.4 this fn had exactly one failure
# value (0 - 1, socket error) and reported EVERY other outcome as "here are N
# bytes" — including the two cases where those N bytes are not a whole request.
# A serve loop therefore could not tell a complete request from a truncated one
# and dispatched both. These sentinels close that: each is a distinct negative
# so the loop can answer with the right status instead of handing a handler a
# body that disagrees with its own Content-Length.
var SANDHI_SERVER_ERR_RECV       = 0 - 1;   # socket error            (pre-1.9.4 value)
var SANDHI_SERVER_ERR_TOO_LARGE  = 0 - 2;   # request exceeds `max`   -> answer 413
var SANDHI_SERVER_ERR_INCOMPLETE = 0 - 3;   # peer hung up mid-request -> answer 400

# Read a complete HTTP request from cfd into buf (up to max bytes). Reads until
# the request body is fully received (per Content-Length).
#
# Returns the total bytes read (> 0) for a COMPLETE request, 0 for a connection
# the peer closed without sending anything, or one of the three negative
# sentinels above. Always null-terminates buf at the byte count read.
#
# A `> 0` return is now a guarantee that buf holds a whole request. Callers must
# branch on the sentinels before the `n > 0` dispatch; a caller that only checks
# `n > 0` degrades safely (it closes the connection without answering) rather
# than dispatching a corrupt request, which is what pre-1.9.4 did.
fn sandhi_server_recv_request(cfd, buf, max): i64 {
    if (max <= 0) { return SANDHI_SERVER_ERR_RECV; }
    var have = 0;
    var need_body = 0 - 1;

    while (have < max) {
        var r_tag, n = sock_recv(cfd, buf + have, max - have);
        if (is_err_result(r_tag) == 1) { return SANDHI_SERVER_ERR_RECV; }
        if (n <= 0) {
            # Peer closed. `have == 0` is an idle connection that went away with
            # nothing to say — not an error. Anything else is a request that
            # started and never finished: either the header block never
            # terminated, or Content-Length promised bytes that never arrived.
            # Pre-1.9.4 both fell through to `return have`, so a handler could
            # be handed a half-written JSON body next to a Content-Length
            # claiming the whole thing.
            store8(buf + have, 0);
            if (have == 0) { return 0; }
            return SANDHI_SERVER_ERR_INCOMPLETE;
        }
        have = have + n;

        if (need_body == 0 - 1) {
            store8(buf + have, 0);
            var bo = sandhi_server_body_offset(buf, have);
            if (bo >= 0) {
                var clen = sandhi_server_content_length(buf, have);
                # 1.9.12 P1 — an unrepresentable Content-Length is refused, not
                # folded into `need_body` (where a negative made `have >=
                # need_body` true immediately and framed a body-less request as
                # complete).
                if (clen < 0) { return SANDHI_SERVER_ERR_TOO_LARGE; }
                need_body = bo + clen;
            }
        }
        if (need_body != 0 - 1 && have >= need_body) {
            store8(buf + have, 0);
            return have;
        }
    }
    # Buffer full with the request STILL incomplete — a complete one returns
    # from inside the loop the moment `have` reaches `need_body`, so reaching
    # here means the peer wants to send more than `max` will hold. Pre-1.9.4
    # this fell through to `return have`: silent truncation, no 413, the
    # handler left to trust a Content-Length that no longer described the body.
    store8(buf + have, 0);
    return SANDHI_SERVER_ERR_TOO_LARGE;
}

# Bounded lingering drain before closing a REFUSED request (1.9.4).
#
# Refusing an oversized or unframable request means we stop reading while the
# peer is still sending. close(2) with unread bytes in the receive queue makes
# the kernel send RST instead of FIN — and an RST can discard the 413/501 we
# just wrote before the client ever reads it. The client would then see a bare
# connection reset: no worse than a truncated dispatch to debug, which is not
# the trade we are here to make. So: read and discard what is already in
# flight, briefly, then close cleanly.
#
# Bounded on BOTH axes, because an oversized-body refusal must not become a
# way to hold a worker: a short SO_RCVTIMEO (the peer has to keep the bytes
# coming) and a byte budget. Past either we give up and let the RST happen —
# the same concession nginx makes with lingering_close_time/_max.
#
# `buf`/`buflen` is scratch; callers hand it their request buffer, which they
# are done with by this point.
var SANDHI_SERVER_DRAIN_MS  = 100;
var SANDHI_SERVER_DRAIN_MAX = 1048576;

# Reject-arena capacity (1.9.6). Every refusal a serve loop emits — 400, 413,
# 501 — is built before the user handler is reached, so a consumer's own arena
# discipline cannot cover it, and the bare `_send_*` wrappers draw from the
# no-free global bump. That made "send malformed requests" a way to grow RSS
# without bound. Each serve loop now owns one of these and rewinds it per
# request. A status line is ~176 B; 4 KiB is ample headroom for the longest
# reason phrase and the str_builder's growth steps, and it is allocated ONCE
# per worker (not per request), so the cost is 4 KiB × workers.
var SANDHI_SERVER_REJECT_ARENA_CAP = 4096;

# Reject arena for the two SINGLE-FLIGHT loops (run_opts / run_tls). They serve
# one connection at a time on one thread, so a process-wide arena is safe —
# same discipline as `_hsv_req_buf`, which they already share.
var _hsv_reject_arena = 0;

fn _hsv_ensure_reject_arena(): i64 {
    if (_hsv_reject_arena == 0) {
        _hsv_reject_arena = arena_allocator(SANDHI_SERVER_REJECT_ARENA_CAP);
    }
    return _hsv_reject_arena;
}

fn _sandhi_server_drain_refused(cfd, buf, buflen): i64 {
    if (buf == 0 || buflen <= 0) { return 0; }
    _sandhi_conn_set_timeout_ms(cfd, SANDHI_SERVER_DRAIN_MS, _SANDHI_SO_RCVTIMEO);
    var drained = 0;
    while (drained < SANDHI_SERVER_DRAIN_MAX) {
        var want = buflen;
        var left = SANDHI_SERVER_DRAIN_MAX - drained;
        if (left < want) { want = left; }
        var r_tag, n = sock_recv(cfd, buf, want);
        if (is_err_result(r_tag) == 1) { return drained; }   # timeout / error — done
        if (n <= 0) { return drained; }                  # peer finished
        drained = drained + n;
    }
    return drained;
}

# ================================================================
# Server lifecycle — bind, listen, accept-loop
# ================================================================

# Per-process request buffer (lazily allocated, reused across connections).
var _hsv_req_buf = 0;
var HSV_REQ_BUF_SIZE = 65536;

# 1.9.4 — the request cap is a per-server POLICY, not a compile-time constant.
# HSV_REQ_BUF_SIZE stays the default (and the floor for what a serve loop will
# allocate), but `sandhi_server_options_max_request` raises it for a consumer
# that must accept larger bodies. `_hsv_req_max` is the resolved value for the
# running server: written ONCE by the run_* entry point before any worker
# thread or cooperative task exists, read-only thereafter, which is what makes
# a plain global safe under run_pooled. `_hsv_req_buf_cap` tracks how big the
# process-wide singleton actually is so a raised cap re-allocates it.
var _hsv_req_max     = 65536;

# 1.9.7 — per-request arena size, published by the pooled entry points before
# any worker is spawned. 0 disables the arena.
var _hsv_req_arena_cap = 0;
var _hsv_req_buf_cap = 0;

# ================================================================
# Server options (added 0.7.2)
# ================================================================
#
# Struct layout (16 bytes):
#   +0   idle_ms    (int: per-connection recv timeout; 0 = blocking.
#                    Default 30000 = 30 s; matches Go `net/http.Server.
#                    IdleTimeout`. Slowloris guard — a peer that sends
#                    a partial request then stalls gets dropped.)
#   +8   max_conns  (int: reserved for 0.8.0+. Server today is single-
#                    threaded accept/serve; honoring this requires a
#                    thread-pool or epoll-based accept model, which is
#                    bigger than 0.7.2 budget. Getter/setter exist
#                    so the option survey-surface stays stable across
#                    0.7.2 → 0.8.0.)

#
# 1.6.8 extends the struct (16 → 64 bytes) for server-side TLS creds + a
# decoupled accept backlog. New fields are zeroed by options_new, so a
# plaintext caller that never touches them is byte-identical to pre-1.6.8
# (tls_on == 0 → the serve loops take the plaintext path).
#   +16  tls_cert      (ptr: cert chain bytes — leaf-first PEM or DER; 0 = none)
#   +24  tls_cert_len  (int: cert byte length)
#   +32  tls_key       (ptr: private key bytes — PEM or DER; Ed25519 / ECDSA
#                       P-256 / P-384 only, RSA unsupported by the native stack)
#   +40  tls_key_len   (int: key byte length)
#   +48  tls_on        (int: 1 once sandhi_server_options_tls() set creds)
#   +56  backlog       (int: kernel listen backlog AND pooled handoff-channel
#                       depth — DECOUPLED from max_conns/worker count, 1.6.8.
#                       Default 128. A burst beyond the worker count now queues
#                       up to `backlog` accepted conns instead of being sized to
#                       the worker pool — the yeo-cy-test 🔵 handoff-depth fix.)
#
# 1.9.4 extends the struct (64 → 72 bytes) with the request cap. Zeroed by
# options_new for a caller that never touches it, and `get_max_request` reads a
# 0 as "unset" → the 64 KiB default, so a hand-zeroed struct behaves exactly as
# it did pre-1.9.4.
#   +64  max_request   (int: largest whole request — headers + body — the serve
#                       loop will buffer, in bytes. Default HSV_REQ_BUF_SIZE
#                       (64 KiB). A request that exceeds it is answered 413
#                       rather than truncated. THIS IS A MEMORY KNOB: the
#                       pooled loops allocate one buffer PER WORKER and the
#                       cooperative loop one PER IN-FLIGHT CONN, so the
#                       worst-case footprint is max_request × max_conns —
#                       10 MiB × 128 workers is 1.28 GiB. Raise the cap and
#                       lower the worker count together.)

enum SandhiServerOptOff {
    SANDHI_SERVER_OPT_OFF_IDLE_MS      = 0;
    SANDHI_SERVER_OPT_OFF_MAX_CONNS    = 8;
    SANDHI_SERVER_OPT_OFF_TLS_CERT     = 16;
    SANDHI_SERVER_OPT_OFF_TLS_CERT_LEN = 24;
    SANDHI_SERVER_OPT_OFF_TLS_KEY      = 32;
    SANDHI_SERVER_OPT_OFF_TLS_KEY_LEN  = 40;
    SANDHI_SERVER_OPT_OFF_TLS_ON       = 48;
    SANDHI_SERVER_OPT_OFF_BACKLOG      = 56;
    SANDHI_SERVER_OPT_OFF_MAX_REQUEST  = 64;
    SANDHI_SERVER_OPT_OFF_REQ_ARENA    = 72;
    SANDHI_SERVER_OPT_OFF_STOP_FLAG    = 80;
}

var SANDHI_SERVER_OPT_STRUCT_SIZE = 88;
var SANDHI_SERVER_DEFAULT_IDLE_MS = 30000;
var SANDHI_SERVER_DEFAULT_MAX_CONNS = 128;
var SANDHI_SERVER_DEFAULT_BACKLOG = 128;

# Floor for `max_request`. A cap below this cannot hold a realistic header
# block, so every request would 413 — almost certainly a caller bug (or a
# zeroed struct), and treated as "unset" rather than honored.
var SANDHI_SERVER_MIN_MAX_REQUEST = 4096;

# 1.9.7 — per-request handler arena, opt-in.
#
# The reject arena added in 1.9.6 covers only the refusals the worker itself
# emits, all of which happen BEFORE the user handler runs. Everything from
# `fncall4(fp, ...)` onward — the handler, and the routing accessors
# `sandhi_server_get_method` / `_get_path` / `_path_only` that
# `sandhi_router_dispatch` calls on every request — still allocates on the
# no-free global bump. For a long-running server that is unbounded growth
# proportional to requests served, which is what the module note above
# ("arena adoption ... is the answer") has been pointing at.
#
# Setting this to a non-zero byte count gives each worker thread an arena that
# is rewound at the top of every request. `sandhi_server_router_handler` picks
# it up automatically, so a consumer already using the router gets bounded
# per-request allocation by setting one option and changing no code. A handler
# that allocates its own working memory can reach the same arena through
# `sandhi_server_request_arena`.
#
# Default 0 (disabled) so existing consumers are bit-for-bit unaffected: an
# arena changes *where* allocations land, and a handler that returns pointers
# into it expecting global-bump lifetime would break. Opting in is the caller
# asserting their handler does not outlive the request.
var SANDHI_SERVER_DEFAULT_REQ_ARENA = 65536;

# Thread-local slot holding this worker's request arena, or 0 when disabled.
# Allocated once, lazily, on the accept thread before any worker is spawned.
var _sandhi_req_arena_slot = 0 - 1;

# Per-request arena for the calling worker thread, or 0 when not enabled.
#
# Valid only for the duration of one handler invocation: the worker rewinds it
# before the next request, so anything still pointing into it becomes garbage.
# Returns 0 under `run` / `run_async`, which have no worker threads to own one.
fn sandhi_server_request_arena(): i64 {
    if (_sandhi_req_arena_slot < 0) { return 0; }
    return thread_local_get(_sandhi_req_arena_slot);
}

# Bytes of per-request arena each pooled worker gets. 0 disables it.
fn sandhi_server_options_req_arena(opts, n): i64 {
    if (opts == 0) { return 0; }
    store64(opts + SANDHI_SERVER_OPT_OFF_REQ_ARENA, n);
    return 0;
}

# The configured per-request arena size, or 0 when disabled.
fn sandhi_server_options_get_req_arena(opts): i64 {
    if (opts == 0) { return 0; }
    var n = load64(opts + SANDHI_SERVER_OPT_OFF_REQ_ARENA);
    if (n < 0) { return 0; }
    return n;
}

fn sandhi_server_options_new_a(a): i64 {
    var o = alloc_via(a, SANDHI_SERVER_OPT_STRUCT_SIZE);
    if (o == 0) { return 0; }
    store64(o + SANDHI_SERVER_OPT_OFF_IDLE_MS, SANDHI_SERVER_DEFAULT_IDLE_MS);
    store64(o + SANDHI_SERVER_OPT_OFF_MAX_CONNS, SANDHI_SERVER_DEFAULT_MAX_CONNS);
    store64(o + SANDHI_SERVER_OPT_OFF_TLS_CERT, 0);
    store64(o + SANDHI_SERVER_OPT_OFF_TLS_CERT_LEN, 0);
    store64(o + SANDHI_SERVER_OPT_OFF_TLS_KEY, 0);
    store64(o + SANDHI_SERVER_OPT_OFF_TLS_KEY_LEN, 0);
    store64(o + SANDHI_SERVER_OPT_OFF_TLS_ON, 0);
    store64(o + SANDHI_SERVER_OPT_OFF_BACKLOG, SANDHI_SERVER_DEFAULT_BACKLOG);
    store64(o + SANDHI_SERVER_OPT_OFF_MAX_REQUEST, HSV_REQ_BUF_SIZE);
    store64(o + SANDHI_SERVER_OPT_OFF_REQ_ARENA, 0);
    store64(o + SANDHI_SERVER_OPT_OFF_STOP_FLAG, 0);
    return o;
}

fn sandhi_server_options_new(): i64 {
    return sandhi_server_options_new_a(default_alloc());
}

fn sandhi_server_options_idle_ms(opts, ms): i64 {
    store64(opts + SANDHI_SERVER_OPT_OFF_IDLE_MS, ms);
    return 0;
}

fn sandhi_server_options_max_conns(opts, n): i64 {
    store64(opts + SANDHI_SERVER_OPT_OFF_MAX_CONNS, n);
    return 0;
}

fn sandhi_server_options_get_idle_ms(opts): i64 {
    if (opts == 0) { return SANDHI_SERVER_DEFAULT_IDLE_MS; }
    return load64(opts + SANDHI_SERVER_OPT_OFF_IDLE_MS);
}

fn sandhi_server_options_get_max_conns(opts): i64 {
    if (opts == 0) { return SANDHI_SERVER_DEFAULT_MAX_CONNS; }
    return load64(opts + SANDHI_SERVER_OPT_OFF_MAX_CONNS);
}

# Enable server-side TLS on these options. `cert` is the server cert chain
# (leaf-first), `key` the matching private key — both as raw bytes (PEM or
# DER; the native stack auto-detects). Keys: Ed25519 / ECDSA P-256 / P-384
# (RSA is not supported by the native server stack). The buffers are
# BORROWED by pointer (not copied) — they must outlive the server, so pass
# process-lifetime buffers (e.g. read once at startup). Sets tls_on so the
# `_tls` serve loops take the TLS path; the plaintext loops ignore it.
fn sandhi_server_options_tls(opts, cert, cert_len, key, key_len): i64 {
    if (opts == 0) { return 0; }
    store64(opts + SANDHI_SERVER_OPT_OFF_TLS_CERT, cert);
    store64(opts + SANDHI_SERVER_OPT_OFF_TLS_CERT_LEN, cert_len);
    store64(opts + SANDHI_SERVER_OPT_OFF_TLS_KEY, key);
    store64(opts + SANDHI_SERVER_OPT_OFF_TLS_KEY_LEN, key_len);
    store64(opts + SANDHI_SERVER_OPT_OFF_TLS_ON, 1);
    return 0;
}

fn sandhi_server_options_get_tls(opts): i64 {
    if (opts == 0) { return 0; }
    return load64(opts + SANDHI_SERVER_OPT_OFF_TLS_ON);
}

# Accept backlog: the kernel `listen()` backlog AND, for the pooled servers,
# the depth of the accepted-connection handoff channel. DECOUPLED from
# `max_conns` (the worker count) as of 1.6.8 so a spiky burst beyond the
# worker count queues up to `backlog` connections instead of being sized to
# the pool. Default 128.
fn sandhi_server_options_backlog(opts, n): i64 {
    if (opts == 0) { return 0; }
    store64(opts + SANDHI_SERVER_OPT_OFF_BACKLOG, n);
    return 0;
}

fn sandhi_server_options_get_backlog(opts): i64 {
    if (opts == 0) { return SANDHI_SERVER_DEFAULT_BACKLOG; }
    var b = load64(opts + SANDHI_SERVER_OPT_OFF_BACKLOG);
    if (b < 1) { b = SANDHI_SERVER_DEFAULT_BACKLOG; }
    return b;
}

# Largest whole request (headers + body) the serve loop will buffer, in bytes.
# A request that exceeds it is answered 413 Payload Too Large and the
# connection closed — it is NOT truncated into the handler (1.9.4).
#
# Costs memory: the pooled loops allocate one buffer per worker and the
# cooperative loop one per in-flight connection, so budget
# `max_request × max_conns`. Raising this to 10 MiB without also lowering
# `max_conns` from its 128 default asks for 1.28 GiB of buffers.
fn sandhi_server_options_max_request(opts, bytes): i64 {
    if (opts == 0) { return 0; }
    store64(opts + SANDHI_SERVER_OPT_OFF_MAX_REQUEST, bytes);
    return 0;
}

# Resolved cap. A missing options struct, or a value below
# SANDHI_SERVER_MIN_MAX_REQUEST (which includes the 0 of a hand-zeroed
# pre-1.9.4 struct), reads as "unset" → the 64 KiB default.
fn sandhi_server_options_get_max_request(opts): i64 {
    if (opts == 0) { return HSV_REQ_BUF_SIZE; }
    var m = load64(opts + SANDHI_SERVER_OPT_OFF_MAX_REQUEST);
    if (m < SANDHI_SERVER_MIN_MAX_REQUEST) { return HSV_REQ_BUF_SIZE; }
    return m;
}

# --- 1.9.9 — cooperative stop -------------------------------------------
#
# How often a stop-enabled accept loop wakes to re-read the flag. This is the
# SO_RCVTIMEO applied to the LISTEN fd, so it is also the worst-case latency
# between a caller setting the flag and the loop returning.
#
# 100 ms is chosen against the alternative of `accept` blocking forever: it
# costs ten wakeups a second on an idle listener — each an `accept` returning
# EAGAIN and one flag load, with no syscall storm and no allocation — and
# bounds shutdown at a tenth of a second. Nothing depends on the exact value;
# it is a latency/wakeup trade a consumer never has to think about.
var SANDHI_SERVER_STOP_POLL_MS = 100;

# Point the serve loops at a caller-owned stop flag, or 0 to disable.
#
# `ptr` addresses one 8-byte, 8-byte-aligned slot the caller owns. **Any
# non-zero value means stop.** The loop re-reads it between accepts and, when
# it is set, tears down in the same order a fatal accept does — handoff channel
# first so pooled workers unpark rather than parking on a channel nobody will
# feed — and returns **0**.
#
# That return value is the whole contract: every serve loop returns **1** for
# every failure, and previously never returned any other way, so **0 now means
# and only means "you asked me to stop, and I did."** A caller can map the two
# straight onto a clean exit and a fatal one.
#
# **Setting this is what enables stopping at all.** With no flag the listen fd
# keeps its blocking-accept behaviour and the loop is bit-for-bit what it was
# before 1.9.9 — no timeout, no wakeups, no behaviour change for any existing
# consumer. With a flag, the listen fd gets `SANDHI_SERVER_STOP_POLL_MS` of
# SO_RCVTIMEO so `accept` surfaces periodically; the resulting EAGAIN is
# already classified RETRY and already leaves the accept-failure counters
# untouched, so polling cannot walk the loop toward its give-up bound.
#
# **A plain `store64` from another thread or a signal handler is sufficient.**
# The flag is only ever read, never written, by the serve loop, and an aligned
# 8-byte store is single-copy-atomic on every target sandhi builds for, so
# there is nothing to tear and no ordering to establish — this deliberately
# does NOT pull `lib/atomic.cyr` into sandhi's dependency set for one flag.
#
# In-flight requests are NOT drained: the loop stops accepting, and pooled
# workers already holding a connection finish it because the channel closes
# rather than the worker being killed. A caller wanting a hard bound on that
# tail should set `idle_ms`.
fn sandhi_server_options_stop_flag(opts, ptr): i64 {
    if (opts == 0) { return 0; }
    store64(opts + SANDHI_SERVER_OPT_OFF_STOP_FLAG, ptr);
    return 0;
}

# The configured stop-flag pointer, or 0 when cooperative stop is disabled.
fn sandhi_server_options_get_stop_flag(opts): i64 {
    if (opts == 0) { return 0; }
    return load64(opts + SANDHI_SERVER_OPT_OFF_STOP_FLAG);
}

# 1 if `ptr` is a live stop flag currently asking the loop to stop.
#
# A 0 pointer is "no flag configured", which is never a stop — that keeps the
# call site a single unconditional check rather than a nested one.
fn _sandhi_server_stop_requested(ptr): i64 {
    if (ptr == 0) { return 0; }
    if (load64(ptr) != 0) { return 1; }
    return 0;
}

# Arm the listen fd so a stop-enabled loop can surface between accepts.
#
# No-op without a flag, which is what keeps the default path unchanged. On
# AGNOS `sock_set_recv_timeout` is a no-op and accept is already non-blocking,
# so the loop poll-spins there exactly as it did before and the flag is still
# honoured on every pass.
fn _sandhi_server_arm_stop_poll(sfd, stop_ptr): i64 {
    if (stop_ptr == 0) { return 0; }
    return _sandhi_conn_set_timeout_ms(sfd, SANDHI_SERVER_STOP_POLL_MS,
      _SANDHI_SO_RCVTIMEO);
}

# Resolve the cap for the server about to start and publish it to `_hsv_req_max`
# for the worker/task bodies. Called by every run_* entry point BEFORE any
# thread is spawned or any cooperative task queued — the single-writer
# discipline that lets the workers read the global without synchronisation.
fn _hsv_resolve_req_max(opts): i64 {
    var m = sandhi_server_options_get_max_request(opts);
    _hsv_req_max = m;
    return m;
}

# Ensure the process-wide singleton buffer is at least `want` bytes. Used by the
# two single-flight loops (run_opts / run_tls), which share one buffer because
# they serve one connection at a time. Returns 0 on OOM.
fn _hsv_ensure_req_buf(want): i64 {
    if (_hsv_req_buf != 0 && _hsv_req_buf_cap >= want) { return _hsv_req_buf; }
    var b = alloc_via(default_alloc(), want);
    if (b == 0) { return 0; }
    _hsv_req_buf = b;
    _hsv_req_buf_cap = want;
    return b;
}

# ================================================================
# SIGPIPE guard (1.6.6) — security fix (yeo-cy-test probe finding)
# ================================================================
# `net.cyr`'s `sock_send` is a bare `sys_write` with NO `MSG_NOSIGNAL`,
# so a peer that closes the connection mid-response makes the kernel
# raise SIGPIPE — whose DEFAULT disposition terminates the process. That
# is a trivial unauthenticated remote DoS against any sandhi server: a
# client that sends a request line then disconnects (or drops during the
# response write) kills the whole server (verified by the yeo-cy-test
# probe — signal 13). The server owns the process lifecycle, so it
# installs `SIG_IGN` for SIGPIPE once at startup; a send to a dead peer
# then fails with EPIPE on the `sock_send` (whose return both serve loops
# already ignore) instead of terminating the process.
#
# Why a raw syscall here (the one place the server path reaches past a
# stdlib helper): `sock_send` can't pass MSG_NOSIGNAL (the primitive has
# no flags arg, and forking it is forbidden — CLAUDE.md) and stdlib
# exposes no signal-disposition helper (no `signal_ignore`, and SIGPIPE
# isn't even in the `Signal` enum). The proper long-term home is a stdlib
# `signal_ignore(signum)` / `sock_send` MSG_NOSIGNAL — filed as a roadmap
# deferral; when it lands this migrates onto it, exactly as 1.6.1/1.6.2
# migrated conn.cyr's raw socket syscalls onto `net.cyr` helpers.
#
# Portability: `rt_sigaction(SIGPIPE, SIG_IGN)`. SIGPIPE = 13 and
# SIG_IGN = 1 on every Linux arch; the kernel `struct sigaction` is
# {sa_handler, sa_flags, [sa_restorer], sa_mask}. A 32-byte buffer zeroed
# except sa_handler = SIG_IGN is correct for BOTH x86_64 (sa_restorer at
# +16, sa_mask at +24) and aarch64 (sa_mask at +16, no restorer): every
# field past sa_handler is 0, so flags = 0 / mask = 0 whichever ABI reads
# where, and no SA_RESTORER is needed because an ignored signal is never
# delivered. Only the syscall number differs (x86_64 = 13, aarch64 = 134).
# macOS/Windows: no raw rt_sigaction (the macOS ESYSXLAT whitelist
# doesn't cover sigaction, so a raw call would mis-dispatch) — left a
# no-op pending the stdlib helper (roadmap: macOS SIGPIPE guard). AGNOS:
# no signals + no inbound TCP server (`sock_listen` Errs before the loop),
# so moot. Idempotent + cheap; called once per server start (the loops
# never return), so re-installing on every entry is fine.
var _SANDHI_SIGPIPE = 13;
var _SANDHI_SIG_IGN = 1;

fn _sandhi_server_ignore_sigpipe(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    # alloc (8-byte aligned, unlike a stack buffer on aarch64) — leaked
    # once at startup, negligible; the server loop never returns.
    var sa = alloc_via(default_alloc(), 32);
    if (sa == 0) { return 0; }      # OOM at startup — skip guard, don't crash
    store64(sa, _SANDHI_SIG_IGN);   # sa_handler = SIG_IGN
    store64(sa + 8, 0);             # sa_flags = 0 (no SA_RESTORER needed for IGN)
    store64(sa + 16, 0);            # x86_64 sa_restorer / aarch64 sa_mask
    store64(sa + 24, 0);            # x86_64 sa_mask
    #ifdef CYRIUS_ARCH_X86
    return syscall(13, _SANDHI_SIGPIPE, sa, 0, 8);    # SYS_rt_sigaction = 13
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    return syscall(134, _SANDHI_SIGPIPE, sa, 0, 8);   # SYS_rt_sigaction = 134
    #endif
    #endif
    return 0;
}

# ================================================================
# Accept-error policy (1.9.8)
# ================================================================
# Through 1.9.7 every serve loop here was
#
#     while (1 == 1) { var cr = sock_accept(sfd); if (is_err_result(cr) == 0) { … } }
#
# with NO else branch, on a blocking listen socket. On any persistent
# accept error — EMFILE, ENFILE, EBADF, EINVAL, ENOTSOCK — that re-issues
# accept(2) immediately, forever: 100% of one core, no backoff, no bound,
# no diagnostic. Under EMFILE it is worse than a plain spin, because the
# pending connection is never dequeued: the same connection is retried at
# full speed and the peer is never served.
#
# Reported by bote, whose http / streamable / ws / bridge transports are
# each a one-line delegation to `sandhi_server_run`, so all four inherited
# the defect. bote 3.2.1 fixed its own hand-rolled copy of this loop
# (`_unix_accept_action` in its src/transport_unix.cyr) and this is the
# same policy, generalised across sandhi's five accept sites.
#
# Split into three pieces on purpose:
#   * `_sandhi_accept_action`       — pure errno → action classifier
#   * `_sandhi_accept_backoff_next` — pure delay schedule
#   * `_sandhi_accept_step`         — advances caller-owned state, and
#                                     RETURNS the delay rather than
#                                     sleeping it
# The caller does the sleeping. That is what keeps the give-up bound
# unit-testable in milliseconds: driving all 200 steps through a fn that
# slept would take ~48 s of real time.

enum SandhiAcceptAction {
    SANDHI_ACCEPT_RETRY   = 0;   # transient — accept again immediately
    SANDHI_ACCEPT_BACKOFF = 1;   # resource pressure — sleep, then accept again
    SANDHI_ACCEPT_FATAL   = 2;   # listener unusable — hand back to the caller
}

# errno values used by the classifier. Locally namespaced `_SANDHI_ERRNO_*`
# rather than taken from the stdlib `Errno` enum on purpose: enum constants
# share one flat global namespace under "last definition wins", and sandhi
# links sigil, which defines its OWN EINTR / EBADF / EAGAIN / EINVAL block
# (lib/sigil.cyr) after the syscall peer in `[deps] stdlib` order. The
# values agree today; the classifier should not depend on that continuing
# to be true. EAGAIN reuses `_SANDHI_EAGAIN` (src/http/conn.cyr), which is
# already the module-wide spelling.
var _SANDHI_ERRNO_EINTR        = 4;
var _SANDHI_ERRNO_EBADF        = 9;
var _SANDHI_ERRNO_EINVAL       = 22;
var _SANDHI_ERRNO_EPROTO       = 71;
var _SANDHI_ERRNO_ENOTSOCK     = 88;
var _SANDHI_ERRNO_EOPNOTSUPP   = 95;
var _SANDHI_ERRNO_ECONNABORTED = 103;

# Capped exponential backoff: 1 ms doubling to 250 ms, reset on any
# successful accept. SANDHI_ACCEPT_GIVEUP consecutive backoffs (~48 s once
# the cap is reached: 1+2+4+…+128 = 255 ms, then 250 ms × 192) end the loop
# rather than sleeping forever on a listener that is never coming back.
var SANDHI_ACCEPT_BACKOFF_MIN_MS = 1;
var SANDHI_ACCEPT_BACKOFF_MAX_MS = 250;
var SANDHI_ACCEPT_GIVEUP         = 200;

# Classify a POSITIVE errno from accept(2). Pure.
#
# Unknown errnos fall to BACKOFF, not FATAL, on purpose: misclassifying a
# recoverable condition as fatal would take a working server down, while
# backoff is wrong only in that it wastes up to ~48 s before the give-up
# counter ends the loop. Sleeping is never as bad as spinning.
#
# This also covers the AGNOS path, where `sock_accept` reports both "fd
# isn't a LISTEN socket" and "conn table full" as a bare `Err(1)` (EPERM):
# unknown → BACKOFF → bounded give-up, instead of an unbounded spin.
fn _sandhi_accept_action(err): i64 {
    # Transient — this connection attempt failed, the listener is fine.
    if (err == _SANDHI_ERRNO_EINTR)        { return SANDHI_ACCEPT_RETRY; }
    if (err == _SANDHI_ERRNO_ECONNABORTED) { return SANDHI_ACCEPT_RETRY; }
    if (err == _SANDHI_ERRNO_EPROTO)       { return SANDHI_ACCEPT_RETRY; }
    # EAGAIN is the steady state on THREE paths and must never be slowed:
    # `sandhi_server_run_async`'s non-blocking drain (queue empty); every loop
    # on AGNOS, where `sock_accept` is non-blocking by construction and the
    # server poll-loops; and — since 1.9.9 — any loop with a stop flag, whose
    # listen fd carries SANDHI_SERVER_STOP_POLL_MS of SO_RCVTIMEO so it can
    # re-read the flag.
    #
    # **RETRY here is load-bearing for cooperative stop, not incidental.**
    # `_sandhi_accept_step` returns on RETRY *before* touching the counters, so
    # an idle stop-enabled listener can poll indefinitely without walking
    # toward SANDHI_ACCEPT_GIVEUP. Reclassifying this as BACKOFF would make an
    # idle server shut itself down after ~200 polls.
    if (err == _SANDHI_EAGAIN)             { return SANDHI_ACCEPT_RETRY; }

    # Structurally fatal — accept on this fd can never succeed again.
    if (err == _SANDHI_ERRNO_EBADF)        { return SANDHI_ACCEPT_FATAL; }
    if (err == _SANDHI_ERRNO_EINVAL)       { return SANDHI_ACCEPT_FATAL; }
    if (err == _SANDHI_ERRNO_ENOTSOCK)     { return SANDHI_ACCEPT_FATAL; }
    if (err == _SANDHI_ERRNO_EOPNOTSUPP)   { return SANDHI_ACCEPT_FATAL; }

    # EMFILE / ENFILE / ENOBUFS / ENOMEM and anything unrecognised.
    return SANDHI_ACCEPT_BACKOFF;
}

# Next backoff delay in ms given the current one (0 = none yet). Pure.
fn _sandhi_accept_backoff_next(cur_ms): i64 {
    if (cur_ms <= 0) { return SANDHI_ACCEPT_BACKOFF_MIN_MS; }
    var next = cur_ms * 2;
    if (next > SANDHI_ACCEPT_BACKOFF_MAX_MS) { return SANDHI_ACCEPT_BACKOFF_MAX_MS; }
    return next;
}

# Per-loop accept-failure state (16 B): { backoff_ms, consecutive }.
# Caller-owned so the policy carries no globals — the pooled loops run one
# accept thread each but the shape stays reentrant either way.
enum SandhiAcceptStateOff {
    SANDHI_ACCEPT_ST_DELAY = 0;
    SANDHI_ACCEPT_ST_COUNT = 8;
}
var SANDHI_ACCEPT_STATE_SIZE = 16;

# Allocate a zeroed accept-failure state. Drawn from the global bump, once
# per serve loop — the loops never return on the success path, so this is a
# fixed 16 bytes, not per-connection. Returns 0 on OOM (callers bail).
fn _sandhi_accept_state_new(): i64 {
    var st = alloc_via(default_alloc(), SANDHI_ACCEPT_STATE_SIZE);
    if (st == 0) { return 0; }
    store64(st + SANDHI_ACCEPT_ST_DELAY, 0);
    store64(st + SANDHI_ACCEPT_ST_COUNT, 0);
    return st;
}

# Clear the failure state. Call on every successful accept — the bound is on
# CONSECUTIVE failures, so one served connection forgives the whole streak.
fn _sandhi_accept_state_reset(st): i64 {
    if (st == 0) { return 0; }
    store64(st + SANDHI_ACCEPT_ST_DELAY, 0);
    store64(st + SANDHI_ACCEPT_ST_COUNT, 0);
    return 0;
}

# The delay the last `_sandhi_accept_step` decided on, in ms. Only meaningful
# immediately after that call returned SANDHI_ACCEPT_BACKOFF.
fn _sandhi_accept_state_delay(st): i64 {
    if (st == 0) { return 0; }
    return load64(st + SANDHI_ACCEPT_ST_DELAY);
}

# Advance `st` for a failed accept carrying POSITIVE errno `err`, and return
# what the loop must do. On SANDHI_ACCEPT_BACKOFF the caller sleeps
# `_sandhi_accept_state_delay(st)` ms. FATAL is returned both for a
# structurally dead listener and once the consecutive-failure bound trips.
#
# RETRY deliberately leaves the counters ALONE rather than resetting them:
# only a real accepted connection clears the streak, so an EMFILE storm
# sprinkled with EINTR still converges on the give-up bound.
fn _sandhi_accept_step(st, err): i64 {
    var act = _sandhi_accept_action(err);
    if (act == SANDHI_ACCEPT_RETRY) { return SANDHI_ACCEPT_RETRY; }
    if (act == SANDHI_ACCEPT_FATAL) { return SANDHI_ACCEPT_FATAL; }
    if (st == 0) { return SANDHI_ACCEPT_FATAL; }
    var n = load64(st + SANDHI_ACCEPT_ST_COUNT) + 1;
    store64(st + SANDHI_ACCEPT_ST_COUNT, n);
    if (n > SANDHI_ACCEPT_GIVEUP) { return SANDHI_ACCEPT_FATAL; }
    var d = _sandhi_accept_backoff_next(load64(st + SANDHI_ACCEPT_ST_DELAY));
    store64(st + SANDHI_ACCEPT_ST_DELAY, d);
    return SANDHI_ACCEPT_BACKOFF;
}

# Bind addr:port, listen, accept-loop. For each connection:
#   read full request → call handler_fp(ctx, cfd, buf, bytes) → close cfd.
#
# `addr` is a network-order IPv4 (use INADDR_ANY() for 0.0.0.0,
# INADDR_LOOPBACK() for 127.0.0.1). `handler_fp` must have the signature:
#   fn handler(ctx, cfd, req_buf, req_len) → 0
#
# Returns 1 on bind/listen failure; never returns on success (loops forever).
fn sandhi_server_run(addr, port, handler_fp, ctx): i64 {
    return sandhi_server_run_opts(addr, port, handler_fp, ctx, 0);
}

# Opts-aware variant. Applies SO_RCVTIMEO on each accepted connection
# to bound slow/idle peers (slowloris guard). max_conns is accepted
# but not honored today — server stays single-threaded until 0.8.0.
fn sandhi_server_run_opts(addr, port, handler_fp, ctx, opts): i64 {
    # 1.6.6 security fix: ignore SIGPIPE so a peer that disconnects
    # mid-response can't kill the process (sock_send is MSG_NOSIGNAL-less).
    _sandhi_server_ignore_sigpipe();

    # _hsv_req_buf is a process-wide singleton shared across every
    # accepted connection — it must outlive any per-request arena, so
    # always allocate from the global bump.
    var max_req = _hsv_resolve_req_max(opts);
    if (_hsv_ensure_req_buf(max_req) == 0) { return 1; }
    if (_hsv_ensure_reject_arena() == 0) { return 1; }   # 1.9.6

    var idle_ms = sandhi_server_options_get_idle_ms(opts);
    var stop_ptr = sandhi_server_options_get_stop_flag(opts);   # 1.9.9

    var sfd_tag, sfd = tcp_socket();
    if (is_err_result(sfd_tag) == 1) { return 1; }
    sock_reuse(sfd);

    var br_tag, br = sock_bind(sfd, addr, port);
    if (is_err_result(br_tag) == 1) { return 1; }

    var lr_tag, lr = sock_listen(sfd, 16);
    if (is_err_result(lr_tag) == 1) { return 1; }

    # 1.9.9 — no-op unless a stop flag is configured.
    _sandhi_server_arm_stop_poll(sfd, stop_ptr);

    # 1.9.8 — accept-failure state; see the accept-error policy block above.
    var ast = _sandhi_accept_state_new();
    if (ast == 0) { sock_close(sfd); return 1; }

    while (1 == 1) {
        # 1.9.9 — checked before accept, so a flag set before the loop starts
        # stops it without serving anything.
        if (_sandhi_server_stop_requested(stop_ptr) == 1) { sock_close(sfd); return 0; }
        var cr_tag, cr = sock_accept(sfd);
        if (is_err_result(cr_tag) == 1) {
            # 1.9.8: was no else branch at all — a 100%-CPU spin forever on
            # any persistent error, and under EMFILE the pending connection
            # was never dequeued so it re-raced the same one.
            var act = _sandhi_accept_step(ast, cr);
            if (act == SANDHI_ACCEPT_FATAL) { sock_close(sfd); return 1; }
            if (act == SANDHI_ACCEPT_BACKOFF) { sleep_ms(_sandhi_accept_state_delay(ast)); }
        } else {
            _sandhi_accept_state_reset(ast);
            var cfd = cr;
            # Apply per-connection idle timeout (slowloris guard).
            # _sandhi_conn_set_timeout_ms is sandhi/http/conn.cyr's
            # setsockopt helper — works on any socket fd, not just
            # client-side ones.
            if (idle_ms > 0) {
                _sandhi_conn_set_timeout_ms(cfd, idle_ms, _SANDHI_SO_RCVTIMEO);
            }
            reset_via(_hsv_reject_arena);                    # 1.9.6
            var n = sandhi_server_recv_request(cfd, _hsv_req_buf, max_req - 1);
            # 1.9.4 — answer the two "not a whole request" outcomes instead of
            # dispatching them. 1.9.6 — build every refusal on the reject arena.
            if (n == SANDHI_SERVER_ERR_TOO_LARGE) {
                sandhi_server_send_status_a(_hsv_reject_arena, cfd, HTTP_PAYLOAD_TOO_LARGE, "Payload Too Large");
                _sandhi_server_drain_refused(cfd, _hsv_req_buf, max_req);
            } elif (n == SANDHI_SERVER_ERR_INCOMPLETE) {
                # Peer already hung up — nothing left in flight to drain.
                sandhi_server_send_status_a(_hsv_reject_arena, cfd, HTTP_BAD_REQUEST, "Bad Request");
            } elif (n > 0) {
                # 0.9.0 P0 #2 — reject CL+TE coexistence with 400
                # (smuggling vector, RFC 7230 §3.3.3).
                # 0.9.1 P1 — also reject Host.Host / CL.CL / TE.TE
                # duplicates (smuggling vector, RFC 7230 §3.3.2 + §5.4).
                if (sandhi_server_request_has_cl_te_conflict(_hsv_req_buf, n) == 1) {
                    sandhi_server_send_status_a(_hsv_reject_arena, cfd, 400, "Bad Request");
                } elif (sandhi_server_request_has_dup_smuggling_header(_hsv_req_buf, n) == 1) {
                    sandhi_server_send_status_a(_hsv_reject_arena, cfd, 400, "Bad Request");
                } elif (sandhi_server_request_has_unsupported_te(_hsv_req_buf, n) == 1) {
                    sandhi_server_send_status_a(_hsv_reject_arena, cfd, HTTP_NOT_IMPLEMENTED, "Not Implemented");  #skip-lint: HTTP 501 status code — inbound transfer-coding decoding deferred, see CHANGELOG 1.9.4
                    _sandhi_server_drain_refused(cfd, _hsv_req_buf, max_req);
                } else {
                    fncall4(handler_fp, ctx, cfd, _hsv_req_buf, n);
                }
            }
            sock_close(cfd);
        }
    }
    return 0;
}

# ================================================================
# Epoll-cooperative server (1.4.9) — sandhi_server_run_async
# ================================================================
# Honors `sandhi_server_options_max_conns` as the per-drain concurrency
# cap, composing the stdlib cooperative runtime `lib/async.cyr`. The
# decided worker shape (roadmap 1.4.9): epoll-cooperative, not a thread
# pool — the handler stays single-threaded/cooperative (no thread-safety
# requirement) and must not block indefinitely. Absorbs daimon's
# `serve_async` pattern so daimon can collapse its hand-rolled accept
# loop + per-call buffer + smuggling-check duplication onto this one call
# (docs/issues/2026-05-10-daimon-server-max-conns.md).
#
# The sync single-flight `sandhi_server_run` / `sandhi_server_run_opts`
# are unchanged — this is an opt-in concurrent variant.

# Per-connection async handler argument (32 bytes), allocated from the
# per-batch arena: { cfd, handler_fp, ctx, req_buf }.
enum SandhiAsyncArgOff {
    SANDHI_ASYNC_ARG_CFD = 0;
    SANDHI_ASYNC_ARG_FP  = 8;
    SANDHI_ASYNC_ARG_CTX = 16;
    SANDHI_ASYNC_ARG_BUF = 24;
}

# One handler task per accepted connection: recv (SO_RCVTIMEO-bounded),
# smuggling-reject (the same fns the sync loop uses), dispatch to the
# user handler, close. The recv buffer is PER-HANDLER (passed in `arg`) —
# the no-interleave invariant sandhi owns under a concurrent server. The
# sync path's process-global `_hsv_req_buf` is unsafe here because two
# handlers could interleave their recv loops if the runtime ever gains
# true preemption; per-handler buffers are correct regardless.
#
# NOTE: we do NOT `async_await_readable(cfd)` first — `lib/async.cyr`'s
# await is an `epoll_wait(..., -1)` with an INFINITE timeout, so a client
# that connects and never sends would block the whole cooperative loop
# forever (a trivial DoS). The runtime is run-to-completion (no
# preemption), so the await buys no concurrency anyway; the SO_RCVTIMEO'd
# recv (idle_ms, floored > 0 by the caller) is the bounded wait.
fn _sandhi_server_async_handler(arg): i64 {
    var cfd = load64(arg + SANDHI_ASYNC_ARG_CFD);
    var fp  = load64(arg + SANDHI_ASYNC_ARG_FP);
    var ctx = load64(arg + SANDHI_ASYNC_ARG_CTX);
    var buf = load64(arg + SANDHI_ASYNC_ARG_BUF);

    # 1.9.6 — refusals ride the process reject arena, NOT the per-batch arena:
    # the per-conn budget there (arg 32 + buf + task 32) is sized exactly and has
    # no slack for a response. Safe to share and to rewind here because
    # lib/async.cyr is run-to-completion with no preemption, so two handlers are
    # never mid-flight at once (the same invariant the per-handler recv buffer
    # relies on).
    reset_via(_hsv_reject_arena);
    var n = sandhi_server_recv_request(cfd, buf, _hsv_req_max - 1);
    if (n == SANDHI_SERVER_ERR_TOO_LARGE) {
        sandhi_server_send_status_a(_hsv_reject_arena, cfd, HTTP_PAYLOAD_TOO_LARGE, "Payload Too Large");
        _sandhi_server_drain_refused(cfd, buf, _hsv_req_max);
    } elif (n == SANDHI_SERVER_ERR_INCOMPLETE) {
        sandhi_server_send_status_a(_hsv_reject_arena, cfd, HTTP_BAD_REQUEST, "Bad Request");
    } elif (n > 0) {
        if (sandhi_server_request_has_cl_te_conflict(buf, n) == 1) {
            sandhi_server_send_status_a(_hsv_reject_arena, cfd, 400, "Bad Request");
        } elif (sandhi_server_request_has_dup_smuggling_header(buf, n) == 1) {
            sandhi_server_send_status_a(_hsv_reject_arena, cfd, 400, "Bad Request");
        } elif (sandhi_server_request_has_unsupported_te(buf, n) == 1) {
            sandhi_server_send_status_a(_hsv_reject_arena, cfd, HTTP_NOT_IMPLEMENTED, "Not Implemented");  #skip-lint: HTTP 501 status code — inbound transfer-coding decoding deferred, see CHANGELOG 1.9.4
            _sandhi_server_drain_refused(cfd, buf, _hsv_req_max);
        } else {
            fncall4(fp, ctx, cfd, buf, n);
        }
    }
    sock_close(cfd);
    return 0;
}

# Epoll-cooperative accept loop. `max_conns` (server options, default 128)
# is the per-drain concurrency cap: drain the accept queue non-blocking up
# to `max_conns` connections, spawn a handler task for each, run the batch
# to completion via `async_run`, reset the arena, repeat; block on the
# listen fd via `async_await_readable` when the queue is empty. Per-
# connection `idle_ms` / SO_RCVTIMEO bounds slow peers, as on the sync
# path. `handler_fp` signature matches the sync path:
#   fn handler(ctx, cfd, req_buf, req_len) -> 0
# Returns 1 on bind/listen/arena failure; never returns on success.
#
# Memory: per-connection recv buffers + arg structs come from a single
# `max_conns`-sized arena, reset each batch — no growth. As of 1.5.3
# (cyrius v6.1.22 `async_new_in`) `lib/async.cyr`'s OWN runtime + every
# `async_spawn` task struct are drawn from that SAME arena too, so the
# per-batch `reset_via` reclaims them — ZERO residual leak (was ~32 B/conn
# + ~40 B/batch on the no-free global bump before the fix). RSS stays flat
# over a sustained connection stream. See the inline 1.5.3 note on the
# arena sizing below.
fn sandhi_server_run_async(addr, port, handler_fp, ctx, opts): i64 {
    # 1.6.6 security fix: ignore SIGPIPE (see sandhi_server_run_opts) — a
    # disconnecting peer must not be able to terminate the process.
    _sandhi_server_ignore_sigpipe();

    var idle_ms   = sandhi_server_options_get_idle_ms(opts);
    var stop_ptr  = sandhi_server_options_get_stop_flag(opts);   # 1.9.9
    var max_conns = sandhi_server_options_get_max_conns(opts);
    if (max_conns < 1) { max_conns = 1; }
    # 1.9.4 — publish the request cap before the first task is spawned; the
    # per-conn arena below is sized from it and _sandhi_server_async_handler
    # reads it.
    var max_req = _hsv_resolve_req_max(opts);
    if (_hsv_ensure_reject_arena() == 0) { return 1; }   # 1.9.6
    # The cooperative loop runs handlers to completion with no preemption,
    # so EVERY per-connection recv MUST be time-bounded — a single client
    # that connects and sends nothing would otherwise hang the whole loop
    # (and every other connection in the batch). Unlike the single-flight
    # sync path, idle_ms == 0 (blocking) is unsafe here, so floor it to the
    # default. SO_RCVTIMEO (set per accept below) is the bound; there is no
    # unbounded epoll wait on a client fd.
    if (idle_ms <= 0) { idle_ms = SANDHI_SERVER_DEFAULT_IDLE_MS; }

    var sfd_tag, sfd = tcp_socket();
    if (is_err_result(sfd_tag) == 1) { return 1; }
    sock_reuse(sfd);
    if (is_err_result(sock_bind(sfd, addr, port)) == 1) { return 1; }
    if (is_err_result(sock_listen(sfd, 16)) == 1) { return 1; }

    # Listen fd non-blocking so the accept queue drains cooperatively
    # (EAGAIN ends the drain). 1.6.2: composes stdlib `sock_set_nonblocking`
    # (cyrius 6.2.10) instead of the Linux-hardcoded `O_NONBLOCK` fcntl — the
    # stdlib helper carries the per-target flag value (Darwin O_NONBLOCK=0x0004 vs
    # Linux 0x800) and is itself an agnos no-op (SYS_FCNTL is undefined there +
    # inbound TCP is agnos Phase B — `sock_listen` already returns Err above, so
    # this fn bails before the cooperative accept loop regardless).
    sock_set_nonblocking(sfd);

    # Per-batch arena: max_conns × (recv buffer + arg struct + task struct)
    # + slack for the runtime struct. Backing memory is allocated once and
    # reused across batches via reset_via — so nothing accumulates.
    # 1.5.3 (Batch A2): the per-conn `+64` covers the 32-byte arg AND the
    # 32-byte async task struct, and the `+4096` slack covers the 40-byte
    # runtime — because the runtime is now created with `async_new_in(arena)`
    # (cyrius v6.1.22), so the rt + every `async_spawn` task come from this
    # arena instead of the no-free global bump. reset_via(arena) per batch
    # therefore reclaims them too → zero residual leak (was ~32 B/conn +
    # 40 B/batch on the global bump). RSS stays flat over a sustained stream.
    var per_conn  = max_req + 64;
    var arena = arena_allocator(max_conns * per_conn + 4096);
    if (arena == 0) { sock_close(sfd); return 1; }

    var rt = async_new_in(arena);
    if (rt == 0) { sock_close(sfd); return 1; }
    # 1.9.8 — accept-failure state; see the accept-error policy block above.
    var ast = _sandhi_accept_state_new();
    if (ast == 0) { sock_close(sfd); return 1; }
    var batch = 0;
    while (1 == 1) {
        # 1.9.9 — cooperative stop. This loop needs no SO_RCVTIMEO: its listen
        # fd is already non-blocking, so `accept` surfaces on its own. What it
        # DOES need is the idle-path change below, because
        # `async_await_readable` blocks forever.
        if (_sandhi_server_stop_requested(stop_ptr) == 1) { sock_close(sfd); return 0; }
        var accepting = 1;
        while (accepting == 1) {
            var cr_tag, cr = sock_accept(sfd);
            if (is_err_result(cr_tag) == 1) {
                # 1.9.8 — this loop DID have an else branch, but it folded
                # every errno into "queue drained". That is right for EAGAIN
                # and wrong for everything else: under EMFILE the pending
                # connection stays queued, so the listen fd stays readable,
                # so `async_await_readable` below returns instantly and the
                # outer loop spins at 100% CPU exactly like the blocking
                # loops did — just one indirection further out.
                var err = cr;
                if (err == _SANDHI_EAGAIN) {
                    _sandhi_accept_state_reset(ast);
                } else {
                    var aact = _sandhi_accept_step(ast, err);
                    if (aact == SANDHI_ACCEPT_FATAL) { sock_close(sfd); return 1; }
                    if (aact == SANDHI_ACCEPT_BACKOFF) { sleep_ms(_sandhi_accept_state_delay(ast)); }
                }
                # End the drain either way. A transient error costs one
                # round-trip through `async_await_readable`, which returns
                # immediately while the queue is non-empty — cheaper than
                # risking a tight inner retry loop.
                accepting = 0;
            } else {
                _sandhi_accept_state_reset(ast);
                var cfd = cr;
                # idle_ms is floored > 0 above — always bound the recv.
                _sandhi_conn_set_timeout_ms(cfd, idle_ms, _SANDHI_SO_RCVTIMEO);
                var arg = alloc_via(arena, 32);
                var buf = alloc_via(arena, max_req);
                if (arg == 0 || buf == 0) {
                    sock_close(cfd);           # arena exhausted — shed load
                    accepting = 0;
                } else {
                    store64(arg + SANDHI_ASYNC_ARG_CFD, cfd);
                    store64(arg + SANDHI_ASYNC_ARG_FP,  handler_fp);
                    store64(arg + SANDHI_ASYNC_ARG_CTX, ctx);
                    store64(arg + SANDHI_ASYNC_ARG_BUF, buf);
                    # async_spawn now draws the task struct from `arena` too
                    # (1.5.3). Guard its alloc like arg/buf: on exhaustion the
                    # task is unlinked + the handler that closes cfd never runs,
                    # so close cfd here and shed. The per-conn budget (arg 32 +
                    # buf + task 32 = max_req + 64) leaves no slack, so
                    # this completes the load-shed path for the arena-backed task.
                    var task = async_spawn(rt, &_sandhi_server_async_handler, arg);
                    if (task == 0) {
                        sock_close(cfd);
                        accepting = 0;
                    } else {
                        batch = batch + 1;
                    }
                }
            }
            if (batch >= max_conns) { accepting = 0; }
        }

        if (batch > 0) {
            async_run(rt);          # drains the batch; closes rt's epfd
            reset_via(arena);       # reclaim this batch's buffers + args + rt + tasks
            batch = 0;
            rt = async_new_in(arena);   # fresh arena-backed runtime for the next batch
            if (rt == 0) { sock_close(sfd); return 1; }
        } else {
            # 1.9.9 — the idle wait is where a stop flag would otherwise be
            # invisible: `async_await_readable` calls `sys_epoll_wait` with a
            # hardcoded -1 (`lib/async.cyr:823`), so an idle server parks there
            # forever and never re-reads the flag.
            #
            # With a flag configured, poll instead. This deliberately does NOT
            # fork a timeout-capable `async_await_readable` into sandhi —
            # CLAUDE.md's "compose, don't reimplement" makes a missing stdlib
            # primitive a cyrius patch, not a sandhi feature — so the bounded
            # sleep composes what already exists and the stdlib gap is filed
            # upstream instead.
            #
            # Costs an idle stop-enabled async server ~10 wakeups/sec, the same
            # trade the other four loops make, and only when the caller opts in.
            # Without a flag this is byte-for-byte the pre-1.9.9 blocking wait.
            if (stop_ptr == 0) {
                async_await_readable(sfd);   # empty queue — block until a conn
            } else {
                sleep_ms(SANDHI_SERVER_STOP_POLL_MS);
            }
        }
    }
    return 0;
}

# ================================================================
# Routing (1.6.7) — method+path route table with :name params
# ================================================================
# First (and driving) consumer: yeo-cy-test (SecureYeoman → Cyrius port).
# `sandhi_server_run*` dispatches every request to a single handler; this is
# the "routing … layers on top in later milestones" item from this module's
# header. The shape is lifted verbatim from the probe's reference
# (secureyeoman/yeo-cy-test/src/httpd.cyr `route_match` / `router_*`), recast
# into sandhi's stateless-accessor idiom.
#
# Param buffer: a caller-owned scratch buffer holding the captured `:name`
# segments as {ptr,len} pairs pointing INTO the request path. Layout:
#   [+0 count][slot i at +8+i*16 → +0 ptr, +8 len]
# Use a STACK buffer (`var p[SANDHI_ROUTE_PARAMS_SIZE]`) per request — it is
# per-invocation, so it is thread-safe under the pooled server with zero
# allocation and zero leak; `sandhi_server_router_handler` does exactly that.
var SANDHI_ROUTE_MAX_PARAMS  = 16;
var SANDHI_ROUTE_PARAMS_SIZE = 264;   # 8 (count) + 16 slots * 16 B

# Reset a param buffer (count → 0). Call before reuse; route_match also
# resets, so this is only needed to zero a fresh stack buffer defensively.
fn sandhi_route_params_init(params): i64 {
    if (params == 0) { return 0; }
    store64(params, 0);
    return 0;
}

# Number of `:name` segments captured by the last successful route_match.
fn sandhi_route_param_count(params): i64 {
    if (params == 0) { return 0; }
    return load64(params);
}

# Match `path` (a path-only cstr — e.g. `sandhi_server_path_only(get_path(...))`)
# against a route `pattern` cstr, capturing `:name` segments into `params` (may
# be 0 to match without capturing). Both must be absolute. Segment-by-segment
# split on '/': a literal segment must match exactly; a `:name` segment matches
# any one non-empty segment and is captured (ptr+len into `path`). Segment
# counts must be EQUAL, so "/api/notes" does NOT match "/api/notes/:id" (nor the
# reverse). Returns 1 on match (params filled), 0 otherwise. Resets params first.
fn sandhi_server_route_match(path, pattern, params): i64 {
    if (params != 0) { store64(params, 0); }
    if (path == 0 || pattern == 0) { return 0; }
    var pp = pattern;
    var b  = path;
    if (load8(pp) != 47) { return 0; }      # pattern must begin with '/'
    if (load8(b) != 47)  { return 0; }       # path must begin with '/'
    pp = pp + 1;
    b = b + 1;
    while (1 == 1) {
        var ps = pp;                         # pattern segment [ps, pp)
        while (load8(pp) != 0 && load8(pp) != 47) { pp = pp + 1; }
        var pseg = pp - ps;
        var bs = b;                          # path segment [bs, b)
        while (load8(b) != 0 && load8(b) != 47) { b = b + 1; }
        var bseg = b - bs;

        if (pseg > 0 && load8(ps) == 58) {   # ':' → capture, matches any non-empty
            if (bseg == 0) { return 0; }
            if (params != 0) {
                var np = load64(params);
                if (np < SANDHI_ROUTE_MAX_PARAMS) {
                    var slot = params + 8 + np * 16;
                    store64(slot, bs);
                    store64(slot + 8, bseg);
                    store64(params, np + 1);
                }
            }
        } else {                             # literal segment: exact match
            if (pseg != bseg) { return 0; }
            if (pseg > 0 && memeq(ps, bs, pseg) == 0) { return 0; }
        }

        var pmore = 0;
        if (load8(pp) == 47) { pmore = 1; }
        var bmore = 0;
        if (load8(b) == 47) { bmore = 1; }
        if (pmore != bmore) { return 0; }    # differing segment counts
        if (pmore == 0) { return 1; }        # both exhausted → full match
        pp = pp + 1;
        b = b + 1;
    }
    return 0;
}

# Captured param `idx` parsed as a non-negative decimal i64, or `-1` if the
# index is out of range / the segment is empty / non-numeric. (For `:id`-style
# integer keys — a non-numeric value yields `-1` so the handler returns a clean
# 400 rather than mis-parsing.) Parses in place; no allocation.
fn sandhi_route_param_int(params, idx): i64 {
    if (params == 0) { return 0 - 1; }
    if (idx < 0 || idx >= load64(params)) { return 0 - 1; }
    var slot = params + 8 + idx * 16;
    var p   = load64(slot);
    var len = load64(slot + 8);
    if (len <= 0) { return 0 - 1; }
    var val = 0;
    var i = 0;
    while (i < len) {
        var c = load8(p + i);
        if (c < 48 || c > 57) { return 0 - 1; }
        val = val * 10 + (c - 48);
        i = i + 1;
    }
    return val;
}

# Captured param `idx` as a freshly-allocated NUL-terminated cstr (the path
# buffer the segment points into is not NUL-terminated at the boundary), or ""
# if out of range, or 0 on OOM. Mirrors the alloc-the-returned-cstr contract of
# the other `sandhi_server_*_a` accessors.
fn sandhi_route_param_a(a, params, idx): i64 {
    if (params == 0) { return ""; }
    if (idx < 0 || idx >= load64(params)) { return ""; }
    var slot = params + 8 + idx * 16;
    var p   = load64(slot);
    var len = load64(slot + 8);
    var out = alloc_via(a, len + 1);
    if (out == 0) { return 0; }
    memcpy(out, p, len);
    store8(out + len, 0);
    return out;
}

fn sandhi_route_param(params, idx): i64 {
    return sandhi_route_param_a(default_alloc(), params, idx);
}

# Case-sensitive cstr equality (request method vs route method). Match only if
# both hit NUL together.
fn _sandhi_server_cstr_eq(a, b): i64 {
    if (a == 0 || b == 0) { return 0; }
    var i = 0;
    while (load8(a + i) != 0 && load8(b + i) != 0) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    return load8(a + i) == load8(b + i);
}

# Route table — fixed-cap array of {method cstr, pattern cstr, handler fp} plus
# a single user `app_ctx` forwarded to handlers. Route handler signature:
#   fn handler(app_ctx, cfd, req_buf, req_len, params) -> 0
# Read path params inside the handler via sandhi_route_param_int / _param.
enum SandhiRouterOff {
    SANDHI_ROUTER_OFF_COUNT   = 0;
    SANDHI_ROUTER_OFF_CAP     = 8;
    SANDHI_ROUTER_OFF_ROUTES  = 16;
    SANDHI_ROUTER_OFF_APP_CTX = 24;
}
var SANDHI_ROUTER_HDR_SIZE = 32;

enum SandhiRouteEntryOff {
    SANDHI_RE_OFF_METHOD  = 0;
    SANDHI_RE_OFF_PATTERN = 8;
    SANDHI_RE_OFF_FP      = 16;
}
var SANDHI_RE_SIZE = 24;
var SANDHI_ROUTER_DEFAULT_CAP = 32;

fn sandhi_router_new_a(a, cap, app_ctx): i64 {
    if (cap < 1) { cap = 1; }
    var r = alloc_via(a, SANDHI_ROUTER_HDR_SIZE);
    if (r == 0) { return 0; }
    var routes = alloc_via(a, cap * SANDHI_RE_SIZE);
    if (routes == 0) { return 0; }
    store64(r + SANDHI_ROUTER_OFF_COUNT, 0);
    store64(r + SANDHI_ROUTER_OFF_CAP, cap);
    store64(r + SANDHI_ROUTER_OFF_ROUTES, routes);
    store64(r + SANDHI_ROUTER_OFF_APP_CTX, app_ctx);
    return r;
}

fn sandhi_router_new(app_ctx): i64 {
    return sandhi_router_new_a(default_alloc(), SANDHI_ROUTER_DEFAULT_CAP, app_ctx);
}

# Register a route. method/pattern are borrowed cstrs (kept by pointer — must
# outlive the router, e.g. string literals). Returns 1 on success, 0 if the
# table is full.
fn sandhi_router_add(router, method, pattern, fp): i64 {
    if (router == 0) { return 0; }
    var c = load64(router + SANDHI_ROUTER_OFF_COUNT);
    if (c >= load64(router + SANDHI_ROUTER_OFF_CAP)) { return 0; }
    var e = load64(router + SANDHI_ROUTER_OFF_ROUTES) + c * SANDHI_RE_SIZE;
    store64(e + SANDHI_RE_OFF_METHOD, method);
    store64(e + SANDHI_RE_OFF_PATTERN, pattern);
    store64(e + SANDHI_RE_OFF_FP, fp);
    store64(router + SANDHI_ROUTER_OFF_COUNT, c + 1);
    return 1;
}

# Dispatch (buf,blen) through the route table: first route whose pattern AND
# method match wins → its handler runs as fncall5(fp, ctx, cfd, buf, blen,
# params) with the captured params. A pattern match with no method match →
# 405; no pattern match → 404. Always handles the connection (returns 1).
#
# `params` is a caller-owned scratch buffer (see sandhi_route_params_init); pass
# a per-request stack buffer so this is safe under the pooled server.
#
# NOTE: extracts method + path via the bare `sandhi_server_get_method` /
# `_get_path` / `_path_only` accessors, which allocate their small returned
# cstrs on the global bump — the same per-request allocation property the whole
# `sandhi_server_*` accessor family already has. For a long-running server,
# arena adoption (the `_a` accessor variants + a per-request reset arena) is the
# answer; that is the module-wide "arena-per-request adoption" roadmap item, not
# routing's to solve here.
fn sandhi_router_dispatch(router, ctx, cfd, buf, blen, params): i64 {
    return sandhi_router_dispatch_a(default_alloc(), router, ctx, cfd, buf, blen, params);
}

# 1.9.7 — allocator-threaded dispatch. Every allocation the routing path makes
# on behalf of a request lands in `a`: the method and path accessors, and the
# 404/405 status writes. Pass a per-request arena and the whole dispatch becomes
# rewindable; pass `default_alloc()` and this is exactly the pre-1.9.7 behaviour.
#
# The route handler itself still allocates wherever it chooses — sandhi cannot
# reach inside `fncall5` — but it can ask for the same arena via
# `sandhi_server_request_arena`.
fn sandhi_router_dispatch_a(a, router, ctx, cfd, buf, blen, params): i64 {
    if (router == 0) { sandhi_server_send_status_a(a, cfd, 404, "Not Found"); return 1; }
    var method = sandhi_server_get_method_a(a, buf, blen);
    var path   = sandhi_server_path_only_a(a, sandhi_server_get_path_a(a, buf, blen));
    var c      = load64(router + SANDHI_ROUTER_OFF_COUNT);
    var routes = load64(router + SANDHI_ROUTER_OFF_ROUTES);
    var path_match = 0;
    var i = 0;
    while (i < c) {
        var e = routes + i * SANDHI_RE_SIZE;
        if (sandhi_server_route_match(path, load64(e + SANDHI_RE_OFF_PATTERN), params) == 1) {
            path_match = 1;
            if (_sandhi_server_cstr_eq(method, load64(e + SANDHI_RE_OFF_METHOD)) == 1) {
                fncall5(load64(e + SANDHI_RE_OFF_FP), ctx, cfd, buf, blen, params);
                return 1;
            }
        }
        i = i + 1;
    }
    if (path_match == 1) {
        sandhi_server_send_status_a(a, cfd, 405, "Method Not Allowed");
        return 1;
    }
    sandhi_server_send_status_a(a, cfd, 404, "Not Found");
    return 1;
}

# Ready-made handler matching the `fn(ctx, cfd, buf, blen)` shape that
# `sandhi_server_run` / `_run_async` / `_run_pooled` invoke — pass
# `&sandhi_server_router_handler` as the handler_fp and the router as ctx, and
# routing works under any of the three serve loops. The per-request param
# buffer is a stack local (per-invocation → pool-safe, no alloc, no leak); route
# handlers receive the router's `app_ctx` as their ctx.
fn sandhi_server_router_handler(router, cfd, buf, blen): i64 {
    # 1.9.7 — routes through the worker's per-request arena when one is
    # configured, and through the global bump when it is not. That is what lets
    # a consumer bound the routing path's allocation by setting
    # `sandhi_server_options_req_arena` and changing nothing else.
    var a = sandhi_server_request_arena();
    if (a == 0) { a = default_alloc(); }
    return sandhi_server_router_handler_a(a, router, cfd, buf, blen);
}

# Allocator-threaded router handler, for callers driving dispatch themselves.
fn sandhi_server_router_handler_a(a, router, cfd, buf, blen): i64 {
    var params[264];                         # = SANDHI_ROUTE_PARAMS_SIZE
    sandhi_route_params_init(&params);
    var app_ctx = 0;
    if (router != 0) { app_ctx = load64(router + SANDHI_ROUTER_OFF_APP_CTX); }
    return sandhi_router_dispatch_a(a, router, app_ctx, cfd, buf, blen, &params);
}

# ================================================================
# Thread-pool server (1.6.7) — sandhi_server_run_pooled
# ================================================================
# First (and driving) consumer: yeo-cy-test (SecureYeoman → Cyrius port), whose
# axum/Tokio backend needs real multi-core parallelism. The sync `run` is
# single-flight and `run_async` is cooperative/run-to-completion — neither uses
# more than one core, so a handler doing blocking/CPU-bound work (a DB call,
# crypto) serializes every other in-flight request behind it. This adds a fixed
# worker-thread pool: the accept loop hands each accepted fd to a bounded
# channel; `max_conns` worker threads pull from it and serve one connection each,
# so a slow/blocking handler ties up only its own worker.
#
# Pool-safety: the per-request fns take an explicit recv buffer (per-worker) and
# allocate via the thread-safe global `alloc` (process-wide CAS lock), so they
# are safe to call concurrently from N workers. The handler shape is identical
# to `run` / `run_async` — `fn(ctx, cfd, req_buf, req_len)` — so existing
# handlers (and `sandhi_server_router_handler`) drop straight in.
#
# `max_conns` (server options, default 128) is the **fixed worker-thread
# count** here (not a per-drain cap as in run_async) — size it to your workload
# (cores / expected concurrency); each worker owns a 64 KiB recv buffer + a
# 64 KiB thread stack. Per-connection `idle_ms` / SO_RCVTIMEO bounds slow peers
# (floored > 0, since a stalled peer would otherwise hold a worker forever and a
# slowloris could pin the whole pool).

# Per-worker arg (32 bytes): { chan, handler_fp, ctx, idle_ms }.
enum SandhiPoolWorkerOff {
    SANDHI_POOL_W_CHAN    = 0;
    SANDHI_POOL_W_FP      = 8;
    SANDHI_POOL_W_CTX     = 16;
    SANDHI_POOL_W_IDLE_MS = 24;
}
var SANDHI_POOL_WORKER_ARG_SIZE = 32;

# One worker thread: pull a cfd off the channel, recv (SO_RCVTIMEO-bounded),
# smuggling-reject (the same fns the sync loop uses), dispatch to the handler,
# close. The recv buffer is per-worker (allocated once, reused) — the
# no-interleave invariant under a concurrent server. A 0 from chan_recv means
# the channel was closed (an accepted fd is never 0), so the worker exits.
fn _sandhi_server_pool_worker(arg): i64 {
    var ch      = load64(arg + SANDHI_POOL_W_CHAN);
    var fp      = load64(arg + SANDHI_POOL_W_FP);
    var ctx     = load64(arg + SANDHI_POOL_W_CTX);
    var idle_ms = load64(arg + SANDHI_POOL_W_IDLE_MS);
    # `_hsv_req_max` is published by sandhi_server_run_pooled before any worker
    # is spawned, so this read is of a value that is already final.
    var max_req = _hsv_req_max;
    var reqbuf  = alloc_via(default_alloc(), max_req);
    if (reqbuf == 0) { return 0; }           # OOM — worker exits, pool runs short
    # 1.9.6 — per-worker reject arena. Every refusal this loop can emit happens
    # BEFORE the user handler runs, so a consumer's own arena discipline cannot
    # reach it: an attacker who only ever gets 400/413/501 back was still growing
    # the no-free global bump by ~176 B per request. Rewound at the top of each
    # iteration, so a request always starts with the full budget no matter how
    # the previous one exited. Worker-local, so no cross-worker reset race.
    var rarena = arena_allocator(SANDHI_SERVER_REJECT_ARENA_CAP);
    if (rarena == 0) { return 0; }           # OOM — worker exits, pool runs short
    # 1.9.7 — per-worker request arena, published into this thread's slot so
    # `sandhi_server_request_arena` (and therefore the router handler) can find
    # it without threading a parameter through the handler signature. Worker-
    # local, so the rewind below races nothing.
    var harena = 0;
    if (_hsv_req_arena_cap > 0 && _sandhi_req_arena_slot >= 0) {
        harena = arena_allocator(_hsv_req_arena_cap);
        if (harena == 0) { return 0; }       # OOM — worker exits, pool runs short
        thread_local_set(_sandhi_req_arena_slot, harena);
    }
    while (1 == 1) {
        var cfd = chan_recv(ch);
        if (cfd == 0) { return 0; }          # channel closed
        reset_via(rarena);
        # Rewound before the request, not after: a handler that stashed a
        # pointer still sees live bytes until the next request begins, which is
        # the same lifetime the reject arena already promises.
        if (harena != 0) { reset_via(harena); }
        if (idle_ms > 0) {
            _sandhi_conn_set_timeout_ms(cfd, idle_ms, _SANDHI_SO_RCVTIMEO);
        }
        var n = sandhi_server_recv_request(cfd, reqbuf, max_req - 1);
        if (n == SANDHI_SERVER_ERR_TOO_LARGE) {
            sandhi_server_send_status_a(rarena, cfd, HTTP_PAYLOAD_TOO_LARGE, "Payload Too Large");
            _sandhi_server_drain_refused(cfd, reqbuf, max_req);
        } elif (n == SANDHI_SERVER_ERR_INCOMPLETE) {
            sandhi_server_send_status_a(rarena, cfd, HTTP_BAD_REQUEST, "Bad Request");
        } elif (n > 0) {
            if (sandhi_server_request_has_cl_te_conflict(reqbuf, n) == 1) {
                sandhi_server_send_status_a(rarena, cfd, 400, "Bad Request");
            } elif (sandhi_server_request_has_dup_smuggling_header(reqbuf, n) == 1) {
                sandhi_server_send_status_a(rarena, cfd, 400, "Bad Request");
            } elif (sandhi_server_request_has_unsupported_te(reqbuf, n) == 1) {
                sandhi_server_send_status_a(rarena, cfd, HTTP_NOT_IMPLEMENTED, "Not Implemented");  #skip-lint: HTTP 501 status code — inbound transfer-coding decoding deferred, see CHANGELOG 1.9.4
                _sandhi_server_drain_refused(cfd, reqbuf, max_req);
            } else {
                fncall4(fp, ctx, cfd, reqbuf, n);
            }
        }
        sock_close(cfd);
    }
    return 0;
}

# Bind addr:port, listen, spawn a fixed pool of `max_conns` worker threads, then
# accept-loop forever feeding accepted fds to the workers over a bounded channel.
# `handler_fp` signature matches `run` / `run_async`:
#   fn handler(ctx, cfd, req_buf, req_len) -> 0
# Returns 1 on bind/listen/channel failure; never returns on success.
fn sandhi_server_run_pooled(addr, port, handler_fp, ctx, opts): i64 {
    # Same security fix as the other serve loops — SIGPIPE disposition is
    # process-wide, so installing it once here covers every worker thread.
    _sandhi_server_ignore_sigpipe();

    var idle_ms = sandhi_server_options_get_idle_ms(opts);
    if (idle_ms <= 0) { idle_ms = SANDHI_SERVER_DEFAULT_IDLE_MS; }
    var workers = sandhi_server_options_get_max_conns(opts);
    if (workers < 1) { workers = 1; }
    # 1.9.4 — publish the request cap BEFORE spawning workers. Each worker
    # allocates one buffer of this size, so the pool's buffer footprint is
    # max_request × workers; the single write happens here, on this thread,
    # strictly before any reader exists.
    _hsv_resolve_req_max(opts);
    # 1.9.7 — resolve the per-request arena cap and claim a thread-local slot
    # BEFORE any worker exists, for the same reason `_hsv_req_max` is published
    # here: both are read by every worker and written exactly once, on this
    # thread, strictly before the first reader is spawned. Claiming the slot is
    # idempotent, so the second pooled entry point reuses the first's.
    _hsv_req_arena_cap = sandhi_server_options_get_req_arena(opts);
    if (_hsv_req_arena_cap > 0 && _sandhi_req_arena_slot < 0) {
        _sandhi_req_arena_slot = thread_local_alloc();
    }
    # 1.6.8 (yeo-cy-test 🔵 handoff-depth fix): the handoff channel depth + the
    # kernel listen backlog are sized by `backlog` (default 128), DECOUPLED from
    # the worker count. A burst beyond `workers` now queues up to `backlog`
    # accepted conns instead of falling straight onto the kernel backlog at
    # `chan_new(workers)`. backlog is floored to workers so the channel can
    # always hold at least one item per worker.
    var backlog = sandhi_server_options_get_backlog(opts);
    if (backlog < workers) { backlog = workers; }
    var stop_ptr = sandhi_server_options_get_stop_flag(opts);   # 1.9.9

    var sfd_tag, sfd = tcp_socket();
    if (is_err_result(sfd_tag) == 1) { return 1; }
    sock_reuse(sfd);
    if (is_err_result(sock_bind(sfd, addr, port)) == 1) { sock_close(sfd); return 1; }
    if (is_err_result(sock_listen(sfd, backlog)) == 1) { sock_close(sfd); return 1; }

    # 1.9.9 — no-op unless a stop flag is configured.
    _sandhi_server_arm_stop_poll(sfd, stop_ptr);

    # Bounded handoff channel sized to `backlog`: when `backlog` connections are
    # already queued the accept loop blocks (backpressure / load-shed) until a
    # worker frees a slot. cfd values are always > 0, so they never collide with
    # chan's 0-on-close.
    var ch = chan_new(backlog);
    if (ch == 0) { sock_close(sfd); return 1; }

    var w = 0;
    while (w < workers) {
        var warg = alloc_via(default_alloc(), SANDHI_POOL_WORKER_ARG_SIZE);
        if (warg == 0) { sock_close(sfd); return 1; }
        store64(warg + SANDHI_POOL_W_CHAN, ch);
        store64(warg + SANDHI_POOL_W_FP, handler_fp);
        store64(warg + SANDHI_POOL_W_CTX, ctx);
        store64(warg + SANDHI_POOL_W_IDLE_MS, idle_ms);
        thread_create(&_sandhi_server_pool_worker, warg);
        w = w + 1;
    }

    # 1.9.8 — accept-failure state; see the accept-error policy block above.
    var ast = _sandhi_accept_state_new();
    if (ast == 0) { chan_close(ch); sock_close(sfd); return 1; }

    while (1 == 1) {
        # 1.9.9 — cooperative stop. Same teardown ORDER as the fatal path
        # below, and for the same reason: closing the handoff channel first
        # makes every worker's `chan_recv` return 0, so they exit instead of
        # parking on a channel nobody will ever feed again.
        if (_sandhi_server_stop_requested(stop_ptr) == 1) {
            chan_close(ch);
            sock_close(sfd);
            return 0;
        }
        var cr_tag, cr = sock_accept(sfd);
        if (is_err_result(cr_tag) == 1) {
            # 1.9.8: was no else branch (see sandhi_server_run_opts). On the
            # way out, close the handoff channel BEFORE the listen fd so the
            # workers' `chan_recv` returns 0 and they exit instead of parking
            # on a channel nobody will ever feed again.
            var act = _sandhi_accept_step(ast, cr);
            if (act == SANDHI_ACCEPT_FATAL) { chan_close(ch); sock_close(sfd); return 1; }
            if (act == SANDHI_ACCEPT_BACKOFF) { sleep_ms(_sandhi_accept_state_delay(ast)); }
        } else {
            _sandhi_accept_state_reset(ast);
            chan_send(ch, cr);      # blocks if the pool is saturated
        }
    }
    return 0;
}

# ================================================================
# Server-side TLS (1.6.8) — native HTTPS serving
# ================================================================
# First (and driving) consumer: yeo-cy-test / SecureYeoman, whose entire auth
# stack (OIDC/PKCE, WebAuthn, bearer tokens, secrets) is meaningless over
# plaintext. Before 1.6.8 sandhi had NO server-side TLS: the serve loops took
# only {idle_ms, max_conns} and every send path wrote plaintext via sock_send,
# so the probe had to bypass the serve loops and hand-roll an
# accept→tls_native_accept→read→dispatch→write→close loop. This closes that gap.
#
# It ships on the NATIVE TLS stack (the default + future; libssl-server never
# existed and the libssl backend retires at 2.0). All I/O rides the
# backend-agnostic lib/tls.cyr contract — tls_write / tls_read / tls_close. As of
# 1.6.10 the server HANDSHAKE rides it too: cyrius 6.2.37 shipped the symmetric
# `tls_accept_alloc_in` / `tls_accept_complete` (the server mirror of the client
# tls_connect_alloc/_complete), so the bootstrap below composes that contract
# instead of reaching into the native server primitives — exactly as 1.6.1/1.6.2
# migrated conn.cyr's raw socket syscalls onto net.cyr helpers once they landed.
# No native-server symbol is reached anymore; ALPN rides the SAME backend-agnostic
# `_sandhi_alpn_hook` + `tls_set_alpn` the client uses. No FFI, no dlopen: pure
# contract composition.
#
# RSS is flat as of 1.6.10: `tls_accept_alloc_in` takes a per-connection arena
# (`tls_native_new_server_in` backs the native ctx + the whole handshake/record
# footprint + the shim from it), so each serve loop / worker resets ONE arena per
# connection (reset_via) and nothing accumulates. The 1.6.8 limitation —
# per-connection RSS growth, no per-connection free — is closed; the upstream
# arena-aware server ctx it was filed against landed at cyrius 6.2.37.
#
# ALPN: native server-side ALPN *selection* landed at cyrius 6.2.22, so the
# http/1.1 ALPN we offer below is genuinely negotiated (not forward-compat). h2
# over TLS is still not served — not for an ALPN reason, but because sandhi has
# no HTTP/2 *server* (its h2 is client-side only) and we offer only http/1.1; an
# h2 server is a separate, larger feature, not a cyrius gap.

# ── Transport seam: SandhiConn ──
# A tiny tagged handle so one handler set serves both transports. kind 0 =
# plaintext (handle = raw cfd), 1 = TLS (handle = lib/tls.cyr ctx shim). `fd`
# is always the raw socket (for the final sock_close). Conn-aware send/recv/
# router functions (the `_c` family) dispatch on `kind`.
# NOTE: these offsets are namespaced SANDHI_SRVCONN_OFF_* to avoid a
# symbol collision with the CLIENT conn struct's SandhiConnOff
# (src/http/conn.cyr), which defines SANDHI_CONN_OFF_FD = 8 (vs 16 here).
# Under cyrius single-pass "last definition wins", the shared name made the
# client read/write its fd at offset 16, colliding with its own
# SANDHI_CONN_OFF_TLS_CTX (16) and silently zeroing the socket fd. See
# docs/development/issues/2026-06-24-server-conn-off-fd-collision.md.
enum SandhiServerConnOff {
    SANDHI_SRVCONN_OFF_KIND   = 0;
    SANDHI_SRVCONN_OFF_HANDLE = 8;
    SANDHI_SRVCONN_OFF_FD     = 16;
}
var SANDHI_CONN_SIZE  = 24;
var SANDHI_CONN_PLAIN = 0;
var SANDHI_CONN_TLS   = 1;

# 1.6.10 — per-connection TLS arena cap. One arena per serve loop / worker,
# reset_via'd per connection so RSS stays flat (the native server ctx + the whole
# per-handshake footprint + the shim + the SandhiConn all draw from it). Sized to
# the lib/tls.cyr contract's worst-single-handshake guidance (mTLS-1.3 ≈ 128 KiB);
# sandhi serves plain server TLS 1.3 (no client-cert verify), so this is a safe
# upper bound — an undersized cap would only drop a connection (a handshake alloc
# returns 0), never corrupt. Allocated ONCE per loop/worker, never per connection
# (arena_free doesn't munmap).
var SANDHI_SERVER_TLS_ARENA_CAP = 131072;

# Wrap a raw plaintext fd as a SandhiConn (for the plaintext-adapter path so
# conn-based handlers run over the plaintext serve loops too). Returns 0 on OOM.
fn sandhi_server_conn_plain_a(a, fd): i64 {
    var c = alloc_via(a, SANDHI_CONN_SIZE);
    if (c == 0) { return 0; }
    store64(c + SANDHI_SRVCONN_OFF_KIND, SANDHI_CONN_PLAIN);
    store64(c + SANDHI_SRVCONN_OFF_HANDLE, fd);
    store64(c + SANDHI_SRVCONN_OFF_FD, fd);
    return c;
}

fn sandhi_server_conn_plain(fd): i64 {
    return sandhi_server_conn_plain_a(default_alloc(), fd);
}

# Internal: wrap a handshaken TLS ctx shim (+ its raw fd) as a SandhiConn.
fn _sandhi_server_conn_tls_a(a, shim, fd): i64 {
    var c = alloc_via(a, SANDHI_CONN_SIZE);
    if (c == 0) { return 0; }
    store64(c + SANDHI_SRVCONN_OFF_KIND, SANDHI_CONN_TLS);
    store64(c + SANDHI_SRVCONN_OFF_HANDLE, shim);
    store64(c + SANDHI_SRVCONN_OFF_FD, fd);
    return c;
}

# 1 if this conn is TLS (e.g. to set Strict-Transport-Security only over TLS).
fn sandhi_server_conn_is_tls(conn): i64 {
    if (conn == 0) { return 0; }
    return load64(conn + SANDHI_SRVCONN_OFF_KIND) == SANDHI_CONN_TLS;
}

# The underlying raw socket fd (handy for logging / peer info). -1 if conn == 0.
fn sandhi_server_conn_fd(conn): i64 {
    if (conn == 0) { return 0 - 1; }
    return load64(conn + SANDHI_SRVCONN_OFF_FD);
}

# ── Peer address (1.9.0) ──
#
# WHY: a handler could reach the transport (`sandhi_server_conn_fd`) but had no way to
# learn WHO it was talking to, so anything keyed on the client — per-IP rate limiting,
# lockout/backoff on repeated auth failures, access logs with a source address — was
# impossible on top of sandhi. Requested by SecureYeoman's yeo-cy-test: its `/api/login`
# runs Argon2id (~244 ms of CPU per attempt), which is a request-amplification lever
# without per-IP throttling.
#
# HOW: `getpeername(2)` on the fd the conn already holds. The kernel does fill the peer
# sockaddr at `accept(2)` — the stdlib's `sock_accept` (lib/net.cyr) passes a buffer and
# then discards it — but `lib/` is the vendored stdlib and not sandhi's to change, and
# `getpeername` needs no accept-path surgery, works identically for the plaintext and TLS
# seams (both carry the raw fd), and stays correct if a conn is ever adopted from
# elsewhere. Cost is one cheap syscall per call; callers that need it per-request should
# hoist it out of hot loops.
#
# PORTABILITY (1.9.1): uses the stdlib's PER-ARCH `sys_getpeername` wrapper
# (lib/syscalls.cyr; requires cyrius >= 6.4.64). 1.9.0 hardcoded the x86_64-Linux number
# 52 and this comment claimed it was "translated by the Mach-O backends the same way
# net.cyr's socket band is" — it was NOT: getpeername was missing from every translation
# table. On aarch64, 52 is `fchmod(fd, mode)` and it SUCCEEDS, so this returned 1 with
# `out16` never written and the accessors handed back uninitialized stack (verified on
# real pi). A rate limiter keyed on that is not a rate limiter, and it failed QUIETLY.
# Numbers now per peer: x86-Linux 52 · aarch64-Linux 205 · macOS via EMACHO xlat -> BSD 31
# · Windows fail-closed -ENOSYS (the `r < 0` guard below turns that into "unknown").
# AGNOS has no BSD getpeername (conn-id socket model, see lib/net.cyr's AGNOS adapter) and
# the wrapper is not defined there, so the accessors report "unknown" (0) rather than
# fabricate an address — callers MUST treat 0 as unknown and fail open or fall back,
# never as a real peer.

# Fill `out16` (>= 16 bytes, caller-owned) with the connected peer's sockaddr_in.
# Returns 1 on success, 0 if unavailable (AGNOS, Windows, a closed/unconnected fd, or a
# non-INET socket). The caller owns the buffer so this allocates nothing and is thread-safe.
fn sandhi_server_peer_sockaddr(fd, out16): i64 {
    if (fd < 0) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;                      # no BSD getpeername on AGNOS — peer is "unknown"
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var alen[8];
    store32(&alen, 16);
    var r = sys_getpeername(fd, out16, &alen);
    if (r < 0) { return 0; }
    return 1;
    #endif
}

# Peer IPv4 for a raw fd, packed in net.cyr's `addr` convention (network-byte-order
# packed: 127.0.0.1 -> 0x0100007F, the same form sock_connect takes). 0 = unknown.
# Bytes are assembled explicitly, so this does not depend on host endianness.
fn sandhi_server_peer_ip(fd): i64 {
    var sa[16];
    # Zero FIRST (1.9.1 defence-in-depth): the accessors read this buffer after the call,
    # so if a future target is ever unrouted the result degrades to 0.0.0.0 ("unknown")
    # instead of leaking stack contents. The per-arch wrapper makes this moot on every
    # supported target today; it contains the CLASS.
    store64(&sa, 0);
    store64(&sa + 8, 0);
    if (sandhi_server_peer_sockaddr(fd, &sa) == 0) { return 0; }
    return (load8(&sa + 4) & 0xFF)
    | ((load8(&sa + 5) & 0xFF) << 8)
    | ((load8(&sa + 6) & 0xFF) << 16)
    | ((load8(&sa + 7) & 0xFF) << 24);
}

# Peer TCP port for a raw fd (host order). 0 = unknown. sin_port is big-endian on the
# wire regardless of host, so it is decoded byte-wise.
fn sandhi_server_peer_port(fd): i64 {
    var sa[16];
    store64(&sa, 0);               # zero first — see sandhi_server_peer_ip (1.9.1)
    store64(&sa + 8, 0);
    if (sandhi_server_peer_sockaddr(fd, &sa) == 0) { return 0; }
    return ((load8(&sa + 2) & 0xFF) << 8) | (load8(&sa + 3) & 0xFF);
}

# Peer IPv4 for a SandhiConn (works over both the plaintext and TLS seams — both carry
# the raw fd). 0 = unknown.
fn sandhi_server_conn_peer_ip(conn): i64 {
    if (conn == 0) { return 0; }
    return sandhi_server_peer_ip(load64(conn + SANDHI_SRVCONN_OFF_FD));
}

# Peer TCP port for a SandhiConn. 0 = unknown.
fn sandhi_server_conn_peer_port(conn): i64 {
    if (conn == 0) { return 0; }
    return sandhi_server_peer_port(load64(conn + SANDHI_SRVCONN_OFF_FD));
}

# Format a packed IPv4 (the `sandhi_server_peer_ip` / net.cyr `addr` convention) as
# dotted-quad, e.g. 0x0100007F -> "127.0.0.1". Intended for logs and rate-limit keys.
fn sandhi_server_ip4_str(ip): i64 {
    var b = str_builder_new();
    str_builder_add(b, str_from_int(ip & 0xFF));
    str_builder_add_cstr(b, ".");
    str_builder_add(b, str_from_int((ip >> 8) & 0xFF));
    str_builder_add_cstr(b, ".");
    str_builder_add(b, str_from_int((ip >> 16) & 0xFF));
    str_builder_add_cstr(b, ".");
    str_builder_add(b, str_from_int((ip >> 24) & 0xFF));
    return str_builder_build(b);
}

# Write all `len` bytes to a plaintext fd, looping over partial sys_writes.
fn _sandhi_server_plain_write_all(fd, buf, len): i64 {
    var off = 0;
    while (off < len) {
        var r_tag, w = sock_send(fd, buf + off, len - off);
        if (is_err_result(r_tag) == 1) { return 0 - 1; }
        if (w <= 0) { return 0 - 1; }
        off = off + w;
    }
    return off;
}

# The transport seam: write `len` bytes over the conn. Plaintext → looped
# sock_send; TLS → tls_write (the lib/tls.cyr contract, which fragments to
# the record cap internally). Returns >=0 on success, <0 on error.
fn sandhi_server_conn_write(conn, buf, len): i64 {
    if (conn == 0) { return 0 - 1; }
    if (load64(conn + SANDHI_SRVCONN_OFF_KIND) == SANDHI_CONN_TLS) {
        return tls_write(load64(conn + SANDHI_SRVCONN_OFF_HANDLE), buf, len);
    }
    return _sandhi_server_plain_write_all(load64(conn + SANDHI_SRVCONN_OFF_HANDLE), buf, len);
}

# Conn-aware request read. Plaintext → the existing sock_recv loop; TLS → loop
# tls_read (one record per call) until the header terminator, then until the
# Content-Length body has arrived (the plaintext recv's framing logic, over the
# TLS contract — sandhi_server_recv_request is sock_recv-welded). Returns total
# bytes (>=0); always NUL-terminates at the returned length.
fn sandhi_server_recv_request_c(conn, buf, max): i64 {
    if (conn == 0) { return SANDHI_SERVER_ERR_RECV; }
    if (load64(conn + SANDHI_SRVCONN_OFF_KIND) != SANDHI_CONN_TLS) {
        return sandhi_server_recv_request(load64(conn + SANDHI_SRVCONN_OFF_HANDLE), buf, max);
    }
    if (max <= 0) { return SANDHI_SERVER_ERR_RECV; }
    var ctx = load64(conn + SANDHI_SRVCONN_OFF_HANDLE);
    var have = 0;
    var need_body = 0 - 1;
    while (have < max) {
        var n = tls_read(ctx, buf + have, max - have);
        # 0 = close_notify, <0 = error. Same 1.9.4 framing contract as the
        # plaintext path: a partial request is reported, never returned as if
        # it were whole.
        if (n <= 0) {
            store8(buf + have, 0);
            if (have == 0) { return 0; }
            return SANDHI_SERVER_ERR_INCOMPLETE;
        }
        have = have + n;
        store8(buf + have, 0);
        if (need_body == 0 - 1) {
            var bo = sandhi_server_body_offset(buf, have);
            if (bo >= 0) {
                # 1.9.12 P1 — same refusal as the plaintext loop above.
                var clen2 = sandhi_server_content_length(buf, have);
                if (clen2 < 0) { return SANDHI_SERVER_ERR_TOO_LARGE; }
                need_body = bo + clen2;
            }
        }
        if (need_body != 0 - 1 && have >= need_body) { store8(buf + have, 0); return have; }
    }
    store8(buf + have, 0);
    return SANDHI_SERVER_ERR_TOO_LARGE;
}

# ── Conn-aware response framing (parallels the fd-based send_* — those stay
# byte-identical for the plaintext path; these write through the seam) ──

fn sandhi_server_send_response_c_a(a, conn, code, msg, content_type, body, body_len, extra_headers): i64 {
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0 - 1; }
    str_builder_add_cstr_a(a, sb, "HTTP/1.1 ");
    str_builder_add_int_a(a, sb, code);
    str_builder_add_cstr_a(a, sb, " ");
    str_builder_add_cstr_a(a, sb, msg);
    str_builder_add_cstr_a(a, sb, "\r\nContent-Type: ");
    str_builder_add_cstr_a(a, sb, content_type);
    str_builder_add_cstr_a(a, sb, "\r\nContent-Length: ");
    str_builder_add_int_a(a, sb, body_len);
    str_builder_add_cstr_a(a, sb, "\r\n");
    if (extra_headers != 0) { str_builder_add_cstr_a(a, sb, extra_headers); }
    str_builder_add_cstr_a(a, sb, "Connection: close\r\n\r\n");
    var _bld = str_builder_build_a(a, sb);
    if (_bld == 0) { return 0 - 1; }
    var head = str_data(_bld);
    if (sandhi_server_conn_write(conn, head, strlen(head)) < 0) { return 0 - 1; }
    if (body_len > 0) {
        if (sandhi_server_conn_write(conn, body, body_len) < 0) { return 0 - 1; }
    }
    return 0;
}

fn sandhi_server_send_response_c(conn, code, msg, content_type, body, body_len, extra_headers): i64 {
    return sandhi_server_send_response_c_a(default_alloc(), conn, code, msg,
      content_type, body, body_len, extra_headers);
}

fn sandhi_server_send_status_c_a(a, conn, code, msg): i64 {
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0 - 1; }
    str_builder_add_cstr_a(a, sb, "HTTP/1.1 ");
    str_builder_add_int_a(a, sb, code);
    str_builder_add_cstr_a(a, sb, " ");
    str_builder_add_cstr_a(a, sb, msg);
    str_builder_add_cstr_a(a, sb, "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
    var _bld = str_builder_build_a(a, sb);
    if (_bld == 0) { return 0 - 1; }
    var s = str_data(_bld);
    if (sandhi_server_conn_write(conn, s, strlen(s)) < 0) { return 0 - 1; }
    return 0;
}

fn sandhi_server_send_status_c(conn, code, msg): i64 {
    return sandhi_server_send_status_c_a(default_alloc(), conn, code, msg);
}

# ── Conn-aware routing — shares the SAME router table as the fd path ──
# Conn route handlers: fn(app_ctx, conn, req_buf, req_len, params) -> 0
# (write via sandhi_server_send_*_c; path params via sandhi_route_param_int).
fn sandhi_router_dispatch_c(router, ctx, conn, buf, blen, params): i64 {
    if (router == 0) { sandhi_server_send_status_c(conn, 404, "Not Found"); return 1; }
    var method = sandhi_server_get_method(buf, blen);
    var path   = sandhi_server_path_only(sandhi_server_get_path(buf, blen));
    var c      = load64(router + SANDHI_ROUTER_OFF_COUNT);
    var routes = load64(router + SANDHI_ROUTER_OFF_ROUTES);
    var path_match = 0;
    var i = 0;
    while (i < c) {
        var e = routes + i * SANDHI_RE_SIZE;
        if (sandhi_server_route_match(path, load64(e + SANDHI_RE_OFF_PATTERN), params) == 1) {
            path_match = 1;
            if (_sandhi_server_cstr_eq(method, load64(e + SANDHI_RE_OFF_METHOD)) == 1) {
                fncall5(load64(e + SANDHI_RE_OFF_FP), ctx, conn, buf, blen, params);
                return 1;
            }
        }
        i = i + 1;
    }
    if (path_match == 1) { sandhi_server_send_status_c(conn, 405, "Method Not Allowed"); return 1; }
    sandhi_server_send_status_c(conn, 404, "Not Found");
    return 1;
}

# Ready-made conn handler for the `_tls` serve loops (which invoke
# fn(ctx, conn, buf, blen) with a SandhiConn). Pass &sandhi_server_router_handler_c
# as handler_fp + the router as ctx.
fn sandhi_server_router_handler_c(router, conn, buf, blen): i64 {
    var params[264];                         # = SANDHI_ROUTE_PARAMS_SIZE
    sandhi_route_params_init(&params);
    var app_ctx = 0;
    if (router != 0) { app_ctx = load64(router + SANDHI_ROUTER_OFF_APP_CTX); }
    return sandhi_router_dispatch_c(router, app_ctx, conn, buf, blen, &params);
}

# Plaintext adapter matching the fn(ctx, cfd, buf, blen) shape the plaintext
# serve loops (run / run_opts / run_pooled) invoke: wraps the raw cfd in a
# plaintext SandhiConn and routes through the conn-aware dispatch. So ONE
# conn-based route-handler set (using sandhi_server_send_*_c) serves BOTH the
# plaintext loops (via this adapter) and the `_tls` loops (via _handler_c).
# Pass &sandhi_server_router_handler_cp as handler_fp + the router as ctx.
fn sandhi_server_router_handler_cp(router, cfd, buf, blen): i64 {
    var conn = sandhi_server_conn_plain(cfd);
    if (conn == 0) { sandhi_server_send_status(cfd, 500, "Internal Server Error"); return 1; }
    return sandhi_server_router_handler_c(router, conn, buf, blen);
}

# ── Server handshake bootstrap (1.6.10: composes the lib/tls.cyr contract) ──
# Per-connection: pack the borrowed DER cert/key into the 4-slot creds struct,
# offer http/1.1 ALPN via the SAME backend-agnostic `_sandhi_alpn_hook` +
# `_sandhi_alpn_h11_wire` the client uses (the hook calls `tls_set_alpn`, which
# dispatches the backend), and drive the handshake over `fd` through cyrius
# 6.2.37's arena-aware `tls_accept_alloc_in` + `tls_accept_complete` — the
# symmetric mirror of the client tls_connect_alloc/_complete. Returns the
# lib-canonical ctx shim (a usable TLS ctx for tls_write/_read/_close) or 0 on
# any failure. `a` backs the native ctx + the whole per-connection handshake /
# record footprint + the shim, so the serve loop reset_via(a)s it all per
# connection → flat RSS. No native-server symbol is reached anymore. The creds
# struct + hook ctx are read DURING the alloc call (the cert/key buffers it
# points at are the caller's borrowed option buffers, which outlive the server),
# so stack buffers suffice. Does NOT close `fd` on failure — the caller always
# sock_close's it.
fn _sandhi_server_tls_handshake_a(a, fd, cert, cert_len, key, key_len): i64 {
    _sandhi_alpn_init_wire();
    var hook_ctx[16];                        # [protos_ptr@0, protos_len@8]
    store64(&hook_ctx,     _sandhi_alpn_h11_wire);
    store64(&hook_ctx + 8, _sandhi_alpn_h11_wire_len);
    var creds[32];                           # [cert@0, cert_len@8, key@16, key_len@24]
    store64(&creds,      cert);
    store64(&creds + 8,  cert_len);
    store64(&creds + 16, key);
    store64(&creds + 24, key_len);
    var shim = tls_accept_alloc_in(a, fd, &creds, &_sandhi_alpn_hook, &hook_ctx);
    if (shim == 0) { return 0; }
    if (tls_accept_complete(shim) != 1) { tls_close(shim); return 0; }
    return shim;
}

# Serve one handshaken TLS conn: recv (conn-aware), smuggling-reject (the same
# fns the plaintext loops use), dispatch to the handler. `reqbuf` is the
# caller's recv buffer. Closes nothing — the caller owns shim + fd teardown.
# 1.6.10: the SandhiConn rides the caller's per-connection arena `a` (reclaimed
# by the loop's reset_via with the rest of the connection footprint).
fn _sandhi_server_tls_serve_one(a, handler_fp, ctx, shim, fd, reqbuf): i64 {
    var conn = _sandhi_server_conn_tls_a(a, shim, fd);
    if (conn == 0) { return 0; }
    var n = sandhi_server_recv_request_c(conn, reqbuf, _hsv_req_max - 1);
    # 1.9.4 — same refusal contract as the plaintext loops, minus the lingering
    # drain: this fn does not own the fd (the caller does tls_close + sock_close),
    # and discarding in-flight bytes would have to run through tls_read, which
    # can straddle record boundaries. The caller's tls_close sends close_notify
    # first, so the client generally still reads the status; a very large
    # refused body over TLS can still land as a reset. Tracked for the inbound
    # transfer-coding work rather than bolted on here.
    # 1.9.6 — every refusal response is built through `a`, the caller's
    # per-connection arena, which both TLS loops already reset_via per conn. The
    # bare `_c` wrappers draw from the no-free global bump, so an attacker who
    # can make requests get REFUSED could grow RSS without bound. `conn` itself
    # already rides `a` (see _sandhi_server_conn_tls_a above), so this only
    # finishes what the arena was for.
    if (n == SANDHI_SERVER_ERR_TOO_LARGE) {
        sandhi_server_send_status_c_a(a, conn, HTTP_PAYLOAD_TOO_LARGE, "Payload Too Large");
    } elif (n == SANDHI_SERVER_ERR_INCOMPLETE) {
        sandhi_server_send_status_c_a(a, conn, HTTP_BAD_REQUEST, "Bad Request");
    } elif (n > 0) {
        if (sandhi_server_request_has_cl_te_conflict(reqbuf, n) == 1) {
            sandhi_server_send_status_c_a(a, conn, 400, "Bad Request");
        } elif (sandhi_server_request_has_dup_smuggling_header(reqbuf, n) == 1) {
            sandhi_server_send_status_c_a(a, conn, 400, "Bad Request");
        } elif (sandhi_server_request_has_unsupported_te(reqbuf, n) == 1) {
            sandhi_server_send_status_c_a(a, conn, HTTP_NOT_IMPLEMENTED, "Not Implemented");  #skip-lint: HTTP 501 status code — inbound transfer-coding decoding deferred, see CHANGELOG 1.9.4
        } else {
            fncall4(handler_fp, ctx, conn, reqbuf, n);
        }
    }
    return 0;
}

# Single-flight HTTPS serve loop — the TLS mirror of sandhi_server_run_opts.
# Requires sandhi_server_options_tls() to have set cert/key on `opts` (returns
# 1 otherwise). handler_fp signature: fn(ctx, conn, buf, blen) -> 0 (a
# SandhiConn, not a raw fd — write via sandhi_server_send_*_c). For real
# concurrency use sandhi_server_run_pooled_tls. Returns 1 on
# config/bind/listen failure; never returns on success.
fn sandhi_server_run_tls(addr, port, handler_fp, ctx, opts): i64 {
    _sandhi_server_ignore_sigpipe();
    if (sandhi_server_options_get_tls(opts) == 0) { return 1; }
    var cert     = load64(opts + SANDHI_SERVER_OPT_OFF_TLS_CERT);
    var cert_len = load64(opts + SANDHI_SERVER_OPT_OFF_TLS_CERT_LEN);
    var key      = load64(opts + SANDHI_SERVER_OPT_OFF_TLS_KEY);
    var key_len  = load64(opts + SANDHI_SERVER_OPT_OFF_TLS_KEY_LEN);
    if (cert == 0 || key == 0) { return 1; }
    var idle_ms  = sandhi_server_options_get_idle_ms(opts);
    var backlog  = sandhi_server_options_get_backlog(opts);
    var stop_ptr = sandhi_server_options_get_stop_flag(opts);   # 1.9.9

    if (_hsv_ensure_req_buf(_hsv_resolve_req_max(opts)) == 0) { return 1; }
    if (_hsv_ensure_reject_arena() == 0) { return 1; }   # 1.9.6

    var sfd_tag, sfd = tcp_socket();
    if (is_err_result(sfd_tag) == 1) { return 1; }
    sock_reuse(sfd);
    if (is_err_result(sock_bind(sfd, addr, port)) == 1) { sock_close(sfd); return 1; }
    if (is_err_result(sock_listen(sfd, backlog)) == 1) { sock_close(sfd); return 1; }

    # 1.9.9 — no-op unless a stop flag is configured.
    _sandhi_server_arm_stop_poll(sfd, stop_ptr);

    # 1.6.10 — ONE arena for the loop, reset_via per connection: the native
    # server ctx + per-handshake footprint + shim + SandhiConn all draw from it,
    # so RSS stays flat instead of growing per accepted connection (the 1.6.8
    # limitation, now closed via cyrius 6.2.37's arena-aware tls_accept_alloc_in).
    var tarena = arena_allocator(SANDHI_SERVER_TLS_ARENA_CAP);
    if (tarena == 0) { sock_close(sfd); return 1; }

    # 1.9.8 — accept-failure state; see the accept-error policy block above.
    var ast = _sandhi_accept_state_new();
    if (ast == 0) { sock_close(sfd); return 1; }

    while (1 == 1) {
        # 1.9.9 — cooperative stop.
        if (_sandhi_server_stop_requested(stop_ptr) == 1) { sock_close(sfd); return 0; }
        var cr_tag, cr = sock_accept(sfd);
        if (is_err_result(cr_tag) == 1) {
            # 1.9.8: was no else branch (see sandhi_server_run_opts).
            var act = _sandhi_accept_step(ast, cr);
            if (act == SANDHI_ACCEPT_FATAL) { sock_close(sfd); return 1; }
            if (act == SANDHI_ACCEPT_BACKOFF) { sleep_ms(_sandhi_accept_state_delay(ast)); }
        } else {
            _sandhi_accept_state_reset(ast);
            var cfd = cr;
            if (idle_ms > 0) { _sandhi_conn_set_timeout_ms(cfd, idle_ms, _SANDHI_SO_RCVTIMEO); }
            var shim = _sandhi_server_tls_handshake_a(tarena, cfd, cert, cert_len, key, key_len);
            if (shim != 0) {
                _sandhi_server_tls_serve_one(tarena, handler_fp, ctx, shim, cfd, _hsv_req_buf);
                tls_close(shim);
            }
            sock_close(cfd);
            reset_via(tarena);              # rewind this connection's footprint → flat RSS
        }
    }
    return 0;
}

# ── Thread-pool HTTPS serve loop — the TLS mirror of sandhi_server_run_pooled.
# Each worker does its OWN per-connection handshake. `max_conns` = worker count;
# `backlog` (option, default 128, DECOUPLED from workers per the 1.6.8
# handoff-depth fix) sizes the kernel listen backlog + the handoff channel.
#
# CONCURRENT TLS HANDSHAKES ARE SAFE as of sandhi 1.8.0 / cyrius 6.4.49 —
# `max_conns > 1` is supported for HTTPS. Worker ctxs and their per-connection
# arenas are independent, and the TLS handshake's sigil crypto primitives now
# draw from a PER-THREAD crypto-scratch lane: sigil (since 3.9.7; vendored 3.11.1)
# auto-banks a private lane per thread in `cbank()`, so two workers handshaking at
# the same instant no longer race the (formerly process-global) HKDF/ed25519/
# AES-NI/bignum scratch. This closes the 2026-06-28 sigil scratch race — no
# per-worker `crypto_bank_set` call is needed (the lane is assigned automatically
# on first crypto use). `_server_tls_probe.cyr`'s [4] gate drives 16 genuinely
# -simultaneous handshakes against a 4-worker pool and requires all 16 to survive
# with a 200 response (was 0/16 through 1.7.0 / cyrius 6.3.5; now 16/16). The
# plaintext pool `sandhi_server_run_pooled` never touched sigil scratch and was
# always safe at any `max_conns`.

# Per-TLS-worker arg (64 bytes): { chan, fp, ctx, idle_ms, cert, cert_len, key, key_len }.
enum SandhiPoolTlsWorkerOff {
    SANDHI_POOL_TW_CHAN     = 0;
    SANDHI_POOL_TW_FP       = 8;
    SANDHI_POOL_TW_CTX      = 16;
    SANDHI_POOL_TW_IDLE_MS  = 24;
    SANDHI_POOL_TW_CERT     = 32;
    SANDHI_POOL_TW_CERT_LEN = 40;
    SANDHI_POOL_TW_KEY      = 48;
    SANDHI_POOL_TW_KEY_LEN  = 56;
}
var SANDHI_POOL_TLS_WORKER_ARG_SIZE = 64;

fn _sandhi_server_pool_tls_worker(arg): i64 {
    var ch       = load64(arg + SANDHI_POOL_TW_CHAN);
    var fp       = load64(arg + SANDHI_POOL_TW_FP);
    var ctx      = load64(arg + SANDHI_POOL_TW_CTX);
    var idle_ms  = load64(arg + SANDHI_POOL_TW_IDLE_MS);
    var cert     = load64(arg + SANDHI_POOL_TW_CERT);
    var cert_len = load64(arg + SANDHI_POOL_TW_CERT_LEN);
    var key      = load64(arg + SANDHI_POOL_TW_KEY);
    var key_len  = load64(arg + SANDHI_POOL_TW_KEY_LEN);
    # Published by sandhi_server_run_pooled_tls before any worker spawned.
    var reqbuf   = alloc_via(default_alloc(), _hsv_req_max);
    if (reqbuf == 0) { return 0; }           # OOM — worker exits, pool runs short
    # 1.6.10 — per-worker arena, reset_via per connection. Worker ctxs are fully
    # independent, so each owns its own arena → no cross-worker reset race; RSS
    # stays flat per worker.
    var tarena = arena_allocator(SANDHI_SERVER_TLS_ARENA_CAP);
    if (tarena == 0) { return 0; }
    while (1 == 1) {
        var cfd = chan_recv(ch);
        if (cfd == 0) { return 0; }          # channel closed
        if (idle_ms > 0) { _sandhi_conn_set_timeout_ms(cfd, idle_ms, _SANDHI_SO_RCVTIMEO); }
        var shim = _sandhi_server_tls_handshake_a(tarena, cfd, cert, cert_len, key, key_len);
        if (shim != 0) {
            _sandhi_server_tls_serve_one(tarena, fp, ctx, shim, cfd, reqbuf);
            tls_close(shim);
        }
        sock_close(cfd);
        reset_via(tarena);                   # rewind → flat per-worker RSS
    }
    return 0;
}

fn sandhi_server_run_pooled_tls(addr, port, handler_fp, ctx, opts): i64 {
    _sandhi_server_ignore_sigpipe();
    if (sandhi_server_options_get_tls(opts) == 0) { return 1; }
    var cert     = load64(opts + SANDHI_SERVER_OPT_OFF_TLS_CERT);
    var cert_len = load64(opts + SANDHI_SERVER_OPT_OFF_TLS_CERT_LEN);
    var key      = load64(opts + SANDHI_SERVER_OPT_OFF_TLS_KEY);
    var key_len  = load64(opts + SANDHI_SERVER_OPT_OFF_TLS_KEY_LEN);
    if (cert == 0 || key == 0) { return 1; }
    var idle_ms = sandhi_server_options_get_idle_ms(opts);
    if (idle_ms <= 0) { idle_ms = SANDHI_SERVER_DEFAULT_IDLE_MS; }
    var workers = sandhi_server_options_get_max_conns(opts);
    if (workers < 1) { workers = 1; }
    # 1.9.4 — publish the request cap before spawning workers (see run_pooled).
    _hsv_resolve_req_max(opts);
    # 1.9.7 — resolve the per-request arena cap and claim a thread-local slot
    # BEFORE any worker exists, for the same reason `_hsv_req_max` is published
    # here: both are read by every worker and written exactly once, on this
    # thread, strictly before the first reader is spawned. Claiming the slot is
    # idempotent, so the second pooled entry point reuses the first's.
    _hsv_req_arena_cap = sandhi_server_options_get_req_arena(opts);
    if (_hsv_req_arena_cap > 0 && _sandhi_req_arena_slot < 0) {
        _sandhi_req_arena_slot = thread_local_alloc();
    }
    var backlog = sandhi_server_options_get_backlog(opts);
    if (backlog < workers) { backlog = workers; }
    var stop_ptr = sandhi_server_options_get_stop_flag(opts);   # 1.9.9

    var sfd_tag, sfd = tcp_socket();
    if (is_err_result(sfd_tag) == 1) { return 1; }
    sock_reuse(sfd);
    if (is_err_result(sock_bind(sfd, addr, port)) == 1) { sock_close(sfd); return 1; }
    if (is_err_result(sock_listen(sfd, backlog)) == 1) { sock_close(sfd); return 1; }

    # 1.9.9 — no-op unless a stop flag is configured.
    _sandhi_server_arm_stop_poll(sfd, stop_ptr);

    var ch = chan_new(backlog);
    if (ch == 0) { sock_close(sfd); return 1; }

    var w = 0;
    while (w < workers) {
        var warg = alloc_via(default_alloc(), SANDHI_POOL_TLS_WORKER_ARG_SIZE);
        if (warg == 0) { sock_close(sfd); return 1; }
        store64(warg + SANDHI_POOL_TW_CHAN, ch);
        store64(warg + SANDHI_POOL_TW_FP, handler_fp);
        store64(warg + SANDHI_POOL_TW_CTX, ctx);
        store64(warg + SANDHI_POOL_TW_IDLE_MS, idle_ms);
        store64(warg + SANDHI_POOL_TW_CERT, cert);
        store64(warg + SANDHI_POOL_TW_CERT_LEN, cert_len);
        store64(warg + SANDHI_POOL_TW_KEY, key);
        store64(warg + SANDHI_POOL_TW_KEY_LEN, key_len);
        thread_create(&_sandhi_server_pool_tls_worker, warg);
        w = w + 1;
    }

    # 1.9.8 — accept-failure state; see the accept-error policy block above.
    var ast = _sandhi_accept_state_new();
    if (ast == 0) { chan_close(ch); sock_close(sfd); return 1; }

    while (1 == 1) {
        # 1.9.9 — cooperative stop. Same teardown ORDER as the fatal path
        # below, and for the same reason: closing the handoff channel first
        # makes every worker's `chan_recv` return 0, so they exit instead of
        # parking on a channel nobody will ever feed again.
        if (_sandhi_server_stop_requested(stop_ptr) == 1) {
            chan_close(ch);
            sock_close(sfd);
            return 0;
        }
        var cr_tag, cr = sock_accept(sfd);
        if (is_err_result(cr_tag) == 1) {
            # 1.9.8: was no else branch (see sandhi_server_run_pooled) — same
            # channel-then-socket close order so workers unpark and exit.
            var act = _sandhi_accept_step(ast, cr);
            if (act == SANDHI_ACCEPT_FATAL) { chan_close(ch); sock_close(sfd); return 1; }
            if (act == SANDHI_ACCEPT_BACKOFF) { sleep_ms(_sandhi_accept_state_delay(ast)); }
        } else {
            _sandhi_accept_state_reset(ast);
            chan_send(ch, cr);      # blocks if the pool is saturated
        }
    }
    return 0;
}

# ================================================================
# sandhi-scoped identity
# ================================================================
# Kept so downstream can probe the migrated-module version. Retires
# when fold-into-stdlib lands; consumers should prefer sandhi_version().

# --- main.cyr ---

# sandhi — public API / library root.
#
# This file declares the top-level surface that consumers include
# via `lib/sandhi.cyr` (once folded into Cyrius stdlib) or
# `dist/sandhi.cyr` (the distributed bundle pre-fold).
#
# No top-level `main()` / `syscall(60)` — sandhi is a LIBRARY.
# `programs/smoke.cyr` is the compile-link proof target.
#
# Per ADR 0001: sandhi composes stdlib primitives (http.cyr, ws.cyr,
# tls.cyr, json.cyr, net.cyr) into full-featured client patterns +
# service discovery. It does NOT reimplement the primitives.
# Scaffolded 2026-04-24.

# --- Public surface ---------------------------------------------------------
# Each sub-module exposes a small, documented verb set:
#   sandhi::http            — HTTP/1.1 + HTTP/2 client. Full method
#                             surface (GET/POST/PUT/DELETE/PATCH/HEAD),
#                             custom headers, HTTPS via tls, opt-in
#                             bounded redirect following, full timeout
#                             matrix (connect/read/write/total),
#                             retry-with-backoff for idempotent
#                             methods. Auto-selection between h2 and
#                             1.1 via `sandhi_http_request_auto`.
#   sandhi::http::pool      — per-route connection pool. Backs
#                             HTTP/1.1 keep-alive + HTTP/2 stream
#                             multiplex from the same struct (ADR
#                             0003). Opt-in via `sandhi_http_options_pool`.
#   sandhi::http::h2        — full HTTP/2 protocol stack: frames
#                             (RFC 7540 §6), HPACK header compression
#                             with Huffman decode (RFC 7541), per-call
#                             reentrant connection lifecycle.
#                             `sandhi_h2_request` is the manual entry
#                             point; auto-selection wires it through
#                             the pool.
#   sandhi::http::stream    — streaming HTTP + WHATWG SSE parser +
#                             incremental chunked decode + callback-per-
#                             event dispatch.
#   sandhi::http::download  — binary streaming download to an fd or
#                             byte-sink (`sandhi_http_download` /
#                             `_download_sink`). Reuses the redirect-
#                             follow + chunked/close decode of the
#                             buffered path but never buffers the whole
#                             body — resident memory is bounded
#                             regardless of artifact size. The non-SSE
#                             counterpart to stream (carries binary
#                             blobs the SSE path can't).
#   sandhi::rpc             — JSON-RPC dialects (W3C WebDriver wire,
#                             Appium extensions, MCP-over-HTTP + SSE).
#                             Transport only per ADR 0001 — protocol
#                             semantics live in bote / t-ron.
#   sandhi::discovery       — service discovery: daimon-registered
#                             lookup, chain-fallback composition,
#                             mDNS resolver (RFC 6762 link-local A
#                             query against 224.0.0.251:5353).
#   sandhi::tls_policy      — cert pinning (SPKI, constant-time
#                             compare), mTLS, custom trust store,
#                             policy composition, ALPN advertise list.
#                             Runtime enforcement wired since 0.9.3
#                             (libssl/libcrypto symbols resolved via
#                             stdlib `tls_dlsym`); fail-closed when a
#                             policy demands enforcement that isn't
#                             wired.
#   sandhi::client::resolve — `sandhi_client_set_resolver(fn, ctx)` /
#                             `_clear_resolver` / `_resolver_installed`
#                             (1.9.14). A consumer's policy sits between
#                             hostname and connect and can REFUSE, so an
#                             SSRF guard vets the address the client will
#                             actually dial instead of one it resolved
#                             separately a moment earlier. Fires per
#                             redirect hop and for IP literals, so it is a
#                             genuine single choke point. Filed by bote.
#   sandhi::server          — HTTP/1.1 server. Canonical names are
#                             `sandhi_server_*` (post-0.9.2 rename);
#                             `http_*` aliases retained as transitional
#                             wrappers, retire at the v5.7.0 fold.
#                             Built-in 400-on-smuggling guards (CL+TE,
#                             dup Host/CL/TE).

# `SANDHI_VERSION` is declared in `src/version_str.cyr`, which is
# auto-generated from the top-level `VERSION` file via
# `scripts/version-bump.sh` (mirrors the cyrius pattern in
# `cyrius/src/version_str.cyr`). VERSION is the only place a
# developer edits the version string; the bump script regenerates
# version_str.cyr in lockstep and CI fails the build if they drift.
fn sandhi_version(): i64 {
    return SANDHI_VERSION;
}
