# fs_win.cyr — Windows (PE) directory enumeration for lib/fs.cyr.
# Included from lib/fs.cyr under `#ifdef CYRIUS_TARGET_WIN`, mirroring how
# args.cyr → args_win.cyr and process.cyr → process_win.cyr dispatch.
#
# v6.1.18: dir_list/is_dir/dir_walk bottomed out on syscall(SYS_GETDENTS64,…)
# (arity 5), which has no Windows route — since v6.1.17 it returned an honest
# -38, so directory walking was a no-op on Windows. This implements the real
# port via five kernel32 reroutes (see src/backend/pe/emit.cyr + parse_expr.cyr):
#   0xF016 FindFirstFileW(pattern, &data) → HANDLE  (INVALID_HANDLE_VALUE = -1)
#   0xF017 FindNextFileW(h, &data)        → BOOL     (0 = end, or a failure: see 0xF04B)
#   0xF018 FindClose(h)                   → BOOL
#   0xF019 GetFileAttributesW(path)       → DWORD    (0xFFFFFFFF = invalid)
#   0xF04B GetLastError()                 → DWORD    (6.6.12)
# dir_walk / dir_list_full / find_files need no changes — they sit on dir_list
# + is_dir and become correct transitively.
#
# ⛔ 6.6.12 — 0xF016 and 0xF019 take a NARROW UTF-8 path (pattern) and the emitter widens it,
# exactly as it does for open/mkdir/unlink/rename/rmdir: one UTF-8 decoder (invalid UTF-8 is
# refused) and one long-path rule (a path of 248+ units is made absolute and `\\?\`-prefixed).
# Until 6.6.12 this file widened the path itself with no prefix, so Windows applied MAX_PATH: on
# real Windows `is_dir` of an existing 272-byte directory said 0 and `dir_list` of it was empty,
# while mkdir and open worked on the same path (wine does not enforce MAX_PATH). The 509/511-byte
# caps that stood in front of the old widen are gone with it.
#
# Self-contained on purpose: lib/fs.cyr's dependency contract is
# string/alloc/str/vec/syscalls — it does NOT pull in args.cyr or process_win.cyr,
# so this file carries its own UTF-16 → UTF-8 helper rather than reusing
# _args_w2u8 (which would force every fs.cyr consumer to also include that module,
# FATAL under --strict). _fs_narrow mirrors lib/args.cyr::_args_w2u8.

# WIN32_FIND_DATAW field offsets (pack=4): dwFileAttributes@0, cFileName@44
# (WCHAR[260]); total sizeof = 592. FILE_ATTRIBUTE_DIRECTORY = 0x10.

# Copy EXACTLY the Str's bytes (a Str need not be NUL-terminated: str_sub shares its parent's
# bytes) into a NUL-terminated UTF-8 path for the narrow reroutes, with `\*` appended when
# `star` is 1 (FindFirstFileW's "every entry" pattern; only `*` after a path that already ends
# in a separator). Into `dst` (`cap` bytes) when it fits — every caller passes a 32776-byte
# stack buffer, room for any path Windows accepts when it is ASCII (32767 units) — else into a
# fresh allocation, which only a multi-byte path of more than 32773 bytes needs. Returns the
# path, or 0 — which the callers answer as "no such path", never as some other path — for an
# EMPTY path, an embedded NUL (it would cut the path), more bytes than 32768 UTF-16 units can
# decode from, or a refused allocation. UTF-8 validity is the emitter's check
# (MultiByteToWideChar with MB_ERR_INVALID_CHARS refuses). CHANGELOG [6.6.12]
fn _fs_zpath(path: Str, star, dst, cap): i64 {
    var n = str_len(path);
    if (n == 0) { return 0; }
    var out = dst;
    if (n + 3 > cap) {
        if (n > 98304) { return 0; }
        out = alloc(n + 3);
        if (out == 0) { return 0; }
    }
    var pd = str_data(path);
    var i = 0;
    while (i < n) {
        var c = load8(pd + i);
        if (c == 0) { return 0; }
        store8(out + i, c);
        i = i + 1;
    }
    if (star == 1) {
        var last = load8(out + n - 1);
        if (last != 47) {
            if (last != 92) {
                store8(out + n, 92);                    # '\'
                n = n + 1;
            }
        }
        store8(out + n, 42);                            # '*'
        n = n + 1;
    }
    store8(out + n, 0);
    return out;
}

# Convert ONE UTF-16LE NUL-terminated wide string at `w` into UTF-8 in `dst`
# (≤ cap bytes), NUL-terminated; returns bytes written EXCLUDING the NUL.
# Surrogate pairs (U+10000+) decode to 4-byte UTF-8. Mirror of
# lib/args.cyr::_args_w2u8 (kept local so fs.cyr stays decoupled from args.cyr).
fn _fs_narrow(w, dst, cap): i64 {
    var i = 0;
    var o = 0;
    var lo = 0;
    var hi = 0;
    var cu = 0;
    var cp = 0;
    var lo2 = 0;
    var hi2 = 0;
    var cu2 = 0;
    var done = 0;
    while (done == 0) {
        lo = load8(w + i);
        hi = load8(w + i + 1);
        cu = lo | (hi << 8);
        if (cu == 0) {
            done = 1;
        } else {
            cp = cu;
            i = i + 2;
            if (cu >= 0xD800) {
                if (cu <= 0xDBFF) {
                    lo2 = load8(w + i);
                    hi2 = load8(w + i + 1);
                    cu2 = lo2 | (hi2 << 8);
                    if (cu2 >= 0xDC00) {
                        if (cu2 <= 0xDFFF) {
                            cp = 0x10000 + ((cu - 0xD800) << 10) + (cu2 - 0xDC00);
                            i = i + 2;
                        }
                    }
                }
            }
            if (o + 5 < cap) {
                if (cp < 0x80) {
                    store8(dst + o, cp);
                    o = o + 1;
                } elif (cp < 0x800) {
                    store8(dst + o, 0xC0 | (cp >> 6));
                    store8(dst + o + 1, 0x80 | (cp & 0x3F));
                    o = o + 2;
                } elif (cp < 0x10000) {
                    store8(dst + o, 0xE0 | (cp >> 12));
                    store8(dst + o + 1, 0x80 | ((cp >> 6) & 0x3F));
                    store8(dst + o + 2, 0x80 | (cp & 0x3F));
                    o = o + 3;
                } else {
                    store8(dst + o, 0xF0 | (cp >> 18));
                    store8(dst + o + 1, 0x80 | ((cp >> 12) & 0x3F));
                    store8(dst + o + 2, 0x80 | ((cp >> 6) & 0x3F));
                    store8(dst + o + 3, 0x80 | (cp & 0x3F));
                    o = o + 4;
                }
            }
        }
    }
    store8(dst + o, 0);
    return o;
}

# List `path`'s entry names (cloned Strs; `.` and `..` skipped) onto `entries` — the
# Windows arm of fs.cyr's `_dir_list_into_vec` (dir_list / dir_list_checked / the walkers
# sit on it). 0, or -1 when the directory could not be enumerated.
#
# ⛔ 6.6.10 — FAIL CLOSED. FindFirstFileW on "<dir>\*" answers even an EMPTY directory (its
# `.` and `..` entries), so INVALID_HANDLE_VALUE is never "no entries": the path is missing,
# is not a directory, or its ACL denies listing. This returned the empty vec for all three,
# which every walker then read as an empty directory — the same fold as the getdents arms.
# ⛔ 6.6.12 — AND A FAILED FindNextFileW IS NOT THE END. It returns 0 both at the end and on a
# failure part-way; only GetLastError tells them apart, and there was no reroute for it, so a
# listing that failed half-way came back as a complete, shorter directory. The error is now read
# (0xF04B) BEFORE FindClose can overwrite it: ERROR_NO_MORE_FILES (18) is the end, anything else
# is -1 — the same fail-closed answer as a FindFirstFileW failure.
# The buffers are on the STACK (they were alloc()ed and stored through unchecked — a refused
# allocation wrote the pattern to address 0 — and never given back: the default allocator has
# no free, and dir_walk lists every directory it visits). CHANGELOG [6.6.10], [6.6.12]
fn _dir_list_into_vec(path: Str, entries): i64 {
    var zb[32776];
    var pat = _fs_zpath(path, 1, &zb, 32776);          # "<path>\*", UTF-8 (6.6.12)
    if (pat == 0) { return 0 - 1; }

    var fd[592];                        # WIN32_FIND_DATAW
    var h = syscall(61462, pat, &fd);   # FindFirstFileW
    if (h == 0 - 1) { return 0 - 1; }   # INVALID_HANDLE_VALUE — see above: an ERROR

    var name8[1056];
    var more = 1;
    while (more != 0) {
        _fs_narrow(&fd + 44, &name8, 1056);   # cFileName (UTF-16) → UTF-8
        var skip = 0;
        if (load8(&name8) == 46) {
            if (load8(&name8 + 1) == 0) { skip = 1; }
            if (load8(&name8 + 1) == 46) {
                if (load8(&name8 + 2) == 0) { skip = 1; }
            }
        }
        if (skip == 0) {
            vec_push(entries, str_clone(str_from(&name8)));
        }
        more = syscall(61463, h, &fd);  # FindNextFileW (0 at the end OR on a failure)
    }
    var err = syscall(61515);           # GetLastError — FIRST, before FindClose overwrites it
    syscall(61464, h);                  # FindClose
    if (err != 18) { return 0 - 1; }    # not ERROR_NO_MORE_FILES: the listing failed part-way
    return 0;
}

# `dir_list_into`'s Windows arm (fs.cyr): the caller-owned-buffer lister, allocating nothing.
# `scratch` holds the WIN32_FIND_DATAW (592 bytes; fs.cyr has already refused a scratch under
# 1024). Returns the entry count, or -1 (could not be enumerated, or failed part-way — see
# `_dir_list_into_vec`), -3 (names full) or -4 (offs full): truncation is an error, never a
# short count. ⛔ 6.6.12 — there was no Windows arm: the POSIX open + getdents64 body compiled
# for PE and answered -1 for every directory, `.` included. CHANGELOG [6.6.12]
fn _dir_list_into_win(path: Str, scratch, names, names_cap, offs, max_entries): i64 {
    var zb[32776];
    var pat = _fs_zpath(path, 1, &zb, 32776);
    if (pat == 0) { return 0 - 1; }
    var h = syscall(61462, pat, scratch);   # FindFirstFileW into the caller's scratch
    if (h == 0 - 1) { return 0 - 1; }
    var name8[1056];
    var count = 0;
    var npos = 0;
    var more = 1;
    while (more != 0) {
        var nl = _fs_narrow(scratch + 44, &name8, 1056);
        var skip = 0;
        if (load8(&name8) == 46) {
            if (nl == 1) { skip = 1; }
            if (nl == 2) {
                if (load8(&name8 + 1) == 46) { skip = 1; }
            }
        }
        if (skip == 0) {
            if (count >= max_entries) { syscall(61464, h); return 0 - 4; }
            if (npos + nl + 1 > names_cap) { syscall(61464, h); return 0 - 3; }
            store64(offs + count * 8, npos);
            memcpy(names + npos, &name8, nl);
            store8(names + npos + nl, 0);
            npos = npos + nl + 1;
            count = count + 1;
        }
        more = syscall(61463, h, scratch);  # FindNextFileW
    }
    var err = syscall(61515);               # GetLastError, before FindClose
    syscall(61464, h);
    if (err != 18) { return 0 - 1; }        # not ERROR_NO_MORE_FILES
    return count;
}

# Is `path` a directory? One GetFileAttributesW call — no handle churn. Both fns here take
# `path: Str` as fs.cyr's POSIX arms do (bite 14's find, 6.6.10): untyped, a bare literal
# (`is_dir("dir")`) arrived as a raw cstring and `str_data` read garbage — a page fault at
# 0xFFFFFFFFFFFFFFFF under wine, while every POSIX arm coerced it. The attributes
# answer for a directory whose ACL denies LISTING, so such a directory is still a directory
# here (the walkers then fail to list it, by name). Stack buffer, as above; no length cap but
# Windows' own (6.6.12). CHANGELOG [6.6.10], [6.6.12]
fn is_dir(path: Str): i64 {
    var zb[32776];
    var p = _fs_zpath(path, 0, &zb, 32776);
    if (p == 0) { return 0; }
    var attrs = syscall(61465, p);              # GetFileAttributesW (narrow; 6.6.12)
    if (attrs == 4294967295) { return 0; }      # INVALID_FILE_ATTRIBUTES
    if ((attrs & 16) != 0) { return 1; }        # FILE_ATTRIBUTE_DIRECTORY
    return 0;
}
