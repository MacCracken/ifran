#host_only
# ^ v6.5.24 bare-metal forbidden-module check (bare-metal deliverable #4). This
#   module is host-OS-only, so a `--target=<arch>-bare-metal-elf` build (which sets
#   CYRIUS_KERNEL=1) that includes it now FAILS with a clear error instead of
#   compiling silently and faulting at runtime inside the kernel. `#` opens a comment
#   in cyrius, so this line is inert for every host target. See PP_IS_HOST_ONLY in
#   src/frontend/lex_pp.cyr; remove the marker if this module is ever made
#   freestanding.
# fs.cyr — filesystem operations
# Usage: include "lib/fs.cyr"
# Includes its own definers (syscalls, alloc, string, str, vec) — `include "lib/fs.cyr"` alone
# compiles clean on every target. CHANGELOG [6.6.9] bite 7.
#
# Path operations, directory listing, file info.

# Linux getdents64 syscall
var FSYS_GETDENTS64 = 217;

# Directory entry header: d_ino(8) + d_off(8) + d_reclen(2) + d_type(1) + d_name(...)
var DT_REG = 8;
var DT_DIR = 4;
var DT_LNK = 10;

# v6.1.18: Windows has no getdents64 — directory enumeration is FindFirstFileW.
# fs_win.cyr supplies the Windows dir_list/is_dir; the getdents64 bodies below
# are excluded on PE (#ifndef CYRIUS_TARGET_WIN). Mirrors args.cyr/process.cyr.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
#ifdef CYRIUS_TARGET_WIN
include "lib/fs_win.cyr"
#endif

# Copy EXACTLY the Str's bytes into `dst` (`cap` bytes) as a NUL-terminated C string for the
# kernel. Returns the length, or -1 for an embedded NUL or a path that does not fit (`cap` is
# PATH_MAX, 4096, at every caller — the kernel refuses longer itself). ⛔ 6.6.11 — the POSIX arms
# handed `str_data(path)` straight to stat/open/readlink, so a Str made by `str_sub` (which
# shares its parent's bytes, with no NUL at its end) was answered for whatever followed it:
# `is_dir(str_sub(str_from("dirA"), 0, 3))` said 1 for a missing "dir" and dir_list listed
# dirA — the same wrong answer as the Windows widen, on every target. CHANGELOG [6.6.11]
fn _fs_cpath(path: Str, dst, cap): i64 {
    var n = str_len(path);
    if (n >= cap) { return 0 - 1; }
    var pd = str_data(path);
    var i = 0;
    while (i < n) {
        var c = load8(pd + i);
        if (c == 0) { return 0 - 1; }
        store8(dst + i, c);
        i = i + 1;
    }
    store8(dst + n, 0);
    return n;
}

# Join two path components with /
fn path_join(dir: Str, name: Str): i64 {
    var sb = str_builder_new();
    str_builder_add(sb, dir);
    if (str_len(dir) > 0) {
        var last = load8(str_data(dir) + str_len(dir) - 1);
        if (last != 47) { str_builder_add_cstr(sb, "/"); }
    }
    str_builder_add(sb, name);
    return str_builder_build(sb);
}

# Get basename (last component after /)
fn path_basename(path: Str): i64 {
    var slen = str_len(path);
    var sd = str_data(path);
    var last_slash = 0 - 1;
    var pi = 0;
    while (pi < slen) {
        if (load8(sd + pi) == 47) { last_slash = pi; }
        pi = pi + 1;
    }
    if (last_slash < 0) { return path; }
    return str_sub(path, last_slash + 1, slen - last_slash - 1);
}

# Get dirname (everything before last /)
fn path_dirname(path: Str): i64 {
    var slen = str_len(path);
    var sd = str_data(path);
    var last_slash = 0 - 1;
    var pi = 0;
    while (pi < slen) {
        if (load8(sd + pi) == 47) { last_slash = pi; }
        pi = pi + 1;
    }
    if (last_slash <= 0) { return str_from("/"); }
    return str_sub(path, 0, last_slash);
}

# Check if path has a specific extension. Both args are Str
# (matches str_ends_with's signature).
#
# v6.4.72: params annotated `: Str` so a bare cstring-literal arg
# (`path_has_ext(name, ".tcyr")`) is auto-coerced to str_from at
# the call boundary — previously the literal flowed in as a raw
# cstr pointer and str_ends_with read load64(ptr+8) as the suffix
# length (garbage), silently failing every check. The literal→Str
# coercion in PARSE_FNCALL fires ONLY for a param typed `: Str`
# (smask bit) AND a literal-token arg; an untyped param leaves the
# pointer un-wrapped. See the find_files note below. Callers may
# still wrap explicitly (`str_from(".tcyr")`) — an already-Str
# IDENT arg is passed through unchanged.
fn path_has_ext(path: Str, ext: Str): i64 {
    return str_ends_with(path, ext);
}

# The lister behind dir_list / dir_list_checked: push `path`'s entry names (cloned Strs)
# onto `entries`; 0, or a negative error (see dir_list_checked). One arm per target.
#
# v5.9.6 fix: clone each filename out of the getdents64 batch
# buffer before pushing to the vec. Pre-fix `vec_push(entries,
# str_from(name))` borrowed the byte pointer into the 4096-byte
# `buf`; on the next outer iteration, getdents64 overwrote that
# buf with the next batch, and previously-pushed Strs silently
# pointed at garbage. Surfaced when programs/checks/selfhost.cyr's
# `_testsuite_gate` reported "0 files" despite 128 .tcyr files
# present — `path_has_ext(name, ".tcyr")` returned false for
# every borrowed-then-clobbered name. dir_list_full + dir_walk
# inherit the fix transitively (they call dir_list).
#ifndef CYRIUS_TARGET_WIN
#ifdef CYRIUS_TARGET_AGNOS
# v6.2.23: agnos uses getdents #29 (3-arg: dir_fd, buf, bufsize — no Linux 4th
# `basep`) and a sovereign dirent record (agnos-userland-abi.md §4.2), NOT the
# Linux getdents64 #217 / dirent64 this file assumed for every non-Windows
# target. The record is reclen-delimited: reclen u16 @0, type u8 @2
# (1=file/2=dir/3=symlink/0=unknown), namelen u8 @3, ino u32 @4, then the name
# bytes @8 — which are NOT NUL-terminated (namelen is authoritative). Open uses
# the agnos sys_open (name, namelen, flags) ABI directly — a raw
# sys_open(path, O_RDONLY, 0) would read O_RDONLY(=0) as namelen=0. The flags arg
# MUST be AO_DIRECTORY (0x800), NOT 0: the agnos kernel routes an open WITHOUT
# 0x800 to ext2_open(), which rejects anything that is not a regular file
# (mode&0xF000 != 0x8000 → -1), so a directory open returns -1; only the 0x800
# path reaches ext2_open_dir() and yields the VFS_EXT2_DIR fd that getdents(#29)
# consumes (agnos kernel syscall.cyr:586 / ext2.cyr; agnos-userland-abi.md §3.1).
# Inlined (strlen + sys_open) rather than reaching up to io.cyr's file_open so
# this base lib keeps its existing dependency surface (string.cyr supplies
# strlen). See 2026-06-18-stdlib-native-agnos-abi-fs.md.
fn _dir_list_into_vec(path: Str, entries): i64 {
    var dp[4096];
    var dn = _fs_cpath(path, &dp, 4096);                # 6.6.11: exactly the Str's bytes
    if (dn < 0) { return 0 - 1; }
    var fd = sys_open(&dp, dn, AO_DIRECTORY);           # agnos: (name, namelen, AO_DIRECTORY)
    if (fd < 0) { return fd; }
    # v6.5.11: STACK scratch, not alloc(). The getdents buffer is dead the moment
    # this fn returns, but under the bump allocator alloc() never gives it back —
    # so every call leaked 4 KB. See the note on the non-agnos arm below.
    var sbuf[4096];
    var buf = &sbuf;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_getdents(fd, buf, 4096);
        if (n < 0) { sys_close(fd); return n; }   # a read error is NOT the end of the directory
        if (n == 0) { rgo = 0; }
        else {
            var pos = 0;
            while (pos < n) {
                var reclen = load16(buf + pos);
                var namelen = load8(buf + pos + 3);
                var name = buf + pos + 8;
                # Skip . and .. (namelen-delimited; names are not NUL-terminated)
                var skip = 0;
                if (namelen == 1) {
                    if (load8(name) == 46) { skip = 1; }
                }
                if (namelen == 2) {
                    if (load8(name) == 46) {
                        if (load8(name + 1) == 46) { skip = 1; }
                    }
                }
                if (skip == 0) {
                    # str_from_buf copies exactly namelen bytes + NUL-terminates
                    # (the agnos record's name has no terminator of its own).
                    vec_push(entries, str_from_buf(name, namelen));
                }
                pos = pos + reclen;
            }
        }
    }
    sys_close(fd);
    return 0;
}
#endif
#ifndef CYRIUS_TARGET_AGNOS
fn _dir_list_into_vec(path: Str, entries): i64 {
    var cpath[4096];
    if (_fs_cpath(path, &cpath, 4096) < 0) { return 0 - 1; }   # 6.6.11: exactly the Str's bytes
    var fd = sys_open(&cpath, O_RDONLY, 0);
    if (fd < 0) { return fd; }
    # ⛔ v6.5.11: STACK scratch, not alloc(). Both buffers are dead the moment this fn
    # returns, but the default allocator is a BUMP allocator — it has no free — so each
    # call permanently burned 4104 B. Measured before the fix: dir_list 176 B/entry,
    # is_dir 4104 B PER CALL, and because dir_walk calls is_dir once per entry,
    # dir_walk cost 4443 B/entry — ~25x the dir_list it wraps.
    #
    # A stack local is the right answer rather than a file-scope scratch buffer: it is
    # inherently per-call and therefore per-THREAD, so it costs no thread-safety (today
    # every caller owns its own buffer and a shared scratch would have taken that away),
    # and it needs no thread-local slot — those are a scarce, collision-prone resource
    # here (tests/gates/concurrency/thread_local_slot_collision.sh exists for that reason).
    # Safe under dir_walk's recursion: dir_list/is_dir are leaves, so their frames pop
    # before the recursive call and the 4 KB is never held down the stack.
    var sbuf[4096];
    var buf = &sbuf;
    # v6.0.60: Darwin getdirentries64 takes a 4th basep out-param (the new dir
    # position); Linux getdents64 ignores a 4th arg, so passing it is portable.
    # The Mach-O backends translate 217 → getdirentries64 (344). See
    # 2026-06-02-macos-getdirentries-dir-listing-port.md.
    var sbasep[8];
    var basep = &sbasep;
    store64(basep, 0);
    var rgo = 1;
    while (rgo == 1) {
        var n = syscall(FSYS_GETDENTS64, fd, buf, 4096, basep);
        if (n < 0) { sys_close(fd); return n; }   # a read error is NOT the end of the directory
        if (n == 0) { rgo = 0; }
        else {
            var pos = 0;
            while (pos < n) {
                var reclen = load16(buf + pos + 16);
                # Darwin dirent: d_type @20, d_name @21 (Linux: @18 / @19); reclen
                # is @16 on both. Layout confirmed empirically on ecb (arm64).
                #ifdef CYRIUS_TARGET_MACOS
                var dtype = load8(buf + pos + 20);
                var name = buf + pos + 21;
                #else
                var dtype = load8(buf + pos + 18);
                var name = buf + pos + 19;
                #endif
                # Skip . and ..
                var skip = 0;
                if (load8(name) == 46) {
                    if (load8(name + 1) == 0) { skip = 1; }
                    if (load8(name + 1) == 46) {
                        if (load8(name + 2) == 0) { skip = 1; }
                    }
                }
                if (skip == 0) {
                    vec_push(entries, str_clone(str_from(name)));
                }
                pos = pos + reclen;
            }
        }
    }
    sys_close(fd);
    return 0;
}
#endif
#endif

# List directory entries. Returns a vec of Str (the names; `.` and `..` skipped).
#
# ⚠ An UNREADABLE directory lists as EMPTY here — the vec cannot say "I could not look".
# That is fine for a probe and wrong for anything that walks a tree to reach a verdict: a
# test runner, an auditor, a coverage count. Those use `dir_list_checked` /
# `dir_walk_checked`, which report the failure. CHANGELOG [6.6.10]
fn dir_list(path: Str): i64 {
    var entries = vec_new();
    _dir_list_into_vec(path, entries);
    return entries;
}

# List `path` into `entries` (a vec of Str; `.` and `..` skipped). Returns 0 when the
# whole directory was read, or a NEGATIVE error when it could not be opened or its entry
# stream failed part-way (the open's / read's errno on Linux and macOS, -1 on agnos and
# Windows); `entries` then holds whatever was read before the failure.
#
# ⛔ 6.6.10 — THE ERROR CHANNEL. `dir_list` folded both failures into "an empty directory":
# the open error returned the empty vec and `getdents` returning -EACCES/-EIO ended the
# loop like end-of-directory. So `chmod 000 tests/bad` turned `cyrius test` from
# "1 passed, 1 failed" into "1 passed, 0 failed" and `cyrius coverage` from 50 % to 100 %,
# with no diagnostic — every arm (Linux getdents64, Darwin getdirentries, agnos getdents,
# the Windows FindFirstFileW lister) had the same shape. CHANGELOG [6.6.10]
fn dir_list_checked(path: Str, entries): i64 {
    return _dir_list_into_vec(path, entries);
}

# List a directory into CALLER-OWNED buffers — allocates NOTHING.
#
# `dir_list` returns a vec of Str, so it costs one heap Str per entry and the default
# allocator is a bump allocator with no free. v6.5.11 removed the FIXED ~4.1 KB per call
# (the getdents scratch moved to the stack), but the per-entry cost is inherent to that
# return shape and is the half a long-running server actually feels — a directory listing
# inside a request loop grows the heap forever. This is the caller-owned form the agora
# filing asked for (2026-07-26-agora-fs-dir-list-per-call-alloc §"Proposed fix").
#
#   path        directory to list
#   scratch     caller buffer for the raw getdents batch (>= 1024; 4096 recommended; on
#               Windows it holds one WIN32_FIND_DATAW)
#   scratch_len size of `scratch`
#   names       caller buffer receiving NUL-terminated entry names, packed
#   names_cap   size of `names`
#   offs        caller i64 buffer receiving each name's offset into `names`
#   max_entries capacity of `offs`, in entries
#
# Returns the entry count (>= 0), or negative on error:
#   -1 open failed, or the directory could not be read (6.6.10: a read error part-way
#      used to end the listing like end-of-directory and return a short count)
#   -2 scratch too small   -3 names buffer full   -4 offs full
#
# ⛔ Truncation is an ERROR, never a short read: a silent partial listing is how a caller
# ends up believing a directory is smaller than it is. `.` and `..` are skipped, matching
# `dir_list`.
fn dir_list_into(path: Str, scratch, scratch_len, names, names_cap, offs, max_entries): i64 {
    if (scratch_len < 1024) { return 0 - 2; }
    #ifdef CYRIUS_TARGET_WIN
    # 6.6.12: FindFirstFileW/FindNextFileW into the caller's buffers (lib/fs_win.cyr) — there
    # was no Windows arm, so the open + getdents64 body below answered -1 for every directory.
    var wr = _dir_list_into_win(path, scratch, names, names_cap, offs, max_entries);
    return wr;
    #endif
    #ifndef CYRIUS_TARGET_WIN
    var count = 0;
    var npos = 0;
    #ifdef CYRIUS_TARGET_AGNOS
    var dp[4096];
    var dn = _fs_cpath(path, &dp, 4096);                # 6.6.11: exactly the Str's bytes
    if (dn < 0) { return 0 - 1; }
    var fd = sys_open(&dp, dn, AO_DIRECTORY);
    if (fd < 0) { return 0 - 1; }
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_getdents(fd, scratch, scratch_len);
        if (n < 0) { sys_close(fd); return 0 - 1; }   # 6.6.10: a read error, not the end
        if (n == 0) { rgo = 0; }
        else {
            var pos = 0;
            while (pos < n) {
                var reclen = load16(scratch + pos);
                var namelen = load8(scratch + pos + 3);
                var name = scratch + pos + 8;
                var skip = 0;
                if (namelen == 1) { if (load8(name) == 46) { skip = 1; } }
                if (namelen == 2) {
                    if (load8(name) == 46) { if (load8(name + 1) == 46) { skip = 1; } }
                }
                if (skip == 0) {
                    if (count >= max_entries) { sys_close(fd); return 0 - 4; }
                    if (npos + namelen + 1 > names_cap) { sys_close(fd); return 0 - 3; }
                    store64(offs + count * 8, npos);
                    memcpy(names + npos, name, namelen);
                    store8(names + npos + namelen, 0);
                    npos = npos + namelen + 1;
                    count = count + 1;
                }
                pos = pos + reclen;
            }
        }
    }
    sys_close(fd);
    return count;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var cpath[4096];
    if (_fs_cpath(path, &cpath, 4096) < 0) { return 0 - 1; }   # 6.6.11: exactly the Str's bytes
    var fd2 = sys_open(&cpath, O_RDONLY, 0);
    if (fd2 < 0) { return 0 - 1; }
    var basep[8];
    store64(&basep, 0);
    var rgo2 = 1;
    while (rgo2 == 1) {
        var n2 = syscall(FSYS_GETDENTS64, fd2, scratch, scratch_len, &basep);
        if (n2 < 0) { sys_close(fd2); return 0 - 1; }   # 6.6.10: a read error, not the end
        if (n2 == 0) { rgo2 = 0; }
        else {
            var pos2 = 0;
            while (pos2 < n2) {
                var reclen2 = load16(scratch + pos2 + 16);
                #ifdef CYRIUS_TARGET_MACOS
                var name2 = scratch + pos2 + 21;
                #endif
                #ifndef CYRIUS_TARGET_MACOS
                var name2 = scratch + pos2 + 19;
                #endif
                var skip2 = 0;
                if (load8(name2) == 46) {
                    if (load8(name2 + 1) == 0) { skip2 = 1; }
                    if (load8(name2 + 1) == 46) {
                        if (load8(name2 + 2) == 0) { skip2 = 1; }
                    }
                }
                if (skip2 == 0) {
                    var nl2 = strlen(name2);
                    if (count >= max_entries) { sys_close(fd2); return 0 - 4; }
                    if (npos + nl2 + 1 > names_cap) { sys_close(fd2); return 0 - 3; }
                    store64(offs + count * 8, npos);
                    memcpy(names + npos, name2, nl2);
                    store8(names + npos + nl2, 0);
                    npos = npos + nl2 + 1;
                    count = count + 1;
                }
                pos2 = pos2 + reclen2;
            }
        }
    }
    sys_close(fd2);
    return count;
    #endif
    #endif
}

# List directory entries with full paths
fn dir_list_full(path: Str): i64 {
    var names = dir_list(path);
    var full = vec_new();
    var di = 0;
    while (di < vec_len(names)) {
        vec_push(full, path_join(path, vec_get(names, di)));
        di = di + 1;
    }
    return full;
}

# Check if path is a directory (try to open with getdents)
#ifndef CYRIUS_TARGET_WIN
#ifdef CYRIUS_TARGET_AGNOS
# agnos getdents #29 (3-arg). Opening with AO_DIRECTORY (0x800) is itself the
# dir test: the kernel's ext2_open_dir() path only succeeds for a directory
# inode (a regular file / nonexistent path → fd<0), so a successful open already
# proves it is a directory. See dir_list above for the AO_DIRECTORY rationale.
fn is_dir(path: Str): i64 {
    var dp[4096];
    var dn = _fs_cpath(path, &dp, 4096);                # 6.6.11: exactly the Str's bytes
    if (dn < 0) { return 0; }
    var fd = sys_open(&dp, dn, AO_DIRECTORY);           # agnos: (name, namelen, AO_DIRECTORY)
    if (fd < 0) { return 0; }
    # v6.5.11: STACK scratch — see the note in dir_list. is_dir was the DOMINANT
    # allocation cost in this file, not dir_list: dir_walk calls it once per entry.
    var sbuf[4096];
    var buf = &sbuf;
    var n = sys_getdents(fd, buf, 4096);
    sys_close(fd);
    if (n >= 0) { return 1; }
    return 0;
}
#endif
#ifndef CYRIUS_TARGET_AGNOS
# ⛔ 6.6.10 — ASK stat(2), NOT open(2). This opened the path and read one batch of entries,
# so it answered "can I LIST this?", not "is this a directory?" — and a directory you may
# not read (chmod 000, an ACL) answered 0. Every tree walker then took that directory for a
# FILE, filtered it out by extension, and the whole subtree vanished without a word: the
# walker never even tried to list it, so no error channel could fire. A directory you cannot
# read is still a directory; the walker now descends, fails to list it, and says so. stat
# follows a final symlink, exactly as the open did, so `is_dir` on a link to a directory is
# still 1 (the walkers' `is_symlink` loop guard is unchanged). `STAT_MODE` is per target
# (24 x86-Linux, 16 aarch64-Linux, 4 macOS-arm64, 8 macOS-x86 legacy stat) — the offsets
# `_xdir_exists` in lib/io.cyr reads, verified on every host. The buffer is on the STACK
# (v6.5.11: dir_walk calls this once per entry). CHANGELOG [6.6.10]
fn is_dir(path: Str): i64 {
    var st[256];
    var cpath[4096];
    if (_fs_cpath(path, &cpath, 4096) < 0) { return 0; }   # 6.6.11: exactly the Str's bytes
    if (sys_stat(&cpath, &st) != 0) { return 0; }
    if ((load32(&st + STAT_MODE) & 0xF000) == 0x4000) { return 1; }   # S_IFMT == S_IFDIR
    return 0;
}
#endif
#endif

# Walk a directory tree, push all file paths to a vec
# ⛔ v6.5.12: DEPTH-BOUNDED. This recursion had no depth cap, no visited set, and
# `is_dir` (:251) opens with plain `O_RDONLY` — no `O_NOFOLLOW` — so a symlink to an
# ancestor resolves and reports 1. A loop therefore re-descended until the accumulated
# path exhausted PATH_MAX; termination was a property of path-string arithmetic, not of
# any decision. Measured: a tree holding ONE .tcyr plus `ln -s .. tests/sub/loop` ran
# **41 passed, 0 failed** — the count that reads as proof of coverage IS the bug
# inflating it, which is the silent-green shape this release keeps finding.
#
# A depth cap rather than a visited-inode set: it needs no allocation, and it bounds
# every cause (symlink loop, bind mount, Windows directory junction — `fs_win.cyr`'s `is_dir`
# treats a reparse point as a directory), not just the one we reproduced. O_NOFOLLOW was
# rejected because it would refuse LEGITIMATE symlinked directories, which real projects
# use. 64 is far past any real tree (`tests/tcyr/crossos/x.tcyr` is depth 3).
#
# The public signature is UNCHANGED — the depth rides on a private helper, so the
# api-surface snapshot and every caller stay as they were.
var DIR_WALK_MAX_DEPTH = 64;

# Return 1 if `path` is a SYMLINK, else 0.
#
# ⛔ v6.5.12: tree walks must LIST a symlink but not DESCEND it. `is_dir` opens with
# plain `O_RDONLY`, which resolves the link and reports 1, so a link to an ancestor made
# `dir_walk` re-enter the same subtree forever. The depth cap alone was not a fix: it
# bounded the runaway but the pass count stayed inflated (a tree holding ONE .tcyr still
# reported 32), and an inflated count reading as coverage is the failure being fixed.
#
# This matches `find`'s default and the `find`-based CI loops, so the walkers and the
# tooling around them finally agree.
#
# readlink is the portable test — it returns the target length (>= 0) for a symlink and
# -EINVAL for anything else. Present on x86-linux (#89), macOS (#89), aarch64-linux (via
# readlinkat #78) and agnos.
# ⛔ 6.6.9 — THE PE ARM RETURNED 0 FOR EVERYTHING, which failed OPEN in two places:
# `dir_walk` descended every junction and directory symlink on Windows (the loop guard
# above never fired there), and cyrius's own symlinked-lib write refusal
# (`_dep_dest_is_linked`, the v6.5.37 rule) could not see a link on Windows at all. It now
# asks the filesystem: FILE_ATTRIBUTE_REPARSE_POINT (GetFileAttributesW, which does NOT
# follow a final link, so a dangling one answers) and then the reparse TAG
# (FindFirstFileW's dwReserved0, WIN32_FIND_DATAW+36). Only a NAME SURROGATE counts —
# symlink 0xA000000C, junction 0xA0000003 (tag bit 29); a OneDrive placeholder or a dedup
# file is a reparse point that is still a file, and is not reported. CHANGELOG [6.6.9]
# ⚠ agnos's peer is the LENGTH-CARRYING form — `sys_readlink(path, pathlen, buf, buflen)`,
# 4 args, mirroring its `sys_open(name, namelen, flags)` ABI — while Linux/macOS take 3.
# Caught by `folds_agnos_parity.sh`, which compiles every folded stdlib for agnos as well
# as Linux; a 3-arg call here broke `lib/fs.cyr` for EVERY fold (sigil, patra, sankoch,
# sakshi, …) because fs.cyr is a PREAMBLE dep. That gate exists because yukti shipped six
# agnos ABI errors for months — this is the same class, caught the same way.
fn is_symlink(path: Str): i64 {
    #ifdef CYRIUS_TARGET_WIN
    # Exactly the Str's bytes (a Str need not be NUL-terminated), as a NARROW UTF-8 path the
    # emitter decodes and, past 247 units, `\\?\`-prefixes (6.6.12 — it was widened here with
    # no prefix and refused past 519 bytes, so a link on a long path answered 0). Both buffers
    # are on the STACK — dir_walk calls this for every entry, and a bump-allocated pair per call
    # leaked ~600 B + 2x the path each time. A path that is not valid UTF-8 answers 0.
    var zb[32776];
    var p = _fs_zpath(path, 0, &zb, 32776);
    if (p == 0) { return 0; }
    var attrs = syscall(61465, p);                  # GetFileAttributesW (no final-link follow)
    if (attrs == 4294967295) { return 0; }          # INVALID_FILE_ATTRIBUTES
    if ((attrs & 1024) == 0) { return 0; }          # not FILE_ATTRIBUTE_REPARSE_POINT
    var fd[592];                                    # WIN32_FIND_DATAW
    var h = syscall(61462, p, &fd);                 # FindFirstFileW on the name itself
    if (h == 0 - 1) { return 0; }
    syscall(61464, h);                              # FindClose
    if ((load32(&fd + 36) & 0x20000000) != 0) { return 1; }   # dwReserved0 = tag; name surrogate
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_WIN
    var lbuf[8];
    var cpath[4096];
    var cn = _fs_cpath(path, &cpath, 4096);             # 6.6.11: exactly the Str's bytes
    if (cn < 0) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    if (sys_readlink(&cpath, cn, &lbuf, 8) >= 0) { return 1; }
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (sys_readlink(&cpath, &lbuf, 8) >= 0) { return 1; }
    return 0;
    #endif
    #endif
}

# A directory the walk could not list. `failed` (a vec, or 0): the CHECKED walkers record
# the path there and their caller names it; the unchecked ones warn on stderr instead —
# except for the ROOT, which callers routinely probe with a path that may not exist.
fn _dir_walk_unlisted(path: Str, failed, depth, err): i64 {
    if (failed != 0) { vec_push(failed, path); return 0; }
    if (depth == 0) { return 0; }
    syscall(SYS_WRITE, 2, "warning: dir_walk: cannot list ", 31);
    syscall(SYS_WRITE, 2, str_data(path), str_len(path));
    syscall(SYS_WRITE, 2, " (error ", 8);
    var eb[24];
    var en = 0 - err;
    var el = 0;
    if (en <= 0) { store8(&eb, 63); el = 1; }   # '?'
    while (en > 0 && el < 20) { store8(&eb + el, 48 + en % 10); en = en / 10; el = el + 1; }
    while (el > 0) { el = el - 1; syscall(SYS_WRITE, 2, &eb + el, 1); }
    syscall(SYS_WRITE, 2, ") — subtree NOT walked; use dir_walk_checked to fail on it\n", 61);
    return 0;
}

fn _dir_walk_d(path: Str, results, depth, failed): i64 {
    # Stop, but do NOT pretend the tree ended: a silent truncation here would be the
    # same lie as the inflated count, one level down.
    if (depth > DIR_WALK_MAX_DEPTH) {
        if (failed != 0) { vec_push(failed, path); return vec_len(results); }
        syscall(SYS_WRITE, 2, "warning: dir_walk depth cap (64) hit at: ", 41);
        syscall(SYS_WRITE, 2, str_data(path), str_len(path));
        syscall(SYS_WRITE, 2, "\n  a symlink loop or a pathologically deep tree — subtree NOT walked.\n", 72);
        return vec_len(results);
    }
    var entries = vec_new();
    var lr = _dir_list_into_vec(path, entries);
    if (lr < 0) { _dir_walk_unlisted(path, failed, depth, lr); }
    var wi = 0;
    while (wi < vec_len(entries)) {
        var full = path_join(path, vec_get(entries, wi));
        # v6.5.12: a symlinked DIRECTORY is recorded but never DESCENDED (loop guard);
        # a symlinked FILE is recorded exactly as before. See is_symlink.
        if (is_dir(full) == 1 && is_symlink(full) == 1) {
            vec_push(results, full);
        } elif (is_dir(full) == 1) {
            _dir_walk_d(full, results, depth + 1, failed);
        } else {
            vec_push(results, full);
        }
        wi = wi + 1;
    }
    return vec_len(results);
}

# Walk a directory tree, pushing every file path found into `results`.
# Recursion is depth-bounded at DIR_WALK_MAX_DEPTH (see `_dir_walk_d`); a
# deeper subtree is skipped with a warning rather than walked forever.
# Returns the total number of entries in `results`.
fn dir_walk(path: Str, results): i64 {
    return _dir_walk_d(path, results, 0, 0);
}

# Walk a directory tree like `dir_walk`, and REPORT every directory it could not list:
# each one's path (a Str) is pushed onto `failed` — the root itself when it is missing or
# unreadable, a subdirectory whose open or entry stream failed, and a subtree cut at
# DIR_WALK_MAX_DEPTH. Returns the number of paths this call pushed onto `failed`: 0 means
# the whole tree was listed. File paths go to `results` exactly as dir_walk pushes them.
#
# ⛔ 6.6.10 — the walker a verdict may rest on. `dir_walk` dropped an unreadable subtree
# in silence (see dir_list_checked), so `cyrius test`, `cyrius audit` and `cyrius coverage`
# passed over files they had never seen. A caller that reports a result about the tree
# must fail, by name, when this returns non-zero. CHANGELOG [6.6.10]
fn dir_walk_checked(path: Str, results, failed): i64 {
    var before = vec_len(failed);
    _dir_walk_d(path, results, 0, failed);
    return vec_len(failed) - before;
}

# Find files matching an extension in a directory tree.
#
# v6.4.72 — params annotated `: Str`. The pre-fix untyped `ext`
# param was the root cause of a silent-0-matches bug: a caller
# passing a bare cstring literal (`find_files(str_from("src"),
# ".cyr")`) handed `ext` in as a raw cstr pointer rather than a
# Str, because the compiler's literal→Str auto-coercion only
# fires for a param typed `: Str`. That raw pointer then reached
# str_ends_with (via path_has_ext) as the `suffix`, where
# str_len(suffix)=load64(ptr+8) read garbage and every entry
# failed the filter — while dir_walk on the same path and a
# direct str_ends_with(walked, ".cyr") both worked (the direct
# call coerces the literal because str_ends_with IS typed `: Str`).
# NOT an allocator/heap-regime issue: find_files(path,
# str_from(".cyr")) always returned the full set. Typing the
# params makes the bare-literal form coerce at the boundary;
# str_from-wrapped callers are unaffected (byte-identical).
fn find_files(path: Str, ext: Str): i64 {
    return find_files_checked(path, ext, 0);
}

# `find_files`, with every directory the walk could not list pushed onto `failed` (see
# dir_walk_checked; 0 = warn on stderr as dir_walk does). Returns the vec of matching paths;
# the caller fails when `failed` grew. CHANGELOG [6.6.10]
fn find_files_checked(path: Str, ext: Str, failed): i64 {
    var all = vec_new();
    _dir_walk_d(path, all, 0, failed);
    var matched = vec_new();
    var fi = 0;
    while (fi < vec_len(all)) {
        var fp = vec_get(all, fi);
        if (path_has_ext(fp, ext) == 1) {
            vec_push(matched, fp);
        }
        fi = fi + 1;
    }
    return matched;
}

# Walk a directory tree, push all file paths to `results`,
# pruning any subtree whose entry name matches a member of
# `prunes`. `prunes` is a vec of Str; comparison is exact
# (no glob, no path-prefix). Equivalent to `find PATH -type f
# ( -path '*/X/*' -o ... ) -prune -o -print` with X drawn
# from `prunes`.
#
# Pinned at v5.9.17 for the TS corpus regression gates which
# walk `~/Repos/secureyeoman` for *.ts / *.tsx while skipping
# node_modules, dist, build, .next, coverage. Signature picked
# to mirror `dir_walk(path, results)` so callers can use the
# same shape.
# v6.5.12: depth-bounded, same reasoning as `_dir_walk_d` above — pruning by NAME does
# not stop a loop, because the symlink that closes it need not be named in `prunes`.
fn _dir_walk_prunes_d(path: Str, results, prunes, depth): i64 {
    if (depth > DIR_WALK_MAX_DEPTH) {
        syscall(SYS_WRITE, 2, "warning: dir_walk_with_prunes depth cap (64) hit at: ", 53);
        syscall(SYS_WRITE, 2, str_data(path), str_len(path));
        syscall(SYS_WRITE, 2, "\n  a symlink loop or a pathologically deep tree — subtree NOT walked.\n", 72);
        return vec_len(results);
    }
    # 6.6.10: an unlistable SUBdirectory is named on stderr, as in dir_walk.
    var entries = vec_new();
    var lr = _dir_list_into_vec(path, entries);
    if (lr < 0) { _dir_walk_unlisted(path, 0, depth, lr); }
    var wi = 0;
    while (wi < vec_len(entries)) {
        var name = vec_get(entries, wi);
        var pruned = 0;
        var pi = 0;
        while (pi < vec_len(prunes)) {
            if (str_eq(name, vec_get(prunes, pi)) == 1) {
                pruned = 1;
            }
            pi = pi + 1;
        }
        if (pruned == 0) {
            var full = path_join(path, name);
            # v6.5.12: symlinked DIRECTORIES recorded, not descended — see is_symlink.
            if (is_dir(full) == 1 && is_symlink(full) == 1) {
                vec_push(results, full);
            } elif (is_dir(full) == 1) {
                _dir_walk_prunes_d(full, results, prunes, depth + 1);
            } else {
                vec_push(results, full);
            }
        }
        wi = wi + 1;
    }
    return vec_len(results);
}

# Walk a directory tree like `dir_walk`, skipping any subtree whose entry
# name matches a member of `prunes` (a vec of Str; exact match, no glob).
# Depth-bounded identically — pruning by name cannot stop a symlink loop,
# because the link that closes it need not be named in `prunes`.
fn dir_walk_with_prunes(path: Str, results, prunes): i64 {
    return _dir_walk_prunes_d(path, results, prunes, 0);
}

# Find files matching an extension under `path`, pruning any
# subtree whose entry name matches a member of `prunes`. Same
# shape as `find_files(path, ext)`; adds the pruning hook.
#
# v6.4.72 — `path`/`ext` annotated `: Str` (same fix as
# find_files above; `prunes` stays a vec of Str). The TS-corpus
# release gates that pin this fn already pass str_from(...) for
# both, so they were never silently vacuous — but the annotation
# closes the bare-literal footgun for any future caller.
fn find_files_with_prunes(path: Str, ext: Str, prunes): i64 {
    var all = vec_new();
    dir_walk_with_prunes(path, all, prunes);
    var matched = vec_new();
    var fi = 0;
    while (fi < vec_len(all)) {
        var fp = vec_get(all, fi);
        if (path_has_ext(fp, ext) == 1) {
            vec_push(matched, fp);
        }
        fi = fi + 1;
    }
    return matched;
}
