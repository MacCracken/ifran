#host_only
# ^ v6.5.24 bare-metal forbidden-module check (bare-metal deliverable #4). This
#   module is host-OS-only, so a `--target=<arch>-bare-metal-elf` build (which sets
#   CYRIUS_KERNEL=1) that includes it now FAILS with a clear error instead of
#   compiling silently and faulting at runtime inside the kernel. `#` opens a comment
#   in cyrius, so this line is inert for every host target. See PP_IS_HOST_ONLY in
#   src/frontend/lex_pp.cyr; remove the marker if this module is ever made
#   freestanding.
# process.cyr — process management
# Usage: include "lib/process.cyr"
# Includes its own definers (6.6.9): syscalls.cyr, alloc.cyr, string.cyr, result.cyr, vec.cyr, str.cyr.
#
# v5.10.18 — was hard-blocked on `O_WRONLY` from `lib/io.cyr` for
# the `/dev/null` redirect in `run_capture`; cyrius's own
# check program (the only in-tree consumer) happened to
# include io.cyr first so it parsed clean, but every downstream
# consumer that didn't (agnosys 1.1.x specifically) hit
# `error: undefined variable 'O_WRONLY'`. Replaced with the
# literal `1` + a comment to keep this module self-sufficient
# (matching the pattern in `lib/fdlopen.cyr:234` —
# `# O_RDONLY`).

# 6.6.9: the rest of that job. Every arm — POSIX, process_win and process_agnos — calls the
# syscall peer, alloc, strlen, Ok/Err, vec_* and str_data, and this file included none of them,
# so a bare include was a hard error on Linux (`undefined variable 'SYS_GETPPID'`) and agnos
# (`SPAWN_ARGV_MAX`) and ~25 undefined functions elsewhere. CHANGELOG [6.6.9]
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/result.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"

# v6.0.51: Win32 has no fork/exec — the Windows process surface lives in a
# CreateProcessW-based variant. The POSIX implementations below are guarded
# out under CYRIUS_TARGET_WIN (the predefine chain in src/main.cyr makes
# exactly one of WIN/MACOS/AGNOS/LINUX active, so #ifndef WIN covers Linux,
# macOS, and agnos). See lib/process_win.cyr + issue
# 2026-06-03-windows-pe-syscall-surface-blocks-detection.md.
#ifdef CYRIUS_TARGET_WIN
include "lib/process_win.cyr"
#endif

# agnos has fork#96 but no execve or dup2, so the POSIX fork+exec model does not map: it
# spawns FROM DISK with a real argv and a clean fd table (spawn_path#43, 1.57.6), redirects the
# child's fds at spawn time (#62) and waits with WAIT_BLOCK (1.57.7) — process_agnos.cyr, since
# 6.6.8. The POSIX block below is excluded on agnos too (nested #ifndef AGNOS). (This read "no
# fork/exec/dup2 … spawns an in-memory ELF via sys_spawn" — the v6.0.56 design — until 6.6.10.
# CHANGELOG [6.6.10])
#ifdef CYRIUS_TARGET_AGNOS
include "lib/process_agnos.cyr"
#endif

#ifndef CYRIUS_TARGET_WIN
#ifndef CYRIUS_TARGET_AGNOS

# ⛔ v6.6.6 — NO CHILD THIS MODULE SPAWNS OUTLIVES ITS PARENT, AND EVERY CHILD IT WAITS
# FOR CAN BE BOUNDED.
#
# Every verb below was fork + execve + BLOCKING `sys_waitpid(pid, &st, 0)` — with, in the
# capturing ones, an equally unbounded `sys_read` loop on the child's pipe IN FRONT of the
# wait — and none of them set a death signal. So one hung child hung the caller for ever,
# and killing the caller REPARENTED that child to PID 1, where it kept burning a core.
# MEASURED in the 6.6.6 repair release against `exec_capture` on a spinning fixture: the
# parent was still blocked after 6 s, and SIGKILLing it left the child alive at PPID=1.
#
# This is the same defect `lib/regression.cyr` was fixed for in this release, and it reaches
# THIS module through the SAME runner: `programs/checks/main.cyr` includes process.cyr, and
# three of its gates shell out through here (cyrfmt once per fixture, cyrdoc over all of
# `lib/`, and a `/bin/sh -c` qemu boot). Fixing one module told us nothing about the other —
# which is why the census in `tests/gates/toolchain/check_driver_bounded.sh` now DERIVES the
# files it reads from the driver's own `include` lines instead of naming them.
#
# TWO HALVES, and they are not interchangeable:
#   * PR_SET_PDEATHSIG in the child — UNCONDITIONAL, because a SIGKILLed parent runs no
#     cleanup, ever, so nothing parent-side can reach the child. The kernel has to do it.
#   * a DEADLINE — OPT-IN, and OFF by default. This is the general-purpose process module,
#     not a test runner: `lib/sigil.cyr` drives `cryptsetup luksFormat` / `veritysetup
#     format` through `run_capture` and `cbt/deps.cyr` drives git through `exec_capture`, so
#     a default timeout would kill legitimate long work. An embedder that wants a bound asks
#     for one — `proc_set_timeout_ms(120000)` — which is what the check driver now does.
#     0 keeps the historical behaviour exactly.
# CHANGELOG [6.6.6]
var _PROC_DEADLINE_MS = 0;

# errno ETIMEDOUT. The Result-shaped verbs (`run`, `wait_pid`) report a deadline as
# `Err(PROC_ETIMEDOUT)`; the i64-shaped `exec_*` verbs report it as `-2`, matching
# lib/regression.cyr's documented timeout code. The byte-count CAPTURING verbs
# (`exec_capture`, `exec_capture_str`, `run_capture`) cannot carry a status at all: they
# return the bytes they did capture, so a crash, a refusal, a deadline kill and a clean run
# with short output all look the same from the return value.
# ⛔ "The caller checks the output" is NOT a substitute — the audit walkers did exactly that
# (they parsed the tool's summary trailer) and read a MISSING trailer as zero findings, so a
# crashed, hung, refusing or absent cyrlint scored clean. A caller that has to tell those
# apart uses `exec_capture_status`, which reports the exit code, the signal and the deadline.
# CHANGELOG [6.6.7]
var PROC_ETIMEDOUT = 110;
# errno ECHILD. `run` / `wait_pid` report `Err(PROC_ECHILD)` when waitpid never reaped the
# child (e.g. the process inherited SIGCHLD = SIG_IGN), so the exit status is UNKNOWN — not a
# decoded stack word. The i64-shaped `exec_*` verbs report the same case as -1.
# CHANGELOG [6.6.7]
var PROC_ECHILD = 10;

# ⛔ 6.6.8 — A DEADLINE KILL IS COUNTED WHERE IT HAPPENS. The byte-count capturing verbs
# (`exec_capture`, `exec_capture_str`, `run_capture`) cannot carry a status, so a child ended
# at the deadline looked exactly like one that printed less. This count lets an embedder ask
# "did a deadline fire?" around any call without changing a single return contract (sigil's
# cryptsetup and deps' git use this module). It counts every child `_proc_wait_deadline`
# ended AND every capture the idle deadline cut short. CHANGELOG [6.6.8]
var _proc_deadline_kills = 0;

# How many children this process has ended at a deadline, ever (see above).
fn proc_deadline_kills(): i64 { return _proc_deadline_kills; }

# Bound every child this module WAITS for to `ms` milliseconds; 0 = wait for ever (the
# default, and the pre-6.6.6 behaviour). Returns the previous value, so a caller can set a
# short bound around one call and put the old one back. POSIX and Windows (process_win.cyr
# has had its own since 6.6.8); process_agnos.cyr does not define it — agnos verbs have no
# deadline — so a call there fails to COMPILE rather than silently not bounding anything.
# (This said "POSIX only … process_win.cyr … do not define this" until 6.6.10.
# CHANGELOG [6.6.10])
fn proc_set_timeout_ms(ms): i64 {
    var prev = _PROC_DEADLINE_MS;
    _PROC_DEADLINE_MS = ms;
    return prev;
}

# The deadline in force, in ms. Every wait below passes this rather than reading the global,
# so a future per-call override is a parameter change and not a new code path.
fn proc_timeout_ms(): i64 {
    return _PROC_DEADLINE_MS;
}

# Called in the CHILD, between fork and execve. PR_SET_PDEATHSIG = 1, SIGKILL = 9; it
# survives execve for a non-setuid binary, so the exec'd program inherits it. Linux only —
# prctl is not a Darwin/BSD syscall and is not routed on PE. The getppid re-check closes the
# race where the parent died between the fork and the prctl: the death signal was then
# delivered to nobody and will never fire, so the child exits itself.
# When a deadline is in force the child also calls setsid(), so it leads its own process group
# and a deadline can end that GROUP: macOS (6.6.10) because it has no /proc to walk for
# descendants; Linux (6.6.11) for the one case the /proc walk cannot reach — a child that exited
# while a grandchild it started still holds the capture pipe (`_proc_end_cut_group`): by then the
# child is reaped and its orphans reparented, so they are nobody's descendants. Only with a
# deadline: a session of its own detaches the child from the terminal (no Ctrl-C, no /dev/tty),
# which an unbounded call — `git` prompting for credentials through cbt/deps.cyr — must keep.
# PR_SET_PDEATHSIG still ends a Linux child when its parent dies. CHANGELOG [6.6.10] [6.6.11]
fn _proc_child_guard(ppid_before): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    sys_prctl(1, 9, 0, 0, 0);
    if (syscall(SYS_GETPPID) != ppid_before) { sys_exit(1); }
    if (_PROC_DEADLINE_MS > 0) { sys_setsid(); }
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    if (_PROC_DEADLINE_MS > 0) { sys_setsid(); }
    #endif
    return 0;
}

# ⛔ 6.6.8 — A DEADLINE ENDS THE CHILD'S WHOLE TREE, AND ASKS FIRST. The kill below signalled
# `pid` alone, with SIGKILL: PR_SET_PDEATHSIG is cleared on fork, so a `/bin/sh -c` child's
# own children (the check driver's OVMF boot runs qemu that way) were reparented to init and
# kept running, and SIGKILL runs no cleanup, so the shell's `trap 'rm -rf …' EXIT` never
# removed its 64 MB disk image from RAM-backed /tmp. Now: snapshot the descendants (Linux:
# /proc/<pid>/task/*/children), SIGTERM the child, then ONE SIGTERM to each descendant it left
# once it has gone, all within `_PROC_GRACE_MS`, then SIGKILL what is left. Off Linux the
# child alone is signalled, still TERM first.
# The twin of lib/regression.cyr's `_regression_kill_tree`. CHANGELOG [6.6.8]
var _PROC_GRACE_MS = 5000;
var _proc_tree = 0;      # i64[4096] snapshot, then a 4 KiB dirent buffer, then 64 KiB of text
var _PROC_TREE_CAP = 4096;

#ifdef CYRIUS_TARGET_LINUX
# Append `v` (>= 0) in decimal at `p`; returns the byte after it.
fn _proc_put_dec(p, v): i64 {
    var t[24];
    var n = 0;
    if (v == 0) { store8(&t, 48); n = 1; }
    while (v > 0) { store8(&t + n, 48 + v % 10); v = v / 10; n = n + 1; }
    var i = 0;
    while (i < n) { store8(p + i, load8(&t + n - 1 - i)); i = i + 1; }
    return p + n;
}

fn _proc_put_str(p, s): i64 {
    var i = 0;
    while (load8(s + i) != 0) { store8(p + i, load8(s + i)); i = i + 1; }
    return p + i;
}

# Append the children of thread `tid` of `pid` (tid 0: of every thread) from index `n`.
fn _proc_tree_add(pid, tid, n): i64 {
    var path[80];
    var e = _proc_put_dec(_proc_put_str(&path, "/proc/"), pid);
    e = _proc_put_str(e, "/task");
    if (tid > 0) { e = _proc_put_str(_proc_put_dec(_proc_put_str(e, "/"), tid), "/children"); }
    store8(e, 0);
    var fd = sys_open(&path, 0, 0);
    if (fd < 0) { return n; }
    if (tid == 0) {
        var db = _proc_tree + _PROC_TREE_CAP * 8;
        var got = sys_getdents64(fd, db, 4096);
        while (got > 0) {
            var off = 0;
            while (off < got) {
                var nm = db + off + 19;
                var t = 0;
                var j = 0;
                while (load8(nm + j) >= 48 && load8(nm + j) <= 57) { t = t * 10 + load8(nm + j) - 48; j = j + 1; }
                if (j > 0 && load8(nm + j) == 0) { n = _proc_tree_add(pid, t, n); }
                off = off + load16(db + off + 16);
            }
            got = sys_getdents64(fd, db, 4096);
        }
        sys_close(fd);
        return n;
    }
    var cb = _proc_tree + _PROC_TREE_CAP * 8 + 4096;
    var len = sys_read(fd, cb, 65535);
    sys_close(fd);
    var i = 0;
    var v = 0 - 1;
    while (i <= len) {
        var c = 32;
        if (i < len) { c = load8(cb + i); }
        if (c >= 48 && c <= 57) { if (v < 0) { v = 0; } v = v * 10 + c - 48; }
        else {
            if (v >= 0 && n < _PROC_TREE_CAP) { store64(_proc_tree + n * 8, v); n = n + 1; }
            v = 0 - 1;
        }
        i = i + 1;
    }
    return n;
}
#endif

# Allocate the snapshot buffer once. Returns 1 when it exists, 0 when the allocation failed —
# then no tree can be snapshotted and the callers end the direct child alone (6.6.10: the
# allocation was unchecked, so an exhausted heap walked /proc into address 0). CHANGELOG [6.6.10]
fn _proc_tree_ready(): i64 {
    if (_proc_tree != 0) { return 1; }
    var tb = alloc(_PROC_TREE_CAP * 8 + 4096 + 65536);
    if (tb == 0) { return 0; }
    _proc_tree = tb;
    return 1;
}

# Snapshot every descendant of `root` into `_proc_tree`, breadth-first; returns how many
# (0 off Linux — nothing to walk).
fn _proc_tree_collect(root): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    if (_proc_tree_ready() == 0) { return 0; }
    var n = _proc_tree_add(root, 0, 0);
    var i = 0;
    while (i < n) { n = _proc_tree_add(load64(_proc_tree + i * 8), 0, n); i = i + 1; }
    return n;
    #endif
    #ifndef CYRIUS_TARGET_LINUX
    return 0;
    #endif
}

# 1 when `p` is a ZOMBIE: `kill(p, 0)` succeeds on one, so a process that honoured its
# SIGTERM but was adopted by an ANCESTOR subreaper read "alive" and the grace period was waited
# out in full. The twin of lib/regression.cyr's `_regression_proc_zombie`. Linux only.
# CHANGELOG [6.6.8]
fn _proc_zombie(p): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    var path[48];
    var e = _proc_put_str(_proc_put_dec(_proc_put_str(&path, "/proc/"), p), "/stat");
    store8(e, 0);
    var b[512];
    var fd = sys_open(&path, 0, 0);
    if (fd < 0) { return 0; }
    var n = sys_read(fd, &b, 511);
    sys_close(fd);
    var i = n - 1;
    while (i > 0 && load8(&b + i) != 41) { i = i - 1; }   # the LAST ')' ends comm
    if (i <= 0 || i + 2 >= n) { return 0; }
    var st = load8(&b + i + 2);
    if (st == 90 || st == 88) { return 1; }                # 'Z' / 'X'
    #endif
    return 0;
}

# Walk the first `n` entries of the snapshot at `snap`: reap each that is OUR zombie, blank each
# that is gone (so a later SIGKILL cannot reach a recycled pid), and with `sig` == 15 give each
# live one that has not had it yet its ONE SIGTERM (stored negated once sent); `sig` == 9 SIGKILLs
# every listed entry. Returns how many are still alive. `snap` is `_proc_tree`, or a copy a
# caller keeps for a kill that outlives the next snapshot (lib/async.cyr's kill task, 6.6.11).
fn _proc_snap_sweep(snap, n, sig): i64 {
    var st[8];
    var live = 0;
    var i = 0;
    while (i < n) {
        var e = load64(snap + i * 8);
        var p = e;
        if (p < 0) { p = 0 - p; }
        if (p > 0) {
            if (sig == 9) { sys_kill(p, 9); }
            sys_waitpid(p, &st, 1);
            if (sys_kill(p, 0) == 0 && _proc_zombie(p) == 0) {
                live = live + 1;
                if (sig == 15 && e > 0) { sys_kill(p, 15); store64(snap + i * 8, 0 - p); }
            } else {
                store64(snap + i * 8, 0);
            }
        }
        i = i + 1;
    }
    return live;
}

# `_proc_snap_sweep` over the module's own snapshot, `_proc_tree`.
fn _proc_tree_sweep(n, sig): i64 {
    var live = _proc_snap_sweep(_proc_tree, n, sig);
    return live;
}

# End child `pid` and every process descended from it, and REAP `pid` into `stbuf` (the
# wait-status buffer — at least 4 bytes; never a signal number). TERM first, a grace of
# `_PROC_GRACE_MS` (5 s) for the tree to go, then KILL whatever is left. Returns 0. The caller
# must NOT waitpid `pid` again: it has been reaped here.
#   Linux: the descendants are snapshotted from /proc/<pid>/task/*/children before the TERM;
#          `pid` gets its TERM first, and each descendant ONE TERM once `pid` has gone (a
#          second TERM kills a shell mid-EXIT-trap — see lib/regression.cyr's twin).
#   macOS: there is no /proc, so "the tree" is `pid`'s PROCESS GROUP — the whole group gets
#          one TERM, then one KILL. That covers the tree when the child called setsid() before
#          exec (this module's verbs do when a deadline is set; cbt's batch runner and
#          lib/async_macos.cyr's async_run_process always do). A child that does not lead a
#          group of its own is ended alone.
# Not defined on Windows (a process there is a HANDLE; process_win.cyr ends a tree through a
# Job object). The agnos peer defines it on kill#16's tree bit.
# 6.6.10: public. It was the private `_proc_kill_tree` (6.6.8), so every other deadline in the
# stdlib — lib/async.cyr's async_run_process, cbt's test runner — SIGKILLed the pid alone and
# left the grandchildren running. CHANGELOG [6.6.10]
fn proc_kill_tree(pid, stbuf): i64 {
    #ifdef CYRIUS_TARGET_MACOS
    var g = _proc_kill_group(pid, stbuf);
    return g;
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    var t = _proc_kill_tree(pid, stbuf);
    return t;
    #endif
}

# macOS: `proc_kill_tree` by process group. `kill(-pid, 0)` answers 0 while a group with that
# id has a live member — and POSIX does not reuse a pid while a process group of that id
# exists, so while ours lives the probe cannot reach a stranger's group. This relies on
# sys_kill passing Darwin's third `posix` argument as 0: with a stale register an all-zombie
# group answered EPERM instead of ESRCH, and the wait below ran out its whole grace
# (lib/syscalls_linux_common.cyr, CHANGELOG [6.6.10]). Compiled on Linux too: a child that
# called setsid() under a deadline leads a group there as well (`_proc_end_cut_group`).
fn _proc_kill_group(pid, stbuf): i64 {
    var g = _proc_kill_run(pid, stbuf, 1);
    return g;
}

# ── A kill in three steps (6.6.11) ──────
# `_proc_kill_begin` sends the TERM, `_proc_kill_step` is ONE non-blocking look (called every
# 10 ms until it answers 1 or `_PROC_GRACE_MS` has passed) and `_proc_kill_finish` KILLs what is
# left and reaps. `_proc_kill_run` is the blocking loop over them behind `proc_kill_tree`; the
# async reactors drive the same three from a task, so their other tasks keep running during the
# grace instead of stalling behind a 10 ms sleep loop (lib/async.cyr, lib/async_macos.cyr).
# A kill state is 40 bytes: { pid@0, tgt@8, got@16, n@24, snap@32 }.
#   tgt   what the TERM and the KILL go to: `pid`, or `-pid` when `grp` asked for its process
#         group and one exists.
#   got   0 until `pid` is reaped; 1 reaped into the caller's status buffer; 2 waitpid failed.
#   n, snap   the /proc descendant snapshot (Linux, `grp` 0): `n` entries at `snap` — which is
#         `_proc_tree`; a caller whose kill outlives the next snapshot copies it and repoints.
var _PROC_KILL_STATE = 40;

# Begin ending `pid`: with `grp` 1 target its process group when it leads one, else snapshot its
# descendants; then TERM the target. Fills the kill state `ks`. Returns 0.
fn _proc_kill_begin(ks, pid, grp): i64 {
    store64(ks, pid);
    store64(ks + 16, 0);
    store64(ks + 24, 0);
    store64(ks + 32, 0);
    var tgt = pid;
    if (grp == 1) {
        if (sys_kill(0 - pid, 0) == 0) { tgt = 0 - pid; }
    } else {
        store64(ks + 24, _proc_tree_collect(pid));
        store64(ks + 32, _proc_tree);
    }
    store64(ks + 8, tgt);
    sys_kill(tgt, 15);
    return 0;
}

# One non-blocking look at a kill in progress: reap `pid` if it has gone, and once it has, give
# each descendant it left its ONE TERM (a second TERM kills a shell mid-EXIT-trap). Returns 1 when
# nothing is left to wait for — `pid` reaped and its group, or every snapshot entry, gone — else 0.
fn _proc_kill_step(ks, stbuf): i64 {
    var pid = load64(ks);
    if (load64(ks + 16) == 0) {
        var w = sys_waitpid(pid, stbuf, 1);
        if (w == pid) { store64(ks + 16, 1); }
        if (w < 0) { store64(ks + 16, 2); }
    }
    if (load64(ks + 16) == 0) { return 0; }
    var tgt = load64(ks + 8);
    if (tgt != pid) {
        if (sys_kill(tgt, 0) != 0) { return 1; }
        return 0;
    }
    if (_proc_snap_sweep(load64(ks + 32), load64(ks + 24), 15) == 0) { return 1; }
    return 0;
}

# Finish a kill: KILL every snapshot entry and the group still listed, and if `pid` itself has not
# been reaped, KILL and reap it into `stbuf`. Returns 0. The caller must not waitpid `pid` again.
fn _proc_kill_finish(ks, stbuf): i64 {
    var pid = load64(ks);
    var tgt = load64(ks + 8);
    var snap = load64(ks + 32);
    var n = load64(ks + 24);
    _proc_snap_sweep(snap, n, 9);
    if (tgt != pid) { sys_kill(tgt, 9); }
    if (load64(ks + 16) == 0) { sys_kill(pid, 9); sys_waitpid(pid, stbuf, 0); }
    _proc_snap_sweep(snap, n, 0);
    return 0;
}

# The rest of a begun kill, blocking: look every 10 ms until nothing is left or `_PROC_GRACE_MS`
# has passed (`waited` of it already has), then finish. Returns 0.
fn _proc_kill_wait(ks, stbuf, waited): i64 {
    var go = 1;
    while (go == 1) {
        if (_proc_kill_step(ks, stbuf) == 1) { go = 0; }
        elif (waited >= _PROC_GRACE_MS) { go = 0; }
        else { syscall(7, 0, 0, 10); waited = waited + 10; }
    }
    _proc_kill_finish(ks, stbuf);
    return 0;
}

# The blocking kill: begin, then `_proc_kill_wait`. `grp` 1 ends `pid`'s process group (macOS's
# `proc_kill_tree`, and `_proc_end_cut_group`), 0 its /proc tree.
fn _proc_kill_run(pid, stbuf, grp): i64 {
    var ks[40];
    _proc_kill_begin(&ks, pid, grp);
    _proc_kill_wait(&ks, stbuf, 0);
    return 0;
}

# A capture the deadline cut short (`_proc_read_cut` == 1) whose child had ALREADY exited on its
# own: the drain was held open by something the child left running (a `cmd & echo` grandchild on
# the pipe), and the verb reports the deadline. End what is left of the child's process group —
# the child called setsid() because a deadline was set, and POSIX does not reuse a pid while a
# group of that id exists, so the probe cannot reach a stranger's group (the same shape as cbt's
# `_run_end_leftovers`). Every POSIX host: `_proc_kill_group` directly, never `proc_kill_tree`,
# whose Linux arm walks /proc from a pid that is already reaped. Returns 0.
# ⛔ 6.6.11 — this was macOS-only: Linux had no group here, so the verb returned -2 with the
# grandchild still running at PPID 1 (measured: `sleep 9 & echo hi` under a 300 ms deadline).
# CHANGELOG [6.6.10] [6.6.11]
fn _proc_end_cut_group(pid): i64 {
    var st[8];
    if (sys_kill(0 - pid, 0) == 0) { _proc_kill_group(pid, &st); }
    return 0;
}

# SIGTERM `pid`; once it has gone, ONE SIGTERM to each descendant it left (a second TERM kills
# a shell mid-EXIT-trap — see lib/regression.cyr's twin); all within `_PROC_GRACE_MS`; then
# SIGKILL the stragglers and reap `pid` into `stbuf`. The /proc walk behind `proc_kill_tree`
# (off Linux the snapshot is empty and `pid` alone is signalled).
fn _proc_kill_tree(pid, stbuf): i64 {
    var t = _proc_kill_run(pid, stbuf, 0);
    return t;
}

# TERM the first `n` snapshot entries (each once), give them `_PROC_GRACE_MS` to go, KILL
# what is left, and reap every one of them that is our child. CHANGELOG [6.6.10]
fn _proc_tree_end(n): i64 {
    var waited = 0;
    var live = _proc_tree_sweep(n, 15);
    while (live > 0 && waited < _PROC_GRACE_MS) {
        syscall(7, 0, 0, 10);
        waited = waited + 10;
        live = _proc_tree_sweep(n, 15);
    }
    _proc_tree_sweep(n, 9);
    var tries = 0;
    while (_proc_tree_sweep(n, 0) > 0 && tries < 100) { syscall(7, 0, 0, 10); tries = tries + 1; }
    return 0;
}

# ⛔ 6.6.10 — AN ADOPTION WINDOW, for a caller that must also end what its child LEFT BEHIND.
# `proc_kill_tree` reaches the tree that exists when a deadline fires. A child that EXITS on its
# own leaves its descendants to init, where nothing of ours can find them again: the
# `cyrius test` runner left a test's forked `sleep` at PPID=1 on every clean pass, and one that
# held the runner's stdout hung `cyrius test f | cat` until it exited. Linux's
# PR_SET_CHILD_SUBREAPER makes those orphans OUR children instead. Open the window just before
# the fork and close it once the child has been reaped:
#   `_proc_subreap_begin()` — become a subreaper and remember the children we ALREADY have;
#   `_proc_subreap_end()`   — end every child adopted since, and its descendants (TERM, grace,
#                             KILL, reap), then clear the subreaper bit if begin set it.
# Children that existed before the window are left alone — and they are all a subreaper can
# have adopted before it — so a daemon an earlier step started (a git credential-cache daemon
# from an implicit `cyrius deps` resolve) survives the window. Linux only: elsewhere both
# return 0 and do nothing (macOS: the child leads its own process group and `proc_kill_tree`
# ends that group after the reap). Not re-entrant. CHANGELOG [6.6.10]
var _proc_sr_pre = 0;       # i64[_PROC_TREE_CAP]: our children when the window opened
var _proc_sr_npre = 0;
var _proc_sr_set = 0;       # 1 when begin set the bit (it was clear), so end clears it again
var _proc_sr_open = 0;      # 1 between a SUCCESSFUL begin and its end — end does nothing otherwise

# Open the adoption window. Returns 0, or -1 when it could not (no memory, or prctl refused) —
# the caller then runs without one, exactly as before 6.6.10.
fn _proc_subreap_begin(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    if (_proc_tree_ready() == 0) { return 0 - 1; }
    if (_proc_sr_pre == 0) {
        var pb = alloc(_PROC_TREE_CAP * 8);
        if (pb == 0) { return 0 - 1; }
        _proc_sr_pre = pb;
    }
    var cur[8];
    store64(&cur, 0);
    sys_prctl(37, &cur, 0, 0, 0);                             # PR_GET_CHILD_SUBREAPER
    _proc_sr_set = 0;
    if (load32(&cur) == 0) {
        if (sys_prctl(36, 1, 0, 0, 0) != 0) { return 0 - 1; } # PR_SET_CHILD_SUBREAPER
        _proc_sr_set = 1;
    }
    var n = _proc_tree_add(sys_getpid(), 0, 0);
    var i = 0;
    while (i < n) { store64(_proc_sr_pre + i * 8, load64(_proc_tree + i * 8)); i = i + 1; }
    _proc_sr_npre = n;
    _proc_sr_open = 1;
    #endif
    return 0;
}

# 1 when `p` was already our child when the window opened.
fn _proc_sr_had(p): i64 {
    var i = 0;
    while (i < _proc_sr_npre) {
        if (load64(_proc_sr_pre + i * 8) == p) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Close the adoption window: end every child adopted since `_proc_subreap_begin` and all of
# their descendants. Up to four rounds, because a process ended in one round can orphan its
# own children onto us. Returns how many the first round found (0 when nothing was left).
fn _proc_subreap_end(): i64 {
    var found = 0;
    #ifdef CYRIUS_TARGET_LINUX
    if (_proc_sr_open == 0) { return 0; }         # begin failed (or never ran): nothing adopted
    _proc_sr_open = 0;
    var round = 0;
    while (round < 4) {
        var n = _proc_tree_add(sys_getpid(), 0, 0);
        var k = 0;
        var i = 0;
        while (i < n) {
            var p = load64(_proc_tree + i * 8);
            if (_proc_sr_had(p) == 0) { store64(_proc_tree + k * 8, p); k = k + 1; }
            i = i + 1;
        }
        if (k == 0) { round = 4; }
        else {
            i = 0;
            while (i < k) { k = _proc_tree_add(load64(_proc_tree + i * 8), 0, k); i = i + 1; }
            if (round == 0) { found = k; }
            _proc_tree_end(k);
            round = round + 1;
        }
    }
    if (_proc_sr_set == 1) { sys_prctl(36, 0, 0, 0, 0); _proc_sr_set = 0; }
    _proc_sr_npre = 0;
    #endif
    return found;
}

# Wait for `pid`, but not for ever. Returns 1 if the child was reaped normally (`stbuf` holds
# its status), 0 if the deadline fired (the child's whole tree was then ended by
# `proc_kill_tree`: TERM, grace, KILL — 6.6.8), and -1 if waitpid failed before either —
# then `stbuf` was NEVER WRITTEN and must not be decoded. That is not hypothetical: a caller
# that inherited SIGCHLD = SIG_IGN (it survives execve) has its children auto-reaped by the
# kernel, so waitpid blocks until they exit and then fails ECHILD; decoding the untouched
# stack word there reported a failed child as "exit 0". CHANGELOG [6.6.7]
# `timeout_ms <= 0` is the historical blocking wait (EINTR retried). A waitpid error in the
# timed loop still KILLS before returning: a bare return there is an ABANDONMENT path, the
# very thing a deadline exists to prevent — the correction cbt/build.cyr's
# `run_binary_timed` took at v6.5.51.
# `syscall(7, 0, 0, slice)` is poll(NULL, 0, ms), i.e. a portable millisecond sleep (the
# backend translates 7 to Darwin poll / aarch64 ppoll).
fn _proc_wait_deadline(pid, stbuf, timeout_ms): i64 {
    if (timeout_ms <= 0) {
        var bw = sys_waitpid(pid, stbuf, 0);
        while (bw == 0 - 4) { bw = sys_waitpid(pid, stbuf, 0); }   # EINTR
        if (bw == pid) { return 1; }
        return 0 - 1;
    }
    var waited = 0;
    var slice = 1;
    while (waited < timeout_ms) {
        var w = sys_waitpid(pid, stbuf, 1);
        if (w == pid) { return 1; }
        if (w < 0) { proc_kill_tree(pid, stbuf); return 0 - 1; }
        syscall(7, 0, 0, slice);
        waited = waited + slice;
        if (waited >= 50) { slice = 10; }
        if (waited >= 2000) { slice = 50; }
    }
    _proc_deadline_kills = _proc_deadline_kills + 1;
    # The deadline fired and WE ended it (6.6.8: its whole tree, TERM -> grace -> KILL): 0 is
    # the truth even if an auto-reap leaves nothing to collect.
    proc_kill_tree(pid, stbuf);
    return 0;
}

# poll(POLLIN) one fd. >0 readable (or hung up / errored — poll reports POLLHUP and POLLERR
# whether or not you asked for them, which is what ends the read loop when the child exits),
# 0 timed out, <0 syscall error.
fn _proc_poll_in(fd, timeout_ms): i64 {
    var pfd[8];
    store32(&pfd,     fd);
    store16(&pfd + 4, 1);   # POLLIN
    store16(&pfd + 6, 0);   # revents
    return syscall(7, &pfd, 1, timeout_ms);
}

# Drain `fd` into `buf` (at most `buflen`), never blocking longer than `timeout_ms` WITHOUT
# PROGRESS. The deadline is an IDLE one by design and the distinction is worth stating: a
# child that keeps producing output is working, and killing it at a wall-clock limit would
# break `cbt/deps.cyr`'s git and sigil's cryptsetup; a child that produces nothing and does
# not exit is the hang this exists to stop. The total is bounded regardless because the loop
# also stops at `buflen`. `timeout_ms <= 0` is the historical unbounded drain.
# Set by `_proc_read_pipe`: 1 when it stopped because the idle deadline expired, 2 when poll
# failed (6.6.8: EINTR is retried, and an error is no longer reported as the deadline), 0 when
# it reached EOF or filled the buffer. After a cut the child is abandoned
# mid-output — it is then killed at the wait deadline, or dies of SIGPIPE on its next write,
# and either way the capture is incomplete. `exec_capture_status` reports that as the
# deadline (-2), not as the SIGPIPE "crash" the reader itself caused. CHANGELOG [6.6.7]
var _proc_read_cut = 0;

fn _proc_read_pipe(fd, buf, buflen, timeout_ms): i64 {
    var total = 0;
    var rgo = 1;
    _proc_read_cut = 0;
    while (rgo == 1) {
        if (timeout_ms > 0) {
            # 0 = the idle deadline expired: a CUT (reported as the deadline). A poll ERROR is
            # not a deadline — 6.6.8: EINTR is retried (a signal handler in the embedder must
            # not read as "the tool hung"), and any other error stops the read as a failure
            # (`_proc_read_cut` = 2, reported as -1), not as a timeout it was not.
            var pr = _proc_poll_in(fd, timeout_ms);
            while (pr == 0 - 4) { pr = _proc_poll_in(fd, timeout_ms); }
            if (pr == 0) { rgo = 0; _proc_read_cut = 1; }
            if (pr < 0) { rgo = 0; _proc_read_cut = 2; }
        }
        if (rgo == 1) {
            var n = sys_read(fd, buf + total, buflen - total);
            if (n <= 0) { rgo = 0; }
            else {
                total = total + n;
                if (total >= buflen) { rgo = 0; }
            }
        }
    }
    return total;
}

# Build argv array and execve. Called in child after fork. Does not return.
# argv[40] = 5 × 8 B (cmd + up to 2 args + NUL + 1 slot headroom); envp[16] =
# 2 × 8 B (envp[0] + NUL). var buf[N] is N BYTES per CLAUDE.md buffer contract;
# the pre-v5.11.60 var argv[4] / var envp[1] reserved only 4 and 1 BYTES and
# silently corrupted the stack on every call. See CHANGELOG [5.11.60].
fn _exec3(cmd, arg1, arg2): i64 {
    var argv[40];
    store64(&argv, cmd);
    var ai = 1;
    if (arg1 != 0) { store64(&argv + ai * 8, arg1); ai = ai + 1; }
    if (arg2 != 0) { store64(&argv + ai * 8, arg2); ai = ai + 1; }
    store64(&argv + ai * 8, 0);
    var envp[16];
    store64(&envp, 0);
    sys_execve(cmd, &argv, &envp);
    sys_exit(127);
}

# Run a command and wait for it. Returns Result(exit_code).
fn run(cmd, arg1, arg2): Result {
    var _pg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { return Err(0 - pid); }
    if (pid == 0) { _proc_child_guard(_pg_ppid); _exec3(cmd, arg1, arg2); }
    var status_buf[4];
    var reaped = _proc_wait_deadline(pid, &status_buf, proc_timeout_ms());
    if (reaped == 0) { return Err(PROC_ETIMEDOUT); }
    if (reaped < 0) { return Err(PROC_ECHILD); }
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) { return Ok(WEXITSTATUS(status)); }
    if (WIFSIGNALED(status) == 1) { return Ok(128 + WTERMSIG(status)); }
    return Err(1);
}

# Run a command and capture stdout into a buffer.
# Returns Result(bytes_read).
fn run_capture(cmd, arg1, arg2, buf, buflen): Result {
    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { return Err(0 - pr); }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var _pg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd);
        sys_close(write_fd);
        return Err(0 - pid);
    }
    if (pid == 0) {
        _proc_child_guard(_pg_ppid);
        sys_close(read_fd);
        sys_dup2(write_fd, 1);
        sys_close(write_fd);
        var devnull = sys_open("/dev/null", 1, 0);   # 1 = O_WRONLY (Linux/macOS native; PE backend reroutes)
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        _exec3(cmd, arg1, arg2);
    }
    sys_close(write_fd);
    var total = _proc_read_pipe(read_fd, buf, buflen, proc_timeout_ms());
    var cut = _proc_read_cut;
    sys_close(read_fd);
    var status_buf[4];
    var reaped = _proc_wait_deadline(pid, &status_buf, proc_timeout_ms());
    if (cut == 1 && reaped == 1) { _proc_deadline_kills = _proc_deadline_kills + 1; _proc_end_cut_group(pid); }
    return Ok(total);
}

# Spawn a command in the background (don't wait).
# Returns Result(child_pid).
#
# fork-guard-exempt: THE CHILD IS MEANT TO OUTLIVE THIS CALL. This is the one verb here
# whose contract is "keep running after I return", so PR_SET_PDEATHSIG would break it — a
# consumer that launches a daemon and exits would have the daemon killed by the kernel. The
# caller owns the child's lifetime (`wait_pid`, which IS bounded when a deadline is set).
# The census in tests/gates/toolchain/check_driver_bounded.sh reads this marker, so the
# exemption is one line in one place rather than a file the census stops looking at.
# CHANGELOG [6.6.6]
fn spawn(cmd, arg1, arg2): Result {
    var pid = sys_fork();
    if (pid < 0) { return Err(0 - pid); }
    if (pid == 0) { _exec3(cmd, arg1, arg2); }
    return Ok(pid);
}

# Wait for a specific pid. Returns Result(exit_code).
fn wait_pid(pid): Result {
    var status_buf[4];
    # v6.6.6: bounded when the embedder set a deadline, an unchanged blocking wait when it
    # did not (the default). A caller that spawn()ed a long-running child and set a deadline
    # gets that child KILLED here — which is the point of asking for one.
    var reaped = _proc_wait_deadline(pid, &status_buf, proc_timeout_ms());
    if (reaped == 0) { return Err(PROC_ETIMEDOUT); }
    if (reaped < 0) { return Err(PROC_ECHILD); }
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) { return Ok(WEXITSTATUS(status)); }
    if (WIFSIGNALED(status) == 1) { return Ok(128 + WTERMSIG(status)); }
    return Err(1);
}

# Get current process ID
fn getpid(): i64 { return sys_getpid(); }

# Get parent process ID
fn getppid(): i64 { return sys_getppid(); }

# ================================================================
# Enhanced subprocess — variable args via vec, env passing
# ================================================================
#
# Two argv-shape families (v5.10.44):
#
# - `exec_vec` / `exec_capture` / `exec_env` — argv elements are
#   **cstr** (raw byte pointers; literal-friendly). `execve(2)`
#   reads each as a NUL-terminated string directly. Use this shape
#   when callers push cstr literals: `vec_push(a, "/usr/bin/ls")`.
#
# - `exec_vec_str` / `exec_capture_str` / `exec_env_str` — argv
#   elements are **Str fat-pointers** (16-byte `{data, len}` heap
#   structs). `str_data` is extracted on the way into execve's
#   argv. Use this shape when callers push runtime-built Strs:
#   `vec_push(a, str_from("/bin/" + name))`.
#
# **Do not mix shapes in one vec.** Pushing a Str into the cstr
# family (or a cstr into the Str family) is silently broken —
# `execve` reads the wrong 8 bytes as the path → typically rc=127
# (path not found). v5.10.44 added the `_str` family specifically
# to give Str-pushing consumers a working verb; pre-v5.10.44 the
# natural cyrius idiom (Str push) silently failed under exec_vec.
# Filed at `docs/development/issues/archived/2026-05-10-process-exec-str-
# cstr-ambiguity.md` (argonaut-blocking).
#
# Both shapes share the same envp shape with their family — the
# cstr family pushes cstr envp entries (KEY=VALUE strings as cstr
# literals), the _str family pushes Str envp entries. envp shape
# follows the family, not the call site.

# 6.6.10: every verb below checks its argv / envp allocations and answers -1 (nothing ran)
# when the heap is exhausted — they stored through address 0 before (the alloc census,
# tests/gates/memory/stdlib_alloc_checked_census.sh). CHANGELOG [6.6.10]

# Run command with a vec of cstr argv elements. Returns exit code
# or -1.
# Usage: var args = vec_new(); vec_push(args, "/usr/bin/ls");
#        vec_push(args, "-la"); var rc = exec_vec(args);
# v5.10.44: docstring now explicitly cstr-only; Str pushers MUST
# use `exec_vec_str` instead (silently fails otherwise — see family
# header comment above).
fn exec_vec(args): i64 {
    var argc = vec_len(args);
    if (argc < 1) { return 0 - 1; }
    var cmd = vec_get(args, 0);
    # Build argv array (argc + 1 for null terminator)
    var argv = alloc((argc + 1) * 8);
    if (argv == 0) { return 0 - 1; }
    var avi = 0;
    while (avi < argc) {
        store64(argv + avi * 8, vec_get(args, avi));
        avi = avi + 1;
    }
    store64(argv + argc * 8, 0);
    var envp = alloc(8);
    if (envp == 0) { return 0 - 1; }
    store64(envp, 0);
    var _pg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        _proc_child_guard(_pg_ppid);
        sys_execve(cmd, argv, envp);
        sys_exit(127);
    }
    var stbuf[4];
    # v6.6.6: -2 is the timeout code (module header). Without it the deadline's own SIGKILL
    # is indistinguishable from the child crashing, and "it never finished" is a very
    # different report from "it died".
    var reaped = _proc_wait_deadline(pid, &stbuf, proc_timeout_ms());
    if (reaped == 0) { return 0 - 2; }
    if (reaped < 0) { return 0 - 1; }
    var st = load32(&stbuf);
    if (WIFEXITED(st) == 1) { return WEXITSTATUS(st); }
    return 0 - 1;
}

# Decode a wait(2) status word into `status_out`'s two i64 slots (the shape
# lib/regression.cyr's `regression_exec_capture_status` uses): [0] = exit code (0..255),
# 128+sig on a signal death, -2 when `reaped` == 0 (the deadline killed it), -1 when
# `reaped` < 0 (waitpid never reaped the child, so `st` is not a status and is NOT decoded);
# [1] = 1 iff a signal killed the child (a crash — `exit(139)` and SIGSEGV both read 139 in
# slot 0).
fn _proc_store_status(status_out, reaped, st): i64 {
    var code = 0 - 1;
    var sig = 0;
    if (reaped == 1) {
        if (WIFEXITED(st) == 1) { code = WEXITSTATUS(st); }
        if (WIFSIGNALED(st) == 1) { code = 128 + WTERMSIG(st); sig = 1; }
    }
    if (reaped == 0) { code = 0 - 2; }
    store64(status_out, code);
    store64(status_out + 8, sig);
    return 0;
}

# Run command with cstr args vec, capture stdout, and REPORT HOW IT ENDED. Returns bytes
# read (-1 when nothing could be spawned). `status_out` points to TWO i64 slots:
#   [0] exit code 0..255 · 128+sig on a signal death · -2 deadline kill (proc_set_timeout_ms)
#       · -1 nothing ran (empty argv, pipe or fork failure) OR the end was never observed
#       (waitpid did not reap the child — e.g. an inherited SIGCHLD = SIG_IGN auto-reaped
#       it). A path execve cannot run is the child's own exit 127.
#   [1] 1 iff a signal killed the child, else 0.
# Use this, not `exec_capture`, whenever "the tool failed" must not read as "the tool said
# nothing" (see the ETIMEDOUT note above). Same argv shape as exec_capture (cstr).
# CHANGELOG [6.6.7]
fn exec_capture_status(args, buf, buflen, status_out): i64 {
    store64(status_out, 0 - 1);
    store64(status_out + 8, 0);
    var argc = vec_len(args);
    if (argc < 1) { return 0 - 1; }
    var cmd = vec_get(args, 0);
    var argv = alloc((argc + 1) * 8);
    if (argv == 0) { return 0 - 1; }
    var avi = 0;
    while (avi < argc) {
        store64(argv + avi * 8, vec_get(args, avi));
        avi = avi + 1;
    }
    store64(argv + argc * 8, 0);
    var envp = alloc(8);
    if (envp == 0) { return 0 - 1; }
    store64(envp, 0);
    var pipefd[16];
    if (sys_pipe(&pipefd) < 0) { return 0 - 1; }
    var rfd = load32(&pipefd);
    var wfd = load32(&pipefd + 4);
    var _pg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { sys_close(rfd); sys_close(wfd); return 0 - 1; }
    if (pid == 0) {
        _proc_child_guard(_pg_ppid);
        sys_close(rfd);
        sys_dup2(wfd, 1);
        sys_close(wfd);
        var devnull = sys_open("/dev/null", 1, 0);   # 1 = O_WRONLY (mirrors run_capture)
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        sys_execve(cmd, argv, envp);
        sys_exit(127);
    }
    sys_close(wfd);
    var total = _proc_read_pipe(rfd, buf, buflen, proc_timeout_ms());
    var cut = _proc_read_cut;
    sys_close(rfd);
    var stbuf[4];
    store32(&stbuf, 0 - 1);   # never a stale stack word, even if a path below forgets
    var reaped = _proc_wait_deadline(pid, &stbuf, proc_timeout_ms());
    # The reader gave up at the deadline: report THAT — unless waitpid never saw the child,
    # which is "unknown" (-1), never a guessed -2. A poll error (cut 2) is a failure to read
    # the child's output, reported as -1, never as the deadline. CHANGELOG [6.6.8]
    if (cut == 1) {
        if (reaped == 1) { reaped = 0; _proc_deadline_kills = _proc_deadline_kills + 1; _proc_end_cut_group(pid); }
    }
    if (cut == 2) { if (reaped == 1) { reaped = 0 - 1; } }
    _proc_store_status(status_out, reaped, load32(&stbuf));
    return total;
}

# Run command with cstr args vec and capture stdout. Returns bytes
# read. buf must be pre-allocated. The exit status is DISCARDED — use
# `exec_capture_status` when a failed run must not read as short output.
# v5.10.44: cstr-only; Str pushers use `exec_capture_str`.
fn exec_capture(args, buf, buflen): i64 {
    var _st[16];
    return exec_capture_status(args, buf, buflen, &_st);
}

# Run command with cstr args vec + cstr env vec.
# env is a vec of cstr "KEY=VALUE" pointers.
# v5.10.44: cstr-only on both args + env; Str pushers use
# `exec_env_str`.
fn exec_env(args, env): i64 {
    var argc = vec_len(args);
    if (argc < 1) { return 0 - 1; }
    var cmd = vec_get(args, 0);
    var argv = alloc((argc + 1) * 8);
    if (argv == 0) { return 0 - 1; }
    var avi = 0;
    while (avi < argc) {
        store64(argv + avi * 8, vec_get(args, avi));
        avi = avi + 1;
    }
    store64(argv + argc * 8, 0);
    var envc = vec_len(env);
    var envp = alloc((envc + 1) * 8);
    if (envp == 0) { return 0 - 1; }
    var evi = 0;
    while (evi < envc) {
        store64(envp + evi * 8, vec_get(env, evi));
        evi = evi + 1;
    }
    store64(envp + envc * 8, 0);
    var _pg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        _proc_child_guard(_pg_ppid);
        var devnull = sys_open("/dev/null", 1, 0);   # 1 = O_WRONLY (mirrors run_capture)
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        sys_execve(cmd, argv, envp);
        sys_exit(127);
    }
    var stbuf[4];
    var reaped = _proc_wait_deadline(pid, &stbuf, proc_timeout_ms());
    if (reaped == 0) { return 0 - 2; }
    if (reaped < 0) { return 0 - 1; }
    var st = load32(&stbuf);
    if (WIFEXITED(st) == 1) { return WEXITSTATUS(st); }
    return 0 - 1;
}

# ================================================================
# Str-shape variants (v5.10.44 — argonaut-blocking unblock)
# ================================================================
# `_str` siblings of exec_vec / exec_capture / exec_env. Each
# extracts `str_data` from every vec element on the way into
# execve's argv (or envp for the env variant), so callers can
# build the vec with `vec_push(a, str_from("..."))` — the natural
# cyrius idiom — and pass it directly.
#
# Implementation: copy each `load64(slot)` through `load64` again
# (= `str_data(Str_ptr)`) to land the byte payload pointer in argv.
# Caller-side memory: every Str header pushed into `args` must
# outlive the execve syscall (the byte payload is what execve
# reads; the header itself is consulted only at copy time and can
# be freed after). Standard cyrius lifetime — heap-allocated Strs
# from `str_from(...)` survive until the consumer explicitly frees
# them, so this is rarely a concern.

# Run command with a vec of Str argv elements. Returns exit code
# or -1. Same semantics as exec_vec; the only difference is the
# argv element shape (Str fat-pointer rather than cstr).
fn exec_vec_str(args): i64 {
    var argc = vec_len(args);
    if (argc < 1) { return 0 - 1; }
    var cmd = str_data(vec_get(args, 0));
    var argv = alloc((argc + 1) * 8);
    if (argv == 0) { return 0 - 1; }
    var avi = 0;
    while (avi < argc) {
        store64(argv + avi * 8, str_data(vec_get(args, avi)));
        avi = avi + 1;
    }
    store64(argv + argc * 8, 0);
    var envp = alloc(8);
    if (envp == 0) { return 0 - 1; }
    store64(envp, 0);
    var _pg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        _proc_child_guard(_pg_ppid);
        sys_execve(cmd, argv, envp);
        sys_exit(127);
    }
    var stbuf[4];
    var reaped = _proc_wait_deadline(pid, &stbuf, proc_timeout_ms());
    if (reaped == 0) { return 0 - 2; }
    if (reaped < 0) { return 0 - 1; }
    var st = load32(&stbuf);
    if (WIFEXITED(st) == 1) { return WEXITSTATUS(st); }
    return 0 - 1;
}

# Run command with Str args vec and capture stdout. Returns bytes
# read. buf must be pre-allocated.
fn exec_capture_str(args, buf, buflen): i64 {
    var argc = vec_len(args);
    if (argc < 1) { return 0 - 1; }
    var cmd = str_data(vec_get(args, 0));
    var argv = alloc((argc + 1) * 8);
    if (argv == 0) { return 0 - 1; }
    var avi = 0;
    while (avi < argc) {
        store64(argv + avi * 8, str_data(vec_get(args, avi)));
        avi = avi + 1;
    }
    store64(argv + argc * 8, 0);
    var envp = alloc(8);
    if (envp == 0) { return 0 - 1; }
    store64(envp, 0);
    var pipefd[16];
    sys_pipe(&pipefd);
    var rfd = load32(&pipefd);
    var wfd = load32(&pipefd + 4);
    var _pg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { sys_close(rfd); sys_close(wfd); return 0 - 1; }
    if (pid == 0) {
        _proc_child_guard(_pg_ppid);
        sys_close(rfd);
        sys_dup2(wfd, 1);
        sys_close(wfd);
        var devnull = sys_open("/dev/null", 1, 0);   # 1 = O_WRONLY (mirrors run_capture)
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        sys_execve(cmd, argv, envp);
        sys_exit(127);
    }
    sys_close(wfd);
    var total = _proc_read_pipe(rfd, buf, buflen, proc_timeout_ms());
    var cut = _proc_read_cut;
    sys_close(rfd);
    var stbuf[4];
    var reaped = _proc_wait_deadline(pid, &stbuf, proc_timeout_ms());
    if (cut == 1 && reaped == 1) { _proc_deadline_kills = _proc_deadline_kills + 1; _proc_end_cut_group(pid); }
    return total;
}

# Run command with Str args vec + Str env vec.
# env is a vec of "KEY=VALUE" Str pointers.
fn exec_env_str(args, env): i64 {
    var argc = vec_len(args);
    if (argc < 1) { return 0 - 1; }
    var cmd = str_data(vec_get(args, 0));
    var argv = alloc((argc + 1) * 8);
    if (argv == 0) { return 0 - 1; }
    var avi = 0;
    while (avi < argc) {
        store64(argv + avi * 8, str_data(vec_get(args, avi)));
        avi = avi + 1;
    }
    store64(argv + argc * 8, 0);
    var envc = vec_len(env);
    var envp = alloc((envc + 1) * 8);
    if (envp == 0) { return 0 - 1; }
    var evi = 0;
    while (evi < envc) {
        store64(envp + evi * 8, str_data(vec_get(env, evi)));
        evi = evi + 1;
    }
    store64(envp + envc * 8, 0);
    var _pg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        _proc_child_guard(_pg_ppid);
        var devnull = sys_open("/dev/null", 1, 0);   # 1 = O_WRONLY (mirrors run_capture)
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        sys_execve(cmd, argv, envp);
        sys_exit(127);
    }
    var stbuf[4];
    var reaped = _proc_wait_deadline(pid, &stbuf, proc_timeout_ms());
    if (reaped == 0) { return 0 - 2; }
    if (reaped < 0) { return 0 - 1; }
    var st = load32(&stbuf);
    if (WIFEXITED(st) == 1) { return WEXITSTATUS(st); }
    return 0 - 1;
}

# Helper: build args vec from command string (split by spaces)
# For simple cases like exec_cmd("/usr/bin/ls -la /tmp")
# v5.10.43: sep changed from " " (cstr — silently broken under
# the pre-v5.10.43 byte-or-pointer impl, would crash under the
# new STR-path dispatch) to 32 (byte literal for space). Hits the
# byte path of str_split's v5.10.43 runtime dispatch.
# Read /proc/self/environ and build a NULL-terminated envp array suitable
# for execve. Each entry points into a heap copy of the environ blob, so the
# array outlives this call and survives across fork into the child. Returns
# the envp array pointer, or 0 if environ can't be read (caller substitutes
# an empty env). Mirrors getenv's /proc/self/environ source (lib/io.cyr).
fn _read_environ_envp(): i64 {
    var fd = sys_open("/proc/self/environ", 0, 0);   # 0 = O_RDONLY
    if (fd < 0) { return 0; }
    var blob = alloc(65536);
    if (blob == 0) { sys_close(fd); return 0; }
    var n = sys_read(fd, blob, 65535);
    sys_close(fd);
    if (n <= 0) { return 0; }
    store8(blob + n, 0);
    # environ entries are NUL-separated; one terminator per entry.
    var count = 0;
    var i = 0;
    while (i < n) {
        if (load8(blob + i) == 0) { count = count + 1; }
        i = i + 1;
    }
    var envp = alloc((count + 1) * 8);
    if (envp == 0) { return 0; }
    var ei = 0;
    var start = 0;
    i = 0;
    while (i < n) {
        if (load8(blob + i) == 0) {
            store64(envp + ei * 8, blob + start);
            ei = ei + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    store64(envp + ei * 8, 0);
    return envp;
}

# Run a shell command line through `/bin/sh -c` so pipes, redirects, inline
# VAR=val assignments, and $PATH lookup all work — and forward the parent's
# environment (PATH/HOME/...) to the child so install.sh-style consumers see
# HOME and sh can resolve curl. Pre-v6.2.34 this space-split the cmdline and
# execve'd the bare first token directly: shell metacharacters (`|`, `$(...)`,
# `&&`, `VAR=`) became literal argv, and the bare command name was never
# $PATH-resolved → ENOENT → silent rc=127. That broke every cyriusly heavy
# verb (install/update/uninstall/setup/cmdtools): `cyriusly install <ver>`
# printed "Installing..." then did nothing. See CHANGELOG.
fn exec_cmd(cmdline): i64 {
    var argv[40];
    store64(&argv + 0, "/bin/sh");
    store64(&argv + 8, "-c");
    store64(&argv + 16, cmdline);
    store64(&argv + 24, 0);
    var envp = _read_environ_envp();
    if (envp == 0) {
        envp = alloc(8);
        if (envp == 0) { return 0 - 1; }
        store64(envp, 0);
    }
    var _pg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        _proc_child_guard(_pg_ppid);
        sys_execve("/bin/sh", &argv, envp);
        sys_exit(127);
    }
    var stbuf[4];
    var reaped = _proc_wait_deadline(pid, &stbuf, proc_timeout_ms());
    if (reaped == 0) { return 0 - 2; }
    if (reaped < 0) { return 0 - 1; }
    var st = load32(&stbuf);
    if (WIFEXITED(st) == 1) { return WEXITSTATUS(st); }
    return 0 - 1;
}

#endif
#endif
