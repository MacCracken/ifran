# log.cyr — structured logging wrapper over sakshi
# Usage: include "lib/log.cyr"
# Self-sufficient: includes string.cyr (strlen) and the sakshi fold (sakshi_*), whose bundle
# carries its own requires block since 6.6.19 R1. CHANGELOG [6.6.19]
#
# Provides simple log_debug/info/warn/error/fatal API with
# level filtering. Delegates to sakshi for output routing
# (stderr, file, ring buffer, UDP).
#
#   log_init(LOG_INFO);
#   log_info("server started");
#   log_warn("connection timeout");
#   log_error("disk full");

include "lib/string.cyr"
include "lib/sakshi.cyr"

# Log levels — severity-ascending (TRACE=0 .. FATAL=5)
enum LogLevel {
    LOG_TRACE = 0;
    LOG_DEBUG = 1;
    LOG_INFO  = 2;
    LOG_WARN  = 3;
    LOG_ERROR = 4;
    LOG_FATAL = 5;
}

var _log_level = 2;

# Map log.cyr levels (ascending) to sakshi's threshold (descending), BY NAME. LOG_FATAL maps
# to SK_ERROR, not SK_FATAL: _log_emit sends fatal through sakshi_error, which SK_FATAL drops.
# ⛔ These were literals 4..0 from a sakshi scheme with no FATAL level (ERROR = 0); sakshi
# renumbered (FATAL 0 .. TRACE 5) and the literals did not follow, so log_init(LOG_INFO)
# set sakshi to WARN and every log_info was dropped. Invisible while this file left sakshi
# to its caller and its one test stubbed sakshi_* out. CHANGELOG [6.6.19]
fn _log_to_sk(level): i64 {
    if (level == LOG_TRACE) { return SK_TRACE; }
    if (level == LOG_DEBUG) { return SK_DEBUG; }
    if (level == LOG_INFO) { return SK_INFO; }
    if (level == LOG_WARN) { return SK_WARN; }
    return SK_ERROR;
}

# Initialize logging with minimum level. Opt-in entry for the
# structured-log subsystem; pre-init reads default to stderr at
# all levels (free, no setup needed). No current downstream
# caller (audited v5.11.21); revisit at v6.0.0 dead-code sweep
# if structured-log surface stays unclaimed. See
# docs/audit/2026-05-11-zero-call-stdlib.md.
fn log_init(level): i64 {
    _log_level = level;
    sakshi_set_level(_log_to_sk(level));
    return 0;
}

# Get current log level
fn log_level(): i64 { return _log_level; }

# Set log level at runtime
fn log_set_level(level): i64 {
    _log_level = level;
    sakshi_set_level(_log_to_sk(level));
    return 0;
}

# Check if a level would be logged
fn log_enabled(level): i64 {
    if (level >= _log_level) { return 1; }
    return 0;
}

# Core log function — delegates to sakshi for output routing
fn _log_emit(level, msg): i64 {
    if (level < _log_level) { return 0; }
    var len = strlen(msg);
    if (level >= LOG_ERROR) { sakshi_error(msg, len); }
    elif (level == LOG_WARN) { sakshi_warn(msg, len); }
    elif (level == LOG_INFO) { sakshi_info(msg, len); }
    elif (level == LOG_DEBUG) { sakshi_debug(msg, len); }
    else { sakshi_trace(msg, len); }
    return 0;
}

# Log at TRACE level
fn log_trace(msg): i64 { return _log_emit(LOG_TRACE, msg); }

# Log at DEBUG level
fn log_debug(msg): i64 { return _log_emit(LOG_DEBUG, msg); }

# Log at INFO level
fn log_info(msg): i64 { return _log_emit(LOG_INFO, msg); }

# Log at WARN level
fn log_warn(msg): i64 { return _log_emit(LOG_WARN, msg); }

# Log at ERROR level
fn log_error(msg): i64 { return _log_emit(LOG_ERROR, msg); }

# Log at FATAL level (does NOT exit — caller decides)
fn log_fatal(msg): i64 { return _log_emit(LOG_FATAL, msg); }

# Append NUL-terminated `s` at buf + off, never writing at or past `lim`. Returns the new
# offset. The one copy both structured loggers below go through: `lim` is what keeps a
# caller-controlled string inside their 512-byte stack scratch. CHANGELOG [6.6.12]
fn _log_cat(buf, off, s, lim): i64 {
    var i = 0;
    while (off < lim) {
        var c = load8(s + i);
        if (c == 0) { return off; }
        store8(buf + off, c);
        off = off + 1;
        i = i + 1;
    }
    return off;
}

# Mark a truncated line: overwrite the last three bytes before `off` with "...".
fn _log_mark_trunc(buf, off): i64 {
    if (off < 3) { return 0; }
    store8(buf + off - 3, 46);
    store8(buf + off - 2, 46);
    store8(buf + off - 1, 46);
    return 0;
}

# The line limit: a 512-byte scratch holds at most 511 bytes plus the NUL.
var _LOG_LINE_MAX = 511;

# Log with key=value context: "msg key=val". A line longer than 511 bytes is cut at 511
# and ends "..." — the sink never sees more than 511 bytes.
#
# ⛔ CVE-56 (6.6.12): the three copies had no bound, so a logged caller-controlled value
# (a request header, a path) longer than the 512-byte stack scratch overwrote this fn's
# own locals and its return address — a 4 KB value killed the process with SIGSEGV
# before the sink was reached. Same class as CVE-50. CHANGELOG [6.6.12]
fn log_info_kv(msg, key, val): i64 {
    if (LOG_INFO < _log_level) { return 0; }
    var buf[512];
    var lim = _LOG_LINE_MAX;
    var off = _log_cat(&buf, 0, msg, lim);
    off = _log_cat(&buf, off, " ", lim);
    off = _log_cat(&buf, off, key, lim);
    off = _log_cat(&buf, off, "=", lim);
    off = _log_cat(&buf, off, val, lim);
    if (strlen(msg) + strlen(key) + strlen(val) + 2 > lim) { _log_mark_trunc(&buf, off); }
    store8(&buf + off, 0);
    sakshi_info(&buf, off);
    return 0;
}

# Log with integer value: "msg key=<decimal>". The value is never truncated: msg and key
# share 511 - 22 bytes (22 = '=' + '-' + 19 digits, with one to spare) and end "..." when
# they do not fit. CVE-56, CHANGELOG [6.6.12]
fn log_info_int(msg, key, val): i64 {
    if (LOG_INFO < _log_level) { return 0; }
    var buf[512];
    var lim = _LOG_LINE_MAX - 22;
    var off = _log_cat(&buf, 0, msg, lim);
    off = _log_cat(&buf, off, " ", lim);
    off = _log_cat(&buf, off, key, lim);
    if (strlen(msg) + strlen(key) + 1 > lim) { _log_mark_trunc(&buf, off); }
    store8(&buf + off, 61); off = off + 1;
    # Format integer into buffer
    if (val == 0) { store8(&buf + off, 48); off = off + 1; }
    else {
        var tmp[20];
        var ti = 19;
        var v = val;
        # i64::MIN — see lib/fmt.cyr:fmt_int. This site emits the sign EAGERLY (no `neg`
        # flag), so only the negation and the loop condition change; `tmp[20]` still
        # holds all 19 digits with ti starting at 19. CHANGELOG [6.5.8]
        if (v < 0) { store8(&buf + off, 45); off = off + 1; }
        while (v != 0) {
            var d = v % 10;
            if (d < 0) { d = 0 - d; }
            store8(&tmp + ti, 48 + d); v = v / 10; ti = ti - 1;
        }
        ti = ti + 1;
        while (ti < 20) { store8(&buf + off, load8(&tmp + ti)); off = off + 1; ti = ti + 1; }
    }
    store8(&buf + off, 0);
    sakshi_info(&buf, off);
    return 0;
}
