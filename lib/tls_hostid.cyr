# tls_hostid.cyr — classify a TLS client's `host` as a reference identity (RFC 9525 §6.3).
# Internal to the TLS stack: included by lib/tls.cyr and lib/tls_native.cyr, so BOTH
# backends classify a host with the same code — the native SAN walk
# (`_tn_cert_san_match`, tls_native_conn.cyr) and the libssl binder
# (`_tls_libssl_bind_host`, tls.cyr), which is compiled in a `-D CYRIUS_TLS_LIBSSL`
# build that carries no native stack. `_tn_parse_ip_literal` is the one entry point:
# 4 / 16 an IPv4 / IPv6 literal (compared with iPAddress SANs only), 0 a DNS name
# (dNSName SANs only), -1 a ':'-bearing host that is no literal, or one starting with '.'
# (no identity at all). `_tn_sni_len` asks it whether the host goes out as SNI (a DNS name only; 6.6.14).
# Builtins only (load8 / store8), no includes. The `_tn_` names are the native stack's,
# kept so its callers and tests did not move. CHANGELOG [6.6.13] (CYRIUS-2026-0018, CYRIUS-2026-0015).

# Hex digit value (0-15) or -1. CYRIUS-2026-0003: used by the IPv6 literal parser.
fn _tn_hexval(c): i64 {
    if (c >= 0x30) { if (c <= 0x39) { return c - 0x30; } }       # 0-9
    if (c >= 0x61) { if (c <= 0x66) { return c - 0x61 + 10; } }  # a-f
    if (c >= 0x41) { if (c <= 0x46) { return c - 0x41 + 10; } }  # A-F
    return 0 - 1;
}

# CYRIUS-2026-0003 (v6.1.36): parse an IPv4 dotted-decimal literal (`host`/`host_len`)
# into 4 network-order bytes at `out`. Returns 4 on success, 0 if not a
# well-formed IPv4 literal. Used for iPAddress-SAN matching of IP connects.
# The rule is net_parse_ipv4's (lib/net.cyr), leading zeros refused: a host the
# resolver sends to DNS as a name must not verify as an address.
# CHANGELOG [6.6.13] (CYRIUS-2026-0018).
fn _tn_parse_ipv4(host, host_len, out): i64 {
    var octet = 0;
    var digits = 0;
    var count = 0;
    var i = 0;
    while (i < host_len) {
        var c = load8(host + i) & 0xFF;
        if (c == 0x2E) {                        # '.'
            if (digits == 0) { return 0; }
            if (count >= 3) { return 0; }
            store8(out + count, octet & 0xFF);
            count = count + 1;
            octet = 0;
            digits = 0;
        } else {
            if (c < 0x30) { return 0; }
            if (c > 0x39) { return 0; }
            if (digits == 1) { if (octet == 0) { return 0; } }   # "00", "010": leading zero
            octet = octet * 10 + (c - 0x30);
            if (octet > 255) { return 0; }
            digits = digits + 1;
            if (digits > 3) { return 0; }
        }
        i = i + 1;
    }
    if (digits == 0) { return 0; }
    if (count != 3) { return 0; }
    store8(out + 3, octet & 0xFF);
    return 4;
}

# Parse one colon-separated run of an IPv6 literal (`s`/`slen`: the whole
# address, or one side of its "::") into `out`, network order, at most
# `max_bytes`. RFC 4291 §2.2: every group is 1-4 hex digits, so an empty
# group, a trailing ':' and a 5-digit "00001" are refused. With `allow_v4`
# the run may END in a dotted quad (form 3, "::ffff:1.2.3.4"), parsed by the
# strict _tn_parse_ipv4 into the next 4 bytes. Returns the bytes written, or
# -1. CHANGELOG [6.6.13] (CYRIUS-2026-0018).
fn _tn_ipv6_groups(s, slen, out, max_bytes, allow_v4): i64 {
    # A '.' after the last ':' marks a dotted-quad tail; the hex groups end there.
    var last_colon = 0 - 1;
    var dotted = 0;
    var j = 0;
    while (j < slen) {
        var cj = load8(s + j) & 0xFF;
        if (cj == 0x3A) { last_colon = j; dotted = 0; }
        if (cj == 0x2E) { dotted = 1; }
        j = j + 1;
    }
    var hex_end = slen;
    if (dotted == 1) {
        if (allow_v4 == 0) { return 0 - 1; }
        hex_end = last_colon + 1;               # through the ':' that closes the last group
    }
    var written = 0;
    var group = 0;
    var nd = 0;                                 # hex digits in the open group
    var i = 0;
    while (i < hex_end) {
        var c = load8(s + i) & 0xFF;
        if (c == 0x3A) {                        # ':' closes a group
            if (nd == 0) { return 0 - 1; }      # empty group
            if (written + 2 > max_bytes) { return 0 - 1; }
            store8(out + written, (group >> 8) & 0xFF);
            store8(out + written + 1, group & 0xFF);
            written = written + 2;
            group = 0;
            nd = 0;
        } else {
            var hv = _tn_hexval(c);
            if (hv < 0) { return 0 - 1; }
            nd = nd + 1;
            if (nd > 4) { return 0 - 1; }
            group = (group << 4) | hv;
        }
        i = i + 1;
    }
    if (dotted == 1) {
        if (written + 4 > max_bytes) { return 0 - 1; }
        if (_tn_parse_ipv4(s + hex_end, slen - hex_end, out + written) != 4) { return 0 - 1; }
        return written + 4;
    }
    if (nd == 0) { return 0 - 1; }              # empty run, or a trailing ':'
    if (written + 2 > max_bytes) { return 0 - 1; }
    store8(out + written, (group >> 8) & 0xFF);
    store8(out + written + 1, group & 0xFF);
    return written + 2;
}

# CYRIUS-2026-0003: parse an IPv6 literal into 16 bytes at `out`, per RFC 4291 §2.2:
# eight groups, or fewer around ONE "::" that stands for at least one zero
# group, the last 32 bits optionally a dotted quad ("::ffff:1.2.3.4").
# Returns 16 on success, 0 otherwise. Brackets and zone ids ("[::1]",
# "fe80::1%eth0") are not literals here. CHANGELOG [6.6.13] (CYRIUS-2026-0018).
fn _tn_parse_ipv6(host, host_len, out): i64 {
    var z = 0;
    while (z < 16) { store8(out + z, 0); z = z + 1; }
    var dpos = 0 - 1;                            # index of "::" or -1
    var i = 0;
    while (i + 1 < host_len) {
        if ((load8(host + i) & 0xFF) == 0x3A) {
            if ((load8(host + i + 1) & 0xFF) == 0x3A) {
                if (dpos >= 0) { return 0; }      # only one "::" allowed
                dpos = i;
            }
        }
        i = i + 1;
    }
    if (dpos < 0) {
        if (_tn_ipv6_groups(host, host_len, out, 16, 1) != 16) { return 0; }
        return 16;
    }
    # "::" covers at least one group, so the two sides hold at most 14 bytes;
    # a dotted quad may only end the address, i.e. sit on the tail side.
    var head_len = dpos;
    var tail_start = dpos + 2;
    var tail_len = host_len - tail_start;
    var hb = 0;
    if (head_len > 0) {
        hb = _tn_ipv6_groups(host, head_len, out, 14, 0);
        if (hb < 0) { return 0; }
    }
    var tailbuf[16];
    var tb = 0;
    if (tail_len > 0) {
        tb = _tn_ipv6_groups(host + tail_start, tail_len, &tailbuf, 14 - hb, 1);
        if (tb < 0) { return 0; }
    }
    if (hb + tb > 14) { return 0; }
    var k = 0;
    while (k < tb) {
        store8(out + (16 - tb) + k, load8(&tailbuf + k) & 0xFF);
        k = k + 1;
    }
    return 16;
}

# CYRIUS-2026-0003: classify `host`, parsing an IP literal into `out` (16 bytes).
# Returns 4 / 16 for an IPv4 / IPv6 literal, 0 for a DNS name, and -1 for a
# host that holds a ':' but is no well-formed IPv6 literal ("[::1]",
# "fe80::1%eth0", "1:2:3:4:5:6:7:8:"). No DNS name holds a ':', so a -1 host
# has no reference identity and matches nothing. CHANGELOG [6.6.13]
# (CYRIUS-2026-0018).
# 6.6.14 (CYRIUS-2026-0022): a host that starts with '.' is -1 too. No DNS name does, and
# OpenSSL's X509_check_host reads one as a SUBDOMAIN pattern (".example.com"
# matched a certificate for any name under example.com) — so the libssl binder
# would have bound it to every subdomain while native bound it to nothing.
fn _tn_parse_ip_literal(host, host_len, out): i64 {
    if (host_len > 0) {
        if ((load8(host) & 0xFF) == 0x2E) { return 0 - 1; }
    }
    var has_colon = 0;
    var i = 0;
    while (i < host_len) {
        if ((load8(host + i) & 0xFF) == 0x3A) { has_colon = 1; i = host_len; }
        else { i = i + 1; }
    }
    if (has_colon == 1) {
        if (_tn_parse_ipv6(host, host_len, out) != 16) { return 0 - 1; }
        return 16;
    }
    return _tn_parse_ipv4(host, host_len, out);
}

# How many bytes of `host` go out as the ClientHello's server_name (SNI): host_len when the
# classifier calls it a DNS name, 0 otherwise. RFC 6066 §3: "Literal IPv4 and IPv6 addresses
# are not permitted in HostName" — and a host with no reference identity (-1) is no HostName
# either. The libssl binder (lib/tls.cyr _tls_libssl_bind_host) sets SNI under the same rule,
# so the two backends send the same ClientHello name. The host still binds the certificate
# (an IP literal against iPAddress SANs). CHANGELOG [6.6.14]
fn _tn_sni_len(host, host_len): i64 {
    if (host == 0) { return 0; }
    if (host_len <= 0) { return 0; }
    var ipb[16];                                 # 16 BYTES (local-array rule)
    if (_tn_parse_ip_literal(host, host_len, &ipb) != 0) { return 0; }
    return host_len;
}
