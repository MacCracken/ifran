# thread_win.cyr — Windows (PE) threading: REAL preemptive threads (v6.0.61).
# Usage: included by lib/thread.cyr under #ifdef CYRIUS_TARGET_WIN.
# Requires: alloc.cyr, fnptr.cyr.
#
# Win32 has no clone/futex; this maps the cyrius thread surface onto kernel32
# (the PE-internal 0xF00N reroutes — see backend/pe/emit.cyr + backend/x86/emit.cyr):
#   thread_create → CreateThread (0xF007). The cyrius thread-body fn is a valid
#     MS-x64 ThreadProc directly — PE arg0 == RCX == lpParameter — so NO trampoline.
#   thread_join   → WaitForSingleObject(INFINITE) (0xF001) + CloseHandle (syscall 3).
#   mutex_*       → SRWLOCK: InitializeSRWLock (0xF008) / AcquireSRWLockExclusive
#     (0xF009) / ReleaseSRWLockExclusive (0xF00A) — an 8-byte in-place lock cell.
#   chan_*        → a mutex-protected FIFO ring (thread-safe send/recv). recv is
#     NON-BLOCKING (returns 0 on empty) — a blocking recv needs a condition
#     variable (SleepConditionVariableSRW), a future upgrade when a consumer
#     forces it.
# Supersedes the v6.0.53 serial fallback. See
# 2026-06-03-windows-threading-stdlib-gap.md + the Windows nuances issue.
# NOTE: the bump allocator (alloc.cyr) is not itself thread-safe, so thread
# bodies should avoid concurrent alloc() (same as the Linux thread.cyr model);
# pass pre-allocated buffers via the arg pointer.
#
# The public surface MUST match lib/thread.cyr's so consumers stay
# target-agnostic: thread_create / thread_join / gettid / mutex_new /
# mutex_lock / mutex_unlock / chan_new / chan_send / chan_recv /
# chan_close / chan_try_recv.
#
# >>> include "lib/fnptr.cyr"
include "lib/fnptr.cyr"

# v6.5.44 — THREADS_CONCURRENT: does thread_create actually produce a SECOND thread?
# 1 = the body runs concurrently with the caller; 0 = it runs INLINE at create (serial peer).
# ⛔ This exists because the concurrency corpus could not tell the two apart. Every test in it
# passed on macOS while bodies ran inline — a serial backend satisfies "the worker ran", "join
# returned 0" and "the count is exact". A test that DISCRIMINATES must be guarded by capability
# (never by target name, never by errno — the v6.5.36 lesson), and this is that capability.
var THREADS_CONCURRENT = 0;   # serial fallback (bodies run inline)

# Create a real OS thread: CreateThread(NULL, 0, fp, arg, 0, NULL). fp is the
# cyrius thread-body fn pointer (&body) — a single-i64-param fn returning i64,
# which compiled for PE is already a valid MS-x64 ThreadProc (lpParameter arrives
# in RCX = the cyrius arg0 register). Returns the OS thread HANDLE (0 on failure),
# matching thread.cyr's "pointer or 0" contract. The 6 CreateThread params are
# packed into a struct + passed by address (the 0xF007 reroute reads them).
fn thread_create(fp, arg): i64 {
    alloc_init();
    _threads_active = 1;   # v6.3.17 PF-02: arm the shared-heap lock before CreateThread
    var a = alloc(48);
    store64(a,      0);    # lpThreadAttributes = NULL
    store64(a + 8,  0);    # dwStackSize = 0 (default)
    store64(a + 16, fp);   # lpStartAddress = the cyrius body
    store64(a + 24, arg);  # lpParameter
    store64(a + 32, 0);    # dwCreationFlags = 0 (run immediately)
    store64(a + 40, 0);    # lpThreadId = NULL
    return syscall(61447, a);   # CreateThread → HANDLE in rax
}

# Join: WaitForSingleObject(handle, INFINITE) then CloseHandle. Mirrors
# thread.cyr's returns (-1 on a null handle, 0 on success). INFINITE = 0xFFFFFFFF.
fn thread_join(t): i64 {
    if (t == 0) { return 0 - 1; }
    syscall(61441, t, 4294967295);   # WaitForSingleObject(t, INFINITE)
    syscall(3, t);                    # CloseHandle(t)
    return 0;
}

# v6.5.8: detached spawn. Windows needs no unmap trampoline — the OS owns the thread
# stack and reclaims it at thread exit — so detaching is just dropping our reference:
# CreateThread then CloseHandle immediately. The thread keeps running; only the HANDLE
# is released, which is what would otherwise leak (a never-closed HANDLE is a kernel
# object leak, the PE-side analogue of thread.cyr's stranded 2 MiB mapping).
# Returns 1 on success, 0 on failure — boolean, matching thread.cyr, because there is
# deliberately nothing left to join.
fn thread_create_detached(fp, arg): i64 {
    var h = thread_create(fp, arg);
    if (h == 0) { return 0; }
    syscall(3, h);          # CloseHandle — the thread runs on
    return 1;
}

# v6.5.8: non-blocking completion test. WaitForSingleObject with a 0 timeout returns
# WAIT_OBJECT_0 (0) if signalled, WAIT_TIMEOUT (0x102 = 258) if still running.
# ⛔ VALID ONLY BEFORE `thread_join`. Join CONSUMES the handle — on Windows it
# CloseHandle()s it, so a post-join query inspects a closed handle and reports "not
# done" (caught on real cass hardware, by a test that asserted the wrong contract).
# The intended use is the reaper shape: poll while running, then join once this
# returns 1. After joining, the thread is done by definition and there is nothing
# left to ask.
fn thread_is_done(t): i64 {
    if (t == 0) { return 0 - 1; }
    if (syscall(61441, t, 0) == 0) { return 1; }
    return 0;
}

# Current thread id — the real Win32 GetCurrentThreadId (0xF00B reroute).
fn gettid(): i64 { return syscall(61451); }

# Mutex (MUTEX_SIZE + mutex_new/lock/unlock) now comes from lib/sync.cyr →
# lib/sync_windows.cyr, which is this same in-place SRWLOCK cell (InitializeSRWLock
# 0xF008 / AcquireSRWLockExclusive 0xF009 / ReleaseSRWLockExclusive 0xF00A). Moved
# to the single owner in v6.3.44 (issue 2026-07-03-duplicate-mutex-fns-thread-vs-
# sync-stdlib); thread.cyr includes sync.cyr at its top before routing here. The
# channel below uses mutex_* unchanged.

# Channel — a thread-safe FIFO ring over the same 56-byte layout as thread.cyr
# ({buf@0, cap@8, head@16, tail@24, count@32, mutex@40 (inline SRWLOCK), closed@48}).
# send/recv are SRWLOCK-protected; recv is NON-BLOCKING (0 when empty — a blocking
# recv needs a condvar, future).
fn chan_new(cap): i64 {
    alloc_init();
    var ch = alloc(56);
    var buf = alloc(cap * 8);
    store64(ch, buf);          # buf
    store64(ch + 8, cap);      # cap
    store64(ch + 16, 0);       # head
    store64(ch + 24, 0);       # tail
    store64(ch + 32, 0);       # count
    store64(ch + 40, 0);       # mutex (inline SRWLOCK)
    syscall(61448, ch + 40);   # InitializeSRWLock(&mutex)
    store64(ch + 48, 0);       # closed
    return ch;
}
# Enqueue val (FIFO ring). Returns 0, or -1 if the channel is full.
fn chan_send(ch, val): i64 {
    syscall(61449, ch + 40);   # AcquireSRWLockExclusive
    var cap = load64(ch + 8);
    var count = load64(ch + 32);
    if (count >= cap) { syscall(61450, ch + 40); return 0 - 1; }
    var buf = load64(ch);
    var tail = load64(ch + 24);
    store64(buf + tail * 8, val);
    store64(ch + 24, (tail + 1) % cap);
    store64(ch + 32, count + 1);
    syscall(61450, ch + 40);   # ReleaseSRWLockExclusive
    return 0;
}
# Non-blocking send (v6.4.84). Contract is IDENTICAL on all three backends:
#    0 → enqueued · -1 → closed · -2 → full
#
# ⚠ NOT an alias for this backend's `chan_send`, even though that one already never
# blocks. Two reasons, both contract bugs if ignored:
#   1. `chan_send` above returns **-1 when FULL**, while the portable contract says -1
#      means CLOSED. Aliasing would make a consumer unable to tell "stop producing"
#      from "drop this one" — which is the entire reason `chan_try_send` exists.
#   2. `chan_send` here never inspects `closed` (+48) at all, so a send on a closed
#      channel silently succeeds. This fn checks it, so the closed signal is real.
# The Linux/macOS `chan_send` does check closed and blocks on full, so only THIS fn is
# consistent across backends. See lib/thread.cyr's `chan_try_send` for the rationale.
fn chan_try_send(ch, val): i64 {
    syscall(61449, ch + 40);   # AcquireSRWLockExclusive
    if (load64(ch + 48) != 0) { syscall(61450, ch + 40); return 0 - 1; }
    var cap = load64(ch + 8);
    var count = load64(ch + 32);
    if (count >= cap) { syscall(61450, ch + 40); return 0 - 2; }
    var buf = load64(ch);
    var tail = load64(ch + 24);
    store64(buf + tail * 8, val);
    store64(ch + 24, (tail + 1) % cap);
    store64(ch + 32, count + 1);
    syscall(61450, ch + 40);   # ReleaseSRWLockExclusive
    return 0;
}
# Dequeue the oldest value (FIFO), or 0 if empty (never blocks).
fn chan_try_recv(ch): i64 {
    syscall(61449, ch + 40);
    var count = load64(ch + 32);
    if (count == 0) { syscall(61450, ch + 40); return 0; }
    var buf = load64(ch);
    var cap = load64(ch + 8);
    var head = load64(ch + 16);
    var val = load64(buf + head * 8);
    store64(ch + 16, (head + 1) % cap);
    store64(ch + 32, count - 1);
    syscall(61450, ch + 40);
    return val;
}
# recv is non-blocking here (no condvar yet); identical to try_recv.
fn chan_recv(ch): i64 {
    return chan_try_recv(ch);
}
# Mark the channel closed.
fn chan_close(ch): i64 {
    syscall(61449, ch + 40);
    store64(ch + 48, 1);
    syscall(61450, ch + 40);
    return 0;
}
