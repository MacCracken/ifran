# ================================================================
# TLS 1.2 record-layer protection (Mini-arc D, .72)
# ================================================================
# TLS 1.2 AEAD records differ from 1.3 in three ways (RFC 5246
# §6.2.3.3, RFC 5288 for AES-GCM, RFC 7905 for ChaCha20-Poly1305):
#   1. No TLSInnerPlaintext — the real content type rides the OUTER
#      record header; there is no inner-type byte and no padding.
#   2. AAD is the classic 13 bytes: seq_num(8) ‖ type(1) ‖ version(2)
#      ‖ length(2), where length is the PLAINTEXT length.
#   3. AES-GCM carries an 8-byte explicit nonce on the wire (we use the
#      sequence number, RFC 5288 §3); the 12-byte GCM nonce is
#      salt(4, from the key block) ‖ explicit(8). ChaCha20-Poly1305
#      (RFC 7905) instead reuses the 1.3-style implicit nonce
#      (iv XOR seq) with NO explicit field.
# Legacy CBC suites are intentionally NOT implemented (modern-peer set
# only). See CHANGELOG [6.0.72].

# 1 if `cipher` is an AES-GCM suite (explicit nonce on the wire under
# TLS 1.2), 0 for ChaCha20-Poly1305 (implicit nonce) — RFC 5288 vs 7905.
fn _tn_cipher_is_gcm(cipher): i64 {
    if (cipher == TLS_AES_128_GCM_SHA256) { return 1; }
    if (cipher == TLS_AES_256_GCM_SHA384) { return 1; }
    return 0;
}

# Build the 12-byte TLS-1.2 AES-GCM nonce: salt(4) ‖ explicit(8)
# (RFC 5288 §3). `salt4` is the 4-byte implicit IV from the key block;
# `explicit8` is the 8-byte explicit nonce (the value sent on the wire).
fn tls_native_aead_nonce_12_gcm(salt4, explicit8, nonce_out12): i64 {
    memcpy(nonce_out12, salt4, 4);
    memcpy(nonce_out12 + 4, explicit8, 8);
    return TLS_OK;
}

# Build the 13-byte TLS-1.2 AEAD additional-data:
#   seq_num(8) ‖ type(1) ‖ version(2) ‖ length(2)
# `length` is the plaintext length (RFC 5246 §6.2.3.3). `seq8` is the
# 8-byte BE sequence buffer; copied verbatim.
fn tls_native_record_aad_12(seq8, ct, version, length, aad_out13): i64 {
    memcpy(aad_out13, seq8, 8);
    store8(aad_out13 + 8, ct & 0xFF);
    _tn_be16_w(aad_out13 + 9, version);
    _tn_be16_w(aad_out13 + 11, length);
    return 13;
}

# Seal `plain` (real content type `ct`) into a TLS 1.2 AEAD record at
# `out`. `iv` is the GCM 4-byte salt or the ChaCha 12-byte IV per the
# cipher. Increments `seq8`. Returns the total record length, or a
# negative TLS_ERR_*. A negative `plain_len` is TLS_ERR_INVALID_PARAM before anything is
# written — ChaCha20 with -16 returned a 5-byte "record" and moved `seq8` (CHANGELOG [6.7.6],
# as tls_native_record_seal does).
fn tls_native_record_seal_12(cipher, key, iv, seq8, ct, plain, plain_len, out, out_max): i64 {
    var tag_len = tls_native_cipher_tag_len(cipher);
    if (tag_len < 0) { return TLS_ERR_CIPHER_NOT_SUPPORTED; }
    if (plain_len < 0) { return TLS_ERR_INVALID_PARAM; }
    var is_gcm = _tn_cipher_is_gcm(cipher);
    var explicit_len = 0;
    if (is_gcm != 0) { explicit_len = 8; }
    # RFC 5246 §6.2.1: TLSPlaintext.fragment is capped at 2^14 (16384)
    # independent of AEAD expansion. Defend the cap at the record layer —
    # the ciphertext-total cap below would otherwise let a ChaCha fragment
    # (explicit_len 0) reach 16624 before tripping, emitting an over-length
    # record a strict peer rejects with record_overflow. See CHANGELOG [6.0.72].
    if (plain_len > _TLS_RECORD_MAX_PLAINTEXT) { return TLS_ERR_RECORD_OVERFLOW; }
    var rec_len = explicit_len + plain_len + tag_len;
    if (rec_len > TLS_RECORD_MAX_CIPHERTEXT) { return TLS_ERR_RECORD_OVERFLOW; }
    var total = TLS_RECORD_HEADER_LEN + rec_len;
    if (total > out_max) { return TLS_ERR_BUFFER_FULL; }
    var aad[13];
    tls_native_record_aad_12(seq8, ct, 0x0303, plain_len, &aad);
    var nonce[_TLS_AEAD_NONCE_LEN];
    if (is_gcm != 0) {
        tls_native_aead_nonce_12_gcm(iv, seq8, &nonce);
    } else {
        tls_native_aead_nonce(iv, seq8, &nonce);
    }
    var wh = tls_native_record_write_header(out, ct, 0x0303, rec_len);
    if (wh < 0) { return wh; }
    var body = out + TLS_RECORD_HEADER_LEN;
    if (is_gcm != 0) {
        memcpy(body, seq8, 8);
        body = body + 8;
    }
    var tag_out = body + plain_len;
    var er = tls_native_aead_encrypt(cipher, key, &nonce, &aad, 13, plain, plain_len, body, tag_out);
    if (er != TLS_OK) { return er; }
    tls_native_seq_increment(seq8);
    return total;
}

# Open a TLS 1.2 AEAD record. Writes plaintext to `out`, the record's
# content type to `out_ct`, increments `seq8`. Returns the plaintext
# length, or a negative TLS_ERR_* (TLS_ERR_DECRYPT on a bad tag).
fn tls_native_record_open_12(cipher, key, iv, seq8, record, record_len, out, out_max, out_ct): i64 {
    var tag_len = tls_native_cipher_tag_len(cipher);
    if (tag_len < 0) { return TLS_ERR_CIPHER_NOT_SUPPORTED; }
    var is_gcm = _tn_cipher_is_gcm(cipher);
    var explicit_len = 0;
    if (is_gcm != 0) { explicit_len = 8; }
    if (record_len < TLS_RECORD_HEADER_LEN + explicit_len + tag_len) { return TLS_ERR_BAD_RECORD; }
    var rct = 0;
    var ver = 0;
    var len = 0;
    if (tls_native_record_read_header(record, record_len, &rct, &ver, &len) < 0) {
        return TLS_ERR_BAD_RECORD;
    }
    if (TLS_RECORD_HEADER_LEN + len > record_len) { return TLS_ERR_BAD_RECORD; }
    var pt_len = len - explicit_len - tag_len;
    if (pt_len < 0) { return TLS_ERR_BAD_RECORD; }
    # RFC 5246 §6.2.3: a received fragment exceeding 2^14 is a
    # record_overflow condition — reject before decrypt (incoming-DoS
    # defense + symmetry with seal_12's cap). See CHANGELOG [6.0.72].
    if (pt_len > _TLS_RECORD_MAX_PLAINTEXT) { return TLS_ERR_RECORD_OVERFLOW; }
    if (pt_len > out_max) { return TLS_ERR_BUFFER_FULL; }
    var body = record + TLS_RECORD_HEADER_LEN;
    var nonce[_TLS_AEAD_NONCE_LEN];
    if (is_gcm != 0) {
        tls_native_aead_nonce_12_gcm(iv, body, &nonce);
        body = body + 8;
    } else {
        tls_native_aead_nonce(iv, seq8, &nonce);
    }
    var aad[13];
    tls_native_record_aad_12(seq8, rct, ver, pt_len, &aad);
    var tag_in = body + pt_len;
    var dr = tls_native_aead_decrypt(cipher, key, &nonce, &aad, 13, body, pt_len, tag_in, out);
    if (dr != TLS_OK) { return dr; }
    store64(out_ct, rct & 0xFF);
    tls_native_seq_increment(seq8);
    return pt_len;
}

# ================================================================
# TLS 1.2 PRF + key derivation (Mini-arc D, .73)
# ================================================================
# TLS 1.2 derives all key material from one PRF (RFC 5246 §5):
#   PRF(secret, label, seed) = P_<hash>(secret, label ‖ seed)
# where <hash> is the ciphersuite's hash (SHA-256 or SHA-384) and
# P_hash is the HMAC expansion. sigil's tls12_prf_sha{256,384} implement
# P_hash and concatenate label ‖ seed internally, so these wrappers just
# select the hash and assemble the two-random seed. The outputs feed the
# .72 record layer (the key + the GCM 4-byte salt / ChaCha 12-byte IV).
# See CHANGELOG [6.0.72]/[6.0.73].

var TLS12_MASTER_SECRET_LEN = 48;       # RFC 5246 §8.1 (fixed 48 bytes)
const _TLS12_VERIFY_DATA_LEN = 12;      # RFC 5246 §7.4.9 (default 12)
# Read-only mirror of `_TLS12_VERIFY_DATA_LEN`: lib/ reads the const; a write changes nothing (D16). CHANGELOG [6.7.12]
var TLS12_VERIFY_DATA_LEN   = _TLS12_VERIFY_DATA_LEN;
const _TLS12_RANDOM_LEN     = 32;       # client/server Random (RFC 5246 §7.4.1.2)
# Read-only mirror of `_TLS12_RANDOM_LEN`: lib/ reads the const; a write changes nothing (D16). CHANGELOG [6.7.12]
var TLS12_RANDOM_LEN        = _TLS12_RANDOM_LEN;
const _TLS12_SEED_LEN       = 2 * _TLS12_RANDOM_LEN;   # the PRF seed: one Random after the other
# The key_block an AEAD suite needs (2 * key_len + 2 * iv_len, at most 2 * 32 + 2 * 12 = 88), rounded up to
# whole words: tls_native_12_derive_keys's buffer and its guard. CHANGELOG [6.7.18]
const _TLS12_KEY_BLOCK_MAX  = 96;

# TLS 1.2 "fixed_iv_length" per ciphersuite — distinct from the 1.3
# 12-byte IV: AES-GCM uses a 4-byte implicit salt (the 8-byte explicit
# nonce rides the wire, RFC 5288 §3); ChaCha20-Poly1305 uses the full
# 12-byte IV with no explicit nonce (RFC 7905). Returns -1 for unknown.
fn tls_native_cipher_iv_len_12(cipher): i64 {
    if (cipher == TLS_AES_128_GCM_SHA256)       { return 4; }
    if (cipher == TLS_AES_256_GCM_SHA384)       { return 4; }
    if (cipher == TLS_CHACHA20_POLY1305_SHA256) { return 12; }
    return 0 - 1;
}

# The TLS 1.2 PRF: dispatch to sigil's P_hash by the ciphersuite hash.
# (`sec` not `secret` — `secret` is the reserved zeroise keyword.)
# sigil's tls12_prf_* returns `out_len` on success and 0 if the assembled
# `label ‖ seed` exceeds its 256-byte seed cap (writing nothing) — propagate
# that 0 as an error so a derive call can't silently report TLS_OK with an
# uninitialized output buffer. Unreachable for the fixed-size internal seeds
# (≤77 B) but verify_data's handshake-hash arg is caller-supplied.
fn tls_native_12_prf(cipher, sec, secret_len, label, label_len, seed, seed_len, out, out_len): i64 {
    var algo = tls_native_cipher_hash_algo(cipher);
    if (algo == TLS_HASH_SHA384) {
        if (tls12_prf_sha384(sec, secret_len, label, label_len, seed, seed_len, out, out_len) == 0) {
            return TLS_ERR_INVALID_PARAM;
        }
        return TLS_OK;
    }
    if (algo == TLS_HASH_SHA256) {
        if (tls12_prf_sha256(sec, secret_len, label, label_len, seed, seed_len, out, out_len) == 0) {
            return TLS_ERR_INVALID_PARAM;
        }
        return TLS_OK;
    }
    return TLS_ERR_CIPHER_NOT_SUPPORTED;
}

# master_secret = PRF(pre_master_secret, "master secret",
#                     client_random ‖ server_random)[0..48]  (RFC 5246 §8.1).
# `client_random` / `server_random` are 32 bytes each; `out48` gets 48 bytes.
fn tls_native_12_master_secret(cipher, pre_master, pm_len, client_random, server_random, out48): i64 {
    var seed[_TLS12_SEED_LEN];
    memcpy(&seed,                     client_random, _TLS12_RANDOM_LEN);
    memcpy(&seed + _TLS12_RANDOM_LEN,  server_random, _TLS12_RANDOM_LEN);
    return tls_native_12_prf(cipher, pre_master, pm_len, "master secret", 13,
      &seed, _TLS12_SEED_LEN, out48, TLS12_MASTER_SECRET_LEN);
}

# Extended Master Secret variant (RFC 7627 §4): when EMS is negotiated,
# master = PRF(pre_master, "extended master secret", session_hash)[0..47].
# The label is 22 bytes (NOT the legacy 13) and the seed is the session_hash
# ALONE — NOT client_random ‖ server_random. session_hash = Hash(CH..CKE)
# under the ciphersuite PRF hash (sh_len = 32 SHA-256 / 48 SHA-384). EMS binds
# the master to the full handshake transcript, closing the triple-handshake
# class of attacks. See CHANGELOG [6.0.77].
fn tls_native_12_master_secret_ems(cipher, pre_master, pm_len, session_hash, sh_len, out48): i64 {
    return tls_native_12_prf(cipher, pre_master, pm_len, "extended master secret", 22,
      session_hash, sh_len, out48, TLS12_MASTER_SECRET_LEN);
}

# key_block = PRF(master_secret, "key expansion",
#                 server_random ‖ client_random)  (RFC 5246 §6.3).
# NOTE the random order is REVERSED vs master_secret (server first here).
# Caller sizes `out` via tls_native_12_key_block_len.
fn tls_native_12_key_block(cipher, master48, client_random, server_random, out, out_len): i64 {
    var seed[_TLS12_SEED_LEN];
    memcpy(&seed,                     server_random, _TLS12_RANDOM_LEN);
    memcpy(&seed + _TLS12_RANDOM_LEN,  client_random, _TLS12_RANDOM_LEN);
    return tls_native_12_prf(cipher, master48, TLS12_MASTER_SECRET_LEN, "key expansion", 13,
      &seed, _TLS12_SEED_LEN, out, out_len);
}

# Bytes of key_block an AEAD suite needs: 2*key_len + 2*iv_len (no MAC
# keys for AEAD — RFC 5288/7905). Returns -1 for unknown cipher.
fn tls_native_12_key_block_len(cipher): i64 {
    var kl = tls_native_cipher_key_len(cipher);
    var il = tls_native_cipher_iv_len_12(cipher);
    if (kl < 0) { return 0 - 1; }
    if (il < 0) { return 0 - 1; }
    return kl + kl + il + il;
}

# Partition a TLS 1.2 AEAD key_block (RFC 5246 §6.3, AEAD has zero MAC
# keys) into client_write_key ‖ server_write_key ‖ client_write_IV ‖
# server_write_IV. Each `*_key` gets cipher_key_len bytes; each `*_iv`
# gets cipher_iv_len_12 bytes.
fn tls_native_12_partition_keys(cipher, key_block, cw_key, sw_key, cw_iv, sw_iv): i64 {
    var kl = tls_native_cipher_key_len(cipher);
    var il = tls_native_cipher_iv_len_12(cipher);
    if (kl < 0) { return TLS_ERR_CIPHER_NOT_SUPPORTED; }
    if (il < 0) { return TLS_ERR_CIPHER_NOT_SUPPORTED; }
    var p = key_block;
    memcpy(cw_key, p, kl); p = p + kl;
    memcpy(sw_key, p, kl); p = p + kl;
    memcpy(cw_iv,  p, il); p = p + il;
    memcpy(sw_iv,  p, il);
    return TLS_OK;
}

# Finished verify_data = PRF(master_secret, finished_label,
#                           Hash(handshake_messages))[0..12]  (RFC 5246
# §7.4.9). `label` is "client finished" or "server finished" (15 bytes);
# `handshake_hash` is the ciphersuite-hash digest of the handshake
# transcript. Writes 12 bytes to `out12`.
fn tls_native_12_verify_data(cipher, master48, label, label_len, handshake_hash, hh_len, out12): i64 {
    return tls_native_12_prf(cipher, master48, TLS12_MASTER_SECRET_LEN,
      label, label_len, handshake_hash, hh_len, out12, _TLS12_VERIFY_DATA_LEN);
}

# ================================================================
# TLS 1.2 handshake messages (Mini-arc D, .74)
# ================================================================
# Pure byte-buffer builders/parsers for the 1.2 (ECDHE) handshake.
# Wire formats per RFC 5246 (handshake) + RFC 8422 (ECC: ECDHE
# ServerKeyExchange / ClientKeyExchange / named curves). All work on
# RAW handshake-message bytes (4-byte header + body) — record-layer
# wrapping (plaintext ct=22 pre-CCS, AEAD-sealed post-CCS) is the
# connect_12/accept_12 I/O layer. The transcript hash (reused
# transcript object) feeds on these raw bytes, CCS excluded.
# See CHANGELOG [6.0.74].

# Build a TLS 1.2 ClientHello into `out`. legacy_version=0x0303, a
# full 32-byte random (no gmt_unix_time split), empty session_id, the
# supported 1.2 wire ciphersuites (descending), null compression, and
# the extensions a 1.2 ECDHE handshake needs: SNI (when the host is a
# DNS name), supported_groups (by default x25519, secp256r1, secp384r1 — tls_native_set_groups),
# ec_point_formats(uncompressed), and
# signature_algorithms. NO supported_versions / key_share (those are
# 1.3 — and the client's ECDHE share rides ClientKeyExchange, not the
# hello). Buffers the message into CH_BUF/CH_LEN for the retroactive
# transcript init. Returns the message length or a negative TLS_ERR_*.
fn tls_native_12_build_client_hello(ctx, out, out_max): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    if (load64(ctx + TLS_CTX_OFF_ROLE) != TLS_ROLE_CLIENT) {
        return _tn_ctx_fail(ctx, TLS_ERR_PROTOCOL);
    }
    var crand = _tn_alloc(ctx, _TLS_RANDOM_LEN);
    if (crand == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    if (_tn_rand_bytes(crand, _TLS_RANDOM_LEN) != _TLS_RANDOM_LEN) {
        return _tn_ctx_fail(ctx, TLS_ERR_INTERNAL);
    }
    store64(ctx + TLS_CTX_OFF_CLIENT_RANDOM, crand);
    var host = load64(ctx + TLS_CTX_OFF_HOST);
    # SNI only for a DNS name: an IP literal is not a HostName (RFC 6066 §3). The host still binds
    # the certificate (tls_native_client_verify_hostname). CHANGELOG [6.6.14]
    var host_len = _tn_sni_len(host, load64(ctx + TLS_CTX_OFF_HOST_LEN));
    var sni_ext = 0;
    if (host_len > 0) { sni_ext = 4 + 2 + 1 + 2 + host_len; }
    # ext_block = SNI + supported_groups(6 + 2 per group) + ec_point_formats(6)
    #           + signature_algorithms(20, seven schemes — .83 added RSA PSS+PKCS1)
    #           + renegotiation_info(5, empty — RFC 5746 §3.4)
    #           + extended_master_secret(4, empty — RFC 7627 §5.1)
    #           + ALPN(6+protos, RFC 7301) when offered
    var alpn = load64(ctx + TLS_CTX_OFF_ALPN_OFFER);
    var apl = 0;
    var alpn_ext = 0;
    if (alpn != 0) { apl = _tn_be16_r(alpn); alpn_ext = 6 + apl; }
    # supported_groups lists every curve the 1.2 client does ECDHE on (RFC 8422 §5.1.1) — by
    # default x25519 first, then secp256r1 and secp384r1 (sigil's constant-time ECDH; the list
    # tls_native_set_groups installed, if any), with or without a client certificate — the list is
    # also the curves a server may accept an ECDSA client certificate on, and the curves an ECDSA
    # server certificate may use. 6.6.14 listed a P-256 / P-384 client certificate's curve while
    # the key exchange was x25519 only, so a server ranking that curve first failed the handshake;
    # without a certificate the hello offered x25519 alone and an OpenSSL server with an ECDSA
    # certificate answered "no shared cipher". CHANGELOG [6.6.15]
    var sg_ext = 6 + 2 * _tn_groups_n(_tn_groups(ctx));
    var ext_block = sni_ext + sg_ext + 6 + 20 + 5 + 4 + alpn_ext;
    # cipher_suites = 2-byte len + six supported suites (12 bytes; .83 added RSA + AES-128)
    var body_len = 2 + 32 + 1 + 2 + 12 + 2 + 2 + ext_block;
    var total = _TLS_HANDSHAKE_HEADER_LEN + body_len;
    if (total > out_max) { return _tn_ctx_fail(ctx, TLS_ERR_BUFFER_FULL); }
    tls_native_handshake_write_header(out, TLS_HS_CLIENT_HELLO, body_len);
    var p = out + _TLS_HANDSHAKE_HEADER_LEN;
    _tn_be16_w(p, 0x0303); p = p + 2;
    memcpy(p, crand, 32); p = p + 32;
    store8(p, 0); p = p + 1;                          # legacy_session_id (empty)
    _tn_be16_w(p, 12); p = p + 2;                      # cipher_suites length (6 suites); see CHANGELOG [6.0.83]
    _tn_be16_w(p, TLS12_ECDHE_ECDSA_AES256_GCM_SHA384); p = p + 2;
    _tn_be16_w(p, TLS12_ECDHE_ECDSA_CHACHA20_SHA256); p = p + 2;
    _tn_be16_w(p, TLS12_ECDHE_ECDSA_AES128_GCM_SHA256); p = p + 2;
    _tn_be16_w(p, TLS12_ECDHE_RSA_AES256_GCM_SHA384); p = p + 2;
    _tn_be16_w(p, TLS12_ECDHE_RSA_AES128_GCM_SHA256); p = p + 2;
    _tn_be16_w(p, TLS12_ECDHE_RSA_CHACHA20_SHA256); p = p + 2;
    store8(p, 1); p = p + 1; store8(p, 0); p = p + 1;  # legacy_compression null
    _tn_be16_w(p, ext_block); p = p + 2;
    if (sni_ext > 0) {
        _tn_be16_w(p, TLS_EXT_SERVER_NAME); p = p + 2;
        _tn_be16_w(p, 2 + 1 + 2 + host_len); p = p + 2;
        _tn_be16_w(p, 1 + 2 + host_len); p = p + 2;    # server_name_list length
        store8(p, 0); p = p + 1;                       # name_type host_name(0)
        _tn_be16_w(p, host_len); p = p + 2;
        memcpy(p, host, host_len); p = p + host_len;
    }
    p = p + _tn_write_supported_groups(ctx, p);
    _tn_be16_w(p, TLS_EXT_EC_POINT_FORMATS); p = p + 2;
    _tn_be16_w(p, 2); p = p + 2;
    store8(p, 1); p = p + 1;                           # ec_point_format_list length (1 BYTE)
    store8(p, 0); p = p + 1;                           # uncompressed(0)
    _tn_be16_w(p, TLS_EXT_SIGNATURE_ALGORITHMS); p = p + 2;
    _tn_be16_w(p, 16); p = p + 2;                      # ext_data len (2 + 7*2); see CHANGELOG [6.0.83]
    _tn_be16_w(p, 14); p = p + 2;                      # supported_signature_algorithms len (7 schemes)
    _tn_be16_w(p, TLS_SIG_ECDSA_SECP256R1_SHA256); p = p + 2;
    _tn_be16_w(p, TLS_SIG_ECDSA_SECP384R1_SHA384); p = p + 2;
    _tn_be16_w(p, TLS_SIG_RSA_PSS_RSAE_SHA256); p = p + 2;   # RSA-cert 1.2 servers
    _tn_be16_w(p, TLS_SIG_RSA_PSS_RSAE_SHA384); p = p + 2;
    _tn_be16_w(p, TLS_SIG_RSA_PKCS1_SHA256); p = p + 2;
    _tn_be16_w(p, TLS_SIG_RSA_PKCS1_SHA384); p = p + 2;
    _tn_be16_w(p, TLS_SIG_ED25519); p = p + 2;
    _tn_be16_w(p, TLS_EXT_RENEGOTIATION_INFO); p = p + 2;   # RFC 5746 secure renegotiation
    _tn_be16_w(p, 1); p = p + 2;                       # ext_data length
    store8(p, 0); p = p + 1;                           # renegotiated_connection<0> (empty)
    _tn_be16_w(p, TLS_EXT_EXTENDED_MASTER_SECRET); p = p + 2;   # RFC 7627 — always offer
    _tn_be16_w(p, 0); p = p + 2;                       # empty extension_data
    store64(ctx + TLS_CTX_OFF_USE_EMS, 1);             # offered; SH parser clears it if not echoed
    if (alpn != 0) {
        _tn_be16_w(p, TLS_EXT_ALPN); p = p + 2;
        _tn_be16_w(p, 2 + apl); p = p + 2;             # extension_data length
        _tn_be16_w(p, apl); p = p + 2;                  # ProtocolNameList length
        memcpy(p, alpn + 2, apl); p = p + apl;          # offered protocols
    }
    var chbuf = _tn_alloc(ctx, total);
    if (chbuf == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    memcpy(chbuf, out, total);
    store64(ctx + TLS_CTX_OFF_CH_BUF, chbuf);
    store64(ctx + TLS_CTX_OFF_CH_LEN, total);
    return total;
}

# Build a TLS 1.2 ServerHello into `out`. server_version=0x0303, the
# ctx server_random, an (echoed/empty) session_id, the chosen WIRE
# ciphersuite, null compression, and the minimal extensions a 1.2 peer
# expects: an empty renegotiation_info (RFC 5746) and, when
# `want_ecpf`, ec_point_formats(uncompressed). Requires SERVER_RANDOM
# + CIPHER (identity) set. Returns the message length or
# TLS_ERR_BUFFER_FULL. (CIPHER holds the AEAD identity; the wire id to
# emit comes from the reverse map.)
fn _tn_build_server_hello_12(ctx, out, out_max, want_ecpf): i64 {
    var identity = load64(ctx + TLS_CTX_OFF_CIPHER);
    var wire = tls_native_aead_to_wire_12(identity, TLS12_AUTH_ECDSA);
    if (wire < 0) { return TLS_ERR_CIPHER_NOT_SUPPORTED; }
    var sid_len = load64(ctx + TLS_CTX_OFF_SESSION_ID_LEN);
    var ems = load64(ctx + TLS_CTX_OFF_USE_EMS);
    var ecpf_ext = 0;
    if (want_ecpf == 1) { ecpf_ext = 6; }
    var ems_ext = 0;
    if (ems == 1) { ems_ext = 4; }                     # RFC 7627 — echo iff client offered
    # ALPN (RFC 7301): echo the protocol negotiated during ClientHello parse.
    var alpn_sel = load64(ctx + TLS_CTX_OFF_ALPN_SEL);
    var alpn_ext = 0;
    if (alpn_sel != 0) { alpn_ext = 4 + 2 + 1 + (load8(alpn_sel) & 0xFF); }
    var ext_block = 5 + ecpf_ext + ems_ext + alpn_ext; # renegotiation_info(5) + ec_point_formats + EMS + ALPN
    var body_len = 2 + 32 + 1 + sid_len + 2 + 1 + 2 + ext_block;
    var total = _TLS_HANDSHAKE_HEADER_LEN + body_len;
    if (total > out_max) { return TLS_ERR_BUFFER_FULL; }
    tls_native_handshake_write_header(out, TLS_HS_SERVER_HELLO, body_len);
    var p = out + _TLS_HANDSHAKE_HEADER_LEN;
    _tn_be16_w(p, 0x0303); p = p + 2;
    memcpy(p, load64(ctx + TLS_CTX_OFF_SERVER_RANDOM), 32); p = p + 32;
    store8(p, sid_len & 0xFF); p = p + 1;
    if (sid_len > 0) {
        memcpy(p, load64(ctx + TLS_CTX_OFF_SESSION_ID), sid_len);
        p = p + sid_len;
    }
    _tn_be16_w(p, wire); p = p + 2;
    store8(p, 0); p = p + 1;                            # compression null
    _tn_be16_w(p, ext_block); p = p + 2;
    _tn_be16_w(p, TLS_EXT_RENEGOTIATION_INFO); p = p + 2;
    _tn_be16_w(p, 1); p = p + 2;                        # ext_data length
    store8(p, 0); p = p + 1;                            # renegotiated_connection<0> (empty)
    if (want_ecpf == 1) {
        _tn_be16_w(p, TLS_EXT_EC_POINT_FORMATS); p = p + 2;
        _tn_be16_w(p, 2); p = p + 2;
        store8(p, 1); p = p + 1;                        # list length (1 BYTE)
        store8(p, 0); p = p + 1;                        # uncompressed(0)
    }
    if (ems == 1) {
        _tn_be16_w(p, TLS_EXT_EXTENDED_MASTER_SECRET); p = p + 2;   # RFC 7627 echo (empty)
        _tn_be16_w(p, 0); p = p + 2;
    }
    if (alpn_sel != 0) {
        var aplen = load8(alpn_sel) & 0xFF;
        _tn_be16_w(p, TLS_EXT_ALPN); p = p + 2;
        _tn_be16_w(p, 2 + 1 + aplen); p = p + 2;        # extension_data length
        _tn_be16_w(p, 1 + aplen); p = p + 2;            # ProtocolNameList length
        store8(p, aplen); p = p + 1;                    # protocol name length
        memcpy(p, alpn_sel + 1, aplen); p = p + aplen;  # the selected protocol
    }
    return total;
}

# Probe a ServerHello for a supported_versions extension carrying
# 0x0304 (RFC 8446 §4.2.1) — the authoritative 1.3 signal. Returns 1
# (1.3), 0 (absent → 1.2), or -1 (malformed). The connect dispatcher
# uses this to route a parsed SH to the 1.2-vs-1.3 path; the legacy
# version field stays 0x0303 in both, so the extension is the only
# reliable discriminator.
fn _tn_sh_is_tls13(sh, sh_len): i64 {
    var ht = 0;
    var blen = 0;
    if (tls_native_handshake_read_header(sh, sh_len, &ht, &blen) < 0) { return 0 - 1; }
    if (ht != TLS_HS_SERVER_HELLO) { return 0 - 1; }
    if (_TLS_HANDSHAKE_HEADER_LEN + blen > sh_len) { return 0 - 1; }
    var body = sh + _TLS_HANDSHAKE_HEADER_LEN;
    var pos = 2 + 32;                                  # version + random
    if (pos + 1 > blen) { return 0 - 1; }
    var sid_len = load8(body + pos) & 0xFF;
    pos = pos + 1 + sid_len;
    pos = pos + 2 + 1;                                 # cipher_suite + compression
    if (pos > blen) { return 0 - 1; }
    if (pos == blen) { return 0; }                     # no extensions → 1.2
    if (pos + 2 > blen) { return 0 - 1; }
    var ext_total = _tn_be16_r(body + pos);
    pos = pos + 2;
    if (pos + ext_total > blen) { return 0 - 1; }
    var dp = 0;
    var dl = 0;
    var found = _tn_find_ext(body + pos, ext_total, TLS_EXT_SUPPORTED_VERSIONS, &dp, &dl);
    if (found == 0 - 1) { return 0 - 1; }
    if (found == 0) { return 0; }
    if (dl != 2) { return 0 - 1; }
    if (_tn_be16_r(dp) == 0x0304) { return 1; }
    return 0;
}

# Client: parse a TLS 1.2 ServerHello (RFC 5246 §7.4.1.3) answering the
# ClientHello this ctx built (tls_native_12_build_client_hello, buffered
# at CH_BUF). Validates the legacy_version (0x0303), caps the session id
# at 32 bytes (SessionID<0..32>), asserts supported_versions is ABSENT
# (its presence means a 1.3 server — a protocol error on this path),
# walks every extension (_tn_client_ext_walk: one our ClientHello did
# not carry, or one carried twice, is refused), validates the
# secure-renegotiation echo (RFC 5746) and the ALPN answer
# (_tn_client_alpn_answer: exactly one name we offered), and
# reverse-maps the chosen wire ciphersuite to the internal AEAD identity
# (rejecting unsupported), storing the identity at OFF_CIPHER plus the
# server random and version 0x0303. (No RFC 8446 §4.1.3
# downgrade-sentinel check — a 1.2-pinned client never offered 1.3, so
# there is nothing to downgrade from.) Returns TLS_OK or a negative
# TLS_ERR_* (ctx → ERROR) with the alert for the server recorded
# (_tn_hs_refuse; tls_native_connect_12 sends it): malformed, a session
# id over 32 bytes or a non-empty extended_master_secret echo
# (decode_error); a message other than a ServerHello
# (unexpected_message); a version other than 0x0303
# (protocol_version); an extension we did not offer, supported_versions
# included (unsupported_extension); a suite we did not offer, a
# non-null compression method, an extension carried twice, an ALPN
# protocol we did not offer (illegal_parameter); a renegotiation_info
# that is not empty (handshake_failure, RFC 5746 §3.4).
# ⛔ 6.7.14 — WHY. This looked up supported_versions, renegotiation_info,
# extended_master_secret and ALPN and accepted the rest of the block — an
# unsolicited extension, an ALPN answer to no offer or naming a protocol
# not offered, a 33-byte session id — and recorded no alert for any
# refusal. CHANGELOG [6.7.14]
fn tls_native_client_parse_server_hello_12(ctx, sh, sh_len): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    if (load64(ctx + TLS_CTX_OFF_ROLE) != TLS_ROLE_CLIENT) {
        return _tn_ctx_fail(ctx, TLS_ERR_PROTOCOL);
    }
    var ht = 0;
    var blen = 0;
    if (tls_native_handshake_read_header(sh, sh_len, &ht, &blen) < 0) {
        return _tn_hs_refuse(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE);
    }
    if (ht != TLS_HS_SERVER_HELLO) { return _tn_hs_refuse(ctx, TLS_AD_UNEXPECTED_MESSAGE, TLS_ERR_BAD_HANDSHAKE); }
    if (_TLS_HANDSHAKE_HEADER_LEN + blen > sh_len) {
        return _tn_hs_refuse(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE);
    }
    var body = sh + _TLS_HANDSHAKE_HEADER_LEN;
    if (blen < 2 + 32 + 1 + 2 + 1) { return _tn_hs_refuse(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
    if (_tn_be16_r(body) != 0x0303) { return _tn_hs_refuse(ctx, TLS_AD_PROTOCOL_VERSION, TLS_ERR_PROTOCOL); }
    var rnd = body + 2;
    # No RFC 8446 §4.1.3 downgrade-sentinel check here: this path is only
    # reached on a 1.2-pinned client (max_ver==1.2), which never offered
    # 1.3, so there is no downgrade to detect — and a 1.3-capable peer that
    # legitimately negotiates 1.2 sets the sentinel, so checking it would
    # wrongly abort conformant servers.
    var srand = _tn_alloc(ctx, _TLS_RANDOM_LEN);
    if (srand == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    memcpy(srand, rnd, 32);
    store64(ctx + TLS_CTX_OFF_SERVER_RANDOM, srand);
    var pos = 2 + 32;
    var sid_len = load8(body + pos) & 0xFF;
    if (sid_len > 32) { return _tn_hs_refuse(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
    pos = pos + 1 + sid_len;
    if (pos + 2 + 1 > blen) { return _tn_hs_refuse(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
    var wire = _tn_be16_r(body + pos);
    pos = pos + 2;
    var comp = load8(body + pos) & 0xFF;
    pos = pos + 1;
    if (comp != 0) { return _tn_hs_refuse(ctx, TLS_AD_ILLEGAL_PARAMETER, TLS_ERR_PROTOCOL); }
    var identity = tls_native_12_cipher_aead_identity(wire);
    if (identity < 0) { return _tn_hs_refuse(ctx, TLS_AD_ILLEGAL_PARAMETER, TLS_ERR_HANDSHAKE_FAILED); }
    if (tls_native_12_cipher_supported(wire) != 1) {
        return _tn_hs_refuse(ctx, TLS_AD_ILLEGAL_PARAMETER, TLS_ERR_CIPHER_NOT_SUPPORTED);
    }
    # EMS (RFC 7627): the client always offered it (flag set to 1 in
    # build_client_hello). Default to legacy fallback — clear the flag now, then
    # set it back to 1 only if the server echoes the extension below. A legacy
    # server (no extension block, or a block without EMS) thus falls back to 0.
    store64(ctx + TLS_CTX_OFF_USE_EMS, 0);
    # Extensions: supported_versions MUST be absent (else a 1.3 server). A block, when present,
    # fills the rest of the message: a byte after it is decode_error, as in the 1.3 client's
    # ServerHello since 6.7.14 (`>` let it through). CHANGELOG [6.7.15]
    if (pos < blen) {
        if (pos + 2 > blen) { return _tn_hs_refuse(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
        var ext_total = _tn_be16_r(body + pos);
        pos = pos + 2;
        if (pos + ext_total != blen) { return _tn_hs_refuse(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
        var dp = 0;
        var dl = 0;
        var sv = _tn_find_ext(body + pos, ext_total, TLS_EXT_SUPPORTED_VERSIONS, &dp, &dl);
        if (sv == 0 - 1) { return _tn_hs_refuse(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
        if (sv == 1) { return _tn_hs_refuse(ctx, TLS_AD_UNSUPPORTED_EXTENSION, TLS_ERR_PROTOCOL); }
        # Every extension: one the 1.2 ClientHello we sent did not carry is unsupported_extension
        # (RFC 5246 §7.4.1.4: the client MUST abort), one carried twice illegal_parameter.
        # CHANGELOG [6.7.14]
        var xw = _tn_client_ext_walk(ctx, body + pos, ext_total, 2);
        if (xw != TLS_OK) { return xw; }
        # Secure renegotiation (RFC 5746 §3.4): on an initial handshake the
        # server's renegotiation_info, if present, MUST carry an empty
        # renegotiated_connection (a single 0x00 length byte).
        var rp = 0;
        var rl2 = 0;
        var rn = _tn_find_ext(body + pos, ext_total, TLS_EXT_RENEGOTIATION_INFO, &rp, &rl2);
        if (rn == 1) {
            if (rl2 != 1) { return _tn_hs_refuse(ctx, TLS_AD_HANDSHAKE_FAILURE, TLS_ERR_PROTOCOL); }
            if ((load8(rp) & 0xFF) != 0) { return _tn_hs_refuse(ctx, TLS_AD_HANDSHAKE_FAILURE, TLS_ERR_PROTOCOL); }
        }
        # Extended Master Secret echo (RFC 7627 §5.1): a present echo MUST be
        # empty; record EMS active. Absent → leave the flag at 0 (legacy
        # fallback; the §5.2 SHOULD-abort is relaxed to keep legacy-server
        # interop — OpenSSL 3.x always echoes it, so the abort path is moot).
        var ep = 0;
        var el = 0;
        var ems = _tn_find_ext(body + pos, ext_total, TLS_EXT_EXTENDED_MASTER_SECRET, &ep, &el);
        if (ems == 1) {
            if (el != 0) { return _tn_hs_refuse(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_PROTOCOL); }
            store64(ctx + TLS_CTX_OFF_USE_EMS, 1);
        }
        # ALPN selection (RFC 7301): the 1.2 server returns it in the SH — exactly one name we
        # offered (_tn_client_alpn_answer). CHANGELOG [6.7.14]
        var aw = _tn_client_alpn_answer(ctx, body + pos, ext_total);
        if (aw != TLS_OK) { return aw; }
    }
    store64(ctx + TLS_CTX_OFF_CIPHER, identity);
    store64(ctx + TLS_CTX_OFF_VERSION, TLS_VERSION_1_2);
    # No group yet: a 1.2 ServerHello names none — the ServerKeyExchange does
    # (_tn_12_parse_server_kex stores it). CHANGELOG [6.6.15]
    return TLS_OK;
}

# Build a TLS 1.2 Certificate message (RFC 5246 §7.4.2): a 3-byte
# certificate_list length, then 3-byte-length-prefixed cert DER. NO
# certificate_request_context byte and NO per-entry extensions — those
# are TLS 1.3-only (contrast _tn_build_certificate). Single-leaf scope.
# Returns the message length or a negative TLS_ERR_*.
fn _tn_build_certificate_12(ctx, out, out_max): i64 {
    var cert = load64(ctx + TLS_CTX_OFF_CERT_CHAIN);
    var cert_len = load64(ctx + TLS_CTX_OFF_CERT_LEN);
    if (cert == 0) { return TLS_ERR_CERT_INVALID; }
    if (cert_len <= 0) { return TLS_ERR_CERT_INVALID; }
    if (cert_len > 0xFFFFFF - 6) { return TLS_ERR_CERT_INVALID; }
    var list_len = 3 + cert_len;
    var body_len = 3 + list_len;
    var total = _TLS_HANDSHAKE_HEADER_LEN + body_len;
    if (total > out_max) { return TLS_ERR_BUFFER_FULL; }
    tls_native_handshake_write_header(out, TLS_HS_CERTIFICATE, body_len);
    var p = out + _TLS_HANDSHAKE_HEADER_LEN;
    _tn_be24_w(p, list_len); p = p + 3;
    _tn_be24_w(p, cert_len); p = p + 3;
    memcpy(p, cert, cert_len);
    return total;
}

# Client: parse a TLS 1.2 Certificate body (header already stripped).
# Explicit ordered bounds checks; rejects an empty certificate_list
# (the server MUST authenticate) and a zero inner cert length; bounds
# the cert against the list, not just the message. Parses the leaf via
# sigil x509 and stores it at OFF_SERVER_CERT, and the certificates after it
# (TLS order, up to 16; one that does not parse is skipped, as the TLS 1.3
# client skips one) at OFF_SERVER_INTERS for _tn_verify_chain. Every entry
# must be a non-empty ASN.1Cert inside the list. Returns TLS_OK or a
# negative TLS_ERR_*.
# ⛔ 6.7.18 — WHY the intermediates: this kept the leaf only, so a TLS 1.2 server
# that sent its intermediate (most do) failed every verifying connect — no path
# to a root — and no 1.2 chain ever met a CA's nameConstraints. CHANGELOG [6.7.18]
fn _tn_parse_certificate_12(ctx, body, blen): i64 {
    if (blen < 3) { return TLS_ERR_BAD_HANDSHAKE; }
    var list_len = _tn_be24_r(body);
    if (list_len == 0) { return TLS_ERR_CERT_INVALID; }
    var cp = 3;
    if (cp + list_len > blen) { return TLS_ERR_BAD_HANDSHAKE; }
    if (cp + 3 > blen) { return TLS_ERR_BAD_HANDSHAKE; }
    var cert_len = _tn_be24_r(body + cp);
    cp = cp + 3;
    if (cert_len == 0) { return TLS_ERR_CERT_INVALID; }
    if (cert_len > list_len - 3) { return TLS_ERR_BAD_HANDSHAKE; }
    if (cp + cert_len > blen) { return TLS_ERR_BAD_HANDSHAKE; }
    var leaf = x509_cert_alloc_into(_tn_arena(ctx));
    if (leaf == 0) { return TLS_ERR_OOM; }
    if (x509_parse_into(body + cp, cert_len, leaf, _tn_arena(ctx)) != 1) { return TLS_ERR_CERT_INVALID; }
    store64(ctx + TLS_CTX_OFF_SERVER_CERT, leaf);
    var list_end = 3 + list_len;
    cp = cp + cert_len;
    var inters = _tn_alloc(ctx, 8 + 16 * 8);
    if (inters == 0) { return TLS_ERR_OOM; }
    var nint = 0;
    while (cp < list_end) {
        if (cp + 3 > list_end) { return TLS_ERR_BAD_HANDSHAKE; }
        var il = _tn_be24_r(body + cp);
        cp = cp + 3;
        if (il == 0) { return TLS_ERR_BAD_HANDSHAKE; }                 # ASN.1Cert<1..2^24-1>
        if (il > list_end - cp) { return TLS_ERR_BAD_HANDSHAKE; }
        if (nint < 16) {
            var ic = x509_cert_alloc_into(_tn_arena(ctx));
            if (ic == 0) { return TLS_ERR_OOM; }
            if (x509_parse_into(body + cp, il, ic, _tn_arena(ctx)) == 1) {
                store64(inters + 8 + nint * 8, ic);
                nint = nint + 1;
            }
        }
        cp = cp + il;
    }
    store64(inters, nint);
    store64(ctx + TLS_CTX_OFF_SERVER_INTERS, inters);
    return TLS_OK;
}

# Sign the ServerKeyExchange ECDHE params. The signed content is the RAW concatenation
# client_random ‖ server_random ‖ ServerECDHParams (`params`, its exact `params_len` wire bytes:
# 4 + the point — 36 on x25519, 69 / 101 on secp256r1 / secp384r1) (RFC 8422 §5.4) — NOT a
# transcript hash and NOT the 1.3 CertificateVerify content (no 0x20*64 prefix, no context
# string). _tn_sign signs with the loaded key (ECDSA → DER, sigil hashes internally; Ed25519 →
# 64-byte PureEdDSA) and writes the TLS SignatureScheme via `scheme_out`; returns the signature
# length (>0) or a negative TLS_ERR_*.
fn _tn_12_sign_kex_params(ctx, params, params_len, sig_out, sig_max, scheme_out): i64 {
    var content = _tn_alloc(ctx, 64 + params_len);
    if (content == 0) { return TLS_ERR_OOM; }
    memcpy(content,      load64(ctx + TLS_CTX_OFF_CLIENT_RANDOM), 32);
    memcpy(content + 32, load64(ctx + TLS_CTX_OFF_SERVER_RANDOM), 32);
    memcpy(content + 64, params, params_len);
    return _tn_sign(ctx, content, 64 + params_len, sig_out, sig_max, scheme_out);
}

# Build a TLS 1.2 ECDHE ServerKeyExchange (RFC 8422 §5.4). Body = ServerECDHParams
# { curve_type=named_curve(3), namedcurve, ECPoint{ len, EPH_PUB } } ‖ SignatureScheme(2) ‖
# signature<2-byte len>, on the ctx's group (OFF_GROUP — the server picked it from the client's
# supported_groups, _tn_12_parse_client_hello; 0, never set, is x25519): x25519's raw 32-byte
# u-coordinate, or the 65 / 97-byte uncompressed point (6.6.15). The group is independent of the
# certificate: a P-384 certificate signs a secp256r1 exchange as readily as an x25519 one.
# Requires EPH_PUB on that group + the randoms + loaded creds. Returns the message length or a
# negative TLS_ERR_*.
fn _tn_12_build_server_kex(ctx, out, out_max): i64 {
    var group = load64(ctx + TLS_CTX_OFF_GROUP);
    if (group == 0) { group = TLS_GROUP_X25519; }
    var plen = _tn_group_point_len(group);
    if (plen == 0) { return TLS_ERR_HANDSHAKE_FAILED; }
    var params_len = 4 + plen;
    # Worst case: 4 (hdr) + params + 2 (scheme) + 2 (siglen) + 128 (sig cap).
    if (_TLS_HANDSHAKE_HEADER_LEN + params_len + 4 + 128 > out_max) { return TLS_ERR_BUFFER_FULL; }
    var epub = load64(ctx + TLS_CTX_OFF_EPH_PUB);
    if (epub == 0) { return TLS_ERR_PROTOCOL; }
    var body = out + _TLS_HANDSHAKE_HEADER_LEN;
    store8(body, 3);                                   # curve_type named_curve(3)
    _tn_be16_w(body + 1, group);                       # namedcurve
    store8(body + 3, plen);                            # ECPoint length (1 byte)
    memcpy(body + 4, epub, plen);
    var sig = _tn_alloc(ctx, 128);
    if (sig == 0) { return TLS_ERR_OOM; }
    var scheme = 0;
    var sig_len = _tn_12_sign_kex_params(ctx, body, params_len, sig, 128, &scheme);
    if (sig_len < 0) { return sig_len; }
    var body_len = params_len + 2 + 2 + sig_len;
    _tn_be16_w(body + params_len, scheme);
    _tn_be16_w(body + params_len + 2, sig_len);
    memcpy(body + params_len + 4, sig, sig_len);
    tls_native_handshake_write_header(out, TLS_HS_SERVER_KEY_EXCHANGE, body_len);
    return _TLS_HANDSHAKE_HEADER_LEN + body_len;
}

# The NamedGroup of a server leaf's ECDSA key (secp256r1 / secp384r1), 0 for any other key — the
# curve the 1.2 client's supported_groups must list for that certificate. CHANGELOG [6.7.12]
fn _tn_12_leaf_group(leaf): i64 {
    var c = x509_cert_curve(leaf);
    if (c == X509_CURVE_P256) { return TLS_GROUP_SECP256R1; }
    if (c == X509_CURVE_P384) { return TLS_GROUP_SECP384R1; }
    return 0;
}

# Client: parse + verify a TLS 1.2 ECDHE ServerKeyExchange body (header stripped).
# ServerECDHParams { curve_type=named_curve(3), namedcurve, ECPoint<1-byte len> }: the
# namedcurve must be one we offered (_tn_groups: x25519, secp256r1, secp384r1 — 6.6.15) and the
# point exactly that group's length (_tn_group_point_len). The signed content is client_random ‖
# server_random ‖ the params exactly as sent (RFC 8422 §5.4), verified against the parsed
# server-cert key per the SKE's SignatureScheme — an ECDSA certificate on a curve we did not list
# is refused first (6.7.12). Once it verifies, the group goes to OFF_GROUP
# and the point into OWNED storage at OFF_PEER_PUB (the record buffer is transient). An EC
# point's validity — prefix 0x04, both coordinates below p, on the curve — is sigil's check, in
# _tn_ecdhe_shared. Returns TLS_OK or a negative TLS_ERR_*.
fn _tn_12_parse_server_kex(ctx, body, body_len): i64 {
    if (body_len < 4) { return TLS_ERR_BAD_HANDSHAKE; }
    if ((load8(body) & 0xFF) != 3) { return TLS_ERR_HANDSHAKE_FAILED; }
    var group = _tn_be16_r(body + 1);
    if (_tn_groups_has(_tn_groups(ctx), group) != 1) { return TLS_ERR_HANDSHAKE_FAILED; }
    var want = _tn_group_point_len(group);
    if (want == 0) { return TLS_ERR_HANDSHAKE_FAILED; }
    var point_len = load8(body + 3) & 0xFF;
    if (point_len != want) { return TLS_ERR_HANDSHAKE_FAILED; }
    var plen = 4 + point_len;                          # the params' wire length
    if (body_len < plen + 4) { return TLS_ERR_BAD_HANDSHAKE; }
    var scheme = _tn_be16_r(body + plen);
    var sig_len = _tn_be16_r(body + plen + 2);
    # The signature fills the body exactly: a byte after it is refused like one missing (`>` let
    # trailing bytes through, 6.7.12). CHANGELOG [6.7.12]
    if (plen + 4 + sig_len != body_len) { return TLS_ERR_BAD_HANDSHAKE; }
    var sig = body + plen + 4;
    var content = _tn_alloc(ctx, 64 + plen);
    if (content == 0) { return TLS_ERR_OOM; }
    memcpy(content,      load64(ctx + TLS_CTX_OFF_CLIENT_RANDOM), 32);
    memcpy(content + 32, load64(ctx + TLS_CTX_OFF_SERVER_RANDOM), 32);
    memcpy(content + 64, body, plen);
    var leaf = load64(ctx + TLS_CTX_OFF_SERVER_CERT);
    if (leaf == 0) { return TLS_ERR_CERT_INVALID; }
    # An ECDSA server certificate must be on a curve our supported_groups listed (RFC 8422 §5.1 —
    # the 1.2 ClientHello lists _tn_groups(ctx) exactly; OpenSSL's client refuses it as "wrong
    # curve"); an Ed25519 or RSA key is not bound by the list. CHANGELOG [6.7.12]
    var lg = _tn_12_leaf_group(leaf);
    if (lg != 0) {
        if (_tn_groups_has(_tn_groups(ctx), lg) != 1) { return TLS_ERR_HANDSHAKE_FAILED; }
    }
    # 1.2 SKE allows ECDSA (P-256/P-384), EdDSA, and RSA (PKCS#1 v1.5 or PSS,
    # per the SKE's SignatureAndHashAlgorithm). See CHANGELOG [6.0.83].
    # An ECDSA scheme names only the hash in TLS 1.2: a P-384 server key signs SHA-256 when we list
    # 0x0403 first (OpenSSL's does), and reading the scheme as 1.3 does — curve bound to it — failed
    # every P-384 server certificate with TLS_ERR_AUTHN (_tn_ecdsa_verify_12). CHANGELOG [6.6.15]
    var ok = 0;
    var ecdsa = 0;
    if (scheme == TLS_SIG_ECDSA_SECP256R1_SHA256) { ecdsa = 1; }
    if (scheme == TLS_SIG_ECDSA_SECP384R1_SHA384) { ecdsa = 1; }
    if (ecdsa == 1) { ok = _tn_ecdsa_verify_12(scheme, leaf, content, 64 + plen, sig, sig_len); }
    else { ok = _tn_verify_sig_scheme(scheme, leaf, content, 64 + plen, sig, sig_len); }
    if (ok < 0) { return TLS_ERR_KEY_UNSUPPORTED; }
    if (ok != 1) { return TLS_ERR_AUTHN; }
    # Only a signed group and point are recorded.
    var peer = _tn_alloc(ctx, point_len);
    if (peer == 0) { return TLS_ERR_OOM; }
    memcpy(peer, body + 4, point_len);
    store64(ctx + TLS_CTX_OFF_PEER_PUB, peer);
    store64(ctx + TLS_CTX_OFF_GROUP, group);
    return TLS_OK;
}

# Build a ServerHelloDone (RFC 5246 §7.4.5): a bare handshake header,
# type 14, zero-length body. Returns 4 or TLS_ERR_BUFFER_FULL.
fn tls_native_12_build_server_hello_done(out, out_max): i64 {
    if (out_max < _TLS_HANDSHAKE_HEADER_LEN) { return TLS_ERR_BUFFER_FULL; }
    tls_native_handshake_write_header(out, TLS_HS_SERVER_HELLO_DONE, 0);
    return _TLS_HANDSHAKE_HEADER_LEN;
}

# Parse + validate a ServerHelloDone. Requires type 14 and an exactly
# empty body. Returns TLS_OK or TLS_ERR_BAD_HANDSHAKE.
fn tls_native_12_parse_server_hello_done(msg, msg_len): i64 {
    var ht = 0;
    var blen = 0;
    if (tls_native_handshake_read_header(msg, msg_len, &ht, &blen) < 0) { return TLS_ERR_BAD_HANDSHAKE; }
    if (ht != TLS_HS_SERVER_HELLO_DONE) { return TLS_ERR_BAD_HANDSHAKE; }
    if (blen != 0) { return TLS_ERR_BAD_HANDSHAKE; }
    return TLS_OK;
}

# Build a TLS 1.2 ECDHE ClientKeyExchange (RFC 8422 §5.7): body =
# ECPoint{ length, point } — a 1-BYTE length prefix (not 2). `point_len` bytes of `point`:
# x25519's raw 32-byte u-coord, or an uncompressed SEC 1 point (65 B secp256r1, 97 B
# secp384r1). Returns 4 + 1 + point_len, or TLS_ERR_BUFFER_FULL / TLS_ERR_INVALID_PARAM.
# CHANGELOG [6.6.15]
fn _tn_12_build_client_kex(point, point_len, out, out_max): i64 {
    if (point_len <= 0) { return TLS_ERR_INVALID_PARAM; }
    if (point_len > 255) { return TLS_ERR_INVALID_PARAM; }
    var body_len = 1 + point_len;
    var total = _TLS_HANDSHAKE_HEADER_LEN + body_len;
    if (total > out_max) { return TLS_ERR_BUFFER_FULL; }
    tls_native_handshake_write_header(out, TLS_HS_CLIENT_KEY_EXCHANGE, body_len);
    var p = out + _TLS_HANDSHAKE_HEADER_LEN;
    store8(p, point_len); p = p + 1;
    memcpy(p, point, point_len);
    return total;
}

# Build an x25519 ClientKeyExchange: ECPoint{ length=32, client_eph_pub } — a raw 32-byte
# u-coord, no 0x04 prefix. Returns 37 or TLS_ERR_BUFFER_FULL. (The 1.2 client builds the
# ClientKeyExchange of whichever group the server chose through _tn_12_build_client_kex.)
fn tls_native_12_build_client_key_exchange(client_eph_pub, out, out_max): i64 {
    return _tn_12_build_client_kex(client_eph_pub, 32, out, out_max);
}

# Server: parse a TLS 1.2 ECDHE ClientKeyExchange carrying a `point_len`-byte ECPoint (RFC 8422
# §5.7: a 1-byte length, then the point). Requires type 16 and a body of EXACTLY 1 + point_len
# bytes (rejects trailing garbage) whose length byte is point_len. Copies the point to `out`.
# Returns TLS_OK, TLS_ERR_BAD_HANDSHAKE (malformed) or TLS_ERR_HANDSHAKE_FAILED (a point of
# another length). CHANGELOG [6.6.15]
fn _tn_12_parse_client_kex(msg, msg_len, point_len, out): i64 {
    var ht = 0;
    var blen = 0;
    if (tls_native_handshake_read_header(msg, msg_len, &ht, &blen) < 0) { return TLS_ERR_BAD_HANDSHAKE; }
    if (ht != TLS_HS_CLIENT_KEY_EXCHANGE) { return TLS_ERR_BAD_HANDSHAKE; }
    if (_TLS_HANDSHAKE_HEADER_LEN + blen > msg_len) { return TLS_ERR_BAD_HANDSHAKE; }
    if (blen != 1 + point_len) { return TLS_ERR_BAD_HANDSHAKE; }
    var body = msg + _TLS_HANDSHAKE_HEADER_LEN;
    if ((load8(body) & 0xFF) != point_len) { return TLS_ERR_HANDSHAKE_FAILED; }
    memcpy(out, body + 1, point_len);
    return TLS_OK;
}

# Server: parse an x25519 ClientKeyExchange — a body of EXACTLY 1 + 32 = 33 bytes with a 32-byte
# point, copied to `peer_pub_out32`. Returns TLS_OK or a negative TLS_ERR_*. (The 1.2 server
# parses the ClientKeyExchange of whichever group it chose through _tn_12_parse_client_kex.)
fn tls_native_12_parse_client_key_exchange(msg, msg_len, peer_pub_out32): i64 {
    return _tn_12_parse_client_kex(msg, msg_len, 32, peer_pub_out32);
}

# ----------------------------------------------------------------
# TLS 1.2 client authentication (6.6.14, CYRIUS-2026-0019)
# ----------------------------------------------------------------
# RFC 5246 §7.4.4 / §7.4.6 / §7.4.8. A server whose verify mode is not TLS_VERIFY_NONE sends a
# CertificateRequest between its ServerKeyExchange and ServerHelloDone; the client answers with a
# Certificate (empty when it has nothing acceptable to present), its ClientKeyExchange and — when
# it presented a certificate — a CertificateVerify signing every handshake message before it. The
# server verifies the chain (_tn_server_take_client_chain) and the signature
# (_tn_verify_client_sig), as the 1.3 server does. The offer is the 1.3 server's: ecdsa_sign
# certificates (RFC 8422 §5.5 — EdDSA included) signing with ecdsa_secp256r1_sha256 (a P-256 key),
# ecdsa_secp384r1_sha384 (a P-384 key) or ed25519; certificate_authorities is empty, so a client
# picks its certificate itself (OpenSSL's s_client sends what it was given).
# ⛔ WHY. The 1.2 server sent no CertificateRequest and never read the verify mode: a server that
# required client certificates completed the handshake with ANY client that offered only TLS 1.2,
# unauthenticated, and the 1.2 client failed every server that asked (TLS_ERR_BAD_HANDSHAKE).
# CHANGELOG [6.6.14]

var TLS12_CERT_TYPE_ECDSA_SIGN = 64;   # ClientCertificateType ecdsa_sign (RFC 8422 §5.5)

# Server: build the TLS 1.2 CertificateRequest: certificate_types { ecdsa_sign },
# supported_signature_algorithms { ecdsa_secp256r1_sha256, ecdsa_secp384r1_sha384, ed25519 },
# certificate_authorities empty. Returns the message length (16) or TLS_ERR_BUFFER_FULL.
fn _tn_12_build_cert_request(out, out_max): i64 {
    var body_len = 1 + 1 + 2 + 6 + 2;
    var total = _TLS_HANDSHAKE_HEADER_LEN + body_len;
    if (total > out_max) { return TLS_ERR_BUFFER_FULL; }
    tls_native_handshake_write_header(out, TLS_HS_CERTIFICATE_REQUEST, body_len);
    var p = out + _TLS_HANDSHAKE_HEADER_LEN;
    store8(p, 1); p = p + 1;                           # certificate_types length
    store8(p, TLS12_CERT_TYPE_ECDSA_SIGN); p = p + 1;
    _tn_be16_w(p, 6); p = p + 2;                       # supported_signature_algorithms length
    _tn_be16_w(p, TLS_SIG_ECDSA_SECP256R1_SHA256); p = p + 2;
    _tn_be16_w(p, TLS_SIG_ECDSA_SECP384R1_SHA384); p = p + 2;
    _tn_be16_w(p, TLS_SIG_ED25519); p = p + 2;
    _tn_be16_w(p, 0);                                  # certificate_authorities: empty
    return total;
}

# Client: parse a TLS 1.2 CertificateRequest body (header stripped). Records that the server asked
# (TLS_CTX_OFF_CERT_REQUESTED = 1) and the SignatureScheme our CertificateVerify will use
# (TLS_CTX_OFF_CLIENT_SIG_SCHEME): the scheme of our key (_tn_key_scheme) when a certificate and its
# key are installed (tls_native_set_client_cert / _key), the server lists ecdsa_sign and that
# scheme — else 0, and the client answers with an empty Certificate (RFC 5246 §7.4.6). Every
# length is checked against the body, and the three fields must fill it exactly. Returns TLS_OK
# or TLS_ERR_BAD_HANDSHAKE.
fn _tn_12_parse_cert_request(ctx, body, blen): i64 {
    if (blen < 1) { return TLS_ERR_BAD_HANDSHAKE; }
    var nt = load8(body) & 0xFF;
    if (nt < 1) { return TLS_ERR_BAD_HANDSHAKE; }       # certificate_types<1..2^8-1>
    var pos = 1 + nt;
    if (pos + 2 > blen) { return TLS_ERR_BAD_HANDSHAKE; }
    var sl = _tn_be16_r(body + pos);
    pos = pos + 2;
    if (sl < 2) { return TLS_ERR_BAD_HANDSHAKE; }       # supported_signature_algorithms<2..2^16-2>
    if ((sl & 1) != 0) { return TLS_ERR_BAD_HANDSHAKE; }
    if (pos + sl > blen) { return TLS_ERR_BAD_HANDSHAKE; }
    var sa = body + pos;
    pos = pos + sl;
    if (pos + 2 > blen) { return TLS_ERR_BAD_HANDSHAKE; }
    var cal = _tn_be16_r(body + pos);                   # certificate_authorities<0..2^16-1>
    pos = pos + 2;
    if (pos + cal != blen) { return TLS_ERR_BAD_HANDSHAKE; }
    store64(ctx + TLS_CTX_OFF_CERT_REQUESTED, 1);
    store64(ctx + TLS_CTX_OFF_CLIENT_SIG_SCHEME, 0);
    if (load64(ctx + TLS_CTX_OFF_CERT_CHAIN) == 0) { return TLS_OK; }
    if (load64(ctx + TLS_CTX_OFF_CREDS_LOADED) != 1) { return TLS_OK; }
    var want = _tn_key_scheme(ctx);
    if (want == 0) { return TLS_OK; }
    var type_ok = 0;
    var i = 0;
    while (i < nt) {
        if ((load8(body + 1 + i) & 0xFF) == TLS12_CERT_TYPE_ECDSA_SIGN) { type_ok = 1; }
        i = i + 1;
    }
    if (type_ok == 0) { return TLS_OK; }
    var j = 0;
    while (j < sl) {
        if (_tn_be16_r(sa + j) == want) {
            store64(ctx + TLS_CTX_OFF_CLIENT_SIG_SCHEME, want);
            j = sl;
        } else {
            j = j + 2;
        }
    }
    return TLS_OK;
}

# Client: the TLS 1.2 Certificate message with no certificate (RFC 5246 §7.4.6: an empty
# certificate_list, never an omitted message). Returns 7 or TLS_ERR_BUFFER_FULL.
fn _tn_12_build_empty_certificate(out, out_max): i64 {
    if (out_max < _TLS_HANDSHAKE_HEADER_LEN + 3) { return TLS_ERR_BUFFER_FULL; }
    tls_native_handshake_write_header(out, TLS_HS_CERTIFICATE, 3);
    _tn_be24_w(out + _TLS_HANDSHAKE_HEADER_LEN, 0);
    return _TLS_HANDSHAKE_HEADER_LEN + 3;
}

# The three spans a TLS 1.2 CertificateVerify signs — every handshake message before it, in
# order (RFC 5246 §7.4.8): `a` ‖ `b` ‖ `c`, copied into one buffer from the ctx's allocator (Ed25519
# signs the messages themselves, so a running hash cannot stand in). Returns the buffer or 0 (OOM).
fn _tn_12_cv_content(ctx, a, an, b, bn, c, cn): i64 {
    var buf = _tn_alloc(ctx, an + bn + cn + 1);
    if (buf == 0) { return 0; }
    memcpy(buf, a, an);
    memcpy(buf + an, b, bn);
    memcpy(buf + an + bn, c, cn);
    return buf;
}

# Client: build the TLS 1.2 CertificateVerify — `scheme` (TLS_CTX_OFF_CLIENT_SIG_SCHEME) and our
# key's signature over `content` (_tn_12_cv_content). Returns the message length or a negative
# TLS_ERR_* (TLS_ERR_KEY_UNSUPPORTED if the key cannot make `scheme`).
fn _tn_12_build_cert_verify(ctx, scheme, content, content_len, out, out_max): i64 {
    var sig = _tn_alloc(ctx, 128);
    if (sig == 0) { return TLS_ERR_OOM; }
    var made = 0;
    var sig_len = _tn_sign(ctx, content, content_len, sig, 128, &made);
    if (sig_len < 0) { return sig_len; }
    if (made != scheme) { return TLS_ERR_KEY_UNSUPPORTED; }
    var body_len = 2 + 2 + sig_len;
    var total = _TLS_HANDSHAKE_HEADER_LEN + body_len;
    if (total > out_max) { return TLS_ERR_BUFFER_FULL; }
    tls_native_handshake_write_header(out, TLS_HS_CERTIFICATE_VERIFY, body_len);
    _tn_be16_w(out + _TLS_HANDSHAKE_HEADER_LEN, scheme);
    _tn_be16_w(out + _TLS_HANDSHAKE_HEADER_LEN + 2, sig_len);
    memcpy(out + _TLS_HANDSHAKE_HEADER_LEN + 4, sig, sig_len);
    return total;
}

# Wrap `n` bytes of handshake messages as plaintext handshake records into `out`, fragmenting at
# 2^14 bytes per record (RFC 5246 §6.2.1). Returns the bytes written or TLS_ERR_BUFFER_FULL.
fn _tn_hs_plain_records(msgs, n, out, out_max): i64 {
    var done = 0;
    var w = 0;
    while (done < n) {
        var frag = n - done;
        if (frag > _TLS_RECORD_MAX_PLAINTEXT) { frag = _TLS_RECORD_MAX_PLAINTEXT; }
        if (w + TLS_RECORD_HEADER_LEN + frag > out_max) { return TLS_ERR_BUFFER_FULL; }
        tls_native_record_write_header(out + w, TLS_CT_HANDSHAKE, 0x0303, frag);
        memcpy(out + w + TLS_RECORD_HEADER_LEN, msgs + done, frag);
        w = w + TLS_RECORD_HEADER_LEN + frag;
        done = done + frag;
    }
    return w;
}

# Server: the next whole handshake message of the client's TLS 1.2 flight before its
# ChangeCipherSpec, reassembled in `hb` (`hcap` bytes; *hlenp bytes held, *hposp of them
# consumed): reads plaintext handshake records — no CCS, which ends the flight and is read with the
# Finished — until one more message is complete, however the client split or coalesced them
# (RFC 5246 §6.2.1). Returns the message's length (header + body; it starts at hb + *hposp - len),
# or a negative TLS_ERR_* with the ctx failed: the read path's codes (an alert in place of a
# handshake record is TLS_ERR_ALERT), TLS_ERR_BAD_RECORD for an empty record, TLS_ERR_BAD_HANDSHAKE
# for a flight past `hcap`.
fn _tn_12_srv_next_msg(ctx, fd, rbuf, rcap, hb, hcap, hlenp, hposp): i64 {
    var hl = load64(hlenp);
    var hp = load64(hposp);
    while (1 == 1) {
        if (hp + _TLS_HANDSHAKE_HEADER_LEN <= hl) {
            var ml = _TLS_HANDSHAKE_HEADER_LEN + _tn_be24_r(hb + hp + 1);
            if (hp + ml <= hl) {
                store64(hposp, hp + ml);
                return ml;
            }
            if (hp + ml > hcap) { return _tn_ctx_fail(ctx, TLS_ERR_BAD_HANDSHAKE); }
        }
        var rl = _tn_read_rec(ctx, fd, rbuf, rcap, _TN_CCS_REFUSE);
        if (rl < 0) { return _tn_read_fail(ctx, rl); }
        var hx = _tn_hs_expect_ct(ctx, load8(rbuf) & 0xFF, TLS_CT_HANDSHAKE);
        if (hx != TLS_OK) { return hx; }
        var pl = rl - TLS_RECORD_HEADER_LEN;
        if (pl <= 0) { return _tn_ctx_fail(ctx, TLS_ERR_BAD_RECORD); }
        if (hl + pl > hcap) { return _tn_ctx_fail(ctx, TLS_ERR_BAD_HANDSHAKE); }
        memcpy(hb + hl, rbuf + TLS_RECORD_HEADER_LEN, pl);
        hl = hl + pl;
        store64(hlenp, hl);
    }
    return TLS_ERR_INTERNAL;
}

# Server: the client's TLS 1.2 Certificate message (`msg`, `ml` bytes). An empty certificate_list
# is no identity: accepted under TLS_VERIFY_PEER, refused under TLS_VERIFY_FAIL_IF_NO_PEER_CERT
# (TLS_ERR_CERT_INVALID, as the 1.3 server answers it). A non-empty one MUST verify
# (_tn_server_take_client_chain), and its leaf is then at TLS_CTX_OFF_CLIENT_CERT. On failure the
# client is told why (_tn_client_auth_alert) and the ctx fails. Returns TLS_OK or the failure.
fn _tn_12_srv_client_cert(ctx, fd, msg, ml): i64 {
    var blen = ml - _TLS_HANDSHAKE_HEADER_LEN;
    var body = msg + _TLS_HANDSHAKE_HEADER_LEN;
    if (blen < 3) { return _tn_client_auth_alert(ctx, fd, TLS_ERR_BAD_HANDSHAKE, 0, 0); }
    var list_len = _tn_be24_r(body);
    if (3 + list_len != blen) { return _tn_client_auth_alert(ctx, fd, TLS_ERR_BAD_HANDSHAKE, 0, 0); }
    if (list_len == 0) {
        if (load64(ctx + TLS_CTX_OFF_VERIFY) == TLS_VERIFY_FAIL_IF_NO_PEER_CERT) {
            return _tn_client_auth_alert(ctx, fd, TLS_ERR_CERT_INVALID, 1, 0);
        }
        return TLS_OK;
    }
    var tr = _tn_server_take_client_chain(ctx, body + 3, list_len, 0);
    if (tr != TLS_OK) { return _tn_client_auth_alert(ctx, fd, tr, 0, 0); }
    return TLS_OK;
}

# Server: the client's TLS 1.2 CertificateVerify (`msg`, `ml` bytes) over `content` (every
# handshake message before it). Returns TLS_OK, or the failure with the client told
# (decrypt_error for a bad signature) and the ctx failed.
fn _tn_12_srv_client_cv(ctx, fd, msg, ml, content, content_len): i64 {
    var blen = ml - _TLS_HANDSHAKE_HEADER_LEN;
    var body = msg + _TLS_HANDSHAKE_HEADER_LEN;
    if (blen < 4) { return _tn_client_auth_alert(ctx, fd, TLS_ERR_BAD_HANDSHAKE, 0, 0); }
    var scheme = _tn_be16_r(body);
    var sig_len = _tn_be16_r(body + 2);
    if (4 + sig_len != blen) { return _tn_client_auth_alert(ctx, fd, TLS_ERR_BAD_HANDSHAKE, 0, 0); }
    var vr = _tn_verify_client_sig(scheme, load64(ctx + TLS_CTX_OFF_CLIENT_CERT), content,
      content_len, body + 4, sig_len, 1);
    if (vr != TLS_OK) { return _tn_client_auth_alert(ctx, fd, vr, 0, 0); }
    return TLS_OK;
}

# Write a ChangeCipherSpec record (RFC 5246 §7.1): ContentType
# change_cipher_spec(20), version 0x0303, a single 0x01 body byte =
# `14 03 03 00 01 01`. CCS is NOT a handshake message — it is never
# fed to the transcript and never AEAD-sealed; it is the plaintext
# marker that the sender's next records are protected. Returns 6.
fn tls_native_ccs_record_write(out): i64 {
    tls_native_record_write_header(out, TLS_CT_CHANGE_CIPHER_SPEC, 0x0303, 1);
    store8(out + TLS_RECORD_HEADER_LEN, 1);
    return TLS_RECORD_HEADER_LEN + 1;
}

# ----------------------------------------------------------------
# TLS 1.2 key-schedule glue (.74)
# ----------------------------------------------------------------

# Generate an ephemeral x25519 keypair, storing priv + pub in the ctx but computing NO shared
# secret. The 1.2 ordering needs this: the server makes its keypair at ServerKeyExchange (before
# the client's pub is known) and the client at ClientKeyExchange (server pub known but the DH
# happens later, in compute_premaster). _tn_ephemeral_keygen on x25519 (6.6.15: every group's key
# pair comes from there). Returns TLS_OK or an error.
fn _tn_gen_ephemeral_x25519_pub_only(ctx): i64 {
    return _tn_ephemeral_keygen(ctx, TLS_GROUP_X25519);
}

# The 1.2 client's side of the key exchange, once the ServerKeyExchange is verified: our
# ephemeral key on the group it named — x25519, secp256r1 or secp384r1 (6.6.15,
# _tn_ephemeral_keygen) — and the premaster against its point, in a _TN_EPH_MAX-byte ctx buffer at
# OFF_SHARED. The private key's only use is then behind us, so it is zeroised whatever the outcome;
# the caller zeroises the premaster once the master secret is derived (tls_native_connect_12).
# Returns the premaster's length (32, or 48 on secp384r1) or a negative TLS_ERR_*.
# CHANGELOG [6.6.15]
fn _tn_12_client_premaster(ctx): i64 {
    var group = load64(ctx + TLS_CTX_OFF_GROUP);
    var er = _tn_ephemeral_keygen(ctx, group);
    if (er != TLS_OK) {
        _tn_wipe_priv(ctx);
        return er;
    }
    var pm = _tn_alloc(ctx, _TN_EPH_MAX);
    if (pm == 0) {
        _tn_wipe_priv(ctx);
        return TLS_ERR_OOM;
    }
    store64(ctx + TLS_CTX_OFF_SHARED, pm);
    var pr = tls_native_12_compute_premaster(ctx, load64(ctx + TLS_CTX_OFF_PEER_PUB), pm);
    _tn_wipe_priv(ctx);
    if (pr != TLS_OK) {
        memset(pm, 0, _TN_EPH_MAX);
        return pr;
    }
    return _tn_group_secret_len(group);
}

# Fail the ctx with `err` (tls_native_connect_12, between the premaster and the master secret),
# zeroising the premaster buffer first. Returns `err`.
fn _tn_12_fail_pm(ctx, pm, err): i64 {
    memset(pm, 0, _TN_EPH_MAX);
    return _tn_ctx_fail(ctx, err);
}

# Compute the TLS 1.2 ECDHE pre-master secret from our EPH_PRIV and the peer's ephemeral public
# key, on the ctx's group (OFF_GROUP; 0 — never set — is x25519, the group every 1.2 peer used
# before 6.6.15). Writes _tn_group_secret_len(group) bytes to `out` — 32, or 48 on secp384r1:
#   x25519     x25519(EPH_PRIV, peer 32 B) used directly, no truncation/hash (RFC 8422 §5.11).
#              The all-zero shared secret (a low-order point) is refused.
#   secp256r1  sigil's ecdh_p256_shared / ecdh_p384_shared: `peer` is the 65 / 97-byte
#   secp384r1  uncompressed point; sigil refuses (and zeroes `out`) a point not 0x04-prefixed,
#              with a coordinate >= p, off the curve, or a result at infinity. The premaster is
#              the x-coordinate, leading zeros kept (RFC 8422 §5.10). `out` must hold 48.
# _tn_ecdhe_shared (6.6.15) is the computation. Returns TLS_OK, TLS_ERR_HANDSHAKE_FAILED (a
# refused point / an all-zero x25519 result / a group we do not do) or TLS_ERR_PROTOCOL (no
# ephemeral key).
fn tls_native_12_compute_premaster(ctx, peer_pub, out): i64 {
    var group = load64(ctx + TLS_CTX_OFF_GROUP);
    if (group == 0) { group = TLS_GROUP_X25519; }
    return _tn_ecdhe_shared(ctx, group, peer_pub, _tn_group_point_len(group), out);
}

# Derive + install the full TLS 1.2 key material from the pre-master
# secret: master_secret (PRF over client‖server random), the key_block
# (PRF over server‖client random — the .73 fns take natural order and
# swap internally), partitioned into client/server write key+IV (AEAD,
# no MAC keys). Stores the master at OFF_MASTER12 (for both Finished
# verify_data) and the keys in the REUSED 1.3 application-traffic ctx
# slots (single 1.2 epoch): client-write → CLI_APP, server-write →
# SRV_APP, so seal_app/open_app's role logic stays correct. Resets
# both record sequences to 0 (the post-CCS epoch starts at seq 0).
# Returns TLS_OK or a negative TLS_ERR_*.
fn tls_native_12_derive_keys(ctx, premaster, pm_len): i64 {
    # The key_block (every key and IV of the epoch, at most 2 * 32 + 2 * 12 = 88 bytes) is a
    # `secret var`, zeroised on every return (it was a _tn_alloc abandoned un-wiped). CHANGELOG [6.7.18]
    secret var kb_b[_TLS12_KEY_BLOCK_MAX];
    var identity = load64(ctx + TLS_CTX_OFF_CIPHER);
    var master = _tn_alloc(ctx, TLS12_MASTER_SECRET_LEN);
    if (master == 0) { return TLS_ERR_OOM; }
    if (load64(ctx + TLS_CTX_OFF_USE_EMS) == 1) {
        # Extended Master Secret (RFC 7627): master derives from the
        # session_hash (Hash(CH..CKE)), NOT the randoms. The transcript already
        # covers CH..CKE at this point (the server feeds CKE before deriving;
        # the client reorder in connect_12 ensures the same). transcript_digest
        # is non-destructive, so the running transcript the later Finished
        # verify_data needs stays intact.
        var ts = load64(ctx + TLS_CTX_OFF_TRANSCRIPT);
        if (ts == 0) { return TLS_ERR_PROTOCOL; }
        var shbuf[_TLS_MAX_DIGEST_LEN];
        var sh_len = tls_native_transcript_digest(ts, &shbuf);
        if (sh_len < 0) { return TLS_ERR_INTERNAL; }
        if (tls_native_12_master_secret_ems(identity, premaster, pm_len, &shbuf, sh_len, master) != TLS_OK) {
            return TLS_ERR_INTERNAL;
        }
    } else {
        var crl = load64(ctx + TLS_CTX_OFF_CLIENT_RANDOM);
        var srl = load64(ctx + TLS_CTX_OFF_SERVER_RANDOM);
        if (crl == 0) { return TLS_ERR_PROTOCOL; }
        if (srl == 0) { return TLS_ERR_PROTOCOL; }
        if (tls_native_12_master_secret(identity, premaster, pm_len, crl, srl, master) != TLS_OK) {
            return TLS_ERR_INTERNAL;
        }
    }
    store64(ctx + TLS_CTX_OFF_MASTER12, master);
    # The key_block (RFC 5246 §6.3) uses the randoms in BOTH EMS and legacy
    # modes — re-load them at function scope for the key_block call below.
    var cr = load64(ctx + TLS_CTX_OFF_CLIENT_RANDOM);
    var sr = load64(ctx + TLS_CTX_OFF_SERVER_RANDOM);
    var kb_len = tls_native_12_key_block_len(identity);
    if (kb_len < 0) { return TLS_ERR_CIPHER_NOT_SUPPORTED; }
    if (kb_len > _TLS12_KEY_BLOCK_MAX) { return TLS_ERR_INTERNAL; }
    var kb = &kb_b;
    if (tls_native_12_key_block(identity, master, cr, sr, kb, kb_len) != TLS_OK) {
        return TLS_ERR_INTERNAL;
    }
    var key_len = tls_native_cipher_key_len(identity);
    var iv_len = tls_native_cipher_iv_len_12(identity);
    if (key_len < 0) { return TLS_ERR_CIPHER_NOT_SUPPORTED; }
    if (iv_len < 0) { return TLS_ERR_CIPHER_NOT_SUPPORTED; }
    var cw_key = _tn_alloc(ctx, key_len);
    var sw_key = _tn_alloc(ctx, key_len);
    var cw_iv = _tn_alloc(ctx, iv_len);
    var sw_iv = _tn_alloc(ctx, iv_len);
    if (cw_key == 0) { return TLS_ERR_OOM; }
    if (sw_key == 0) { return TLS_ERR_OOM; }
    if (cw_iv == 0) { return TLS_ERR_OOM; }
    if (sw_iv == 0) { return TLS_ERR_OOM; }
    if (tls_native_12_partition_keys(identity, kb, cw_key, sw_key, cw_iv, sw_iv) != TLS_OK) {
        return TLS_ERR_INTERNAL;
    }
    store64(ctx + TLS_CTX_OFF_CLI_APP_KEY, cw_key);
    store64(ctx + TLS_CTX_OFF_CLI_APP_IV,  cw_iv);
    store64(ctx + TLS_CTX_OFF_SRV_APP_KEY, sw_key);
    store64(ctx + TLS_CTX_OFF_SRV_APP_IV,  sw_iv);
    tls_native_seq_init(ctx + TLS_CTX_OFF_CLI_APP_SEQ);
    tls_native_seq_init(ctx + TLS_CTX_OFF_SRV_APP_SEQ);
    return TLS_OK;
}

# Build a TLS 1.2 Finished (RFC 5246 §7.4.9). verify_data =
# PRF(master, label, Hash(handshake_messages))[0..12] — ALWAYS 12
# bytes (do NOT mirror the 1.3 path's hlen-sized verify_data). `label`
# is "client finished" / "server finished" (15 bytes). The handshake
# hash is the live transcript snapshot (CCS excluded). Feeds the built
# 16-byte Finished into the transcript (so the peer's later Finished
# covers it). Returns 16 (the inner plaintext — the caller AEAD-seals
# it) or a negative TLS_ERR_*.
fn tls_native_12_build_finished(ctx, label, out, out_max): i64 {
    if (out_max < _TLS_HANDSHAKE_HEADER_LEN + _TLS12_VERIFY_DATA_LEN) { return TLS_ERR_BUFFER_FULL; }
    var ts = load64(ctx + TLS_CTX_OFF_TRANSCRIPT);
    var identity = load64(ctx + TLS_CTX_OFF_CIPHER);
    var master = load64(ctx + TLS_CTX_OFF_MASTER12);
    if (ts == 0) { return TLS_ERR_PROTOCOL; }
    if (master == 0) { return TLS_ERR_PROTOCOL; }
    var hh = _tn_alloc(ctx, _TLS_MAX_DIGEST_LEN);
    if (hh == 0) { return TLS_ERR_OOM; }
    var hh_len = tls_native_transcript_digest(ts, hh);
    if (hh_len < 0) { return TLS_ERR_INTERNAL; }
    tls_native_handshake_write_header(out, TLS_HS_FINISHED, _TLS12_VERIFY_DATA_LEN);
    if (tls_native_12_verify_data(identity, master, label, 15, hh, hh_len,
        out + _TLS_HANDSHAKE_HEADER_LEN) != TLS_OK) {
        return TLS_ERR_INTERNAL;
    }
    var total = _TLS_HANDSHAKE_HEADER_LEN + _TLS12_VERIFY_DATA_LEN;
    tls_native_transcript_update(ts, out, total);
    return total;
}

# Verify a peer's TLS 1.2 Finished. Requires type 20 + an exactly
# 12-byte verify_data; recomputes the expected verify_data from the
# live transcript + master and constant-time compares. On success,
# feeds the 16-byte Finished into the transcript (ONLY after a good
# compare — RFC 5246 §7.4.9 ordering). Returns TLS_OK or a negative
# TLS_ERR_* (TLS_ERR_AUTHN on mismatch).
fn tls_native_12_verify_finished(ctx, msg, msg_len, label): i64 {
    var ht = 0;
    var blen = 0;
    if (tls_native_handshake_read_header(msg, msg_len, &ht, &blen) < 0) { return TLS_ERR_BAD_HANDSHAKE; }
    if (ht != TLS_HS_FINISHED) { return TLS_ERR_BAD_HANDSHAKE; }
    if (blen != _TLS12_VERIFY_DATA_LEN) { return TLS_ERR_BAD_HANDSHAKE; }
    if (_TLS_HANDSHAKE_HEADER_LEN + blen > msg_len) { return TLS_ERR_BAD_HANDSHAKE; }
    var ts = load64(ctx + TLS_CTX_OFF_TRANSCRIPT);
    var identity = load64(ctx + TLS_CTX_OFF_CIPHER);
    var master = load64(ctx + TLS_CTX_OFF_MASTER12);
    if (ts == 0) { return TLS_ERR_PROTOCOL; }
    if (master == 0) { return TLS_ERR_PROTOCOL; }
    var hh = _tn_alloc(ctx, _TLS_MAX_DIGEST_LEN);
    if (hh == 0) { return TLS_ERR_OOM; }
    var hh_len = tls_native_transcript_digest(ts, hh);
    if (hh_len < 0) { return TLS_ERR_INTERNAL; }
    var expected[_TLS12_VERIFY_DATA_LEN];
    if (tls_native_12_verify_data(identity, master, label, 15, hh, hh_len, &expected) != TLS_OK) {
        return TLS_ERR_INTERNAL;
    }
    if (_tn_ct_eq(&expected, msg + _TLS_HANDSHAKE_HEADER_LEN, _TLS12_VERIFY_DATA_LEN) != 1) {
        return TLS_ERR_AUTHN;
    }
    tls_native_transcript_update(ts, msg, _TLS_HANDSHAKE_HEADER_LEN + _TLS12_VERIFY_DATA_LEN);
    return TLS_OK;
}

# ----------------------------------------------------------------
# TLS 1.2 record seal/open wrappers (single post-CCS epoch)
# ----------------------------------------------------------------
# Seal `plain` (content type `ct`) under THIS side's write key into a
# 1.2 AEAD record (RFC 5288/7905). Used for the protected Finished
# (ct=22) and post-handshake application data (ct=23). Client writes
# with the client-write key (stored in the CLI_APP slots), server with
# the server-write key (SRV_APP slots). Returns the record length.
fn tls_native_12_seal(ctx, ct, plain, plain_len, out, out_max): i64 {
    var key = load64(ctx + TLS_CTX_OFF_SRV_APP_KEY);
    var iv = load64(ctx + TLS_CTX_OFF_SRV_APP_IV);
    var seqoff = TLS_CTX_OFF_SRV_APP_SEQ;
    if (load64(ctx + TLS_CTX_OFF_ROLE) == TLS_ROLE_CLIENT) {
        key = load64(ctx + TLS_CTX_OFF_CLI_APP_KEY);
        iv = load64(ctx + TLS_CTX_OFF_CLI_APP_IV);
        seqoff = TLS_CTX_OFF_CLI_APP_SEQ;
    }
    if (key == 0) { return TLS_ERR_PROTOCOL; }
    return tls_native_record_seal_12(load64(ctx + TLS_CTX_OFF_CIPHER), key, iv,
      ctx + seqoff, ct, plain, plain_len, out, out_max);
}

# Open a peer 1.2 AEAD record with the PEER's write key, returning the
# plaintext length + the inner content type via `out_ct`. Client reads
# with the server-write key, server with the client-write key.
fn tls_native_12_open(ctx, record, record_len, out, out_max, out_ct): i64 {
    var key = load64(ctx + TLS_CTX_OFF_CLI_APP_KEY);
    var iv = load64(ctx + TLS_CTX_OFF_CLI_APP_IV);
    var seqoff = TLS_CTX_OFF_CLI_APP_SEQ;
    if (load64(ctx + TLS_CTX_OFF_ROLE) == TLS_ROLE_CLIENT) {
        key = load64(ctx + TLS_CTX_OFF_SRV_APP_KEY);
        iv = load64(ctx + TLS_CTX_OFF_SRV_APP_IV);
        seqoff = TLS_CTX_OFF_SRV_APP_SEQ;
    }
    if (key == 0) { return TLS_ERR_PROTOCOL; }
    return tls_native_record_open_12(load64(ctx + TLS_CTX_OFF_CIPHER), key, iv,
      ctx + seqoff, record, record_len, out, out_max, out_ct);
}

# ----------------------------------------------------------------
# TLS 1.2 connect/accept drivers (.74)
# ----------------------------------------------------------------

# Classify a ClientHello for the accept() dispatcher: 1 (it offers TLS 1.3), 0 (TLS 1.2), or -1
# (malformed). supported_versions alone decides (RFC 8446 §4.2.1): 1 when it lists 0x0304, 0 when
# it does not or is absent — a ClientHello without it is TLS 1.2 or earlier, and a server "MUST
# negotiate TLS 1.2 or prior", whatever else the hello carries. A key_share does not make it 1.3.
# ⛔ 6.6.15 — WHY. A key_share alone classified a hello as TLS 1.3 before supported_versions was
# read, so the server negotiated TLS 1.3 with a client whose supported_versions did not list it —
# in a first ClientHello, and in the second one that answers a HelloRetryRequest, whose check
# that it "must still offer TLS 1.3" therefore did not hold. CHANGELOG [6.6.15]
fn _tn_ch_is_tls13(ch_msg, ch_len): i64 {
    var ht = 0;
    var blen = 0;
    if (tls_native_handshake_read_header(ch_msg, ch_len, &ht, &blen) < 0) { return 0 - 1; }
    if (ht != TLS_HS_CLIENT_HELLO) { return 0 - 1; }
    if (_TLS_HANDSHAKE_HEADER_LEN + blen > ch_len) { return 0 - 1; }
    var body = ch_msg + _TLS_HANDSHAKE_HEADER_LEN;
    var pos = 2 + 32;
    if (pos + 1 > blen) { return 0 - 1; }
    var sid_len = load8(body + pos) & 0xFF;
    pos = pos + 1 + sid_len;
    if (pos + 2 > blen) { return 0 - 1; }
    var cs_len = _tn_be16_r(body + pos);
    pos = pos + 2 + cs_len;
    if (pos + 1 > blen) { return 0 - 1; }
    var comp_len = load8(body + pos) & 0xFF;
    pos = pos + 1 + comp_len;
    if (pos == blen) { return 0; }
    if (pos + 2 > blen) { return 0 - 1; }
    var ext_total = _tn_be16_r(body + pos);
    pos = pos + 2;
    if (pos + ext_total > blen) { return 0 - 1; }
    var dp = 0;
    var dl = 0;
    var found = _tn_find_ext(body + pos, ext_total, TLS_EXT_SUPPORTED_VERSIONS, &dp, &dl);
    if (found == 0 - 1) { return 0 - 1; }
    if (found == 0) { return 0; }
    if (dl < 1) { return 0 - 1; }
    var n = load8(dp) & 0xFF;
    if (1 + n > dl) { return 0 - 1; }
    var i = 0;
    while (i + 2 <= n) {
        if (_tn_be16_r(dp + 1 + i) == 0x0304) { return 1; }
        i = i + 2;
    }
    return 0;
}

# Server: parse a TLS 1.2 ClientHello body — capture client_random, pick the first offered
# ciphersuite we can answer (_tn_12_server_suite_ok; its AEAD identity to OFF_CIPHER) and the
# ECDHE group (OFF_GROUP): the first of the server's groups (_tn_groups: x25519, then secp256r1,
# then secp384r1 by default) the client's supported_groups lists (RFC 8422 §5.1.1). A client that
# sends no supported_groups gets the server's first group — the extension is how a client
# restricts the curve, and without it the server may choose (RFC 8422 §4); one whose list shares
# none of ours is refused with handshake_failure. The group never depends on the certificate, but
# in TLS 1.2 the client's list also bounds an ECDSA certificate's curve (RFC 8422 §5.1: an ECC
# suite only if the handshake completes within the client's curves), so a list without it leaves
# no suite to negotiate: handshake_failure. (An Ed25519 certificate is not bound by the list.)
# Returns the chosen WIRE ciphersuite (>0) or a negative TLS_ERR_* with the alert recorded
# (_tn_hs_fail).
# ⛔ 6.6.15 — WHY. The 1.2 server never read supported_groups and sent an x25519
# ServerKeyExchange to every client, so a client offering only P-256 or P-384 refused it
# (OpenSSL's s_client: "wrong curve"). It negotiated an ECDHE_ECDSA suite on a certificate whose
# curve the client had not listed (the client refused it: "wrong curve"); and it took the first
# suite tls_native_12_cipher_supported knew — an ECDHE_RSA one, on a server with no RSA key,
# was answered with an ECDHE_ECDSA suite the client never offered ("wrong cipher returned"), and
# ECDHE_ECDSA_AES128_GCM_SHA256 failed with no alert (the ServerHello cannot name it).
# CHANGELOG [6.6.15]
fn _tn_12_parse_client_hello(ctx, body, blen): i64 {
    if (blen < 2 + 32 + 1) { return _tn_hs_fail(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
    var crand = _tn_alloc(ctx, _TLS_RANDOM_LEN);
    if (crand == 0) { return TLS_ERR_OOM; }
    memcpy(crand, body + 2, 32);
    store64(ctx + TLS_CTX_OFF_CLIENT_RANDOM, crand);
    var pos = 2 + 32;
    var sid_len = load8(body + pos) & 0xFF;
    # SessionID<0..32> (RFC 5246 §7.4.1.2), as the 1.3 parser refuses. CHANGELOG [6.7.12]
    if (sid_len > 32) { return _tn_hs_fail(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
    pos = pos + 1 + sid_len;
    if (pos + 2 > blen) { return _tn_hs_fail(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
    var cs_len = _tn_be16_r(body + pos);
    pos = pos + 2;
    if (pos + cs_len > blen) { return _tn_hs_fail(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
    var chosen = 0;
    var j = 0;
    while (j + 2 <= cs_len) {
        var w = _tn_be16_r(body + pos + j);
        if (_tn_12_server_suite_ok(w) == 1) {
            chosen = w;
            j = cs_len;
        } else {
            j = j + 2;
        }
    }
    # Past cipher_suites (the loop above indexed pos + j and left pos there) come
    # compression_methods<1..2^8-1> (RFC 5246 §7.4.1.2) and the optional extension block; every
    # read is bounds-checked against blen (an untrusted ClientHello). A hello that does not parse
    # is decode_error, recorded so the driver sends it: no compression_methods byte, an empty list,
    # a list overrunning the message, a block that does not fill the rest of the message (6.7.15's
    # D40), an extension whose header or data overruns the block or a 1-3 byte tail after its last
    # whole extension (_tn_ch_ext_walk — walked once, before any lookup, so a malformed list is
    # never read as "absent": no extended master secret, no ALPN, the server's first group), and
    # the three short-message refusals above. The answer the 1.3 server and both clients give
    # (6.7.16's D32, the user, 2026-10-19; the 1.3 server's block tail, 6.7.16's D81). A hello
    # that ends after compression_methods has no block: EMS 0, no ALPN, our first group.
    # Once the whole hello parses, two values are refused with illegal_parameter (the user,
    # 2026-10-20): a compression_methods list without the null method (RFC 5246 §7.4.1.2: it "MUST
    # contain" it; 6.7.16's D83) and an extension type named twice (§7.4.1.4; 6.7.16's D82) — both
    # negotiated before, the second on the first copy. CHANGELOG [6.7.16]
    pos = pos + cs_len;
    var group = 0;
    if (pos + 1 > blen) { return _tn_hs_fail(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
    var cm_len = load8(body + pos) & 0xFF;
    if (cm_len == 0) { return _tn_hs_fail(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
    if (pos + 1 + cm_len > blen) { return _tn_hs_fail(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
    var cmp = body + pos + 1;
    pos = pos + 1 + cm_len;
    var has_ext = 0;
    var ext_total = 0;
    var xw = 1;
    if (pos < blen) {
        if (pos + 2 > blen) { return _tn_hs_fail(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
        ext_total = _tn_be16_r(body + pos);
        pos = pos + 2;
        if (pos + ext_total != blen) { return _tn_hs_fail(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
        xw = _tn_ch_ext_walk(ctx, body + pos, ext_total);
        if (xw < 0) { return xw; }
        if (xw == 0) { return _tn_hs_fail(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
        has_ext = 1;
    }
    if (_tn_12_cm_has_null(cmp, cm_len) != 1) {
        return _tn_hs_fail(ctx, TLS_AD_ILLEGAL_PARAMETER, TLS_ERR_HANDSHAKE_FAILED);
    }
    if (xw == 2) { return _tn_hs_fail(ctx, TLS_AD_ILLEGAL_PARAMETER, TLS_ERR_HANDSHAKE_FAILED); }
    if (has_ext == 1) {
        var ep = 0;
        var el = 0;
        var got = _tn_find_ext(body + pos, ext_total, TLS_EXT_EXTENDED_MASTER_SECRET, &ep, &el);
        if (got == 1) { store64(ctx + TLS_CTX_OFF_USE_EMS, 1); }
        # ALPN (RFC 7301): negotiate against the server's configured
        # list; _tn_build_server_hello_12 emits the result. Lenient.
        _tn_server_negotiate_alpn(ctx, body + pos, ext_total);
        var sgp = 0;
        var sgl = 0;
        if (_tn_find_ext(body + pos, ext_total, TLS_EXT_SUPPORTED_GROUPS, &sgp, &sgl) == 1) {
            group = _tn_pick_group(ctx, sgp, sgl);
            if (group < 0) { return _tn_hs_fail(ctx, TLS_AD_DECODE_ERROR, TLS_ERR_BAD_HANDSHAKE); }
            if (group == 0) { return _tn_hs_fail(ctx, TLS_AD_HANDSHAKE_FAILURE, TLS_ERR_HANDSHAKE_FAILED); }
            var kc = _tn_12_key_curve(ctx);
            if (kc != 0) {
                if (_tn_sg_has(sgp, sgl, kc) != 1) { chosen = 0; }   # no ECDSA suite on this certificate
            }
        }
    }
    if (chosen == 0) { return _tn_hs_fail(ctx, TLS_AD_HANDSHAKE_FAILURE, TLS_ERR_HANDSHAKE_FAILED); }
    if (group == 0) { group = _tn_groups(ctx) & 0xFFFF; }    # no supported_groups: our first
    store64(ctx + TLS_CTX_OFF_GROUP, group);
    store64(ctx + TLS_CTX_OFF_CIPHER, tls_native_12_cipher_aead_identity(chosen));
    return chosen;
}

# 1 if a TLS 1.2 ClientHello's compression_methods (`cm`, `n` bytes, n >= 1) lists the null method
# (0) anywhere, else 0 — RFC 5246 §7.4.1.2: the list "MUST contain" it, and the ServerHello names
# it. CHANGELOG [6.7.16]
fn _tn_12_cm_has_null(cm, n): i64 {
    var i = 0;
    while (i < n) {
        if ((load8(cm + i) & 0xFF) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 if the TLS 1.2 server can negotiate wire suite `w`: an ECDHE suite whose ServerHello it can
# write back — the server's key is Ed25519 or ECDSA, so an ECDHE_ECDSA suite that
# tls_native_aead_to_wire_12 maps to itself (AES256-GCM-SHA384, CHACHA20-POLY1305). Never an
# ECDHE_RSA suite (no RSA server key) nor AES128-GCM (the ServerHello cannot name it).
# CHANGELOG [6.6.15]
fn _tn_12_server_suite_ok(w): i64 {
    if (tls_native_12_cipher_supported(w) != 1) { return 0; }
    if (tls_native_aead_to_wire_12(tls_native_12_cipher_aead_identity(w), TLS12_AUTH_ECDSA) != w) { return 0; }
    return 1;
}

# The NamedGroup of the server's ECDSA key (secp256r1 / secp384r1), 0 for any other key — the
# curve a TLS 1.2 client's supported_groups must list (RFC 8422 §5.1). CHANGELOG [6.6.15]
fn _tn_12_key_curve(ctx): i64 {
    var ka = load64(ctx + TLS_CTX_OFF_KEY_ALGO);
    if (ka == SIG_PRIVKEY_ECDSA_P256) { return TLS_GROUP_SECP256R1; }
    if (ka == SIG_PRIVKEY_ECDSA_P384) { return TLS_GROUP_SECP384R1; }
    return 0;
}

# Server: build the coalesced flight ServerHello ‖ Certificate ‖
# ServerKeyExchange [‖ CertificateRequest] ‖ ServerHelloDone into `out`, feeding each raw
# handshake message into the transcript. The CertificateRequest is sent when the ctx's verify
# mode is not TLS_VERIFY_NONE (6.6.14, CYRIUS-2026-0019: it never was). Requires the transcript
# initialized + the ClientHello already fed, plus CIPHER, SERVER_RANDOM,
# EPH_PUB, and loaded creds. Returns the total length or a negative
# TLS_ERR_*.
fn tls_native_12_build_server_flight(ctx, out, out_max): i64 {
    var ts = load64(ctx + TLS_CTX_OFF_TRANSCRIPT);
    if (ts == 0) { return TLS_ERR_PROTOCOL; }
    var pos = 0;
    var n = _tn_build_server_hello_12(ctx, out + pos, out_max - pos, 1);
    if (n < 0) { return n; }
    tls_native_transcript_update(ts, out + pos, n);
    pos = pos + n;
    n = _tn_build_certificate_12(ctx, out + pos, out_max - pos);
    if (n < 0) { return n; }
    tls_native_transcript_update(ts, out + pos, n);
    pos = pos + n;
    n = _tn_12_build_server_kex(ctx, out + pos, out_max - pos);
    if (n < 0) { return n; }
    tls_native_transcript_update(ts, out + pos, n);
    pos = pos + n;
    if (load64(ctx + TLS_CTX_OFF_VERIFY) != TLS_VERIFY_NONE) {
        n = _tn_12_build_cert_request(out + pos, out_max - pos);
        if (n < 0) { return n; }
        tls_native_transcript_update(ts, out + pos, n);
        pos = pos + n;
    }
    n = tls_native_12_build_server_hello_done(out + pos, out_max - pos);
    if (n < 0) { return n; }
    tls_native_transcript_update(ts, out + pos, n);
    pos = pos + n;
    return pos;
}

# Client: consume the server flight (SH ‖ Cert ‖ SKE [‖ CertificateRequest] ‖ SHD, reassembled
# by the caller). Parses the ServerHello (fixing the
# cipher), retroactively initializes the transcript and feeds the
# buffered ClientHello + ServerHello, then parses + verifies the
# Certificate (leaf), ServerKeyExchange (signature + ephemeral pub), a
# CertificateRequest when the server sent one (6.6.14, _tn_12_parse_cert_request)
# and ServerHelloDone, feeding each into the transcript. Returns the number of
# flight bytes those messages span (> 0; the CertificateVerify signs exactly them)
# or a negative TLS_ERR_*.
fn _tn_12_client_consume_flight(ctx, flight, flight_len): i64 {
    var ht = 0;
    var blen = 0;
    # ServerHello. CRITICAL: handshake_read_header only checks buflen>=4
    # and never validates the 24-bit body length, so each sub-message's
    # claimed length MUST be bounded against the remaining flight buffer
    # before it feeds the transcript or a parser — otherwise a hostile
    # server's oversized length drives an OOB read in sha*_update.
    if (tls_native_handshake_read_header(flight, flight_len, &ht, &blen) < 0) { return TLS_ERR_BAD_HANDSHAKE; }
    var sh_len = _TLS_HANDSHAKE_HEADER_LEN + blen;
    if (sh_len > flight_len) { return TLS_ERR_BAD_HANDSHAKE; }
    var pr = tls_native_client_parse_server_hello_12(ctx, flight, sh_len);
    if (pr != TLS_OK) { return pr; }
    var identity = load64(ctx + TLS_CTX_OFF_CIPHER);
    var ts = tls_native_transcript_init_in(load64(ctx + TLS_CTX_OFF_ALLOC), tls_native_cipher_hash_algo(identity));
    if (ts == 0) { return TLS_ERR_INTERNAL; }
    store64(ctx + TLS_CTX_OFF_TRANSCRIPT, ts);
    var chbuf = load64(ctx + TLS_CTX_OFF_CH_BUF);
    if (chbuf == 0) { return TLS_ERR_PROTOCOL; }
    tls_native_transcript_update(ts, chbuf, load64(ctx + TLS_CTX_OFF_CH_LEN));
    tls_native_transcript_update(ts, flight, sh_len);
    var pos = sh_len;
    if (tls_native_handshake_read_header(flight + pos, flight_len - pos, &ht, &blen) < 0) {
        return TLS_ERR_BAD_HANDSHAKE;
    }
    if (ht != TLS_HS_CERTIFICATE) { return TLS_ERR_BAD_HANDSHAKE; }
    var cert_msg_len = _TLS_HANDSHAKE_HEADER_LEN + blen;
    if (cert_msg_len > flight_len - pos) { return TLS_ERR_BAD_HANDSHAKE; }
    var cr2 = _tn_parse_certificate_12(ctx, flight + pos + _TLS_HANDSHAKE_HEADER_LEN, blen);
    if (cr2 != TLS_OK) { return cr2; }
    tls_native_transcript_update(ts, flight + pos, cert_msg_len);
    pos = pos + cert_msg_len;
    if (tls_native_handshake_read_header(flight + pos, flight_len - pos, &ht, &blen) < 0) {
        return TLS_ERR_BAD_HANDSHAKE;
    }
    if (ht != TLS_HS_SERVER_KEY_EXCHANGE) { return TLS_ERR_BAD_HANDSHAKE; }
    var ske_msg_len = _TLS_HANDSHAKE_HEADER_LEN + blen;
    if (ske_msg_len > flight_len - pos) { return TLS_ERR_BAD_HANDSHAKE; }
    var sr2 = _tn_12_parse_server_kex(ctx, flight + pos + _TLS_HANDSHAKE_HEADER_LEN, blen);
    if (sr2 != TLS_OK) { return sr2; }
    tls_native_transcript_update(ts, flight + pos, ske_msg_len);
    pos = pos + ske_msg_len;
    if (tls_native_handshake_read_header(flight + pos, flight_len - pos, &ht, &blen) < 0) {
        return TLS_ERR_BAD_HANDSHAKE;
    }
    if (ht == TLS_HS_CERTIFICATE_REQUEST) {
        var crq_msg_len = _TLS_HANDSHAKE_HEADER_LEN + blen;
        if (crq_msg_len > flight_len - pos) { return TLS_ERR_BAD_HANDSHAKE; }
        var qr = _tn_12_parse_cert_request(ctx, flight + pos + _TLS_HANDSHAKE_HEADER_LEN, blen);
        if (qr != TLS_OK) { return qr; }
        tls_native_transcript_update(ts, flight + pos, crq_msg_len);
        pos = pos + crq_msg_len;
        if (tls_native_handshake_read_header(flight + pos, flight_len - pos, &ht, &blen) < 0) {
            return TLS_ERR_BAD_HANDSHAKE;
        }
    }
    var shd_msg_len = _TLS_HANDSHAKE_HEADER_LEN + blen;
    if (shd_msg_len > flight_len - pos) { return TLS_ERR_BAD_HANDSHAKE; }
    var dr = tls_native_12_parse_server_hello_done(flight + pos, shd_msg_len);
    if (dr != TLS_OK) { return dr; }
    tls_native_transcript_update(ts, flight + pos, shd_msg_len);
    return pos + shd_msg_len;
}

# Client-side TLS 1.2 handshake driver over a connected socket. Sends a
# plaintext ClientHello, consumes the server flight, computes the ECDHE
# shared secret + derives keys, sends ClientKeyExchange + ChangeCipherSpec
# + a sealed Finished, then verifies the server's sealed Finished →
# CONNECTED. Returns TLS_OK or a negative TLS_ERR_* (ctx → ERROR).
# Reached via tls_native_connect when the ctx is pinned to max 1.2.
fn tls_native_connect_12(ctx, sock_fd): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    store64(ctx + TLS_CTX_OFF_SOCK_FD, sock_fd);
    var ch = _tn_alloc(ctx, 2048);
    if (ch == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var chn = tls_native_12_build_client_hello(ctx, ch, 2048);
    if (chn < 0) { return chn; }
    var chrec = _tn_alloc(ctx, chn + TLS_RECORD_HEADER_LEN);
    if (chrec == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    tls_native_record_write_header(chrec, TLS_CT_HANDSHAKE, 0x0303, chn);
    memcpy(chrec + TLS_RECORD_HEADER_LEN, ch, chn);
    var chw = _tn_io_write_all(ctx, sock_fd, chrec, chn + TLS_RECORD_HEADER_LEN);
    if (chw < 0) { return _tn_ctx_fail(ctx, chw); }
    var cap = TLS_RECORD_MAX_CIPHERTEXT + TLS_RECORD_HEADER_LEN;
    var inbuf = _tn_alloc(ctx, cap);
    if (inbuf == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    # The 1.2 server flight (ServerHello, Certificate, ServerKeyExchange,
    # ServerHelloDone) is plaintext, but a real server fragments it across
    # records (a large RSA Certificate especially). Reassemble the handshake
    # bytes until ServerHelloDone (type 14), then consume. See CHANGELOG [6.0.83].
    var fbuf = _tn_alloc(ctx, 65536);
    if (fbuf == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var flen = 0;
    var fdone = 0;
    while (fdone == 0) {
        var rl = _tn_read_rec(ctx, sock_fd, inbuf, cap, _TN_CCS_REFUSE);
        if (rl < 0) { return _tn_read_fail(ctx, rl); }
        var hx_rec = _tn_hs_expect_ct(ctx, load8(inbuf) & 0xFF, TLS_CT_HANDSHAKE);
        if (hx_rec != TLS_OK) { return hx_rec; }
        var paylen = rl - TLS_RECORD_HEADER_LEN;
        # A zero-length handshake record makes no progress; reject it so a peer
        # streaming empty records can't spin this loop forever. See CHANGELOG [6.0.83].
        if (paylen <= 0) { return _tn_ctx_fail(ctx, TLS_ERR_BAD_RECORD); }
        if (flen + paylen > 65536) { return _tn_ctx_fail(ctx, TLS_ERR_BAD_HANDSHAKE); }
        memcpy(fbuf + flen, inbuf + TLS_RECORD_HEADER_LEN, paylen);
        flen = flen + paylen;
        fdone = _tn_flight_complete(fbuf, flen, TLS_HS_SERVER_HELLO_DONE);
    }
    var cf = _tn_12_client_consume_flight(ctx, fbuf, flen);
    if (cf < 0) {
        _tn_send_hs_alert(ctx, sock_fd);               # the alert a refused ServerHello recorded (6.7.14)
        return _tn_ctx_fail(ctx, cf);
    }
    var group = load64(ctx + TLS_CTX_OFF_GROUP);
    var pm_len = _tn_12_client_premaster(ctx);
    if (pm_len < 0) { return _tn_ctx_fail(ctx, pm_len); }
    var pm = load64(ctx + TLS_CTX_OFF_SHARED);
    # Our flight before the CCS, as handshake messages in `hm`: [Certificate,] ClientKeyExchange
    # [, CertificateVerify] (RFC 5246 §7.3). The Certificate answers a CertificateRequest
    # (6.6.14, CYRIUS-2026-0019): ours when _tn_12_parse_cert_request chose a scheme, else an empty one.
    var creq = load64(ctx + TLS_CTX_OFF_CERT_REQUESTED);
    var cscheme = load64(ctx + TLS_CTX_OFF_CLIENT_SIG_SCHEME);
    var hcap = 512;
    if (cscheme != 0) { hcap = hcap + load64(ctx + TLS_CTX_OFF_CERT_LEN); }
    var hm = _tn_alloc(ctx, hcap);
    if (hm == 0) { return _tn_12_fail_pm(ctx, pm, TLS_ERR_OOM); }
    var hn = 0;
    var ts = load64(ctx + TLS_CTX_OFF_TRANSCRIPT);
    if (creq == 1) {
        var cmn = 0;
        if (cscheme != 0) { cmn = _tn_build_certificate_12(ctx, hm, hcap); }
        else { cmn = _tn_12_build_empty_certificate(hm, hcap); }
        if (cmn < 0) { return _tn_12_fail_pm(ctx, pm, cmn); }
        tls_native_transcript_update(ts, hm, cmn);
        hn = cmn;
    }
    # Build the ClientKeyExchange + feed it into the transcript BEFORE deriving
    # keys, so the EMS session_hash (RFC 7627) covers CH..CKE. The legacy master
    # ignores the transcript, so this reorder is safe in both modes; the
    # record-wrap + socket-send stay below (the wire bytes are order-independent).
    # The server (_tn_12_server_drive) already feeds CKE before deriving — it
    # needs no reorder.
    var cken = _tn_12_build_client_kex(load64(ctx + TLS_CTX_OFF_EPH_PUB), _tn_group_point_len(group),
      hm + hn, hcap - hn);
    if (cken < 0) { return _tn_12_fail_pm(ctx, pm, cken); }
    tls_native_transcript_update(ts, hm + hn, cken);
    hn = hn + cken;
    var dk = tls_native_12_derive_keys(ctx, pm, pm_len);
    memset(pm, 0, _TN_EPH_MAX);                        # the master secret replaces it
    if (dk != TLS_OK) { return _tn_ctx_fail(ctx, dk); }
    if (creq == 1) {
        if (cscheme != 0) {
            # The CertificateVerify signs every handshake message before it (RFC 5246 §7.4.8) —
            # after the EMS session_hash, which ends at the ClientKeyExchange (RFC 7627 §3).
            var cvc = _tn_12_cv_content(ctx, load64(ctx + TLS_CTX_OFF_CH_BUF), load64(ctx + TLS_CTX_OFF_CH_LEN),
              fbuf, cf, hm, hn);
            if (cvc == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
            var cvn = _tn_12_build_cert_verify(ctx, cscheme, cvc,
              load64(ctx + TLS_CTX_OFF_CH_LEN) + cf + hn, hm + hn, hcap - hn);
            if (cvn < 0) { return _tn_ctx_fail(ctx, cvn); }
            tls_native_transcript_update(ts, hm + hn, cvn);
            hn = hn + cvn;
        }
    }
    var ckcap = hn + TLS_RECORD_HEADER_LEN * (1 + hn / _TLS_RECORD_MAX_PLAINTEXT);
    var ckerec = _tn_alloc(ctx, ckcap);
    if (ckerec == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var ckrn = _tn_hs_plain_records(hm, hn, ckerec, ckcap);
    if (ckrn < 0) { return _tn_ctx_fail(ctx, ckrn); }
    var ckw = _tn_io_write_all(ctx, sock_fd, ckerec, ckrn);
    if (ckw < 0) { return _tn_ctx_fail(ctx, ckw); }
    var ccs = _tn_alloc(ctx, 8);
    if (ccs == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var ccsn = tls_native_ccs_record_write(ccs);
    var ccw = _tn_io_write_all(ctx, sock_fd, ccs, ccsn);
    if (ccw < 0) { return _tn_ctx_fail(ctx, ccw); }
    # Our CCS is out: from here our alerts are sealed under the 1.2 write keys (_tn_send_fatal_alert).
    store64(ctx + TLS_CTX_OFF_CCS_STATE, load64(ctx + TLS_CTX_OFF_CCS_STATE) | 2);
    var fin = _tn_alloc(ctx, 64);
    if (fin == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var finn = tls_native_12_build_finished(ctx, "client finished", fin, 64);
    if (finn < 0) { return _tn_ctx_fail(ctx, finn); }
    var finrec = _tn_alloc(ctx, finn + 64);
    if (finrec == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var finreclen = tls_native_12_seal(ctx, TLS_CT_HANDSHAKE, fin, finn, finrec, finn + 64);
    if (finreclen < 0) { return _tn_ctx_fail(ctx, finreclen); }
    var fw = _tn_io_write_all(ctx, sock_fd, finrec, finreclen);
    if (fw < 0) { return _tn_ctx_fail(ctx, fw); }
    var srl = _tn_read_rec(ctx, sock_fd, inbuf, cap, _TN_CCS_MUST);
    if (srl < 0) { return _tn_read_fail(ctx, srl); }
    var pa_sfin = _tn_hs_plain_alert(ctx, inbuf, srl);
    if (pa_sfin != TLS_OK) { return pa_sfin; }
    var sfin = _tn_alloc(ctx, 64);
    if (sfin == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var sct = 0;
    var sfinlen = tls_native_12_open(ctx, inbuf, srl, sfin, 64, &sct);
    if (sfinlen < 0) { return _tn_ctx_fail(ctx, sfinlen); }
    var hx_sfin = _tn_hs_expect_ct(ctx, sct, TLS_CT_HANDSHAKE);
    if (hx_sfin != TLS_OK) { return hx_sfin; }
    var vr = tls_native_12_verify_finished(ctx, sfin, sfinlen, "server finished");
    if (vr != TLS_OK) { return _tn_ctx_fail(ctx, vr); }
    store64(ctx + TLS_CTX_OFF_STATE, TLS_STATE_CONNECTED);
    var cvr = _tn_connect_verify(ctx);   # CYRIUS-2026-0003: fail-closed chain + hostname
    if (cvr != TLS_OK) { return cvr; }
    return TLS_OK;
}

# Server-side TLS 1.2 handshake, given the already-read ClientHello
# message (`ch_msg`/`ch_len`). Loads creds, negotiates, sends the
# coalesced flight (SH+Cert+SKE+SHD), reads ClientKeyExchange, derives
# keys, verifies the client's sealed Finished, then sends its own
# ChangeCipherSpec + sealed Finished → CONNECTED. Returns TLS_OK or a
# negative TLS_ERR_*. Our ephemeral private key and the premaster are zeroised on the way out,
# whatever the outcome (_tn_wipe_ephemeral), as well as by the steps that use them.
# ⛔ 6.6.15 — WHY. Neither was ever zeroised: a server kept every connection's ephemeral key and
# premaster in its heap or arena until the memory was reused. CHANGELOG [6.6.15]
fn _tn_12_server_drive(ctx, sock_fd, ch_msg, ch_len): i64 {
    var rc = _tn_12_server_hs(ctx, sock_fd, ch_msg, ch_len);
    _tn_wipe_ephemeral(ctx);
    return rc;
}

fn _tn_12_server_hs(ctx, sock_fd, ch_msg, ch_len): i64 {
    store64(ctx + TLS_CTX_OFF_SOCK_FD, sock_fd);
    if (load64(ctx + TLS_CTX_OFF_CREDS_LOADED) != 1) {
        var lr = tls_native_server_load_creds(ctx);
        if (lr != TLS_OK) { return lr; }
    }
    var ht = 0;
    var blen = 0;
    if (tls_native_handshake_read_header(ch_msg, ch_len, &ht, &blen) < 0) {
        return _tn_ctx_fail(ctx, TLS_ERR_BAD_HANDSHAKE);
    }
    if (ht != TLS_HS_CLIENT_HELLO) { return _tn_ctx_fail(ctx, TLS_ERR_BAD_HANDSHAKE); }
    if (_TLS_HANDSHAKE_HEADER_LEN + blen > ch_len) { return _tn_ctx_fail(ctx, TLS_ERR_BAD_HANDSHAKE); }
    var chosen = _tn_12_parse_client_hello(ctx, ch_msg + _TLS_HANDSHAKE_HEADER_LEN, blen);
    if (chosen < 0) {
        _tn_send_hs_alert(ctx, sock_fd);
        return _tn_ctx_fail(ctx, chosen);
    }
    store64(ctx + TLS_CTX_OFF_VERSION, TLS_VERSION_1_2);
    var group = load64(ctx + TLS_CTX_OFF_GROUP);       # chosen from the client's supported_groups
    var srand = _tn_alloc(ctx, _TLS_RANDOM_LEN);
    if (srand == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    if (_tn_rand_bytes(srand, _TLS_RANDOM_LEN) != _TLS_RANDOM_LEN) {
        return _tn_ctx_fail(ctx, TLS_ERR_INTERNAL);
    }
    store64(ctx + TLS_CTX_OFF_SERVER_RANDOM, srand);
    var er = _tn_ephemeral_keygen(ctx, group);
    if (er != TLS_OK) { return _tn_ctx_fail(ctx, er); }
    var identity = load64(ctx + TLS_CTX_OFF_CIPHER);
    var ts = tls_native_transcript_init_in(load64(ctx + TLS_CTX_OFF_ALLOC), tls_native_cipher_hash_algo(identity));
    if (ts == 0) { return _tn_ctx_fail(ctx, TLS_ERR_INTERNAL); }
    store64(ctx + TLS_CTX_OFF_TRANSCRIPT, ts);
    tls_native_transcript_update(ts, ch_msg, _TLS_HANDSHAKE_HEADER_LEN + blen);
    var flight = _tn_alloc(ctx, 4096);
    if (flight == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var fl = tls_native_12_build_server_flight(ctx, flight, 4096);
    if (fl < 0) { return _tn_ctx_fail(ctx, fl); }
    var flrec = _tn_alloc(ctx, fl + TLS_RECORD_HEADER_LEN);
    if (flrec == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    tls_native_record_write_header(flrec, TLS_CT_HANDSHAKE, 0x0303, fl);
    memcpy(flrec + TLS_RECORD_HEADER_LEN, flight, fl);
    var flw = _tn_io_write_all(ctx, sock_fd, flrec, fl + TLS_RECORD_HEADER_LEN);
    if (flw < 0) { return _tn_ctx_fail(ctx, flw); }
    var cap = TLS_RECORD_MAX_CIPHERTEXT + TLS_RECORD_HEADER_LEN;
    var inbuf = _tn_alloc(ctx, cap);
    if (inbuf == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    # The client's flight before its CCS — [Certificate,] ClientKeyExchange [, CertificateVerify]
    # (RFC 5246 §7.3) — read one whole message at a time, however the client split its records.
    # The Certificate and CertificateVerify come only when we asked (6.6.14, CYRIUS-2026-0019): the three
    # messages are bounded at 16 KiB (the 1.3 server reads a client Certificate of at most 8 KiB),
    # which keeps an mTLS 1.2 handshake inside the 128 KiB arena an mTLS 1.3 one fits; without
    # client auth the flight is the 37-byte ClientKeyExchange alone.
    var mtls = 0;
    if (load64(ctx + TLS_CTX_OFF_VERIFY) != TLS_VERIFY_NONE) { mtls = 1; }
    var hcap = 512;
    if (mtls == 1) { hcap = _TLS_RECORD_MAX_PLAINTEXT; }
    var hb = _tn_alloc(ctx, hcap);
    if (hb == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var hlen = 0;
    var hpos = 0;
    var mt = 0;
    var mb = 0;
    if (mtls == 1) {
        var ccm = _tn_12_srv_next_msg(ctx, sock_fd, inbuf, cap, hb, hcap, &hlen, &hpos);
        if (ccm < 0) { return ccm; }
        var ccp = hb + hpos - ccm;
        tls_native_handshake_read_header(ccp, ccm, &mt, &mb);
        if (mt != TLS_HS_CERTIFICATE) { return _tn_ctx_fail(ctx, TLS_ERR_BAD_HANDSHAKE); }
        var ccr = _tn_12_srv_client_cert(ctx, sock_fd, ccp, ccm);
        if (ccr != TLS_OK) { return ccr; }
        tls_native_transcript_update(ts, ccp, ccm);
    }
    var cke_len = _tn_12_srv_next_msg(ctx, sock_fd, inbuf, cap, hb, hcap, &hlen, &hpos);
    if (cke_len < 0) { return cke_len; }
    var cke_msg = hb + hpos - cke_len;
    var cpl = _tn_group_point_len(group);
    var client_pub = _tn_alloc(ctx, cpl);
    if (client_pub == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var cr2 = _tn_12_parse_client_kex(cke_msg, cke_len, cpl, client_pub);
    if (cr2 != TLS_OK) {
        var cdesc = TLS_AD_DECODE_ERROR;
        if (cr2 == TLS_ERR_HANDSHAKE_FAILED) { cdesc = TLS_AD_ILLEGAL_PARAMETER; }
        _tn_send_fatal_alert(ctx, sock_fd, cdesc);
        return _tn_ctx_fail(ctx, cr2);
    }
    tls_native_transcript_update(ts, cke_msg, cke_len);
    var pm = _tn_alloc(ctx, _TN_EPH_MAX);
    if (pm == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    store64(ctx + TLS_CTX_OFF_SHARED, pm);
    var pr2 = tls_native_12_compute_premaster(ctx, client_pub, pm);
    _tn_wipe_priv(ctx);                                # its one use is behind us
    if (pr2 != TLS_OK) {
        # A point sigil refused (off the curve, a coordinate >= p) or a low-order x25519 key:
        # illegal_parameter (RFC 8422 §5.7). The premaster buffer was zeroed with the refusal.
        _tn_send_fatal_alert(ctx, sock_fd, TLS_AD_ILLEGAL_PARAMETER);
        return _tn_ctx_fail(ctx, pr2);
    }
    var dk = tls_native_12_derive_keys(ctx, pm, _tn_group_secret_len(group));
    memset(pm, 0, _TN_EPH_MAX);                        # the master secret replaces it
    if (dk != TLS_OK) { return _tn_ctx_fail(ctx, dk); }
    if (load64(ctx + TLS_CTX_OFF_CLIENT_CERT) != 0) {
        # A presented (and verified) certificate: its CertificateVerify signs every handshake
        # message before it — the ClientHello, our flight and the client's Certificate +
        # ClientKeyExchange (RFC 5246 §7.4.8).
        var cv_at = hpos;
        var cvm = _tn_12_srv_next_msg(ctx, sock_fd, inbuf, cap, hb, hcap, &hlen, &hpos);
        if (cvm < 0) { return cvm; }
        var cvp = hb + hpos - cvm;
        tls_native_handshake_read_header(cvp, cvm, &mt, &mb);
        if (mt != TLS_HS_CERTIFICATE_VERIFY) { return _tn_ctx_fail(ctx, TLS_ERR_BAD_HANDSHAKE); }
        var cvc = _tn_12_cv_content(ctx, ch_msg, _TLS_HANDSHAKE_HEADER_LEN + blen, flight, fl, hb, cv_at);
        if (cvc == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
        var cvr = _tn_12_srv_client_cv(ctx, sock_fd, cvp, cvm, cvc, _TLS_HANDSHAKE_HEADER_LEN + blen + fl + cv_at);
        if (cvr != TLS_OK) { return cvr; }
        tls_native_transcript_update(ts, cvp, cvm);
    }
    # Nothing may follow the flight before the CCS: a message we did not ask for (an unrequested
    # Certificate, a CertificateVerify with no certificate) is a protocol error.
    if (hpos != hlen) { return _tn_ctx_fail(ctx, TLS_ERR_BAD_HANDSHAKE); }
    var crl = _tn_read_rec(ctx, sock_fd, inbuf, cap, _TN_CCS_MUST);
    if (crl < 0) { return _tn_read_fail(ctx, crl); }
    var pa_cfin = _tn_hs_plain_alert(ctx, inbuf, crl);
    if (pa_cfin != TLS_OK) { return pa_cfin; }
    var cfin = _tn_alloc(ctx, 64);
    if (cfin == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var fct = 0;
    var cfinlen = tls_native_12_open(ctx, inbuf, crl, cfin, 64, &fct);
    if (cfinlen < 0) { return _tn_ctx_fail(ctx, cfinlen); }
    var hx_cfin = _tn_hs_expect_ct(ctx, fct, TLS_CT_HANDSHAKE);
    if (hx_cfin != TLS_OK) { return hx_cfin; }
    var vr = tls_native_12_verify_finished(ctx, cfin, cfinlen, "client finished");
    if (vr != TLS_OK) { return _tn_ctx_fail(ctx, vr); }
    var ccs = _tn_alloc(ctx, 8);
    if (ccs == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var ccsn = tls_native_ccs_record_write(ccs);
    var ccw = _tn_io_write_all(ctx, sock_fd, ccs, ccsn);
    if (ccw < 0) { return _tn_ctx_fail(ctx, ccw); }
    store64(ctx + TLS_CTX_OFF_CCS_STATE, load64(ctx + TLS_CTX_OFF_CCS_STATE) | 2);   # alerts sealed from here
    var fin = _tn_alloc(ctx, 64);
    if (fin == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var finn = tls_native_12_build_finished(ctx, "server finished", fin, 64);
    if (finn < 0) { return _tn_ctx_fail(ctx, finn); }
    var finrec = _tn_alloc(ctx, finn + 64);
    if (finrec == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var finreclen = tls_native_12_seal(ctx, TLS_CT_HANDSHAKE, fin, finn, finrec, finn + 64);
    if (finreclen < 0) { return _tn_ctx_fail(ctx, finreclen); }
    var fw = _tn_io_write_all(ctx, sock_fd, finrec, finreclen);
    if (fw < 0) { return _tn_ctx_fail(ctx, fw); }
    return _tn_server_connected(ctx);
}

# Server-side TLS 1.2 handshake driver: read the ClientHello record,
# then drive the 1.2 server handshake. Public entry for a 1.2-only
# server; tls_native_accept auto-routes here when the ClientHello does
# not offer 1.3. Returns TLS_OK or a negative TLS_ERR_*.
fn tls_native_accept_12(ctx, sock_fd): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    var cap = TLS_RECORD_MAX_CIPHERTEXT + TLS_RECORD_HEADER_LEN;
    var inbuf = _tn_alloc(ctx, cap);
    if (inbuf == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    var rl = _tn_read_rec(ctx, sock_fd, inbuf, cap, _TN_CCS_REFUSE);
    if (rl < 0) { return _tn_read_fail(ctx, rl); }
    var hx_rec = _tn_hs_expect_ct(ctx, load8(inbuf) & 0xFF, TLS_CT_HANDSHAKE);
    if (hx_rec != TLS_OK) { return hx_rec; }
    return _tn_12_server_drive(ctx, sock_fd, inbuf + TLS_RECORD_HEADER_LEN, rl - TLS_RECORD_HEADER_LEN);
}

# Derive + install the server and client handshake-traffic key/IV from
# the key schedule, and reset both direction sequence numbers. Call
# after the handshake secret is derived (.18).
fn tls_native_server_install_handshake_keys(ctx): i64 {
    # The two handshake-traffic secrets the keys derive from are `secret var`s, zeroised on every
    # return (they were _tn_alloc copies abandoned un-wiped). CHANGELOG [6.7.18]
    secret var ss_b[_TLS_MAX_DIGEST_LEN];
    secret var cs_b[_TLS_MAX_DIGEST_LEN];
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    var ks = load64(ctx + TLS_CTX_OFF_KEYSCHED);
    if (ks == 0) { return _tn_ctx_fail(ctx, TLS_ERR_PROTOCOL); }
    var cipher = load64(ctx + TLS_CTX_OFF_CIPHER);
    var hash_algo = tls_native_cipher_hash_algo(cipher);
    var key_len = tls_native_cipher_key_len(cipher);
    var iv_len = tls_native_cipher_iv_len(cipher);
    var hlen = _tn_hash_len(hash_algo);
    var ss = &ss_b;
    if (tls_native_keysched_get_secret(ks, TLS_KS_SERVER_HANDSHAKE, ss) < 0) {
        return _tn_ctx_fail(ctx, TLS_ERR_PROTOCOL);
    }
    var sk = _tn_alloc(ctx, key_len);
    var siv = _tn_alloc(ctx, iv_len);
    if (sk == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    if (siv == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    tls_native_derive_key(ss, hlen, hash_algo, sk, key_len);
    tls_native_derive_iv(ss, hlen, hash_algo, siv, iv_len);
    store64(ctx + TLS_CTX_OFF_SRV_HS_KEY, sk);
    store64(ctx + TLS_CTX_OFF_SRV_HS_IV, siv);
    var cs = &cs_b;
    if (tls_native_keysched_get_secret(ks, TLS_KS_CLIENT_HANDSHAKE, cs) < 0) {
        return _tn_ctx_fail(ctx, TLS_ERR_PROTOCOL);
    }
    var ck = _tn_alloc(ctx, key_len);
    var civ = _tn_alloc(ctx, iv_len);
    if (ck == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    if (civ == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    tls_native_derive_key(cs, hlen, hash_algo, ck, key_len);
    tls_native_derive_iv(cs, hlen, hash_algo, civ, iv_len);
    store64(ctx + TLS_CTX_OFF_CLI_HS_KEY, ck);
    store64(ctx + TLS_CTX_OFF_CLI_HS_IV, civ);
    tls_native_seq_init(ctx + TLS_CTX_OFF_SRV_SEQ);
    tls_native_seq_init(ctx + TLS_CTX_OFF_CLI_SEQ);
    return TLS_OK;
}

# Seal a server handshake message into a protected record using the
# installed server handshake-traffic key (inner content type =
# handshake). Returns the record length.
fn tls_native_server_seal_handshake(ctx, inner, inner_len, out, out_max): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    var key = load64(ctx + TLS_CTX_OFF_SRV_HS_KEY);
    var iv = load64(ctx + TLS_CTX_OFF_SRV_HS_IV);
    if (key == 0) { return _tn_ctx_fail(ctx, TLS_ERR_PROTOCOL); }
    return tls_native_record_seal(load64(ctx + TLS_CTX_OFF_CIPHER), key, iv,
      ctx + TLS_CTX_OFF_SRV_SEQ, TLS_CT_HANDSHAKE,
      inner, inner_len, out, out_max);
}

# Open a protected record from the client using the installed client
# handshake-traffic key. Returns the content length + inner type.
fn tls_native_server_open_handshake(ctx, record, record_len, out, out_max, out_ct): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    var key = load64(ctx + TLS_CTX_OFF_CLI_HS_KEY);
    var iv = load64(ctx + TLS_CTX_OFF_CLI_HS_IV);
    if (key == 0) { return _tn_ctx_fail(ctx, TLS_ERR_PROTOCOL); }
    return tls_native_record_open(load64(ctx + TLS_CTX_OFF_CIPHER), key, iv,
      ctx + TLS_CTX_OFF_CLI_SEQ, record, record_len,
      out, out_max, out_ct);
}

# Set the ALPN protocol list. `protos` is a series of length-prefixed
# protocol identifiers (e.g. for HTTP/1.1 + HTTP/2:
# "\x08http/1.1\x02h2", protos_len = 13). Returns TLS_OK on success,
# TLS_ERR_INVALID_PARAM on malformed input.
fn tls_native_set_alpn(ctx, protos, protos_len): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    if (protos == 0) { return TLS_ERR_INVALID_PARAM; }
    if (protos_len <= 0) { return TLS_ERR_INVALID_PARAM; }
    if (protos_len > 255) { return TLS_ERR_INVALID_PARAM; }   # one CH record's worth
    # Store a length-prefixed copy [be16 protos_len][protos] so the CH builder
    # can emit it without re-counting. The protos bytes are the wire-format
    # ProtocolNameList contents (1-byte-len-prefixed protocol names).
    var buf = _tn_alloc(ctx, 2 + protos_len);
    if (buf == 0) { return _tn_ctx_fail(ctx, TLS_ERR_OOM); }
    _tn_be16_w(buf, protos_len);
    memcpy(buf + 2, protos, protos_len);
    store64(ctx + TLS_CTX_OFF_ALPN_OFFER, buf);
    return TLS_OK;
}

# Store a server-sent ALPN extension body's protocol (RFC 7301 §3.1: a 2-byte
# ProtocolNameList length, then exactly ONE 1-byte-len-prefixed protocol) on
# the ctx as [u8 len][proto]. `ext_data` points at the extension_data;
# `ext_len` is its length. A body that is not exactly one well-formed name
# (_tn_alpn_answer_ok) stores nothing — the client refuses it first
# (_tn_client_alpn_answer, decode_error); 6.7.12 stored the first name of a
# list of two. Returns TLS_OK always. CHANGELOG [6.7.14]
fn _tn_store_alpn_selected(ctx, ext_data, ext_len): i64 {
    if (_tn_alpn_answer_ok(ext_data, ext_len) != 1) { return TLS_OK; }
    var plen = load8(ext_data + 2) & 0xFF;
    var sel = _tn_alloc(ctx, 1 + plen);
    if (sel == 0) { return TLS_OK; }
    store8(sel, plen);
    memcpy(sel + 1, ext_data + 3, plen);
    store64(ctx + TLS_CTX_OFF_ALPN_SEL, sel);
    return TLS_OK;
}

# Set the peer-cert verification mode (see TlsVerifyMode). Default
# for clients is TLS_VERIFY_PEER; for servers it's TLS_VERIFY_NONE
# (i.e. don't request a client cert). On the server path the mode
# steers the state machine: anything other than TLS_VERIFY_NONE makes
# RECV_CH transition into WAIT_CLIENT_FLIGHT2 (request a client cert).
fn tls_native_set_verify(ctx, mode): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    if (mode != TLS_VERIFY_NONE) {
        if (mode != TLS_VERIFY_PEER) {
            if (mode != TLS_VERIFY_FAIL_IF_NO_PEER_CERT) {
                return TLS_ERR_INVALID_PARAM;
            }
        }
    }
    store64(ctx + TLS_CTX_OFF_VERIFY, mode);
    return TLS_OK;
}

# Set the CA bundle used for peer-cert verification. `pem_bundle` is
# a concatenated PEM file (or DER if `is_der != 0`); each cert in the
# bundle is treated as a trust root. Defaults to the system bundle
# (Linux: /etc/ssl/certs/ca-certificates.crt or platform equivalent; Windows: the
# CurrentUser ROOT store, 6.6.14).
# CA_ROOT holds a trust-anchor SET: a ptr to [count][root0 ptr]...[rootN-1 ptr].
# (.78: was a single root; now a set so system bundles + multi-root PEM work.)
# TLS_CA_MAX_ROOTS bounds nothing: a trust bundle's chain scratch is sized from its own block count
# (6.6.13, _tn_ca_parse_set) and so is a client certificate's leaf decode (6.7.9,
# tls_native_set_client_cert). The public name is kept (the user's decision D15, 2026-10-15), so a
# program that reads or assigns it still compiles, and a write changes nothing. CHANGELOG [6.7.9] [6.7.12]
var TLS_CA_MAX_ROOTS = 300;

# Parse a trust bundle into a root set [count][root ptrs...] — the layout verify_chain reads.
# Every allocation comes from Allocator `alc` (0 = the global heap) and sigil's per-cert scratch
# from the raw arena `arena` (0 = the global heap), so a ctx's roots live and die with the ctx.
# PEM (`is_der == 0`): every block is decoded and parsed; a block sigil cannot decode (an
# unmatched BEGIN, bad base64) or parse (today: a P-521 root) is SKIPPED, not fatal. DER: one
# certificate. Writes the skipped count through `out_skipped` (blocks not installed:
# blocks - stored; 0 for a DER cert that parsed). Returns the set, or a negative TLS_ERR_*:
# CERT_INVALID when nothing installs (the count is written first), OOM, INVALID_PARAM.
# ⛔ 6.6.13 — WHY THIS EXISTS. The loop lived inline in tls_native_set_ca_bundle, which counted
# successes only: on Arch's /etc/ssl/cert.pem 8 of 121 roots were dropped (1 since sigil 3.13.6)
# with no count anywhere, and a server chaining to one failed CERT_INVALID with nothing pointing
# at the store. It also took a fixed 300-entry chain scratch (a bundle with more blocks failed
# whole), a global x509_cert_alloc per block (failures included) and pem_decode_certs' global
# pool. Issue 2026-09-30-tls-client-memory-and-alert-gaps (e); CHANGELOG [6.6.13].
fn _tn_ca_parse_set(arena, alc, pem, len, is_der, out_skipped): i64 {
    store64(out_skipped, 0);
    if (pem == 0) { return TLS_ERR_INVALID_PARAM; }
    if (len <= 0) { return TLS_ERR_INVALID_PARAM; }
    if (is_der != 0) {
        var root = x509_cert_alloc_into(arena);
        if (root == 0) { return TLS_ERR_OOM; }
        if (x509_parse_into(pem, len, root, arena) != 1) {
            store64(out_skipped, 1);
            return TLS_ERR_CERT_INVALID;
        }
        var set1 = _tn_alloc_a(alc, 16);
        if (set1 == 0) { return TLS_ERR_OOM; }
        store64(set1, 1);
        store64(set1 + 8, root);
        return set1;
    }
    # The BEGIN markers sigil's bundle walk visits: decoded + skipped == blocks (sigil 3.13.7).
    var blocks = pem_count_cert_blocks(pem, len);
    if (blocks < 1) { return TLS_ERR_CERT_INVALID; }
    var chain = _tn_alloc_a(alc, blocks * 16);
    if (chain == 0) { return TLS_ERR_OOM; }
    var pool = _tn_alloc_a(alc, len);   # DER <= 3/4 of its base64; the bundle bounds the pool
    if (pool == 0) { return TLS_ERR_OOM; }
    # ⛔ 6.6.14 — the LENIENT decode: a malformed block (an unmatched BEGIN, bad base64) is
    # skipped and the rest decode. The strict pem_decode_certs_into failed the whole bundle on
    # one, so one corrupt block in an OS store installed ZERO roots. Sized as above, the decode
    # cannot run out of room, so n < 1 means every block was malformed. Its own skipped count is
    # not needed (out_skipped 0): decoded + skipped == blocks, so blocks - stored below counts the
    # decode's skips and the parse's together. CHANGELOG [6.6.14] (sigil 3.13.7).
    var n = pem_decode_certs_lenient_into(pem, len, chain, blocks, pool, len, 0);
    if (n < 1) {
        store64(out_skipped, blocks);
        return TLS_ERR_CERT_INVALID;
    }
    var set = _tn_alloc_a(alc, 8 + n * 8);
    if (set == 0) { return TLS_ERR_OOM; }
    var i = 0;
    var stored = 0;
    var r = 0;                          # the next cert: allocated only after a success used one
    while (i < n) {
        if (r == 0) { r = x509_cert_alloc_into(arena); }
        if (r == 0) { return TLS_ERR_OOM; }
        if (x509_parse_into(load64(chain + i * 16), load64(chain + i * 16 + 8), r, arena) == 1) {
            store64(set + 8 + stored * 8, r);
            stored = stored + 1;
            r = 0;
        }
        i = i + 1;
    }
    store64(out_skipped, blocks - stored);   # decode-skipped (bad) + parse-skipped (n - stored)
    if (stored < 1) { return TLS_ERR_CERT_INVALID; }
    store64(set, stored);
    return set;
}

# Install the trust-root set from a PEM (or DER, is_der != 0) bundle — see the block above. Parsed
# through the ctx's allocator (tls_native_set_alloc / an `_in` constructor), so an arena-backed
# ctx's roots are reclaimed with its arena. Records the skipped count for tls_native_ca_skipped —
# also when nothing installs (TLS_ERR_CERT_INVALID; the ctx keeps any set it already had).
fn tls_native_set_ca_bundle(ctx, pem_bundle, bundle_len, is_der): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    if (pem_bundle == 0) { return TLS_ERR_INVALID_PARAM; }
    if (bundle_len <= 0) { return TLS_ERR_INVALID_PARAM; }
    var skipped = 0;
    var set = _tn_ca_parse_set(_tn_arena(ctx), load64(ctx + TLS_CTX_OFF_ALLOC), pem_bundle,
      bundle_len, is_der, &skipped);
    if (set == TLS_ERR_OOM) { return TLS_ERR_OOM; }
    store64(ctx + TLS_CTX_OFF_CA_SKIPPED, skipped);
    if (set < 0) { return set; }
    store64(ctx + TLS_CTX_OFF_CA_ROOT, set);
    store64(ctx + TLS_CTX_OFF_CA_POLICY, 0);    # a caller's bundle: no system trust policy (6.7.12)
    return TLS_OK;
}

# 6.6.13 — how many certificate blocks the ctx's most recent trust-root install could not use:
# tls_native_set_ca_bundle / tls_native_set_ca_system / tls_ctx_load_verify_locations. After a
# successful install, installed + skipped == the bundle's PEM block count; a server chaining to a
# skipped root fails TLS_ERR_CERT_INVALID, and this is the count that points at the store (on
# Arch's /etc/ssl/cert.pem: 1, the e-Szigno P-521 root, a curve sigil does not have). Since 6.6.14
# (sigil 3.13.7) a malformed block — an unmatched BEGIN, bad base64 — is counted here too and the
# rest of the bundle installs; it used to fail the whole install. After an
# install that failed TLS_ERR_CERT_INVALID it is that bundle's count (every block). Returns >= 0;
# 0 before any install; TLS_ERR_INVALID_PARAM for ctx == 0.
# Windows' system store (6.6.14) also counts the roots it refuses — a Disable date covering TLS or
# root-program name constraints, which the native verifier cannot apply, or a property it cannot read
# (cass: 6; a NotBefore date no longer refuses a root since 6.7.12 — it bounds it) — and any root that
# did not fit the 1 MiB bundle: installed + skipped == the store's TLS roots (`_tn_ca_sys_refused`).
# Issue 2026-09-30-tls-client-memory-and-alert-gaps (e); CHANGELOG [6.6.13], [6.6.14].
fn tls_native_ca_skipped(ctx): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    return load64(ctx + TLS_CTX_OFF_CA_SKIPPED);
}

# Load the OS trust store — a single concatenated-PEM CA bundle — as the ctx's
# trust anchors. Tries the standard bundle locations across distros + macOS
# (the path is NOT the same everywhere: Debian/Ubuntu use
# /etc/ssl/certs/ca-certificates.crt, RHEL/Fedora /etc/pki/..., macOS/Arch
# /etc/ssl/cert.pem). Windows reads none of them (drive-relative there — CYRIUS-2026-0020) and
# exports its CurrentUser ROOT store as the bundle instead (_tn_ca_read_win, 6.6.14).
# Returns TLS_OK, TLS_ERR_IO if no bundle is readable, or a parse error.
# v6.5.36 — the bundle is read and allocated ONCE per process, not per call.
#
# ⛔ WHAT WAS WRONG: this did `alloc(1048576)` on EVERY call and cached nothing, and
# `lib/tls.cyr:316` (`_tls_native_alloc`) calls it on EVERY native-backend connect. On this
# no-free bump allocator that is **exactly 1,048,576 bytes of permanently-retained heap per
# TLS connection** — measured on a real AGNOS kernel at 6.5.35, and present unchanged in
# every snapshot back to 6.2.23. A long-lived client leaked a megabyte per connect.
#
# The bundle is a file on disk that does not change under a running process, so the read and
# the buffer are both cacheable — and so is the parse (6.6.13, below).
#
# ⚠ THE FAILURE IS CACHED TOO, DELIBERATELY. `_tn_ca_len == -1` means "we looked and there is
# no readable bundle", which is a different state from "not looked yet" (0). Without that, a
# machine with no trust store re-walks all four candidate paths on every single connect —
# four failed opens per connect, forever.
#
# ⛔ 6.6.13 — THE CACHE IS PUBLISHED ONCE, 0 -> 1 -> 2 (`_tn_ca_state`). It was check-then-set
# on `_tn_ca_len`, published as two plain stores (`_tn_ca_buf`, then `_tn_ca_len`). Threads whose
# first connects overlapped each saw 0, each allocated a megabyte and read the file (8 racers
# made 7-8 loads on x86, 2-7 on aarch64), and on aarch64 nothing ordered the pointer and the
# bytes before the length, so a reader could see a length with no bundle behind it. Now ONE
# thread claims (0 -> 1) and loads, every other caller waits for 2, and on aarch64 the publish
# and the read of it are fenced.
# `_tn_ca_buf` / `_tn_ca_len` are DATA, valid only once the state reads 2.
# Issue 2026-09-30-tls-first-use-thread-race; CHANGELOG [6.6.13].
#
# ⛔ 6.6.13 — ONE ROOT SET PER PROCESS, SHARED BY EVERY CTX (`_tn_ca_sys_set`). The bytes were
# cached but every ctx re-parsed them: 271,888 B of no-free heap per call on Arch's 121-block
# store, and _tls_native_alloc made that call on EVERY native connect. The claim holder now parses
# the bundle ONCE, onto the GLOBAL heap — never through a caller's allocator, because the set must
# outlive any arena's reset_via — and publishes it with the bytes, under the same 0 -> 1 -> 2
# state; tls_native_set_ca_system then stores the pointer and allocates nothing. The set is
# IMMUTABLE: verify_chain and sigil's _x509_verify_link only read a root, and a later install
# (set_ca_bundle, load_verify_locations) replaces the ctx's pointer, never the set it points at.
# Issue 2026-09-30-tls-client-memory-and-alert-gaps (b); CHANGELOG [6.6.13].
var _tn_ca_state = 0;    # 0 = not loaded · 1 = one thread loading · 2 = published
var _tn_ca_buf = 0;      # cached bundle bytes                              } valid only
var _tn_ca_len = 0;      # >0 = bytes · -1 = looked, none readable (cached) } at state 2
var _tn_ca_sys_set = 0;      # the shared root set [count][roots...], or a negative TLS_ERR_* } valid only
var _tn_ca_sys_skipped = 0;  # blocks of the bundle the set could not use                    } at state 2
# Windows (6.6.14): store roots refused by policy (see _tn_w_policy) or that did not fit the buffer —
# not in the bundle, counted into `_tn_ca_sys_skipped`. Always 0 elsewhere.
# Written by the claim holder only, in _tn_ca_read_win. CHANGELOG [6.6.14]
var _tn_ca_sys_refused = 0;
# 6.7.12: the set's trust policy (_tn_pol_new; Windows only, 0 elsewhere) — published with the set, at
# state 2, and installed with it. CHANGELOG [6.7.12]
var _tn_ca_sys_pol = 0;
# ⛔ CYRIUS-2026-0027 — THE STORE'S PURPOSE IS THE CHAIN'S PURPOSE. The set above is the system roots
# trusted for SERVER authentication, which a CLIENT ctx anchors a server chain to. A SERVER ctx
# anchors CLIENT chains (mTLS, _TN_PURPOSE_CLIENT), and Windows records per root which purposes
# its root program trusts it for (CERT_ENHKEY_USAGE_PROP_ID): tls_native_set_ca_system gave an
# mTLS server the serverAuth export, so a root Windows trusts for server authentication only
# anchored client identities — the trust-store half of CYRIUS-2026-0026, which enforces a CA CERTIFICATE's
# own extendedKeyUsage. Windows now exports a second set for a server ctx, filtered for
# clientAuth by the same rules (_tn_w_policy), cached and published exactly like the first. A
# POSIX bundle carries no per-root purpose (it is the distro's serverAuth export), so both roles
# share the set above there. Same publish protocol and validity rules as the five above.
var _tn_ca_cl_state = 0;
var _tn_ca_cl_buf = 0;
var _tn_ca_cl_len = 0;
var _tn_ca_cl_set = 0;
var _tn_ca_cl_skipped = 0;
var _tn_ca_cl_refused = 0;
var _tn_ca_cl_pol = 0;

# Load and parse the bundle once per process: returns TLS_OK once `_tn_ca_buf`/`_tn_ca_len` and
# the shared root set are published (a cached "none readable" and a cached unusable bundle
# included), or TLS_ERR_OOM, which is NOT cached — the claim is rolled back to 0 so a later caller
# tries again. Safe from any thread.
fn _tn_ca_load(): i64 {
    return _tn_ca_load_into(&_tn_ca_state, &_tn_ca_buf, &_tn_ca_len, &_tn_ca_sys_set,
      &_tn_ca_sys_skipped, &_tn_ca_sys_refused, &_tn_ca_sys_pol, _TN_PURPOSE_SERVER);
}

# _tn_ca_load for the CLIENT-purpose set a Windows server ctx installs (the `_tn_ca_cl_*` cells).
fn _tn_ca_load_client(): i64 {
    return _tn_ca_load_into(&_tn_ca_cl_state, &_tn_ca_cl_buf, &_tn_ca_cl_len, &_tn_ca_cl_set,
      &_tn_ca_cl_skipped, &_tn_ca_cl_refused, &_tn_ca_cl_pol, _TN_PURPOSE_CLIENT);
}

# The once-per-process load behind both: the cells are the state, the bundle bytes and length, the
# set, its skipped count, the store's refused count and the set's trust policy, for roots trusted
# for `purpose`.
# ⚠ Nothing between the claim and the publish may `return`: the state would stay 1 and every later
# connect would spin forever. The build lives in `_tn_ca_read` and `_tn_ca_parse_set`; the only
# exits here are the two OOM rollbacks, each of which releases the claim itself.
fn _tn_ca_load_into(st, pbuf, plen, pset, pskip, pref, ppol, purpose): i64 {
    var s = atomic_load(st);
    while (s != 2) {
        if (s == 0) {
            if (atomic_cas(st, 0, 1) == 1) {
                var cap = 1048576;              # 1 MiB; system bundles are ~250 KB
                var buf = alloc(cap);
                if (buf == 0) {
                    atomic_store(st, 0);
                    return TLS_ERR_OOM;
                }
                var pol = 0;
                var total = _tn_ca_read(buf, cap, pref, &pol, purpose);
                var set = 0;
                var skipped = 0;
                if (total > 0) {
                    # Global heap (arena 0, allocator 0): the set outlives every ctx that shares it.
                    set = _tn_ca_parse_set(0, 0, buf, total, 0, &skipped);
                    if (set == TLS_ERR_OOM) {
                        atomic_store(st, 0);
                        return TLS_ERR_OOM;
                    }
                }
                store64(pbuf, buf);
                store64(plen, total);
                store64(pset, set);
                store64(pskip, skipped + load64(pref));
                store64(ppol, pol);
                # Release half: the bytes, the set, the pointer and the length before the 2. aarch64 only
                # — x86 (TSO) keeps store order, so a fence there is pure tax (lib/freelist.cyr).
                #ifdef CYRIUS_ARCH_AARCH64
                atomic_fence();
                #endif
                atomic_store(st, 2);
                return TLS_OK;
            }
        }
        s = atomic_load(st);
    }
    # Acquire half: on aarch64 the loads of the bundle cells, the set and the bytes behind them must
    # not be satisfied before the state load that saw 2. x86 (TSO) never reorders loads.
    #ifdef CYRIUS_ARCH_AARCH64
    atomic_fence();
    #endif
    return TLS_OK;
}

# Install the platform's system CA bundle — the process-wide root set, parsed once (see the block
# above): after the first call this stores a pointer and allocates nothing, from the global heap or
# the ctx's allocator. Records the set's skipped count for tls_native_ca_skipped. A bundle with no
# usable root is TLS_ERR_CERT_INVALID every time (the ctx keeps any set it had), as
# tls_native_set_ca_bundle answers it. A SERVER ctx (it verifies client chains) gets, on Windows,
# the roots the store trusts for client authentication (CYRIUS-2026-0027, above); a client ctx, and
# every ctx elsewhere, the roots trusted for server authentication.
fn tls_native_set_ca_system(ctx): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    #ifdef CYRIUS_TARGET_WIN
    if (load64(ctx + TLS_CTX_OFF_ROLE) == TLS_ROLE_SERVER) {
        var cr = _tn_ca_load_client();
        if (cr != TLS_OK) { return cr; }
        return _tn_ca_install(ctx, _tn_ca_cl_len, _tn_ca_cl_set, _tn_ca_cl_skipped, _tn_ca_cl_pol);
    }
    #endif
    var lr = _tn_ca_load();
    if (lr != TLS_OK) { return lr; }
    return _tn_ca_install(ctx, _tn_ca_len, _tn_ca_sys_set, _tn_ca_sys_skipped, _tn_ca_sys_pol);
}

# Store a published system set on `ctx`, with its trust policy `pol` (0 = none): `len` < 0 is no
# bundle (TLS_ERR_IO), a negative `set` an unusable one; `skipped` goes to tls_native_ca_skipped
# either way.
fn _tn_ca_install(ctx, len, set, skipped, pol): i64 {
    if (len < 0) {
        # No bundle. On Windows that includes a store whose every TLS root was refused: report those
        # through tls_native_ca_skipped, or the reason the ctx has no roots is invisible. CHANGELOG [6.6.14]
        if (skipped > 0) { store64(ctx + TLS_CTX_OFF_CA_SKIPPED, skipped); }
        return TLS_ERR_IO;
    }
    store64(ctx + TLS_CTX_OFF_CA_SKIPPED, skipped);
    if (set < 0) { return set; }
    store64(ctx + TLS_CTX_OFF_CA_ROOT, set);
    store64(ctx + TLS_CTX_OFF_CA_POLICY, pol);
    return TLS_OK;
}

# Read the first readable system bundle into `buf` (`cap` bytes). Returns the byte count, or -1
# when no candidate is readable (the caller caches that). Called only by the claim holder. `refused`
# receives the roots the store refused (Windows; 0 elsewhere), `ppol` the set's trust policy
# (Windows; 0 elsewhere — a POSIX bundle is a list of roots and nothing more), `purpose` the
# TlsChainPurpose the roots must be trusted for — a POSIX bundle has no per-root purpose, so it is
# read the same for both.
# ⛔ CYRIUS-2026-0020 (6.6.14) — NEVER THE POSIX PATHS ON WINDOWS. There a rooted path is DRIVE-RELATIVE:
# "/etc/ssl/cert.pem" is C:\etc\ssl\cert.pem, and any authenticated user may create folders at the
# root of the system drive, so one local user could plant trust anchors every native TLS client on
# the box then trusted (measured on cass: a planted cert.pem installed as the only root). Windows
# reads its own store instead (_tn_ca_read_win) — CYRIUS-2026-0012 / CYRIUS-2026-0014's class. CHANGELOG [6.6.14]
fn _tn_ca_read(buf, cap, refused, ppol, purpose): i64 {
    store64(refused, 0);
    store64(ppol, 0);
    #ifdef CYRIUS_TARGET_WIN
    var w = _tn_ca_read_win(buf, cap, refused, ppol, purpose);
    return w;
    #endif
    #ifndef CYRIUS_TARGET_WIN
    # v6.2.23: open through io.cyr's `file_open` per-target bridge, NOT raw
    # `sys_open`. On CYRIUS_TARGET_AGNOS sys_open is (name, namelen, flags) —
    # a raw `sys_open(path, 0, 0)` reads the `0` as namelen=0, opens a
    # zero-length filename, fails every candidate, and the ctx is built with
    # zero roots (the failure is then swallowed by `_tls_native_alloc`, which
    # ignores this fn's return — see 2026-06-18-tls-native-set-ca-system-agnos-
    # sys-open-abi.md). `file_open` computes strlen + maps O_*→AO_* on agnos and
    # passes (path, O_RDONLY, mode) straight through on Linux/macOS.
    var fd = file_open("/etc/ssl/cert.pem", 0, 0);                          # macOS, Arch
    if (fd < 0) { fd = file_open("/etc/ssl/certs/ca-certificates.crt", 0, 0); }   # Debian/Ubuntu
    if (fd < 0) { fd = file_open("/etc/pki/tls/certs/ca-bundle.crt", 0, 0); }     # RHEL/Fedora
    if (fd < 0) { fd = file_open("/etc/ssl/ca-bundle.pem", 0, 0); }               # openSUSE
    if (fd < 0) { return 0 - 1; }
    var total = 0;
    var rdone = 0;
    while (rdone == 0) {
        var r = sys_read(fd, buf + total, cap - total);
        if (r > 0) { total = total + r; }
        if (r <= 0) { rdone = 1; }
        if (total >= cap) { rdone = 1; }
    }
    sys_close(fd);
    if (total <= 0) { return 0 - 1; }
    return total;
    #endif
}

#ifdef CYRIUS_TARGET_WIN
# ⛔ CYRIUS-2026-0020 (6.6.14) — THE WINDOWS SYSTEM STORE. Before it Windows had no system roots at all (the
# POSIX paths were its only source), so every verifying native connect there failed.
#
# WHICH STORE: CurrentUser\ROOT, opened read-only. It is the store the current-user chain engine
# anchors to — the one Windows' own TLS (SChannel, WinHTTP) verifies a server against in a user's
# process — and it is a LOGICAL store that already holds LocalMachine\ROOT, the third-party
# (AuthRoot) roots and Group Policy / Enterprise roots (measured on cass: CurrentUser\ROOT 59 ⊇
# LocalMachine\ROOT 59 ⊇ AuthRoot 47).
# ⛔ 6.7.12 — THE ProtectedRoots POLICY IS APPLIED BY THAT OPEN, NOT HERE. crypt32 reads `Flags` under
# HKLM\SOFTWARE\Policies\Microsoft\SystemCertificates\Root\ProtectedRoots when the logical store is
# opened and builds it from the physical stores the policy leaves (CERT_PROT_ROOT_DISABLE_CURRENT_USER_FLAG,
# 1, drops the user's own .Default store). Measured on cass: Flags = 8 took CurrentUser\ROOT from 59 roots
# to 12 at the next open; the same value under HKLM\SOFTWARE\Microsoft\...\Root\ProtectedRoots changed
# nothing — Windows reads only the Policies key. So this export already follows the policy exactly as
# the chain engine does; reading the flags here and opening LocalMachine stores instead could only
# diverge from it. Issue 2026-10-08-windows-trust-store-parity-gaps (1); CHANGELOG [6.7.12]
# WHICH ROOTS: the ones the root's own properties and the Disallowed store say Windows trusts for TLS
# server authentication — the policy only ever REMOVES roots, and anything it cannot judge is refused.
# (A server ctx's set asks the same of CLIENT authentication — every "serverAuth" below reads
# "clientAuth" for it; CYRIUS-2026-0027 at `_tn_ca_cl_state`.)
#   - a root whose root-program purposes (CERT_ENHKEY_USAGE_PROP_ID) leave out serverAuth is not a
#     TLS anchor (cass: 6, e.g. Thawte Timestamping CA) — the analogue of the Mozilla trust bits the
#     POSIX bundles are already filtered by;
#   - the root program distrusts by DATE two ways, each scoped by a purpose list (absent = every
#     purpose): a DISABLE date (CERT_DISALLOWED_FILETIME_PROP_ID 104, scope 122), after which the root
#     is not trusted at all, and a NOTBEFORE date (CERT_NOT_BEFORE_FILETIME_PROP_ID 126, scope 127),
#     after which the certificates it issues are not. A root with a Disable date covering serverAuth is
#     REFUSED whole — the verifier has no clock-dependent root set, so it fails closed (cass: StartCom,
#     DST Root CA X3, AddTrust, QuoVadis, Baltimore, VeriSign G5). A root with a NotBefore date
#     covering serverAuth is TAKEN WITH AN ISSUANCE BOUND (6.7.12, D9): it anchors only a leaf whose
#     notBefore precedes the date, as SChannel does (cass: the three Entrust roots, SecureTrust CA,
#     Certum CA, Class 3 PCA — refused whole before 6.7.12, so a leaf they issued earlier failed here);
#     the bound rides the set's trust policy (_tn_pol_anchor_ok). A date that is not a FILETIME, or a
#     scope that cannot be read, still refuses the root. Refused roots, and any that would not fit
#     `cap`, are counted in tls_native_ca_skipped (`_tn_ca_sys_refused`);
#   - a root carrying root-program NAME CONSTRAINTS (CERT_ROOT_PROGRAM_NAME_CONSTRAINTS_PROP_ID 84)
#     is refused the same way: Windows confines it to the names listed, the verifier has no per-root
#     name constraint (none on cass today);
#   - a certificate in the Disallowed store is never a root (Windows' explicit distrust); a Disallowed
#     store that cannot be opened makes the whole store unusable rather than unfiltered;
#   - 6.7.12: the auto-updated disallowed CTL (HKLM ...\AuthRoot\AutoUpdate\DisallowedCertEncodedCtl,
#     _tn_w_ctl_keys) is read too, and with the Disallowed store it binds EVERY certificate of a path,
#     not only roots: the set's trust policy (_tn_pol_new) carries the CTL's public-key entries and the
#     store's certificates, and _tn_verify_chain refuses a leaf, and skips a CA, that either names; a
#     root either names is not exported. A CTL value that is present but cannot be read or parsed makes
#     the whole store unusable, as the Disallowed store does; an absent one (wine) is an empty list.
#     The CTL's identifiers are not certificate hashes but crypt32's two distrust keys (_TN_POL_LEN):
#     a 16-byte entry (82 of 88 on cass) is the MD5 of a certificate's public key (prop 25); a 20, 32,
#     48 or 64-byte entry is a certificate's signature hash (prop 15) — its tbsCertificate hashed with
#     its own signature digest, SHA-1 / SHA-256 / SHA-384 / SHA-512 (the 6 others on cass are 48-byte,
#     6.7.14; the other lengths since 6.7.15). An MD2 / MD5-signed certificate's signature hash is 16
#     bytes too, so a 16-byte entry is applied under both readings (6.7.16). All are applied; an entry
#     of any other length is not.
# ⚠ NOT "never trusts more than Windows" in every case: roots Windows would fetch on demand (automatic
# root update) are not in the store, so those servers fail closed here — deliberately (D9, 6.7.12): the
# stdlib takes no network action of its own.
# Each root is written into `buf` as a PEM block, so `_tn_ca_buf` is the same thing on every target
# (the system bundle, PEM) and _tn_ca_parse_set counts what it cannot parse exactly as for a file.
# HOW: crypt32 is loaded at first use with LoadLibraryExA(LOAD_LIBRARY_SEARCH_SYSTEM32), resolved
# through GetModuleHandleA / GetProcAddress (0xF013 / 0xF014) and called through callptr. It is
# deliberately NOT an import: crypt32 is not a KnownDLL, so an imported crypt32.dll is looked for in
# the APPLICATION directory first, and one planted beside any TLS program would run at its load.
# CHANGELOG [6.6.14]
var _TN_W_SEARCH_SYSTEM32 = 0x800;      # LOAD_LIBRARY_SEARCH_SYSTEM32
var _TN_W_PROV_SYSTEM_W = 10;           # CERT_STORE_PROV_SYSTEM_W
var _TN_W_STORE_FLAGS = 0x1C000;        # CERT_SYSTEM_STORE_CURRENT_USER | READONLY | OPEN_EXISTING
var _TN_W_PROP_EKU = 9;                 # CERT_ENHKEY_USAGE_PROP_ID
var _TN_W_PROP_NAMES = 84;              # CERT_ROOT_PROGRAM_NAME_CONSTRAINTS_PROP_ID
var _TN_W_PROP_DISABLE = 104;           # CERT_DISALLOWED_FILETIME_PROP_ID: not trusted after it
var _TN_W_PROP_DISABLE_EKU = 122;       # CERT_DISALLOWED_ENHKEY_USAGE_PROP_ID: for these purposes
var _TN_W_PROP_NOTBEFORE = 126;         # CERT_NOT_BEFORE_FILETIME_PROP_ID: issued after it, not trusted
var _TN_W_PROP_NOTBEFORE_EKU = 127;     # CERT_NOT_BEFORE_ENHKEY_USAGE_PROP_ID: for these purposes
var _TN_W_NOT_FOUND = 0x80092004;       # CRYPT_E_NOT_FOUND: the property is absent
var _TN_W_HKLM = 0 - 2147483646;        # HKEY_LOCAL_MACHINE, (HKEY)(LONG)0x80000002 sign-extended
var _TN_W_RRF_BINARY = 8;               # RRF_RT_REG_BINARY
var _TN_W_NO_VALUE = 2;                 # ERROR_FILE_NOT_FOUND: the key or the value is absent
var _TN_W_ENC = 0x10001;                # X509_ASN_ENCODING | PKCS_7_ASN_ENCODING

# Load crypt32 from System32 and resolve the four entry points into fns[0..4): CertOpenStore,
# CertEnumCertificatesInStore, CertCloseStore, CertGetCertificateContextProperty. 1, or 0.
fn _tn_w_crypt32(fns): i64 {
    var k = syscall(0xF013, "kernel32.dll");
    if (k == 0) { return 0; }
    var ll = syscall(0xF014, k, "LoadLibraryExA");
    if (ll == 0) { return 0; }
    var c = callptr(ll, "crypt32.dll", 0, _TN_W_SEARCH_SYSTEM32);
    if (c == 0) { return 0; }
    store64(fns, syscall(0xF014, c, "CertOpenStore"));
    store64(fns + 8, syscall(0xF014, c, "CertEnumCertificatesInStore"));
    store64(fns + 16, syscall(0xF014, c, "CertCloseStore"));
    store64(fns + 24, syscall(0xF014, c, "CertGetCertificateContextProperty"));
    var i = 0;
    while (i < 4) {
        if (load64(fns + i * 8) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Open the CurrentUser system store named by ASCII `name`, read-only. The HCERTSTORE, or 0.
fn _tn_w_open(fns, name): i64 {
    var w[64];                          # the name as UTF-16LE (store names are short ASCII)
    var i = 0;
    while (load8(name + i) != 0) {
        store16(&w + i * 2, load8(name + i) & 0xFF);
        i = i + 1;
    }
    store16(&w + i * 2, 0);
    var st = callptr(load64(fns), _TN_W_PROV_SYSTEM_W, 0, 0, _TN_W_STORE_FLAGS, &w);
    return st;
}

# 1 when the content `o[0..l)` of an OBJECT IDENTIFIER names `purpose` (TlsChainPurpose) —
# serverAuth (1.3.6.1.5.5.7.3.1) for _TN_PURPOSE_SERVER, clientAuth (1.3.6.1.5.5.7.3.2) for
# _TN_PURPOSE_CLIENT — or is anyExtendedKeyUsage (2.5.29.37.0), which names both.
fn _tn_w_oid_purpose(o, l, purpose): i64 {
    if (l == 8) {
        if (load32(o) == 0x0501062B) {
            var want = 0x01030705;                          # 05 07 03 01: serverAuth
            if (purpose == _TN_PURPOSE_CLIENT) { want = 0x02030705; }   # 05 07 03 02: clientAuth
            if (load32(o + 4) == want) { return 1; }
        }
    }
    if (l == 4) {
        if (load32(o) == 0x00251D55) { return 1; }
    }
    return 0;
}

# The DER SEQUENCE OF OBJECT IDENTIFIER at p[0..n) — a purpose-list property: 1 when it names
# `purpose` (_tn_w_oid_purpose) or anyExtendedKeyUsage, 0 when it is well formed and names neither, -1 when it is
# MALFORMED (not one SEQUENCE filling exactly n bytes, or an element that is not a short-form,
# non-empty OID). Three answers because the callers fail closed in OPPOSITE directions: for the
# allow-list (prop 9) malformed is "cannot tell it is a TLS root", for a distrust scope (122, 127)
# it is "cannot tell the distrust spares TLS". CHANGELOG [6.6.14]
fn _tn_w_eku_purpose(p, n, purpose): i64 {
    if (n < 2) { return 0 - 1; }
    if ((load8(p) & 0xFF) != 0x30) { return 0 - 1; }
    var len = load8(p + 1) & 0xFF;
    var i = 2;
    if (len >= 0x80) {                  # long form: 1 or 2 length bytes (no property is longer)
        var nb = len & 0x7F;
        if (nb < 1) { return 0 - 1; }
        if (nb > 2) { return 0 - 1; }
        if (2 + nb > n) { return 0 - 1; }
        len = 0;
        var k = 0;
        while (k < nb) {
            len = (len << 8) | (load8(p + 2 + k) & 0xFF);
            k = k + 1;
        }
        i = 2 + nb;
    }
    var end = i + len;
    if (end != n) { return 0 - 1; }
    var found = 0;
    while (i < end) {
        if (i + 2 > end) { return 0 - 1; }
        if ((load8(p + i) & 0xFF) != 0x06) { return 0 - 1; }
        var l = load8(p + i + 1) & 0xFF;
        if (l == 0) { return 0 - 1; }
        if (l >= 0x80) { return 0 - 1; }
        if (i + 2 + l > end) { return 0 - 1; }
        if (_tn_w_oid_purpose(p + i + 2, l, purpose) == 1) { found = 1; }
        i = i + 2 + l;
    }
    return found;
}

# Read property `id` of the store certificate `cc` into scratch[0..scap): its length, -1 when the
# property is absent (CRYPT_E_NOT_FOUND), -2 when it cannot be read — any other failure, or a value
# longer than `scap`. SIZE-QUERIED FIRST: a fixed 512-byte read failed ERROR_MORE_DATA on a longer
# value, and the policy took that for "not a TLS root" — a root Windows trusts, dropped and counted
# nowhere. CHANGELOG [6.6.14]
fn _tn_w_prop(fns, cc, id, scratch, scap): i64 {
    var cb[8];
    var prop = load64(fns + 24);
    store64(&cb, 0);
    var r = callptr(prop, cc, id, 0, &cb) & 0xFFFFFFFF;
    if (r == 0) {
        if ((syscall(0xF04B) & 0xFFFFFFFF) == _TN_W_NOT_FOUND) { return 0 - 1; }
        return 0 - 2;
    }
    var n = load32(&cb);
    if (n == 0) { return 0; }
    if (n > scap) { return 0 - 2; }
    r = callptr(prop, cc, id, scratch, &cb) & 0xFFFFFFFF;
    if (r == 0) { return 0 - 2; }
    return load32(&cb);
}

# 1 when the store certificate `cc` carries the dated distrust `date_id` and its purpose scope
# `eku_id` covers `purpose` (an absent scope covers every purpose; a malformed one may), or when
# either cannot be read; 0 when it carries no such distrust.
fn _tn_w_dated(fns, cc, date_id, eku_id, scratch, scap, purpose): i64 {
    var n = _tn_w_prop(fns, cc, date_id, scratch, scap);
    if (n == 0 - 1) { return 0; }
    if (n == 0 - 2) { return 1; }
    n = _tn_w_prop(fns, cc, eku_id, scratch, scap);
    if (n < 0) { return 1; }            # absent: the date applies to every purpose
    if (_tn_w_eku_purpose(scratch, n, purpose) != 0) { return 1; }   # names it, or malformed
    return 0;
}

# The NotBefore distrust (props 126 / 127) of the store certificate `cc` for `purpose`: 0 = none
# covers it, 1 = one does — its issuance bound (Unix seconds, rounded up: see _TN_POL_LEN) is stored
# at `pb` — and -1 = it cannot be judged (the date is not one readable 8-byte FILETIME, or its scope
# cannot be read or is malformed), which refuses the root. An absent scope covers every purpose.
# CHANGELOG [6.7.12]
fn _tn_w_notbefore(fns, cc, scratch, scap, purpose, pb): i64 {
    var n = _tn_w_prop(fns, cc, _TN_W_PROP_NOTBEFORE, scratch, scap);
    if (n == 0 - 1) { return 0; }
    if (n != 8) { return 0 - 1; }
    var ft = load64(scratch);
    if (ft < 0) { return 0 - 1; }
    var m = _tn_w_prop(fns, cc, _TN_W_PROP_NOTBEFORE_EKU, scratch, scap);
    if (m == 0 - 2) { return 0 - 1; }
    if (m >= 0) {
        var e = _tn_w_eku_purpose(scratch, m, purpose);
        if (e < 0) { return 0 - 1; }
        if (e == 0) { return 0; }
    }
    store64(pb, (ft + 9999999) / 10000000 - 11644473600);
    return 1;
}

# How Windows trusts the store certificate `cc` (a PCCERT_CONTEXT) for TLS `purpose` (TlsChainPurpose:
# server or client authentication): 1 = as an anchor, 0 = not at all (its purposes leave that one
# out), 2 = refused (a Disable date covers it, it carries root-program name constraints, or a
# property cannot be read or is malformed — it cannot be judged, so it is refused and COUNTED). Any
# failure other than "property absent" fails closed. A NotBefore date covering `purpose` does not
# refuse it (6.7.12, D9): the answer is 1 and its issuance bound is stored at `pbound` (1 = it has
# one) and `pbound + 8` (the bound); `pbound` reads 0 otherwise. Property values are read into
# scratch[0..scap) — the unused tail of the bundle buffer.
fn _tn_w_policy(fns, cc, scratch, scap, purpose, pbound): i64 {
    store64(pbound, 0);
    var n = _tn_w_prop(fns, cc, _TN_W_PROP_EKU, scratch, scap);
    if (n == 0 - 2) { return 2; }
    if (n >= 0) {
        var e = _tn_w_eku_purpose(scratch, n, purpose);
        if (e < 0) { return 2; }
        if (e == 0) { return 0; }
    }
    if (_tn_w_prop(fns, cc, _TN_W_PROP_NAMES, scratch, scap) != 0 - 1) { return 2; }
    if (_tn_w_dated(fns, cc, _TN_W_PROP_DISABLE, _TN_W_PROP_DISABLE_EKU, scratch, scap, purpose) == 1) { return 2; }
    var nb = _tn_w_notbefore(fns, cc, scratch, scap, purpose, pbound + 8);
    if (nb < 0) { return 2; }
    store64(pbound, nb);
    return 1;
}

# 1 when the store `st` holds a certificate whose DER is der[0..dlen). Walks the whole store, so
# every context the walk returns is released by the walk itself.
fn _tn_w_in_store(fns, st, der, dlen): i64 {
    var found = 0;
    var en = load64(fns + 8);
    var c = callptr(en, st, 0);
    while (c != 0) {
        if (found == 0) {
            if (load32(c + 16) == dlen) {
                if (memeq(load64(c + 8), der, dlen) == 1) { found = 1; }
            }
        }
        c = callptr(en, st, c);
    }
    return found;
}

# Append der[0..dlen) at buf+pos as one PEM CERTIFICATE block (64-column base64). The new position,
# or -1 when the block does not fit before `cap` (nothing is written then).
fn _tn_w_pem_put(buf, pos, cap, der, dlen): i64 {
    var b64 = ((dlen + 2) / 3) * 4;
    if (pos + 28 + b64 + (b64 + 63) / 64 + 26 > cap) { return 0 - 1; }
    var tbl = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    memcpy(buf + pos, "-----BEGIN CERTIFICATE-----\n", 28);
    var o = pos + 28;
    var col = 0;
    var i = 0;
    while (i < dlen) {
        var v = (load8(der + i) & 0xFF) << 16;
        if (i + 1 < dlen) { v = v | ((load8(der + i + 1) & 0xFF) << 8); }
        if (i + 2 < dlen) { v = v | (load8(der + i + 2) & 0xFF); }
        store8(buf + o, load8(tbl + ((v >> 18) & 63)));
        store8(buf + o + 1, load8(tbl + ((v >> 12) & 63)));
        store8(buf + o + 2, 61);
        store8(buf + o + 3, 61);
        if (i + 1 < dlen) { store8(buf + o + 2, load8(tbl + ((v >> 6) & 63))); }
        if (i + 2 < dlen) { store8(buf + o + 3, load8(tbl + (v & 63))); }
        o = o + 4;
        col = col + 4;
        if (col == 64) {
            store8(buf + o, 10);
            o = o + 1;
            col = 0;
        }
        i = i + 3;
    }
    if (col != 0) {
        store8(buf + o, 10);
        o = o + 1;
    }
    memcpy(buf + o, "-----END CERTIFICATE-----\n", 26);
    return o + 26;
}

# Append to the trust policy `pol` the issuance bound `bound` of the root der[0..dlen) (the DER is
# copied: the store's context is released by the walk). 1, or 0 on OOM. The bound list grows by
# doubling from 8 entries — its capacity follows from its count.
fn _tn_w_bound_add(pol, der, dlen, bound): i64 {
    var n = load64(pol + 32);
    var b = load64(pol + 40);
    var grow = 0;
    if (n == 0) { grow = 8; }
    if (n >= 8) {
        if ((n & (n - 1)) == 0) { grow = n * 2; }
    }
    if (grow > 0) {
        var nb = alloc(grow * 24);
        if (nb == 0) { return 0; }
        if (n > 0) { memcpy(nb, b, n * 24); }
        b = nb;
    }
    var cp = alloc(dlen);
    if (cp == 0) { return 0; }
    memcpy(cp, der, dlen);
    store64(b + n * 24, cp);
    store64(b + n * 24 + 8, dlen);
    store64(b + n * 24 + 16, bound);
    store64(pol + 40, b);
    store64(pol + 32, n + 1);
    return 1;
}

# Walk the store `root` and write every certificate the policy takes for `purpose` — and neither `dis`
# (the Disallowed store) nor the trust policy `pol` (its deny keys and certs; _tn_pol_new) distrusts —
# into buf[0..cap) as PEM. A root taken with a NotBefore distrust gets its issuance bound appended to
# `pol` (6.7.12). The byte count (0 when none qualified); the number refused (policy 2, a root whose key
# cannot be read against the deny keys, a block that did not fit, or a bound that could not be recorded)
# is stored at `refused`. Takes the store handles and the policy so the rules can be exercised on
# stores built in memory (tests/tcyr/crossos/tls_system_trust_store.tcyr). CHANGELOG [6.6.14], [6.7.12]
fn _tn_w_export(fns, root, dis, buf, cap, refused, purpose, pol): i64 {
    var en = load64(fns + 8);
    var total = 0;
    var nref = 0;
    var bd[16];                         # [has a bound][the bound] (_tn_w_policy)
    var c = callptr(en, root, 0);
    while (c != 0) {
        var der = load64(c + 8);
        var dlen = load32(c + 16);
        var code = _tn_w_policy(fns, c, buf + total, cap - total, purpose, &bd);
        if (code != 0) {
            if (_tn_w_in_store(fns, dis, der, dlen) == 1) { code = 0; }
        }
        if (code != 0) {
            if (pol != 0) {
                var dn = _tn_pol_der_denied(pol, der, dlen);
                if (dn == 1) { code = 0; }
                if (dn == 2) { code = 2; }
            }
        }
        if (code == 2) { nref = nref + 1; }
        if (code == 1) {
            var np = _tn_w_pem_put(buf, total, cap, der, dlen);
            if (np >= 0) {
                if (load64(&bd) == 1) {
                    if (pol == 0) { np = 0 - 1; }   # no policy to carry the bound: refused, never unbounded
                    if (np >= 0) {
                        if (_tn_w_bound_add(pol, der, dlen, load64(&bd + 8)) == 0) { np = 0 - 1; }
                    }
                }
            }
            if (np < 0) { nref = nref + 1; }
            if (np >= 0) { total = np; }
        }
        c = callptr(en, root, c);
    }
    store64(refused, nref);
    return total;
}

# ASCII `s` as NUL-terminated UTF-16LE into w[0..cap) bytes. 1, or 0 when it does not fit.
fn _tn_w_widen(s, w, cap): i64 {
    var i = 0;
    while (load8(s + i) != 0) {
        if (i * 2 + 4 > cap) { return 0; }
        store16(w + i * 2, load8(s + i) & 0xFF);
        i = i + 1;
    }
    store16(w + i * 2, 0);
    return 1;
}

# The entries of the parsed disallowed CTL `ctl` (a PCCTL_CONTEXT), copied: the 16-byte entries — the
# public-key MD5s, read as MD2 / MD5 signature hashes too (6.7.16, _TN_POL_LEN) — are returned (0 when
# it has none) with their count at `pn`, and the other signature hashes go into the 64-byte table
# `sig` — the policy's layout (_TN_POL_LEN): a {count, ptr} pair for each of the 20, 32, 48 and
# 64-byte entries, in that order (ptr 0 when none). -1 when it is not a list of this kind (its
# SubjectAlgorithm is not szOID_DISALLOWED_HASH) or a copy cannot be allocated. An entry of any other
# length is not applied — see the store header. CHANGELOG [6.7.12], [6.7.14], [6.7.15], [6.7.16]
fn _tn_w_ctl_copy(ctl, pn, sig): i64 {
    store64(pn, 0);
    memset(sig, 0, 64);
    var info = load64(ctl + 24);                    # CTL_CONTEXT.pCtlInfo
    if (info == 0) { return 0 - 1; }
    var oid = load64(info + 72);                    # CTL_INFO.SubjectAlgorithm.pszObjId
    if (oid == 0) { return 0 - 1; }
    if (strlen(oid) != 24) { return 0 - 1; }
    if (memeq(oid, "1.3.6.1.4.1.311.10.11.15", 24) != 1) { return 0 - 1; }
    var ne = load32(info + 96);                     # cCTLEntry
    var ents = load64(info + 104);                  # rgCTLEntry: CTL_ENTRY, 32 B each
    var k = 0;
    while (k < 4) {
        var h = _tn_w_ctl_take(ents, ne, _tn_sig_len_at(k), sig + k * 16);
        if (h < 0) { return 0 - 1; }
        store64(sig + k * 16 + 8, h);
        k = k + 1;
    }
    return _tn_w_ctl_take(ents, ne, 16, pn);
}

# The `ne` CTL entries at `ents` whose SubjectIdentifier is exactly `len` bytes, copied back to back
# into one allocation (returned; 0 when there are none) with their count at `pn`; -1 on OOM.
fn _tn_w_ctl_take(ents, ne, len, pn): i64 {
    store64(pn, 0);
    var m = 0;
    var i = 0;
    while (i < ne) {
        if (load32(ents + i * 32) == len) { m = m + 1; }    # SubjectIdentifier.cbData
        i = i + 1;
    }
    if (m == 0) { return 0; }
    var out = alloc(m * len);
    if (out == 0) { return 0 - 1; }
    var k = 0;
    i = 0;
    while (i < ne) {
        if (load32(ents + i * 32) == len) {
            memcpy(out + k * len, load64(ents + i * 32 + 8), len);
            k = k + 1;
        }
        i = i + 1;
    }
    store64(pn, m);
    return out;
}

# The auto-updated disallowed CTL's entries (HKLM\SOFTWARE\Microsoft\SystemCertificates\
# AuthRoot\AutoUpdate, value DisallowedCertEncodedCtl, through advapi32!RegGetValueW and
# crypt32!CertCreateCTLContext, both loaded from System32 like crypt32 above), as _tn_w_ctl_copy
# splits them: the copied 16-byte entries (public-key MD5s, and MD2 / MD5 signature hashes, 6.7.16)
# with their count at `pn`, the other signature hashes in the 64-byte table `sig`. 0 (and no hashes)
# when the value is absent (none listed — wine has none), -1 when it is present but cannot be read or
# parsed: the caller then fails the whole store closed. CHANGELOG [6.7.12], [6.7.14], [6.7.15], [6.7.16]
fn _tn_w_ctl_keys(pn, sig): i64 {
    store64(pn, 0);
    memset(sig, 0, 64);
    var k = syscall(0xF013, "kernel32.dll");
    if (k == 0) { return 0 - 1; }
    var ll = syscall(0xF014, k, "LoadLibraryExA");
    if (ll == 0) { return 0 - 1; }
    var adv = callptr(ll, "advapi32.dll", 0, _TN_W_SEARCH_SYSTEM32);
    if (adv == 0) { return 0 - 1; }
    var c32 = callptr(ll, "crypt32.dll", 0, _TN_W_SEARCH_SYSTEM32);
    if (c32 == 0) { return 0 - 1; }
    var reg = syscall(0xF014, adv, "RegGetValueW");
    var mk = syscall(0xF014, c32, "CertCreateCTLContext");
    var fr = syscall(0xF014, c32, "CertFreeCTLContext");
    if (reg == 0) { return 0 - 1; }
    if (mk == 0) { return 0 - 1; }
    if (fr == 0) { return 0 - 1; }
    var ws[128];
    var wv[64];
    var sub = "SOFTWARE\\Microsoft\\SystemCertificates\\AuthRoot\\AutoUpdate";
    if (_tn_w_widen(sub, &ws, 128) == 0) { return 0 - 1; }
    if (_tn_w_widen("DisallowedCertEncodedCtl", &wv, 64) == 0) { return 0 - 1; }
    var cb[8];
    store64(&cb, 0);
    var r = callptr(reg, _TN_W_HKLM, &ws, &wv, _TN_W_RRF_BINARY, 0, 0, &cb) & 0xFFFFFFFF;
    if (r == _TN_W_NO_VALUE) { return 0; }
    if (r != 0) { return 0 - 1; }
    var n = load32(&cb);
    if (n <= 0) { return 0 - 1; }
    var raw = alloc(n);
    if (raw == 0) { return 0 - 1; }
    r = callptr(reg, _TN_W_HKLM, &ws, &wv, _TN_W_RRF_BINARY, 0, raw, &cb) & 0xFFFFFFFF;
    if (r != 0) { return 0 - 1; }
    var ctl = callptr(mk, _TN_W_ENC, raw, load32(&cb));
    if (ctl == 0) { return 0 - 1; }
    var keys = _tn_w_ctl_copy(ctl, pn, sig);
    callptr(fr, ctl);
    return keys;
}

# Every certificate of the store `st`, copied as [der ptr][der len] pairs (16 B each), its count at
# `pn`; 0 when it holds none, -1 on OOM.
fn _tn_w_store_ders(fns, st, pn): i64 {
    store64(pn, 0);
    var en = load64(fns + 8);
    var n = 0;
    var c = callptr(en, st, 0);
    while (c != 0) {
        n = n + 1;
        c = callptr(en, st, c);
    }
    if (n == 0) { return 0; }
    var list = alloc(n * 16);
    if (list == 0) { return 0 - 1; }
    var k = 0;
    var bad = 0;
    c = callptr(en, st, 0);
    while (c != 0) {
        if (k < n) {
            var l = load32(c + 16);
            var cp = alloc(l);
            if (cp == 0) { bad = 1; }
            if (cp != 0) {
                memcpy(cp, load64(c + 8), l);
                store64(list + k * 16, cp);
                store64(list + k * 16 + 8, l);
                k = k + 1;
            }
        }
        c = callptr(en, st, c);
    }
    if (bad == 1) { return 0 - 1; }
    store64(pn, k);
    return list;
}

# The trust policy Windows' explicit distrust gives the system set (_tn_pol_new): the disallowed CTL's
# public-key entries and signature hashes (every length, 6.7.15), and the Disallowed store `dis`'s
# certificates; bounds are added by the export. 0 when either cannot be read (the store then fails
# closed).
fn _tn_w_store_policy(fns, dis): i64 {
    var nk = 0;
    var sig[64];
    var keys = _tn_w_ctl_keys(&nk, &sig);
    if (keys < 0) { return 0; }
    var nc = 0;
    var certs = _tn_w_store_ders(fns, dis, &nc);
    if (certs < 0) { return 0; }
    var pol = _tn_pol_new(nk, keys, nc, certs, 0, 0);
    if (pol == 0) { return 0; }
    var k = 0;
    while (k < 4) {
        _tn_pol_set_sighash(pol, _tn_sig_len_at(k), load64(&sig + k * 16), load64(&sig + k * 16 + 8));
        k = k + 1;
    }
    return pol;
}

# The Windows system store for _tn_ca_read: every root Windows trusts as an anchor for `purpose`, as
# a PEM bundle in buf[0..cap), and the set's trust policy at `ppol`. The byte count, or -1 for no
# store (crypt32 or a store would not open, the disallowed CTL or the Disallowed store could not be
# read, or no root qualified) — the caller caches that as TLS_ERR_IO. Writes the refused count
# through `refused`.
fn _tn_ca_read_win(buf, cap, refused, ppol, purpose): i64 {
    store64(refused, 0);
    store64(ppol, 0);
    var fns[32];
    if (_tn_w_crypt32(&fns) == 0) { return 0 - 1; }
    var root = _tn_w_open(&fns, "ROOT");
    if (root == 0) { return 0 - 1; }
    var dis = _tn_w_open(&fns, "Disallowed");
    var cl = load64(&fns + 16);
    if (dis == 0) {
        callptr(cl, root, 0);
        return 0 - 1;
    }
    var pol = _tn_w_store_policy(&fns, dis);
    var total = 0 - 1;
    if (pol != 0) { total = _tn_w_export(&fns, root, dis, buf, cap, refused, purpose, pol); }
    callptr(cl, dis, 0);
    callptr(cl, root, 0);
    if (total <= 0) { return 0 - 1; }
    store64(ppol, pol);
    return total;
}
#endif

# v6.2.8: mTLS client-auth — install the CLIENT's own certificate so it can
# present it when a server sends a CertificateRequest. The wire Certificate
# message sends raw DER (`_tn_build_certificate` reads CERT_CHAIN), so a PEM
# input (is_der==0) is decoded to its leaf DER via `pem_decode_certs_into` first;
# DER input (is_der==1) is stored verbatim. Parses the leaf via `_tn_load_cert`.
# Pair with `tls_native_set_client_key`; CREDS_LOADED is set once both halves
# are in. CLIENT role only. Returns TLS_OK / negative TLS_ERR_*. See issue
# 2026-05-22-cyrius-native-tls-in-6.0.x.md (the mTLS half of the residual).
fn tls_native_set_client_cert(ctx, cert, cert_len, is_der): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    if (load64(ctx + TLS_CTX_OFF_ROLE) != TLS_ROLE_CLIENT) { return TLS_ERR_PROTOCOL; }
    if (cert == 0) { return TLS_ERR_INVALID_PARAM; }
    if (cert_len <= 0) { return TLS_ERR_INVALID_PARAM; }
    var der = cert;
    var dlen = cert_len;
    if (is_der == 0) {
        # PEM → first (leaf) DER cert. ⛔ The chain table is sized from the input's own block
        # count, as _tn_ca_parse_set's is, never a fixed cap: TLS_CA_MAX_ROOTS (300) cost 4,800 B
        # for one block and refused a well-formed leaf once 300 more blocks followed it. The
        # strict decode walks non-overlapping BEGIN markers only, never more than
        # pem_count_cert_blocks' greedy count, so it cannot run out of entries. It stays STRICT:
        # a bad first block must fail, not hand back the next certificate (CHANGELOG [6.6.14]).
        # CHANGELOG [6.7.9]
        var blocks = pem_count_cert_blocks(cert, cert_len);
        if (blocks < 1) { return TLS_ERR_CERT_INVALID; }
        var chain = _tn_alloc(ctx, blocks * 16);
        if (chain == 0) { return TLS_ERR_OOM; }
        var pool = _tn_alloc(ctx, cert_len);          # DER <= 3/4 of its base64
        if (pool == 0) { return TLS_ERR_OOM; }
        var n = pem_decode_certs_into(cert, cert_len, chain, blocks, pool, cert_len);
        if (n < 1) { return TLS_ERR_CERT_INVALID; }
        der = load64(chain);
        dlen = load64(chain + 8);
    }
    store64(ctx + TLS_CTX_OFF_CERT_CHAIN, der);
    store64(ctx + TLS_CTX_OFF_CERT_LEN, dlen);
    var cr = _tn_load_cert(ctx);
    if (cr != TLS_OK) { return cr; }
    if (load64(ctx + TLS_CTX_OFF_KEY_MAT) != 0) { store64(ctx + TLS_CTX_OFF_CREDS_LOADED, 1); }
    return TLS_OK;
}

# v6.2.8: mTLS client-auth — install the CLIENT's own private key (the signer
# for the client CertificateVerify). `_tn_load_privkey` auto-detects PEM (0x2D)
# vs DER and the algorithm (Ed25519 / ECDSA P-256 / P-384; RSA-PSS signing is
# not yet wired in sigil → TLS_ERR_KEY_UNSUPPORTED). CLIENT role only. Pair with
# `tls_native_set_client_cert`. Returns TLS_OK / negative TLS_ERR_*.
fn tls_native_set_client_key(ctx, key, key_len): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    if (load64(ctx + TLS_CTX_OFF_ROLE) != TLS_ROLE_CLIENT) { return TLS_ERR_PROTOCOL; }
    if (key == 0) { return TLS_ERR_INVALID_PARAM; }
    if (key_len <= 0) { return TLS_ERR_INVALID_PARAM; }
    store64(ctx + TLS_CTX_OFF_KEY, key);
    store64(ctx + TLS_CTX_OFF_KEY_LEN, key_len);
    var kr = _tn_load_privkey(ctx);
    if (kr != TLS_OK) { return kr; }
    if (load64(ctx + TLS_CTX_OFF_LEAF_CERT) != 0) { store64(ctx + TLS_CTX_OFF_CREDS_LOADED, 1); }
    return TLS_OK;
}

# CYRIUS-2026-0002 (v6.1.36): a CA that signs the next link down must, if it carries a
# keyUsage extension, assert keyCertSign (0x04); and its pathLenConstraint (if
# set, != -1) must permit `below` intermediate CAs beneath it toward the leaf.
# `below` is the path-build depth at which this CA signs (0 = it directly signs
# the leaf). Uses the sigil 3.7.12 keyUsage/pathLen fields. Returns 1 if OK.
# ⛔ 6.6.16 (CYRIUS-2026-0026) — WHY `purpose`: a CA's extendedKeyUsage confines what it may vouch
# for, and this never looked at it. A CA limited to clientAuth / codeSigning / S/MIME could issue
# a leaf the native client took as a TLS server, and a serverAuth-only CA in an mTLS server's
# trust set could issue a client identity; OpenSSL refuses both. The check sits HERE, inside the
# conjunction _tn_verify_chain uses to SELECT a candidate (intermediate and trust anchor alike),
# so a wrongly purposed CA is skipped and path building goes on to the next one — never fatal.
# CHANGELOG [6.6.16]
fn _tn_ca_signer_ok(ca, below, purpose): i64 {
    var ku = x509_cert_key_usage(ca);
    if (ku != 0) {                          # keyUsage present
        if ((ku & 0x04) == 0) { return 0; } # keyCertSign required to sign certs
    }
    var pl = x509_cert_path_len(ca);
    if (pl != (0 - 1)) {                     # pathLenConstraint set
        if (below > pl) { return 0; }
    }
    if (_tn_eku_purpose_ok(ca, purpose) != 1) { return 0; }
    return 1;
}

# What a verified leaf must be fit for (RFC 5280 §4.2.1.3 keyUsage, §4.2.1.12 extendedKeyUsage).
# An absent extension imposes no restriction.
#   _TN_PURPOSE_SERVER  a TLS server: keyUsage allows digitalSignature | keyEncipherment |
#                       keyAgreement (0xA8); extendedKeyUsage lists serverAuth or anyExtendedKeyUsage
#   _TN_PURPOSE_CLIENT  a TLS client: keyUsage allows digitalSignature | keyAgreement (0x88, the
#                       mask of OpenSSL's ssl_client purpose); extendedKeyUsage lists clientAuth or
#                       anyExtendedKeyUsage
# The extendedKeyUsage half binds every CA on the path too, intermediates and the trust anchor
# (_tn_eku_purpose_ok, 6.6.16); keyUsage on a CA is keyCertSign (_tn_ca_signer_ok).
enum TlsChainPurpose {
    _TN_PURPOSE_SERVER = 0;
    _TN_PURPOSE_CLIENT = 1;
}

# 1 if the DER cert's extendedKeyUsage lists id-kp-clientAuth (1.3.6.1.5.5.7.3.2) or
# anyExtendedKeyUsage (2.5.29.37.0), else 0 (an absent extension included: the caller asks only
# when sigil reported one). sigil records the serverAuth bit only, so the client purpose reads
# the extension itself. CHANGELOG [6.6.14]
fn _tn_cert_eku_client_auth(der, der_len): i64 {
    var cp = 0;
    var cl = 0;
    if (_tn_der_hdr(der, der_len, 0, &cp, &cl) != 0x30) { return 0; }      # Certificate
    var tp = 0;
    var tl = 0;
    if (_tn_der_hdr(der, der_len, cp, &tp, &tl) != 0x30) { return 0; }     # tbsCertificate
    var pos = tp;
    var tbs_end = tp + tl;
    var ext_cp = 0 - 1;
    while (pos < tbs_end) {
        var ecp = 0;
        var ecl = 0;
        var tag = _tn_der_hdr(der, der_len, pos, &ecp, &ecl);
        if (tag < 0) { return 0; }
        if (tag == 0xA3) { ext_cp = ecp; pos = tbs_end; }
        else { pos = ecp + ecl; }
    }
    if (ext_cp < 0) { return 0; }
    var sp = 0;
    var sl = 0;
    if (_tn_der_hdr(der, der_len, ext_cp, &sp, &sl) != 0x30) { return 0; }  # SEQUENCE OF Extension
    var ep = sp;
    var ext_end = sp + sl;
    while (ep < ext_end) {
        var xcp = 0;
        var xcl = 0;
        if (_tn_der_hdr(der, der_len, ep, &xcp, &xcl) != 0x30) { return 0; }
        var op = 0;
        var ol = 0;
        if (_tn_der_hdr(der, der_len, xcp, &op, &ol) == 0x06) {
            if (ol == 3) {
                if (memeq(der + op, "\x55\x1d\x25", 3) == 1) {                 # 2.5.29.37
                    var vp = op + ol;
                    var vcp = 0;
                    var vcl = 0;
                    var vtag = _tn_der_hdr(der, der_len, vp, &vcp, &vcl);
                    if (vtag == 0x01) {                                     # critical BOOLEAN
                        vp = vcp + vcl;
                        vtag = _tn_der_hdr(der, der_len, vp, &vcp, &vcl);
                    }
                    if (vtag != 0x04) { return 0; }
                    var qp = 0;
                    var ql = 0;
                    if (_tn_der_hdr(der, der_len, vcp, &qp, &ql) != 0x30) { return 0; }
                    var kp = qp;
                    var kend = qp + ql;
                    while (kp < kend) {
                        var kcp = 0;
                        var kcl = 0;
                        if (_tn_der_hdr(der, der_len, kp, &kcp, &kcl) != 0x06) { return 0; }
                        if (kcl == 8) {
                            if (memeq(der + kcp, "\x2b\x06\x01\x05\x05\x07\x03\x02", 8) == 1) { return 1; }
                        }
                        if (kcl == 4) {
                            if (memeq(der + kcp, "\x55\x1d\x25\x00", 4) == 1) { return 1; }
                        }
                        kp = kcp + kcl;
                    }
                    return 0;
                }
            }
        }
        ep = xcp + xcl;
    }
    return 0;
}

# 1 if `cert`'s extendedKeyUsage permits `purpose` (see TlsChainPurpose), else 0 — the ONE EKU
# rule, applied at every depth: the leaf (_tn_leaf_purpose_ok) and every CA, intermediate or trust
# anchor (_tn_ca_signer_ok). An absent extension imposes no restriction (RFC 5280 §4.2.1.12).
# anyExtendedKeyUsage satisfies either purpose at every depth, as RFC 5280 reads it and as the leaf
# rule always did; OpenSSL 3.6.5 honours it at NO depth (measured) — going strict is this one
# function, and it moves the leaf rule too. `cert`'s DER (load64(cert)) must be live: sigil
# records the serverAuth bit only, so the client purpose reads the extension from the DER.
# CHANGELOG [6.6.16]
fn _tn_eku_purpose_ok(cert, purpose): i64 {
    var eku = x509_cert_eku(cert);
    if (eku == 0) { return 1; }
    if (purpose == _TN_PURPOSE_SERVER) { return eku & 0x01; }
    return _tn_cert_eku_client_auth(load64(cert), load64(cert + 8));
}

# 1 if `leaf`'s keyUsage and extendedKeyUsage permit `purpose` (see TlsChainPurpose), else 0.
fn _tn_leaf_purpose_ok(leaf, purpose): i64 {
    var kmask = 0xA8;
    if (purpose == _TN_PURPOSE_CLIENT) { kmask = 0x88; }
    var lku = x509_cert_key_usage(leaf);
    if (lku != 0) {
        if ((lku & kmask) == 0) { return 0; }
    }
    return _tn_eku_purpose_ok(leaf, purpose);
}

# ── The trust policy a root set carries beyond its certificates (6.7.12) ─────────────────────────
# Windows' chain engine distrusts more than a root set can say, and _tn_verify_chain applies it to
# EVERY certificate of a path when the ctx holds a policy (TLS_CTX_OFF_CA_POLICY; tls_native_set_ca_system
# installs the system store's, any other install clears it, so POSIX ctxs never have one):
#   - DENY KEYS: 16-byte MD5s of a certificate's subjectPublicKey (the BIT STRING's key bytes, its
#     unused-bits octet excluded). The auto-updated disallowed CTL lists distrusted certificates this
#     way — measured on cass: its entry for DigiNotar Root CA is exactly that MD5 (crypt32's
#     CERT_SUBJECT_PUBLIC_KEY_MD5_HASH_PROP_ID, 25), and the chain engine reports DigiNotar
#     CERT_TRUST_IS_EXPLICIT_DISTRUST with the Disallowed store empty; the eleven Fina 1.1.1.1
#     certificates of 2025 match the same way. So every certificate on that KEY is distrusted. The
#     same 16-byte list is also read as signature hashes (6.7.16): an md5WithRSA / md2WithRSA
#     certificate's prop 15 is 16 bytes too — the MD5 / MD2 of its TBS (measured on cass, 2026-10-19:
#     Thawte Timestamping CA e8a598be ... 013576b2, VeriSign Class 3 Public Primary CA d7c63be0 ...
#     5f986ad8) — so one listed by it is distrusted, the reading below, unconfirmed as it is (no
#     read-only probe shows which property the chain engine compares a 16-byte entry with:
#     CertFindSubjectInCTL does not apply the CTL's algorithm at all, finding not even a listed
#     48-byte entry; none of the six MD2 / MD5-signed roots on cass is listed today).
#   - DENY SIGNATURE HASHES (6.7.14, every length 6.7.15): crypt32's signature hash of a certificate
#     (CERT_SIGNATURE_HASH_PROP_ID 15) — its tbsCertificate (the whole TLV) hashed with its own
#     signature digest: 20 bytes for sha1WithRSA / ecdsa-with-SHA1, 32 for SHA-256, 48 for SHA-384, 64
#     for SHA-512 (measured on cass's ROOT store, 2026-10-18: 22 SHA-1-signed roots 20 B, 16 SHA-256 32 B,
#     15 SHA-384 48 B; md2 / md5WithRSA 16 B). The CTL's 48-byte entries are exactly that — measured on
#     cass (2026-10-16): its six are the six DarkMatter intermediates QuoVadis issued in 2016-2017
#     (sha384WithRSA), whose public-key MD5s it does not list, and the chain engine reports each
#     CERT_TRUST_IS_EXPLICIT_DISTRUST with the Disallowed store empty. A 20 / 32 / 64-byte entry is
#     read the same way — 6.7.14's D57 reading carried to every length, unconfirmed as it is (none in
#     the CTL today), in 6.7.12's D9 direction: a wrong reading matches nothing, and a match only
#     distrusts. A certificate is judged only by the list of its own digest's length — an MD2 / MD5-signed
#     one by the deny keys (6.7.16); one signed otherwise (RSASSA-PSS, Ed25519, ...) is not judged by
#     them.
#   - DENY CERTS: certificates distrusted byte for byte (the Disallowed store's), [der ptr][der len].
#   - BOUNDS: a root whose root-program NotBefore distrust (CERT_NOT_BEFORE_FILETIME_PROP_ID 126) covers
#     the purpose anchors only a leaf whose notBefore PRECEDES the date — [der ptr][der len][bound], the
#     bound in Unix seconds rounded up, so `notBefore >= bound` is exactly "on or after the FILETIME".
# A denied certificate is skipped while the path is built (a duplicate on another key still serves); a
# denied leaf fails. Layout: [0] deny-key count [8] keys (16 B each) [16] deny-cert count [24] certs
# (16 B each) [32] bound count [40] bounds (24 B each) [48..112) the deny signature hashes, a {count,
# ptr} pair per digest length — [48] 20 B (SHA-1) [64] 32 B (SHA-256) [80] 48 B (SHA-384) [96] 64 B
# (SHA-512), each list `count` hashes back to back (_tn_pol_sig_off); the 16-byte signature hashes
# are the deny keys at [0]. Immutable once installed. CHANGELOG [6.7.12], [6.7.14], [6.7.15], [6.7.16]
var _TN_POL_LEN = 112;

# A policy from its three lists (counts and pointers as in the layout above), with no signature hashes
# (_tn_pol_set_sighash adds them); 0 on OOM.
fn _tn_pol_new(nkeys, keys, ncerts, certs, nbounds, bounds): i64 {
    var p = alloc(_TN_POL_LEN);
    if (p == 0) { return 0; }
    memset(p, 0, _TN_POL_LEN);
    store64(p, nkeys);
    store64(p + 8, keys);
    store64(p + 16, ncerts);
    store64(p + 24, certs);
    store64(p + 32, nbounds);
    store64(p + 40, bounds);
    return p;
}

# The signature-hash lengths the policy keeps, by index: 20, 32, 48, 64.
fn _tn_sig_len_at(k): i64 {
    if (k == 0) { return 20; }
    return 16 + k * 16;
}

# The policy offset of the {count, ptr} pair of `len`-byte signature hashes, or 0 for any other length.
fn _tn_pol_sig_off(len): i64 {
    if (len == 20) { return 48; }
    if (len == 32) { return 64; }
    if (len == 48) { return 80; }
    if (len == 64) { return 96; }
    return 0;
}

# Give the policy `pol` its deny signature hashes of `len` bytes (20, 32, 48 or 64): `n` of them at
# `hashes`, back to back. Returns `pol`; 0 for another length (no list of that kind).
fn _tn_pol_set_sighash(pol, len, n, hashes): i64 {
    var o = _tn_pol_sig_off(len);
    if (o == 0) { return 0; }
    store64(pol + o, n);
    store64(pol + o + 8, hashes);
    return pol;
}

# The MD5 round constants K[0..64) (RFC 1321 §3.4), little-endian, into t[0..256).
fn _tn_md5_k(t): i64 {
    memcpy(t, "\x78\xa4\x6a\xd7\x56\xb7\xc7\xe8\xdb\x70\x20\x24\xee\xce\xbd\xc1", 16);
    memcpy(t + 16, "\xaf\x0f\x7c\xf5\x2a\xc6\x87\x47\x13\x46\x30\xa8\x01\x95\x46\xfd", 16);
    memcpy(t + 32, "\xd8\x98\x80\x69\xaf\xf7\x44\x8b\xb1\x5b\xff\xff\xbe\xd7\x5c\x89", 16);
    memcpy(t + 48, "\x22\x11\x90\x6b\x93\x71\x98\xfd\x8e\x43\x79\xa6\x21\x08\xb4\x49", 16);
    memcpy(t + 64, "\x62\x25\x1e\xf6\x40\xb3\x40\xc0\x51\x5a\x5e\x26\xaa\xc7\xb6\xe9", 16);
    memcpy(t + 80, "\x5d\x10\x2f\xd6\x53\x14\x44\x02\x81\xe6\xa1\xd8\xc8\xfb\xd3\xe7", 16);
    memcpy(t + 96, "\xe6\xcd\xe1\x21\xd6\x07\x37\xc3\x87\x0d\xd5\xf4\xed\x14\x5a\x45", 16);
    memcpy(t + 112, "\x05\xe9\xe3\xa9\xf8\xa3\xef\xfc\xd9\x02\x6f\x67\x8a\x4c\x2a\x8d", 16);
    memcpy(t + 128, "\x42\x39\xfa\xff\x81\xf6\x71\x87\x22\x61\x9d\x6d\x0c\x38\xe5\xfd", 16);
    memcpy(t + 144, "\x44\xea\xbe\xa4\xa9\xcf\xde\x4b\x60\x4b\xbb\xf6\x70\xbc\xbf\xbe", 16);
    memcpy(t + 160, "\xc6\x7e\x9b\x28\xfa\x27\xa1\xea\x85\x30\xef\xd4\x05\x1d\x88\x04", 16);
    memcpy(t + 176, "\x39\xd0\xd4\xd9\xe5\x99\xdb\xe6\xf8\x7c\xa2\x1f\x65\x56\xac\xc4", 16);
    memcpy(t + 192, "\x44\x22\x29\xf4\x97\xff\x2a\x43\xa7\x23\x94\xab\x39\xa0\x93\xfc", 16);
    memcpy(t + 208, "\xc3\x59\x5b\x65\x92\xcc\x0c\x8f\x7d\xf4\xef\xff\xd1\x5d\x84\x85", 16);
    memcpy(t + 224, "\x4f\x7e\xa8\x6f\xe0\xe6\x2c\xfe\x14\x43\x01\xa3\xa1\x11\x08\x4e", 16);
    memcpy(t + 240, "\x82\x7e\x53\xf7\x35\xf2\x3a\xbd\xbb\xd2\xd7\x2a\x91\xd3\x86\xeb", 16);
    return 0;
}

# One MD5 compression of the 64-byte block `m` into the state st[0..4) (32-bit words in i64 slots),
# with `k` the constant table (_tn_md5_k).
fn _tn_md5_block(st, m, k): i64 {
    var a = load64(st);
    var b = load64(st + 8);
    var c = load64(st + 16);
    var d = load64(st + 24);
    var i = 0;
    while (i < 64) {
        var f = 0;
        var g = i;
        var s = 0;
        var r = i >> 4;
        if (r == 0) {
            f = (b & c) | ((~b) & d);
            s = 7 + (i & 3) * 5;                           # 7 12 17 22
        }
        if (r == 1) {
            f = (d & b) | ((~d) & c);
            g = (5 * i + 1) & 15;
            s = 5;                                          # 5 9 14 20
            if ((i & 3) == 1) { s = 9; }
            if ((i & 3) == 2) { s = 14; }
            if ((i & 3) == 3) { s = 20; }
        }
        if (r == 2) {
            f = b ^ c ^ d;
            g = (3 * i + 5) & 15;
            s = 4;                                          # 4 11 16 23
            if ((i & 3) == 1) { s = 11; }
            if ((i & 3) == 2) { s = 16; }
            if ((i & 3) == 3) { s = 23; }
        }
        if (r == 3) {
            f = c ^ (b | (~d));
            g = (7 * i) & 15;
            s = 6;                                          # 6 10 15 21
            if ((i & 3) == 1) { s = 10; }
            if ((i & 3) == 2) { s = 15; }
            if ((i & 3) == 3) { s = 21; }
        }
        f = (f + a + load32(k + i * 4) + load32(m + g * 4)) & 0xFFFFFFFF;
        a = d;
        d = c;
        c = b;
        b = (b + (((f << s) | (f >> (32 - s))) & 0xFFFFFFFF)) & 0xFFFFFFFF;
        i = i + 1;
    }
    store64(st, (load64(st) + a) & 0xFFFFFFFF);
    store64(st + 8, (load64(st + 8) + b) & 0xFFFFFFFF);
    store64(st + 16, (load64(st + 16) + c) & 0xFFFFFFFF);
    store64(st + 24, (load64(st + 24) + d) & 0xFFFFFFFF);
    return 0;
}

# MD5 (RFC 1321) of p[0..n) into out[0..16). Allocates nothing — the verifier runs it per connect, and
# lib/sha1.cyr's allocating one-shot shows what a per-call heap block costs on the no-free heap. Used
# ONLY to read Windows' disallowed list, whose identifiers are MD5s (_TN_POL_LEN above): a match can
# only distrust, so MD5's collisions cannot make anything trusted.
fn _tn_md5(p, n, out): i64 {
    var k[256];
    var st[32];
    var tail[128];
    _tn_md5_k(&k);
    store64(&st, 0x67452301);
    store64(&st + 8, 0xEFCDAB89);
    store64(&st + 16, 0x98BADCFE);
    store64(&st + 24, 0x10325476);
    var off = 0;
    while (off + 64 <= n) {
        _tn_md5_block(&st, p + off, &k);
        off = off + 64;
    }
    var rem = n - off;
    memset(&tail, 0, 128);
    memcpy(&tail, p + off, rem);
    store8(&tail + rem, 0x80);
    var tl = 64;
    if (rem >= 56) { tl = 128; }
    store64(&tail + tl - 8, n * 8);                         # the bit length, little-endian
    _tn_md5_block(&st, &tail, &k);
    if (tl == 128) { _tn_md5_block(&st, &tail + 64, &k); }
    var i = 0;
    while (i < 4) {
        store32(out + i * 4, load64(&st + i * 8));
        i = i + 1;
    }
    return 0;
}

# The MD2 substitution table S (RFC 1319 §3.2, from the digits of pi) into t[0..256).
fn _tn_md2_s(t): i64 {
    memcpy(t, "\x29\x2e\x43\xc9\xa2\xd8\x7c\x01\x3d\x36\x54\xa1\xec\xf0\x06\x13", 16);
    memcpy(t + 16, "\x62\xa7\x05\xf3\xc0\xc7\x73\x8c\x98\x93\x2b\xd9\xbc\x4c\x82\xca", 16);
    memcpy(t + 32, "\x1e\x9b\x57\x3c\xfd\xd4\xe0\x16\x67\x42\x6f\x18\x8a\x17\xe5\x12", 16);
    memcpy(t + 48, "\xbe\x4e\xc4\xd6\xda\x9e\xde\x49\xa0\xfb\xf5\x8e\xbb\x2f\xee\x7a", 16);
    memcpy(t + 64, "\xa9\x68\x79\x91\x15\xb2\x07\x3f\x94\xc2\x10\x89\x0b\x22\x5f\x21", 16);
    memcpy(t + 80, "\x80\x7f\x5d\x9a\x5a\x90\x32\x27\x35\x3e\xcc\xe7\xbf\xf7\x97\x03", 16);
    memcpy(t + 96, "\xff\x19\x30\xb3\x48\xa5\xb5\xd1\xd7\x5e\x92\x2a\xac\x56\xaa\xc6", 16);
    memcpy(t + 112, "\x4f\xb8\x38\xd2\x96\xa4\x7d\xb6\x76\xfc\x6b\xe2\x9c\x74\x04\xf1", 16);
    memcpy(t + 128, "\x45\x9d\x70\x59\x64\x71\x87\x20\x86\x5b\xcf\x65\xe6\x2d\xa8\x02", 16);
    memcpy(t + 144, "\x1b\x60\x25\xad\xae\xb0\xb9\xf6\x1c\x46\x61\x69\x34\x40\x7e\x0f", 16);
    memcpy(t + 160, "\x55\x47\xa3\x23\xdd\x51\xaf\x3a\xc3\x5c\xf9\xce\xba\xc5\xea\x26", 16);
    memcpy(t + 176, "\x2c\x53\x0d\x6e\x85\x28\x84\x09\xd3\xdf\xcd\xf4\x41\x81\x4d\x52", 16);
    memcpy(t + 192, "\x6a\xdc\x37\xc8\x6c\xc1\xab\xfa\x24\xe1\x7b\x08\x0c\xbd\xb1\x4a", 16);
    memcpy(t + 208, "\x78\x88\x95\x8b\xe3\x63\xe8\x6d\xe9\xcb\xd5\xfe\x3b\x00\x1d\x39", 16);
    memcpy(t + 224, "\xf2\xef\xb7\x0e\x66\x58\xd0\xe4\xa6\x77\x72\xf8\xeb\x75\x4b\x0a", 16);
    memcpy(t + 240, "\x31\x44\x50\xb4\x8f\xed\x1f\x1a\xdb\x99\x8d\x33\x9f\x11\x83\x14", 16);
    return 0;
}

# MD2's checksum step (RFC 1319 §3.3, with its erratum: C[j] is XORed, not set) over the 16-byte block
# m: c[0..16) the checksum, c[16] the running byte L.
fn _tn_md2_sum(c, m, s): i64 {
    var l = load8(c + 16) & 0xFF;
    var j = 0;
    while (j < 16) {
        l = (load8(c + j) & 0xFF) ^ (load8(s + ((load8(m + j) & 0xFF) ^ l)) & 0xFF);
        store8(c + j, l);
        j = j + 1;
    }
    store8(c + 16, l);
    return 0;
}

# MD2's compression (RFC 1319 §3.4) of the 16-byte block m into the 48-byte state x.
fn _tn_md2_block(x, m, s): i64 {
    var j = 0;
    while (j < 16) {
        var b = load8(m + j) & 0xFF;
        store8(x + 16 + j, b);
        store8(x + 32 + j, b ^ (load8(x + j) & 0xFF));
        j = j + 1;
    }
    var t = 0;
    j = 0;
    while (j < 18) {
        var k = 0;
        while (k < 48) {
            t = (load8(x + k) & 0xFF) ^ (load8(s + t) & 0xFF);
            store8(x + k, t);
            k = k + 1;
        }
        t = (t + j) & 0xFF;
        j = j + 1;
    }
    return 0;
}

# MD2 (RFC 1319) of p[0..n) into out[0..16). Allocates nothing, as _tn_md5. Used ONLY to read Windows'
# disallowed list: the signature hash (crypt32's prop 15) of an md2WithRSA certificate is the MD2 of
# its tbsCertificate (measured on cass: VeriSign's Class 3 Public Primary Certification Authority,
# d7c63be0 ... 5f986ad8), and a match can only distrust, so MD2's weakness cannot make anything
# trusted. CHANGELOG [6.7.16]
fn _tn_md2(p, n, out): i64 {
    var s[256];
    var x[48];
    var c[24];
    var tail[16];
    _tn_md2_s(&s);
    memset(&x, 0, 48);
    memset(&c, 0, 24);
    var off = 0;
    while (off + 16 <= n) {
        _tn_md2_sum(&c, p + off, &s);
        _tn_md2_block(&x, p + off, &s);
        off = off + 16;
    }
    var rem = n - off;
    memcpy(&tail, p + off, rem);
    memset(&tail + rem, 16 - rem, 16 - rem);         # i bytes of value i (RFC 1319 §3.1)
    _tn_md2_sum(&c, &tail, &s);
    _tn_md2_block(&x, &tail, &s);
    _tn_md2_block(&x, &c, &s);                       # the checksum, the last block (§3.3)
    memcpy(out, &x, 16);
    return 0;
}

# The MD5 of the subjectPublicKey of the DER certificate der[0..dlen) into out[0..16) — the key bytes
# of SubjectPublicKeyInfo's BIT STRING, its unused-bits octet excluded (crypt32's prop 25). 1, or 0
# when the DER does not have that shape.
fn _tn_spki_md5(der, dlen, out): i64 {
    var cp = 0;
    var cl = 0;
    if (_tn_der_hdr(der, dlen, 0, &cp, &cl) != 0x30) { return 0; }      # Certificate
    var tp = 0;
    var tl = 0;
    if (_tn_der_hdr(der, dlen, cp, &tp, &tl) != 0x30) { return 0; }     # tbsCertificate
    var end = tp + tl;
    var pos = tp;
    var xp = 0;
    var xl = 0;
    var tag = _tn_der_hdr(der, end, pos, &xp, &xl);
    if (tag == 0xA0) {                                                  # [0] version
        pos = xp + xl;
        tag = _tn_der_hdr(der, end, pos, &xp, &xl);
    }
    var skip = 0;                       # serial, signature, issuer, validity, subject
    while (skip < 5) {
        if (tag < 0) { return 0; }
        pos = xp + xl;
        tag = _tn_der_hdr(der, end, pos, &xp, &xl);
        skip = skip + 1;
    }
    if (tag != 0x30) { return 0; }                                      # subjectPublicKeyInfo
    var send = xp + xl;
    var ap = 0;
    var al = 0;
    if (_tn_der_hdr(der, send, xp, &ap, &al) != 0x30) { return 0; }     # algorithm
    var bp = 0;
    var bl = 0;
    if (_tn_der_hdr(der, send, ap + al, &bp, &bl) != 0x03) { return 0; }   # subjectPublicKey
    if (bl < 2) { return 0; }
    _tn_md5(der + bp + 1, bl - 1, out);
    return 1;
}

# SHA-1 (FIPS 180-4) of p[0..n) into out[0..20), big-endian. Allocates nothing, as _tn_md5 does —
# the verifier runs it per connect. Used ONLY to read Windows' disallowed list, whose 20-byte
# identifiers are a SHA-1-signed certificate's signature hash: a match can only distrust, so SHA-1's
# collisions cannot make anything trusted. CHANGELOG [6.7.15]
fn _tn_sha1(p, n, out): i64 {
    var st[40];
    var w[640];
    var tail[128];
    store64(&st, 0x67452301);
    store64(&st + 8, 0xEFCDAB89);
    store64(&st + 16, 0x98BADCFE);
    store64(&st + 24, 0x10325476);
    store64(&st + 32, 0xC3D2E1F0);
    var off = 0;
    while (off + 64 <= n) {
        _tn_sha1_block(&st, p + off, &w);
        off = off + 64;
    }
    var rem = n - off;
    memset(&tail, 0, 128);
    memcpy(&tail, p + off, rem);
    store8(&tail + rem, 0x80);
    var tl = 64;
    if (rem >= 56) { tl = 128; }
    var bits = n * 8;
    var i = 0;
    while (i < 8) {                                         # the bit length, big-endian
        store8(&tail + tl - 1 - i, (bits >> (i * 8)) & 0xFF);
        i = i + 1;
    }
    _tn_sha1_block(&st, &tail, &w);
    if (tl == 128) { _tn_sha1_block(&st, &tail + 64, &w); }
    i = 0;
    while (i < 5) {
        var v = load64(&st + i * 8);
        store8(out + i * 4, (v >> 24) & 0xFF);
        store8(out + i * 4 + 1, (v >> 16) & 0xFF);
        store8(out + i * 4 + 2, (v >> 8) & 0xFF);
        store8(out + i * 4 + 3, v & 0xFF);
        i = i + 1;
    }
    return 0;
}

# One SHA-1 compression of the 64-byte block `m` into st[0..5) (32-bit words in i64 slots), with `w`
# the 80-word schedule (8 B a word).
fn _tn_sha1_block(st, m, w): i64 {
    var i = 0;
    while (i < 16) {
        store64(w + i * 8, ((load8(m + i * 4) & 0xFF) << 24) | ((load8(m + i * 4 + 1) & 0xFF) << 16)
          | ((load8(m + i * 4 + 2) & 0xFF) << 8) | (load8(m + i * 4 + 3) & 0xFF));
        i = i + 1;
    }
    while (i < 80) {
        var x = load64(w + (i - 3) * 8) ^ load64(w + (i - 8) * 8) ^ load64(w + (i - 14) * 8) ^ load64(w + (i - 16) * 8);
        store64(w + i * 8, ((x << 1) | (x >> 31)) & 0xFFFFFFFF);
        i = i + 1;
    }
    var a = load64(st);
    var b = load64(st + 8);
    var c = load64(st + 16);
    var d = load64(st + 24);
    var e = load64(st + 32);
    i = 0;
    while (i < 80) {
        var f = 0;
        var k = 0;
        if (i < 20) {
            f = (b & c) | ((~b) & d);
            k = 0x5A827999;
        } elif (i < 40) {
            f = b ^ c ^ d;
            k = 0x6ED9EBA1;
        } elif (i < 60) {
            f = (b & c) | (b & d) | (c & d);
            k = 0x8F1BBCDC;
        } else {
            f = b ^ c ^ d;
            k = 0xCA62C1D6;
        }
        var t = ((((a << 5) | (a >> 27)) & 0xFFFFFFFF) + (f & 0xFFFFFFFF) + e + k + load64(w + i * 8)) & 0xFFFFFFFF;
        e = d;
        d = c;
        c = ((b << 30) | (b >> 2)) & 0xFFFFFFFF;
        b = a;
        a = t;
        i = i + 1;
    }
    store64(st, (load64(st) + a) & 0xFFFFFFFF);
    store64(st + 8, (load64(st + 8) + b) & 0xFFFFFFFF);
    store64(st + 16, (load64(st + 16) + c) & 0xFFFFFFFF);
    store64(st + 24, (load64(st + 24) + d) & 0xFFFFFFFF);
    store64(st + 32, (load64(st + 32) + e) & 0xFFFFFFFF);
    return 0;
}

# The digest id _tn_tbs_sigalg answers for md2WithRSA: MD2's hash is 16 bytes, as MD5's (id 16) is, so
# the id cannot be its length. CHANGELOG [6.7.16]
const _TN_DG_MD2 = 2;

# The hash length of digest id `dg` (_tn_tbs_sigalg): 16 for MD2, the id itself for every other.
fn _tn_dg_len(dg): i64 {
    if (dg == _TN_DG_MD2) { return 16; }
    return dg;
}

# The digest of the DER certificate der[0..dlen)'s own signature, from its signatureAlgorithm, as a
# digest id — each its hash's length but MD2's (_tn_dg_len): 20 for sha1WithRSAEncryption
# (1.2.840.113549.1.1.5) / ecdsa-with-SHA1 (1.2.840.10045.4.1), 32 for sha256WithRSA (.1.1.11) /
# ecdsa-with-SHA256 (.4.3.2), 48 for SHA-384 (.1.1.12 / .4.3.3), 64 for SHA-512 (.1.1.13 / .4.3.4), 16
# for md5WithRSA (.1.1.4) and _TN_DG_MD2 for md2WithRSA (.1.1.2), whose hash is 16 bytes too — with the
# tbsCertificate TLV's offset and length at `ptp` / `ptn`. 0 for any other algorithm (RSASSA-PSS, whose
# prop 15 is unmeasured, Ed25519, md4WithRSA, ...: not judged), -1 when the DER does not have that
# shape. CHANGELOG [6.7.14], [6.7.15], [6.7.16]
fn _tn_tbs_sigalg(der, dlen, ptp, ptn): i64 {
    var cp = 0;
    var cl = 0;
    if (_tn_der_hdr(der, dlen, 0, &cp, &cl) != 0x30) { return 0 - 1; }      # Certificate
    var end = cp + cl;
    var tp = 0;
    var tl = 0;
    if (_tn_der_hdr(der, end, cp, &tp, &tl) != 0x30) { return 0 - 1; }     # tbsCertificate
    var ap = 0;
    var al = 0;
    if (_tn_der_hdr(der, end, tp + tl, &ap, &al) != 0x30) { return 0 - 1; }   # signatureAlgorithm
    var op = 0;
    var ol = 0;
    if (_tn_der_hdr(der, ap + al, ap, &op, &ol) != 0x06) { return 0 - 1; }
    store64(ptp, cp);
    store64(ptn, tp + tl - cp);
    if (ol == 9) {                                  # 1.2.840.113549.1.1.x: x WithRSAEncryption
        if (memeq(der + op, "\x2a\x86\x48\x86\xf7\x0d\x01\x01", 8) == 1) {
            var r = load8(der + op + 8) & 0xFF;
            if (r == 2) { return _TN_DG_MD2; }
            if (r == 4) { return 16; }
            if (r == 5) { return 20; }
            if (r == 11) { return 32; }
            if (r == 12) { return 48; }
            if (r == 13) { return 64; }
        }
        return 0;
    }
    if (ol == 7) {                                  # ecdsa-with-SHA1 1.2.840.10045.4.1
        if (memeq(der + op, "\x2a\x86\x48\xce\x3d\x04\x01", 7) == 1) { return 20; }
        return 0;
    }
    if (ol == 8) {                                  # ecdsa-with-SHA2 1.2.840.10045.4.3.x
        if (memeq(der + op, "\x2a\x86\x48\xce\x3d\x04\x03", 7) == 1) {
            var e = load8(der + op + 7) & 0xFF;
            if (e == 2) { return 32; }
            if (e == 3) { return 48; }
            if (e == 4) { return 64; }
        }
    }
    return 0;
}

# p[0..n) hashed with digest `dg` (_tn_tbs_sigalg's ids: 20 SHA-1, 32 SHA-256, 48 SHA-384, 64
# SHA-512, 16 MD5, _TN_DG_MD2 MD2) into out[0..its length). The length, or 0 for another id.
# CHANGELOG [6.7.16]
fn _tn_sighash_of(dg, p, n, out): i64 {
    if (dg == _TN_DG_MD2) {
        _tn_md2(p, n, out);
        return 16;
    }
    if (dg == 16) {
        _tn_md5(p, n, out);
        return 16;
    }
    if (dg == 20) { _tn_sha1(p, n, out); }
    if (dg == 32) { sha256(p, n, out); }
    if (dg == 48) { sha384(p, n, out); }
    if (dg == 64) { sha512(p, n, out); }
    if (_tn_pol_sig_off(dg) == 0) { return 0; }
    return dg;
}

# The signature hash (crypt32's prop 15) of the DER certificate der[0..dlen) into out[0..64): its
# tbsCertificate TLV hashed with its own signature digest. The hash's length (16 MD2 / MD5, 20 / 32 /
# 48 / 64), 0 when it is signed with an algorithm this does not judge (see _tn_tbs_sigalg), -1 when
# the DER does not have that shape. CHANGELOG [6.7.14], [6.7.15], [6.7.16]
fn _tn_tbs_sighash(der, dlen, out): i64 {
    var tp = 0;
    var tn = 0;
    var dg = _tn_tbs_sigalg(der, dlen, &tp, &tn);
    if (dg <= 0) { return dg; }
    return _tn_sighash_of(dg, der + tp, tn, out);
}

# 1 when the DER certificate der[0..dlen)'s signature hash is one of `pol`'s deny signature hashes of
# its length, 2 when its shape cannot be read while any are listed, else 0 (a certificate signed with
# an algorithm not judged, or whose digest's list is empty, is not judged by them). An MD2 / MD5-signed
# certificate's 16-byte hash is judged by the policy's 16-byte list, the deny keys at [0] — a 16-byte
# CTL entry is applied under both readings, the public-key MD5 and the signature hash (6.7.16; see
# _TN_POL_LEN). Hashes only when that length's list is non-empty — the Windows system set's — so no
# other policy pays for it. CHANGELOG [6.7.14], [6.7.15], [6.7.16]
fn _tn_pol_tbs_denied(pol, der, dlen): i64 {
    var any = load64(pol) + load64(pol + 48) + load64(pol + 64) + load64(pol + 80) + load64(pol + 96);
    if (any <= 0) { return 0; }
    var tp = 0;
    var tn = 0;
    var dg = _tn_tbs_sigalg(der, dlen, &tp, &tn);
    if (dg < 0) { return 2; }
    if (dg == 0) { return 0; }
    var len = _tn_dg_len(dg);
    var o = _tn_pol_sig_off(len);              # 0 for 16: the deny-key list's {count, ptr} at [0]
    var nt = load64(pol + o);
    if (nt <= 0) { return 0; }
    var t[64];
    _tn_sighash_of(dg, der + tp, tn, &t);
    var hs = load64(pol + o + 8);
    var i = 0;
    while (i < nt) {
        if (memeq(hs + i * len, &t, len) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Whether `pol` distrusts the DER certificate der[0..dlen): 1 when its key's MD5 is a deny key, its
# signature hash a deny signature hash, or it is a deny cert; 2 when its key cannot be read while
# there are deny keys, or its shape while there are deny signature hashes (it cannot be judged, so it
# is not trusted either); 0 otherwise.
fn _tn_pol_der_denied(pol, der, dlen): i64 {
    var nk = load64(pol);
    if (nk > 0) {
        var h[16];
        if (_tn_spki_md5(der, dlen, &h) == 0) { return 2; }
        var keys = load64(pol + 8);
        var i = 0;
        while (i < nk) {
            if (memeq(keys + i * 16, &h, 16) == 1) { return 1; }
            i = i + 1;
        }
    }
    var td = _tn_pol_tbs_denied(pol, der, dlen);
    if (td != 0) { return td; }
    var nc = load64(pol + 16);
    var certs = load64(pol + 24);
    var j = 0;
    while (j < nc) {
        if (load64(certs + j * 16 + 8) == dlen) {
            if (memeq(load64(certs + j * 16), der, dlen) == 1) { return 1; }
        }
        j = j + 1;
    }
    return 0;
}

# 1 when `pol` (0 = none) distrusts the parsed certificate `cert` (see _tn_pol_der_denied), else 0.
fn _tn_pol_denied(pol, cert): i64 {
    if (pol == 0) { return 0; }
    if (_tn_pol_der_denied(pol, load64(cert), load64(cert + 8)) != 0) { return 1; }
    return 0;
}

# 1 when the trusted root `r` may anchor `leaf` under `pol` (0 = none): `r` is not distrusted, and a
# root carrying an issuance bound anchors only a leaf whose notBefore precedes it.
fn _tn_pol_anchor_ok(pol, r, leaf): i64 {
    if (pol == 0) { return 1; }
    if (_tn_pol_denied(pol, r) == 1) { return 0; }
    var der = load64(r);
    var dlen = load64(r + 8);
    var nb = load64(pol + 32);
    var bounds = load64(pol + 40);
    var i = 0;
    while (i < nb) {
        var e = bounds + i * 24;
        if (load64(e + 8) == dlen) {
            if (memeq(load64(e), der, dlen) == 1) {
                if (x509_cert_not_before(leaf) >= load64(e + 16)) { return 0; }
            }
        }
        i = i + 1;
    }
    return 1;
}

# The most certificates _tn_verify_chain's path holds: the leaf, then one CA per step up — at most
# the 16 intermediates the Certificate parsers keep, plus one more step the walk's `ni + 1` bound
# allows (a step that can only fail). CHANGELOG [6.7.18]
const _TN_CHAIN_PATH_MAX = 18;

# 1 when the CA `ca`'s nameConstraints (RFC 5280 §4.2.1.10; none = 1) allow every certificate of
# `path`[0 .. n) — the leaf (`path`[0]) always, an intermediate unless it is self-issued (RFC 5280
# §6.1.3(b): a self-issued certificate other than the last is not checked) — through sigil's
# x509_name_constraints_check for the leaf and x509_name_constraints_check_ca for an intermediate
# (dNSName and iPAddress subtrees permitted and excluded, directoryName permitted, the LEAF's
# subject CN as a dNSName when it has none — a CA's CN names the CA, as OpenSSL reads it at depth 0
# only; any other constrained form refuses a cert carrying it). CYRIUS-2026-0042, CHANGELOG [6.7.18]
fn _tn_nc_below_ok(ca, path, n): i64 {
    if (x509_cert_has_name_constraints(ca) == 0) { return 1; }
    var k = 0;
    while (k < n) {
        var c = load64(path + k * 8);
        if (k == 0) {
            if (x509_name_constraints_check(ca, c) == 0) { return 0; }
        } else {
            if (_x509_self_issued(c) == 0) {
                if (x509_name_constraints_check_ca(ca, c) == 0) { return 0; }
            }
        }
        k = k + 1;
    }
    return 1;
}

# The chain verifier both roles share (6.6.14): `leaf` (a parsed x509 cert, or 0), `inters` (the
# peer's other certificates, [count][cert ptrs] in TLS order, or 0) and the ctx's trust roots
# (TLS_CTX_OFF_CA_ROOT, whatever tls_native_set_ca_bundle / tls_native_set_ca_system /
# tls_ctx_load_verify_locations installed). TLS_OK on a verified path to a trusted, in-window CA
# root with the leaf fit for `purpose`; otherwise the ctx fails with TLS_ERR_CERT_INVALID — no
# leaf, NO TRUST ROOTS (fail closed, as OpenSSL does), a leaf out of its window or unfit for
# `purpose`, or no path. No hostname here: the client binds the host after this
# (_tn_connect_verify); a server has no name to bind a client to.
#
# Why not sigil's x509_verify_chain directly: that primitive has a RIGID
# contract — `intermediates` must be EXACTLY the ordered path root..leaf-signer,
# every cert used. Real servers don't honor that. A server MAY include its
# trust-anchor (or a cross-signed copy of it) in the Certificate message
# (RFC 8446 §4.4.2 makes the self-signed anchor OPTIONAL, not forbidden), and
# may list certs out of strict order. example.com fronted by Cloudflare sends
# leaf + 3 intermediates where the top entry is the SSL.com root cross-signed by
# AAA — the rigid verify then fails `_x509_issuer_matches` on that extra cert.
# 1.1.1.1 happens to send a clean leaf+1-intermediate chain, so it passed; that
# asymmetry was the reported "native handshake gap" (it's actually a chain-
# verification gap — the handshake itself completes for both).
#
# Path-build from the leaf upward instead: at each node, (1) anchor immediately
# if a trusted root issuer-matches AND signs it (so a wire-included root /
# cross-cert is harmlessly unused), else (2) follow ONE verified signing
# intermediate (CA + in-window + good signature). Extra / out-of-order /
# cross-signed certs are simply never selected. Every link is signature-checked;
# we only anchor at a trusted, in-window CA root — same security floor as the old
# rigid path, just tolerant of real-world chains. The `ni + 1` iteration bound
# terminates any cross-sign cycle. See
# docs/development/issues/archived/2026-06-09-native-tls-handshake-gap-public-servers.md,
# CHANGELOG [6.1.19].
# ⛔ 6.6.14 (CYRIUS-2026-0019) — WHY. This was the client's verifier only, and the server checked a client
# certificate's POSSESSION (its CertificateVerify) and never its chain: any self-signed leaf was
# accepted as an identity by a server that asked for verification. CHANGELOG [6.6.14]
# ⛔ 6.7.18 (CYRIUS-2026-0042) — WHY `path`: a CA's nameConstraints bind EVERY certificate below it
# (RFC 5280 §6.1.4(g)), and this walker read none, so a subordinate CA constrained to good.test
# vouched for any host. sigil 3.13.14's _x509_verify_link applies only the DIRECT issuer's, and
# exempts a self-issued CA child even when that child is the leaf. So the path selected so far is
# kept, and each candidate CA — every intermediate and the trust anchor — must allow all of it
# (_tn_nc_below_ok) inside the conjunction that SELECTS it: one that does not is skipped, as a
# wrongly purposed CA is. CHANGELOG [6.7.18]
fn _tn_verify_chain(ctx, leaf, inters, now_unix, purpose): i64 {
    var path: i64[_TN_CHAIN_PATH_MAX];      # path[0] the leaf, path[k] the CA selected at depth k - 1
    path[0] = leaf;
    var rootset = load64(ctx + TLS_CTX_OFF_CA_ROOT);
    if (leaf == 0) { return _tn_ctx_fail(ctx, TLS_ERR_CERT_INVALID); }
    if (rootset == 0) { return _tn_ctx_fail(ctx, TLS_ERR_CERT_INVALID); }
    if (_x509_in_window(leaf, now_unix) == 0) { return _tn_ctx_fail(ctx, TLS_ERR_CERT_INVALID); }
    # CYRIUS-2026-0002 (v6.1.36): the leaf must permit the TLS identity it is used as.
    if (_tn_leaf_purpose_ok(leaf, purpose) != 1) { return _tn_ctx_fail(ctx, TLS_ERR_CERT_INVALID); }
    # 6.7.12: the root set's trust policy (Windows' disallowed list and store, the per-root issuance
    # bound) binds every certificate of the path — the leaf here, each CA where it is selected.
    var pol = load64(ctx + TLS_CTX_OFF_CA_POLICY);
    if (_tn_pol_denied(pol, leaf) == 1) { return _tn_ctx_fail(ctx, TLS_ERR_CERT_INVALID); }
    var ni = 0;
    if (inters != 0) { ni = load64(inters); }
    var rcount = load64(rootset);
    var cur = leaf;
    var depth = 0;
    while (depth <= ni + 1) {
        # (1) Anchor: a trusted root that issuer-matches AND signs `cur`.
        var ri = 0;
        while (ri < rcount) {
            var R = load64(rootset + 8 + ri * 8);
            if (_x509_issuer_matches(cur, R) == 1) {
                if (_x509_in_window(R, now_unix) == 1) {
                    if (x509_cert_is_ca(R) == 1) {
                        if (_x509_verify_link(cur, R) == 1) {
                            # CYRIUS-2026-0002: the anchoring root must assert keyCertSign
                            # (if it has keyUsage) + honor pathLen for `depth`;
                            # 6.6.16: and its EKU must permit `purpose`; 6.7.12: and the policy
                            # must let it anchor this leaf; 6.7.18: and its nameConstraints must
                            # allow the whole path below it.
                            if (_tn_ca_signer_ok(R, depth, purpose) == 1) {
                                if (_tn_pol_anchor_ok(pol, R, leaf) == 1) {
                                    if (_tn_nc_below_ok(R, &path, depth + 1) == 1) { return TLS_OK; }
                                }
                            }
                        }
                    }
                }
            }
            ri = ri + 1;
        }
        # (2) Else follow ONE signing intermediate up (CA + in-window + verified).
        var nextp = 0;
        var ii = 0;
        while (ii < ni) {
            var P = load64(inters + 8 + ii * 8);
            if (P != cur) {
                if (_x509_issuer_matches(cur, P) == 1) {
                    if (x509_cert_is_ca(P) == 1) {
                        if (_x509_in_window(P, now_unix) == 1) {
                            if (_x509_verify_link(cur, P) == 1) {
                                # CYRIUS-2026-0002: signing intermediate must assert
                                # keyCertSign + honor pathLen for `depth`;
                                # 6.6.16: and its EKU must permit `purpose`; 6.7.12: and the
                                # policy must not distrust it; 6.7.18: and its nameConstraints
                                # must allow the whole path below it.
                                if (_tn_ca_signer_ok(P, depth, purpose) == 1) {
                                    if (_tn_pol_denied(pol, P) == 0) {
                                        if (_tn_nc_below_ok(P, &path, depth + 1) == 1) { nextp = P; ii = ni; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            ii = ii + 1;
        }
        if (nextp == 0) { return _tn_ctx_fail(ctx, TLS_ERR_CERT_INVALID); }
        cur = nextp;
        depth = depth + 1;
        # A path no peer can send (the Certificate parsers keep 16 intermediates) is refused.
        if (depth >= _TN_CHAIN_PATH_MAX) { return _tn_ctx_fail(ctx, TLS_ERR_CERT_INVALID); }
        path[depth] = cur;
    }
    return _tn_ctx_fail(ctx, TLS_ERR_CERT_INVALID);
}

# Client: verify the server's certificate chain — its leaf and the intermediates it sent, as a TLS
# server identity — by the path building of _tn_verify_chain (above; v6.1.19, RFC 5280 §6.1 /
# RFC 8446 §4.4.2). `now_unix` is the validation time (the caller supplies it). Returns TLS_OK on a
# verified path to a trusted, in-window CA root, else TLS_ERR_CERT_INVALID (the ctx failed).
fn tls_native_client_verify_chain(ctx, now_unix): i64 {
    if (ctx == 0) { return TLS_ERR_INVALID_PARAM; }
    return _tn_verify_chain(ctx, load64(ctx + TLS_CTX_OFF_SERVER_CERT),
      load64(ctx + TLS_CTX_OFF_SERVER_INTERS), now_unix, _TN_PURPOSE_SERVER);
}
