# Build context for docker/Dockerfile*. The source build needs the manifest,
# VERSION, src/, the vendored lib/ and cyrius.lock (plus scripts/ and tests/
# for the dev image); everything else stays out.
.git/
.github/
.claude/
docs/
benchmarks/
examples/

# Build outputs and the tracked binaries (the image builds its own)
build/
/ifran

# Runtime artifacts
ifran.db
*.db-journal
runs/

# Models (too large, never part of an image)
*.gguf
*.safetensors
*.bin
*.onnx
*.pt
