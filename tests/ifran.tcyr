# ifran test suite — M1: jobspec parse, run store round-trip, the executor
# (happy path + spawn-failure), all against /tmp (no repo-cwd artifacts).
# assert is a [test] stdlib leaf (2.4): the explicit include keeps this file
# self-contained for tools that compile it outside the test scope.
include "lib/assert.cyr"
include "src/jobspec.cyr"
include "src/runstore.cyr"
include "src/run.cyr"
include "src/keys.cyr"
include "src/store.cyr"
include "src/dataset.cyr"
include "src/sweep.cyr"
include "src/eval.cyr"
include "src/pref.cyr"

fn _t_write(path, s): i64 {
    file_write_all(path, s, strlen(s));
    return 0;
}

# a + b as one fresh cstr (keeps long spec literals under lint's 120 columns)
fn _t_cat(a, b): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_cstr(str_builder_build(sb));
}

fn test_jobspec(): i64 {
    var p = "/tmp/ifran_test_job.cyml";
    var good = "[job]\nname = \"t1\"\nbin = \"/bin/echo\"\nargs = \"hello ifran\"\nlogdir = \"/tmp/ifran_test_logs\"\n";
    _t_write(p, good);
    var js = jobspec_parse(p);
    assert_nonnull(js, "good spec parses");
    assert(streq(jobspec_name(js), "t1"), "name parsed");
    assert(streq(jobspec_bin(js), "/bin/echo"), "bin parsed");
    assert_eq(vec_len(jobspec_argv(js)), 3, "argv = bin + 2 split args");
    assert(streq(vec_get(jobspec_argv(js), 2), "ifran"), "arg split");
    assert(streq(jobspec_logdir(js), "/tmp/ifran_test_logs"), "logdir parsed");

    var noname = "[job]\nbin = \"/bin/echo\"\n";
    _t_write(p, noname);
    assert_eq(jobspec_parse(p), 0, "missing name rejected");
    var relbin = "[job]\nname = \"x\"\nbin = \"echo\"\n";
    _t_write(p, relbin);
    assert_eq(jobspec_parse(p), 0, "relative bin rejected");
    var nosec = "name = \"x\"\n";
    _t_write(p, nosec);
    assert_eq(jobspec_parse(p), 0, "missing [job] section rejected");

    # ---- Lane 1 (2.1): quoted args + timeout_s --------------------------------
    # a TOML literal string ('...') carries the double quotes to the splitter
    var q1 = "[job]\nname = \"q\"\nbin = \"/bin/echo\"\nargs = '''pre \"two words\" post'''\n";
    _t_write(p, q1);
    var qjs = jobspec_parse(p);
    assert_nonnull(qjs, "quoted-args spec parses");
    assert_eq(vec_len(jobspec_argv(qjs)), 4, "quoted group = one arg (bin + 3)");
    assert(streq(vec_get(jobspec_argv(qjs), 2), "two words"), "quotes group + strip");
    assert(streq(vec_get(jobspec_argv(qjs), 3), "post"), "post-quote token intact");
    var q3 = "[job]\nname = \"q\"\nbin = \"/bin/echo\"\nargs = '''dangling \"open'''\n";
    _t_write(p, q3);
    assert_eq(jobspec_parse(p), 0, "unterminated quote rejected");
    var t1s = "[job]\nname = \"t\"\nbin = \"/bin/echo\"\ntimeout_s = 42\n";
    _t_write(p, t1s);
    var tjs = jobspec_parse(p);
    assert_nonnull(tjs, "timeout spec parses");
    assert_eq(jobspec_timeout(tjs), 42, "timeout_s parsed");
    assert_eq(jobspec_timeout(js), 0, "absent timeout_s -> 0");

    # the escape path, driven directly (dodges the CYML escaping layer):
    var ev = vec_new();
    assert_eq(_js_split_args("a \"b \\\" c\" d", ev), 0, "escape split ok");
    assert_eq(vec_len(ev), 3, "three tokens");
    assert(streq(vec_get(ev, 1), "b \" c"), "backslash-quote escapes inside quotes");
    return 0;
}

fn test_run_and_store(): i64 {
    sys_unlink("/tmp/ifran_test.db");
    runstore_set_path("/tmp/ifran_test.db");

    # happy path: /bin/echo through the full executor
    var p = "/tmp/ifran_test_job.cyml";
    var good = "[job]\nname = \"echo\"\nbin = \"/bin/echo\"\nargs = \"m1 proof\"\nlogdir = \"/tmp/ifran_test_logs\"\n";
    _t_write(p, good);
    var js = jobspec_parse(p);
    assert_nonnull(js, "echo spec parses");
    var rc = run_job(js);
    assert_eq(rc, 0, "echo job exits 0 through the executor");
    # the captured log holds the child's stdout
    var buf = alloc(256);
    var n = file_read_all("/tmp/ifran_test_logs/run-1.log", buf, 256);
    assert_gt(n, 0, "log file written");
    assert_eq(load8(buf), 109, "log starts with the child's output ('m')");

    # failure path: nonexistent binary -> exit 127 recorded, run_job returns it
    var bad = "[job]\nname = \"ghost\"\nbin = \"/nonexistent/nope\"\nlogdir = \"/tmp/ifran_test_logs\"\n";
    _t_write(p, bad);
    var js2 = jobspec_parse(p);
    var rc2 = run_job(js2);
    assert_eq(rc2, 127, "exec failure surfaces as exit 127");

    # both runs recorded
    var db = runstore_open();
    var rs = patra_query(db, "SELECT id, status, exit_code FROM runs");
    assert_nonnull(rs, "runs query works");
    assert_eq(patra_result_count(rs), 2, "two run records");
    assert_eq(patra_result_get_int(rs, 0, 2), 0, "run 1 exit 0");
    assert_eq(patra_result_get_int(rs, 1, 2), 127, "run 2 exit 127");
    patra_result_free(rs);

    # ---- Lane 1 (2.1): timeout enforcement ------------------------------------
    var tsp1 = "[job]\nname = \"sleepy\"\nbin = \"/usr/bin/sleep\"\nargs = \"30\"\n";
    var tsp2 = "logdir = \"/tmp/ifran_test_logs\"\ntimeout_s = 1\n";
    var tsb = str_builder_new();
    str_builder_add_cstr(tsb, tsp1);
    str_builder_add_cstr(tsb, tsp2);
    var tspec = str_cstr(str_builder_build(tsb));
    _t_write(p, tspec);
    var js3 = jobspec_parse(p);
    assert_nonnull(js3, "timeout spec parses");
    var tt0 = clock_now_ms();
    var rc3 = run_job(js3);
    var tdur = clock_now_ms() - tt0;
    assert_eq(rc3, 137, "timed-out child exits 128+SIGKILL");
    assert(tdur < 5000, "timeout enforced well before the 30 s sleep");
    var rs2 = patra_query(db, "SELECT status, pid FROM runs WHERE id = 3");
    assert_nonnull(rs2, "run 3 queried");
    var stp = patra_result_get_str(rs2, 0, 0);
    var stl = patra_result_get_str_len(rs2, 0, 0);
    assert_eq(stl, 9, "status len = timed-out");
    assert_eq(load8(stp), 116, "status starts 't' (timed-out)");
    assert_gt(patra_result_get_int(rs2, 0, 1), 0, "child pid recorded on the row");
    patra_result_free(rs2);

    # ---- Lane 1 (2.1): reaper -------------------------------------------------
    # a fake `running` row with a definitely-dead pid gets orphaned; live rows
    # are left alone (probe our own pid as the live case)
    var oid = runstore_start("orphan", "/bin/echo", "x", 0);
    assert_gt(oid, 0, "fake running row inserted");
    runstore_set_pid(oid, 999999999);
    var reaped = runstore_reap();
    assert_eq(reaped, 1, "dead-pid running row reaped");
    var rs3 = patra_query(db, "SELECT status FROM runs WHERE id = 4");
    assert_eq(patra_result_get_str_len(rs3, 0, 0), 8, "status len = orphaned");
    assert_eq(load8(patra_result_get_str(rs3, 0, 0)), 111, "status starts 'o' (orphaned)");
    patra_result_free(rs3);
    var lid = runstore_start("alive", "/bin/echo", "x", 0);
    runstore_set_pid(lid, sys_getpid());
    assert_eq(runstore_reap(), 0, "live-pid running row left alone");
    runstore_finish(lid, 0, 0, "done", "");
    return 0;
}

fn test_keys(): i64 {
    keys_set_dir("/tmp/ifran_test_keys");
    sys_unlink("/tmp/ifran_test_keys/operator.sk");
    sys_unlink("/tmp/ifran_test_keys/operator.pk");
    assert_eq(keys_init(), 0, "keys init generates");
    assert_nonnull(keys_sk(), "sk loads");
    assert_nonnull(keys_pk(), "pk loads");
    assert_eq(keys_init(), 1, "keys init refuses to overwrite");
    return 0;
}

fn _t_shp1(a): i64 { var s = alloc(8); store64(s, a); return s; }

# build a small tula artifact in-memory; sk==0 -> unsigned
fn _t_make_tula(path, sk): i64 {
    var data = t_zeroes(64);
    var b = tula_builder_new();
    tula_builder_add(b, "w", TULA_DT_F64, _t_shp1(8), 1, data, 64);
    var buf = 0;
    if (sk != 0) { buf = tula_builder_finish_signed(b, sk); }
    else { buf = tula_builder_finish(b); }
    var total = tula_total_len(buf);
    tula_write_file(path, buf, total);
    return total;
}

fn t_zeroes(n): i64 { return alloc(n); }

# a tula file holding two LoRA tensors whose names are over 47 chars, so tula
# (1.3.0+) adds its reserved names table as a third entry; `seed` varies the
# payload so each call is new content to the store
fn _t_make_tula_long(path, seed): i64 {
    var data = t_zeroes(64);
    store8(data, seed);
    var na = "base_model.model.model.layers.0.self_attn.q_proj.lora_A.weight";    # 62 chars
    var nb = "base_model.model.model.layers.0.self_attn.q_proj.lora_B.weight";
    var b = tula_builder_new();
    tula_builder_add_long(b, na, TULA_DT_F64, _t_shp1(4), 1, data, 32);
    tula_builder_add_long(b, nb, TULA_DT_F64, _t_shp1(4), 1, data + 32, 32);
    var buf = tula_builder_finish(b);
    var total = tula_total_len(buf);
    tula_write_file(path, buf, total);
    return total;
}

# the same two LoRA tensors plus file metadata (tula 1.6.0), so the file holds
# both reserved entries: `__tula.meta__` and the names table
fn _t_make_tula_meta(path, seed): i64 {
    var data = t_zeroes(64);
    store8(data, seed);
    var na = "base_model.model.model.layers.0.self_attn.q_proj.lora_A.weight";
    var nb = "base_model.model.model.layers.0.self_attn.q_proj.lora_B.weight";
    var b = tula_builder_new();
    tula_builder_add_long(b, na, TULA_DT_F64, _t_shp1(4), 1, data, 32);
    tula_builder_add_long(b, nb, TULA_DT_F64, _t_shp1(4), 1, data + 32, 32);
    tula_builder_set_meta(b, "model.arch", "lora");
    var buf = tula_builder_finish(b);
    var total = tula_total_len(buf);
    tula_write_file(path, buf, total);
    return total;
}

fn _t_models_count(db): i64 {
    var rs = patra_query(db, "SELECT id FROM models");
    if (rs == 0) { return 0; }
    var n = patra_result_count(rs);
    patra_result_free(rs);
    return n;
}

fn _t_model_int(db, id, col): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "SELECT ");
    str_builder_add_cstr(sb, col);
    str_builder_add_cstr(sb, " FROM models WHERE id = ?");
    var stmt = patra_prepare(db, str_cstr(str_builder_build(sb)));
    patra_bind_int(stmt, 0, id);
    var rs = patra_query_prepared(db, stmt);
    patra_finalize(stmt);
    var v = patra_result_get_int(rs, 0, 0);
    patra_result_free(rs);
    return v;
}

fn test_model_store(): i64 {
    store_set_dir("/tmp/ifran_test_store");
    var sk = keys_sk();

    # operator-signed -> verified
    _t_make_tula("/tmp/ifran_t_signed.tula", sk);
    var id1 = store_add("/tmp/ifran_t_signed.tula", "signed");
    assert_gt(id1, 0, "operator-signed artifact ingests");
    # unsigned -> accepted, honest status
    _t_make_tula("/tmp/ifran_t_unsigned.tula", 0);
    var id2 = store_add("/tmp/ifran_t_unsigned.tula", "unsigned");
    assert_gt(id2, 0, "unsigned artifact ingests (status recorded)");
    # dedup: same content -> same id
    var id3 = store_add("/tmp/ifran_t_signed.tula", "dup");
    assert_eq(id3, id1, "content-addressed dedup returns the existing id");
    # garbage -> structural reject
    var g = "this is not a tula file at all, not even close......";
    file_write_all("/tmp/ifran_t_garbage.tula", g, strlen(g));
    assert_eq(store_add("/tmp/ifran_t_garbage.tula", "junk"), 0 - 1, "garbage REJECTED");

    # sigstat truth: query the index
    var db = runstore_open();
    var stmt = patra_prepare(db, "SELECT sigstat FROM models WHERE id = ?");
    patra_bind_int(stmt, 0, id1);
    var rs = patra_query_prepared(db, stmt);
    patra_finalize(stmt);
    var p = patra_result_get_str(rs, 0, 0);
    assert_eq(load8(p), 118, "operator-signed records `verified` (v)");
    patra_result_free(rs);

    # verify: green, then tamper the stored file -> hash-mismatch FAIL
    assert_eq(store_verify(id1), 0, "verify green on the stored artifact");
    var stmt2 = patra_prepare(db, "SELECT path FROM models WHERE id = ?");
    patra_bind_int(stmt2, 0, id1);
    var rs2 = patra_query_prepared(db, stmt2);
    patra_finalize(stmt2);
    var pp = patra_result_get_str(rs2, 0, 0);
    var pl = patra_result_get_str_len(rs2, 0, 0);
    var path = alloc(pl + 1);
    memcpy(path, pp, pl);
    store8(path + pl, 0);
    patra_result_free(rs2);
    var fbuf = alloc(4096);
    var fn2 = file_read_all(path, fbuf, 4096);
    store8(fbuf + fn2 - 3, load8(fbuf + fn2 - 3) ^ 1);
    file_write_all(path, fbuf, fn2);
    assert_eq(store_verify(id1), 1, "tampered stored file FAILS verify (hash)");

    # ---- 2.5: long names — tula's names table is not a tensor -----------------
    _t_make_tula_long("/tmp/ifran_t_long.tula", 1);
    var idl = store_add("/tmp/ifran_t_long.tula", "lora");
    assert_gt(idl, 0, "long-name artifact ingests");
    assert_eq(_t_model_int(db, idl, "tensors"), 2, "2 tensors recorded (the names table is not counted)");
    # 2.5.1: tula 1.6.0's metadata entry is not a tensor either
    _t_make_tula_meta("/tmp/ifran_t_meta.tula", 1);
    var idm2 = store_add("/tmp/ifran_t_meta.tula", "lora+meta");
    assert_gt(idm2, 0, "an artifact with metadata ingests");
    assert_eq(_t_model_int(db, idm2, "tensors"), 2, "2 tensors recorded (the metadata table is not counted)");
    assert_eq(_t_model_int(db, idm2, "canonical"), 1, "and a tula-built file with metadata is canonical");

    # ---- 2.5: the stored copy is checked — a failed copy indexes nothing ------
    file_write_all("/tmp/ifran_t_notadir", "x", 1);
    store_set_dir("/tmp/ifran_t_notadir/store");
    _t_make_tula_long("/tmp/ifran_t_copyfail.tula", 2);
    var before = _t_models_count(db);
    assert_eq(store_add("/tmp/ifran_t_copyfail.tula", "nocopy"), 0 - 1, "an unwritable store dir refuses the add");
    assert_eq(_t_models_count(db), before, "nothing indexed for a copy that failed");
    store_set_dir("/tmp/ifran_test_store");

    # ---- 2.5: strict ingestion — the layout is recorded; opt-in flags refuse --
    assert_eq(_t_model_int(db, id1, "canonical"), 1, "a tula-built file records canonical (1)");
    # a canonical file plus 8 trailing bytes: it still opens, but it is not canonical
    var tl = _t_make_tula_long("/tmp/ifran_t_trail.tula", 3);
    var tb = alloc(tl + 8);
    file_read_all("/tmp/ifran_t_trail.tula", tb, tl);
    store64(tb + tl, 0);
    file_write_all("/tmp/ifran_t_trail.tula", tb, tl + 8);
    var idt = store_add("/tmp/ifran_t_trail.tula", "trailing");
    assert_gt(idt, 0, "a non-canonical file still ingests by default");
    assert_eq(_t_model_int(db, idt, "canonical"), 0 - 1, "and records non-canonical (-1)");
    var tl2 = _t_make_tula_long("/tmp/ifran_t_trail2.tula", 4);
    var tb2 = alloc(tl2 + 8);
    file_read_all("/tmp/ifran_t_trail2.tula", tb2, tl2);
    store64(tb2 + tl2, 0);
    file_write_all("/tmp/ifran_t_trail2.tula", tb2, tl2 + 8);
    var before2 = _t_models_count(db);
    assert_eq(store_add_policy("/tmp/ifran_t_trail2.tula", "s", 1, 0), 0 - 1, "--strict refuses a non-canonical file");
    assert_eq(_t_models_count(db), before2, "nothing indexed for a --strict refusal");
    # --require-signed: unsigned and another key's signature are refused
    _t_make_tula_long("/tmp/ifran_t_unsig2.tula", 5);
    assert_eq(store_add_policy("/tmp/ifran_t_unsig2.tula", "u", 0, 1), 0 - 1,
      "--require-signed refuses an unsigned file");
    var osk = alloc(64);
    memcpy(osk, sk, 64);
    store8(osk, load8(osk) ^ 255);
    _t_make_tula("/tmp/ifran_t_otherkey.tula", osk);
    assert_eq(store_add_policy("/tmp/ifran_t_otherkey.tula", "o", 0, 1), 0 - 1,
      "--require-signed refuses another key's signature");
    assert_eq(_t_models_count(db), before2, "nothing indexed for --require-signed refusals");
    assert_eq(store_add_policy("/tmp/ifran_t_signed.tula", "both", 1, 1), id1,
      "a canonical operator-signed file passes both flags");
    return 0;
}

fn _t_ds_field(db, id, col): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "SELECT ");
    str_builder_add_cstr(sb, col);
    str_builder_add_cstr(sb, " FROM datasets WHERE id = ?");
    var stmt = patra_prepare(db, str_cstr(str_builder_build(sb)));
    patra_bind_int(stmt, 0, id);
    var rs = patra_query_prepared(db, stmt);
    patra_finalize(stmt);
    var v = patra_result_get_int(rs, 0, 0);
    patra_result_free(rs);
    return v;
}

fn test_datasets(): i64 {
    dataset_set_dir("/tmp/ifran_test_data");
    var c = "alpha\nbeta\nalpha\ngamma\nbeta\ndelta\n";
    file_write_all("/tmp/ifran_t_corpus.txt", c, strlen(c));
    var id = dataset_add("/tmp/ifran_t_corpus.txt", "toy");
    assert_gt(id, 0, "corpus ingests");
    var db = runstore_open();
    assert_eq(_t_ds_field(db, id, "nlines"), 6, "line stat correct");
    assert_eq(dataset_add("/tmp/ifran_t_corpus.txt", "again"), id, "content dedup returns same id");
    assert_nonnull(dataset_path(id), "id resolves to a stored path");
    assert_eq(dataset_path(9999), 0, "dangling id resolves to 0");

    # ---- 2.2: dataset validate ------------------------------------------------
    assert_eq(dataset_validate(id), 0, "clean text corpus validates");
    assert_eq(dataset_validate(9999), 1, "validate on dangling id fails");
    # NUL contamination -> hard fail
    var nulc = alloc(16);
    memcpy(nulc, "ok\nbad", 6);
    store8(nulc + 6, 0);
    store8(nulc + 7, 10);
    file_write_all("/tmp/ifran_t_nul.txt", nulc, 8);
    var nid = dataset_add("/tmp/ifran_t_nul.txt", "nul");
    assert_gt(nid, 0, "nul corpus ingests");
    assert_eq(dataset_validate(nid), 1, "NUL bytes fail validation");
    # JSONL mode: good lines pass, a junk line fails
    var gj = "{\"a\":1}\n{\"b\":\"two\"}\n";
    file_write_all("/tmp/ifran_t_good.jsonl", gj, strlen(gj));
    var gid = dataset_add("/tmp/ifran_t_good.jsonl", "goodjsonl");
    assert_eq(dataset_validate(gid), 0, "well-formed JSONL validates");
    var bj = "{\"a\":1}\nnot json\n";
    file_write_all("/tmp/ifran_t_bad.jsonl", bj, strlen(bj));
    var bid = dataset_add("/tmp/ifran_t_bad.jsonl", "badjsonl");
    assert_eq(dataset_validate(bid), 1, "junk JSONL line fails validation");
    # 2.3.1+: a repeated top-level key fails too (bayan 1.11.1's flat parser)
    var kj = "{\"a\":1,\"b\":2}\n{\"a\":1,\"a\":2}\n";
    file_write_all("/tmp/ifran_t_dupkey.jsonl", kj, strlen(kj));
    var kid = dataset_add("/tmp/ifran_t_dupkey.jsonl", "dupkeyjsonl");
    assert_eq(dataset_validate(kid), 1, "duplicate-key JSONL line fails validation");

    # real line-dedup: 6 lines with 2 exact dups -> 4 kept, parent recorded
    var did = dataset_dedup(id);
    assert_gt(did, 0, "dedup derives a dataset");
    assert_eq(_t_ds_field(db, did, "nlines"), 4, "exact duplicates dropped (6 -> 4)");
    assert_eq(_t_ds_field(db, did, "parent"), id, "derivation parent recorded");

    # {dataset} placeholder resolves through a real job (/bin/cat prints it)
    var spec = _t_cat("[job]\nname = \"ds\"\nbin = \"/bin/cat\"\n",
      "args = \"{dataset}\"\nlogdir = \"/tmp/ifran_test_logs\"\ndataset = ");
    var sb = str_builder_new();
    str_builder_add_cstr(sb, spec);
    str_builder_add_int(sb, did);
    str_builder_add_cstr(sb, "\n");
    var full = str_cstr(str_builder_build(sb));
    file_write_all("/tmp/ifran_t_dsjob.cyml", full, strlen(full));
    var js = jobspec_parse("/tmp/ifran_t_dsjob.cyml");
    assert_nonnull(js, "dataset job parses");
    assert_eq(jobspec_dataset(js), did, "dataset id parsed");
    assert_eq(run_job(js), 0, "cat-the-dataset job runs");
    var buf = alloc(256);
    var n = file_read_all(run_last_log(), buf, 256);
    assert_gt(n, 0, "dataset-job log written");
    assert_eq(load8(buf), 97, "log begins with the corpus content ('a')");

    # dangling dataset reference fails loud, nothing spawned
    var bad = "[job]\nname = \"dsx\"\nbin = \"/bin/cat\"\nargs = \"{dataset}\"\ndataset = 9999\n";
    file_write_all("/tmp/ifran_t_dsjob.cyml", bad, strlen(bad));
    var js2 = jobspec_parse("/tmp/ifran_t_dsjob.cyml");
    assert_eq(run_job(js2), 0 - 1, "dangling dataset id fails loud");
    return 0;
}

fn _t_last_sweep(db): i64 {
    var rs = patra_query(db, "SELECT id FROM sweeps");
    if (rs == 0) { return 0; }
    var n = patra_result_count(rs);
    if (n == 0) { patra_result_free(rs); return 0; }
    var last = patra_result_get_int(rs, n - 1, 0);
    patra_result_free(rs);
    return last;
}

fn _t_runs_in_sweep(db, sid): i64 {
    var stmt = patra_prepare(db, "SELECT id FROM runs WHERE sweep = ?");
    patra_bind_int(stmt, 0, sid);
    var rs = patra_query_prepared(db, stmt);
    patra_finalize(stmt);
    var n = patra_result_count(rs);
    patra_result_free(rs);
    return n;
}

fn test_sweeps(): i64 {
    var db = runstore_open();
    # 3x2 grid over /bin/echo: every combo runs + is tagged with the sweep id
    var spec = _t_cat("[sweep]\nname = \"g\"\nbin = \"/bin/echo\"\nargs = \"s={steps} l={lr}\"\n",
      "logdir = \"/tmp/ifran_test_logs\"\n[sweep.grid]\nsteps = \"10 20 30\"\nlr = \"0.1 0.2\"\n");
    file_write_all("/tmp/ifran_t_sweep.cyml", spec, strlen(spec));
    assert_eq(sweep_run("/tmp/ifran_t_sweep.cyml"), 0, "3x2 grid sweep runs clean");
    assert_eq(_t_runs_in_sweep(db, 1), 6, "6 combo runs tagged with sweep 1");
    # a combo log shows real substitution (grid order: last axis fastest ->
    # combo #0 = steps=10 lr=0.1)
    var buf = alloc(128);
    var n = file_read_all(_run_log_path("/tmp/ifran_test_logs", run_last_id() - 5), buf, 128);
    assert_gt(n, 0, "combo log written");
    assert_eq(load8(buf + 2), 49, "combo 0 got steps=10 ('1')");

    # deterministic random mode: same seed -> same combos (compare via a
    # second identical sweep's captured args)
    var rspec = _t_cat("[sweep]\nname = \"r\"\nbin = \"/bin/echo\"\nargs = \"{steps}\"\nlogdir = \"/tmp/",
      "ifran_test_logs\"\nmode = \"random\"\nsamples = 4\nseed = 7\n[sweep.grid]\nsteps = \"a b c d e f g h\"\n");
    file_write_all("/tmp/ifran_t_sweep.cyml", rspec, strlen(rspec));
    assert_eq(sweep_run("/tmp/ifran_t_sweep.cyml"), 0, "random sweep (seed 7) runs");
    assert_eq(sweep_run("/tmp/ifran_t_sweep.cyml"), 0, "random sweep (seed 7) again");
    # both random sweeps drew the same sequence: compare the recorded args
    var stmt = patra_prepare(db, "SELECT args FROM runs WHERE sweep = ?");
    patra_bind_int(stmt, 0, 2);
    var rs1 = patra_query_prepared(db, stmt);
    patra_finalize(stmt);
    var stmt2 = patra_prepare(db, "SELECT args FROM runs WHERE sweep = ?");
    patra_bind_int(stmt2, 0, 3);
    var rs2 = patra_query_prepared(db, stmt2);
    patra_finalize(stmt2);
    assert_eq(patra_result_count(rs1), 4, "4 samples in sweep 2");
    assert_eq(patra_result_count(rs2), 4, "4 samples in sweep 3");
    var same = 1;
    var i = 0;
    while (i < 4) {
        var a1 = patra_result_get_str(rs1, i, 0);
        var l1 = patra_result_get_str_len(rs1, i, 0);
        var a2 = patra_result_get_str(rs2, i, 0);
        var l2 = patra_result_get_str_len(rs2, i, 0);
        if (l1 != l2) { same = 0; }
        else {
            var j = 0;
            while (j < l1) { if (load8(a1 + j) != load8(a2 + j)) { same = 0; } j = j + 1; }
        }
        i = i + 1;
    }
    patra_result_free(rs1);
    patra_result_free(rs2);
    assert_eq(same, 1, "seeded random sweeps are reproducible (same draws)");

    # spec rejects: no axes / no [sweep]
    var noax = "[sweep]\nname = \"x\"\nbin = \"/bin/echo\"\n";
    file_write_all("/tmp/ifran_t_sweep.cyml", noax, strlen(noax));
    assert_eq(sweep_parse("/tmp/ifran_t_sweep.cyml"), 0, "sweep without axes rejected");
    # ---- 2.2: budgets — max_trials caps a 3x2 grid to 2 combos -----------------
    var bspec1 = "[sweep]\nname = \"b\"\nbin = \"/bin/echo\"\nargs = \"v={v}\"\n";
    var bspec2 = "logdir = \"/tmp/ifran_test_logs\"\nmax_trials = 2\n[sweep.grid]\nv = \"1 2 3 4 5 6\"\n";
    var bsb = str_builder_new();
    str_builder_add_cstr(bsb, bspec1);
    str_builder_add_cstr(bsb, bspec2);
    var bspec = str_cstr(str_builder_build(bsb));
    file_write_all("/tmp/ifran_t_sweep.cyml", bspec, strlen(bspec));
    var bsid_probe = run_last_id();
    assert_eq(sweep_run("/tmp/ifran_t_sweep.cyml"), 0, "budgeted sweep runs clean");
    assert_eq(run_last_id() - bsid_probe, 2, "max_trials=2 ran exactly 2 of 6 combos");
    # negative budget rejects at parse
    var nspec = "[sweep]\nname = \"n\"\nbin = \"/bin/echo\"\nmax_trials = -1\n[sweep.grid]\nv = \"1\"\n";
    file_write_all("/tmp/ifran_t_sweep.cyml", nspec, strlen(nspec));
    assert_eq(sweep_run("/tmp/ifran_t_sweep.cyml"), 1, "negative max_trials rejected");

    # ---- 2.2: leaderboard — rank combos by a log metric ------------------------
    # the echo combos print "v=N": metric key "v", min -> best v=1, max -> v=2
    var lsid = _t_last_sweep(db);
    assert_gt(lsid, 0, "budgeted sweep id found");
    assert_eq(sweep_best(lsid, "v", 0), 0, "leaderboard (min) over combo logs");
    assert_eq(sweep_best(lsid, "v", 1), 0, "leaderboard (max) over combo logs");
    assert_eq(sweep_best(lsid, "nosuchmetric", 0), 1, "missing metric fails loud");
    assert_eq(sweep_best(99999, "v", 0), 1, "unknown sweep id fails loud");

    # ---- 2.3.2: every combo inherits the template's timeout_s ------------------
    # (the per-combo spec was allocated one slot short of the 2.1 jobspec, so
    # +40 read past it and combos never got the template's timeout)
    var cspec = "[sweep]\nname = \"c\"\nbin = \"/bin/echo\"\ntimeout_s = 7\n[sweep.grid]\nv = \"1\"\n";
    file_write_all("/tmp/ifran_t_sweep.cyml", cspec, strlen(cspec));
    var csw = sweep_parse("/tmp/ifran_t_sweep.cyml");
    assert_nonnull(csw, "timeout_s sweep parses");
    var cidx = vec_new();
    var c0 = alloc(8);
    store64(c0, 0);
    vec_push(cidx, c0);
    var cjs = _sw_combo_spec(load64(csw), load64(csw + 8), cidx, 0);
    assert_eq(jobspec_timeout(cjs), 7, "combo spec inherits template timeout_s");
    var c2spec = "[sweep]\nname = \"c\"\nbin = \"/bin/echo\"\n[sweep.grid]\nv = \"1\"\n";
    file_write_all("/tmp/ifran_t_sweep.cyml", c2spec, strlen(c2spec));
    var csw2 = sweep_parse("/tmp/ifran_t_sweep.cyml");
    var cjs2 = _sw_combo_spec(load64(csw2), load64(csw2 + 8), cidx, 0);
    assert_eq(jobspec_timeout(cjs2), 0, "combo spec without timeout_s -> 0");
    # end to end: timeout_s = 1 kills a 30 s sleep combo
    var tspec1 = "[sweep]\nname = \"slow\"\nbin = \"/usr/bin/sleep\"\nargs = \"{s}\"\n";
    var tspec2 = "logdir = \"/tmp/ifran_test_logs\"\ntimeout_s = 1\n[sweep.grid]\ns = \"30\"\n";
    var tsb = str_builder_new();
    str_builder_add_cstr(tsb, tspec1);
    str_builder_add_cstr(tsb, tspec2);
    var tspec = str_cstr(str_builder_build(tsb));
    file_write_all("/tmp/ifran_t_sweep.cyml", tspec, strlen(tspec));
    var st0 = clock_now_ms();
    assert_eq(sweep_run("/tmp/ifran_t_sweep.cyml"), 1, "timed-out combo fails the sweep");
    assert(clock_now_ms() - st0 < 5000, "combo timeout enforced well before the 30 s sleep");
    var tst = patra_prepare(db, "SELECT status FROM runs WHERE id = ?");
    patra_bind_int(tst, 0, run_last_id());
    var trs = patra_query_prepared(db, tst);
    patra_finalize(tst);
    assert_nonnull(trs, "timed-out combo row queried");
    assert_eq(patra_result_get_str_len(trs, 0, 0), 9, "combo status len = timed-out");
    assert_eq(load8(patra_result_get_str(trs, 0, 0)), 116, "combo status starts 't' (timed-out)");
    patra_result_free(trs);

    return 0;
}

fn test_evals(): i64 {
    var db = runstore_open();
    # metric extraction unit checks
    var out = "step 10 loss 1.2500 done\n";
    var v = eval_extract_metric(out, strlen(out), "loss");
    assert_nonnull(v, "metric found");
    assert(streq(v, "1.2500"), "metric token extracted verbatim");
    var v2 = eval_extract_metric(out, strlen(out), "maxrel=");
    assert_eq(v2, 0, "absent metric extracts 0");
    var out2 = "maxrel=0.000001049 PASS";
    var v3 = eval_extract_metric(out2, strlen(out2), "maxrel");
    assert(streq(v3, "0.000001049"), "'=' skipped before the number");

    # passing eval with a metric, through the full runner
    var spec = _t_cat("[eval]\nname = \"toy-gate\"\nbin = \"/bin/echo\"\n",
      "args = \"loss 0.75 ok\"\nlogdir = \"/tmp/ifran_test_logs\"\nmetric = \"loss\"\n");
    file_write_all("/tmp/ifran_t_eval.cyml", spec, strlen(spec));
    assert_eq(eval_run("/tmp/ifran_t_eval.cyml"), 0, "passing eval gates 0");
    # failing eval: /bin/false -> gate 1
    var fspec = "[eval]\nname = \"fail-gate\"\nbin = \"/bin/false\"\nlogdir = \"/tmp/ifran_test_logs\"\n";
    file_write_all("/tmp/ifran_t_eval.cyml", fspec, strlen(fspec));
    assert_eq(eval_run("/tmp/ifran_t_eval.cyml"), 1, "failing eval gates 1");

    # the benchmark store holds both, with the metric value recorded
    var rs = patra_query(db, "SELECT id, gate, value FROM evals");
    assert_nonnull(rs, "evals query works");
    assert_eq(patra_result_count(rs), 2, "two eval records");
    assert_eq(patra_result_get_int(rs, 0, 1), 0, "eval 1 gate 0");
    assert_eq(patra_result_get_int(rs, 1, 1), 1, "eval 2 gate 1");
    var mv = patra_result_get_str(rs, 0, 2);
    assert_eq(load8(mv), 48, "metric value recorded ('0'.75)");
    patra_result_free(rs);
    return 0;
}

fn test_prefs(): i64 {
    var sid = pref_new("align-demo");
    assert_gt(sid, 0, "preference set created");
    # a pair with EMBEDDED QUOTES + newline-ish text (the escaping case)
    var pr = "say \"hi\" politely";
    assert_gt(pref_pair(sid, pr, "hello there", "yo", 0), 0, "pair added");
    assert_gt(pref_pair(sid, "2+2?", "4", "5", 85), 0, "second pair added (conf 85)");
    assert_gt(pref_unary(sid, "joke?", "a good one", 1), 0, "good thumb added");
    assert_gt(pref_unary(sid, "joke?", "a slur", 0 - 1), 0, "bad thumb added");
    assert_eq(pref_pair(9999, "x", "y", "z", 0), 0 - 1, "unknown set rejected");
    assert_eq(pref_pair(sid, "x", "y", "z", 101), 0 - 1, "conf > 100 rejected");
    # 4-state (2.2): tie + bothbad rows over responses a/b
    assert_gt(pref_tie(sid, "pick one", "resp a", "resp b"), 0, "tie added");
    assert_gt(pref_bothbad(sid, "pick one", "bad a", "bad b"), 0, "bothbad added");

    var db = runstore_open();
    assert_eq(_pf_count(db, sid, "pair"), 2, "pair count");
    assert_eq(_pf_count(db, sid, "unary"), 2, "unary count");
    assert_eq(_pf_count(db, sid, "tie"), 1, "tie count");
    assert_eq(_pf_count(db, sid, "bothbad"), 1, "bothbad count");

    # export -> parse EVERY line back with bayan's JSON DOM (escaping proof)
    var out = "/tmp/ifran_t_prefs.jsonl";
    assert_eq(pref_export(sid, out), 6, "export writes 6 rows");
    var buf = alloc(65536);
    var n = file_read_all(out, buf, 65536);
    assert_gt(n, 0, "export file written");
    var lines = 0;
    var parsed = 0;
    var quoted_ok = 0;
    var start = 0;
    var i = 0;
    while (i < n) {
        if (load8(buf + i) == 10) {
            var root = bayan_json_v_parse_buf(buf + start, i - start);
            if (root != 0) {
                if (bayan_json_v_is_obj(root) == 1) {
                    parsed = parsed + 1;
                    var pv = bayan_json_v_obj_get_by_cstr(root, "prompt");
                    if (pv != 0) {
                        var psx = bayan_json_v_str(pv);
                        if (psx != 0) {
                            # the quoted prompt round-trips exactly
                            if (str_len(psx) == strlen(pr)) {
                                var same = 1;
                                var j = 0;
                                while (j < str_len(psx)) {
                                    if (load8(str_data(psx) + j) != load8(pr + j)) { same = 0; }
                                    j = j + 1;
                                }
                                if (same == 1) { quoted_ok = 1; }
                            }
                        }
                    }
                }
            }
            lines = lines + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    assert_eq(lines, 6, "6 JSONL lines");
    assert_eq(parsed, 6, "every line parses as a JSON object (bayan DOM)");
    assert_eq(quoted_ok, 1, "embedded-quote prompt round-trips exactly");
    # conf + 4-state present in the export text (substring checks)
    var hits = 0;
    var needles = vec_new();
    vec_push(needles, "\"conf\":85");
    vec_push(needles, "\"kind\":\"tie\"");
    vec_push(needles, "\"kind\":\"bothbad\"");
    vec_push(needles, "\"a\":\"resp a\"");
    var w = 0;
    while (w < vec_len(needles)) {
        var nd = vec_get(needles, w);
        var nl2 = strlen(nd);
        var found = 0;
        var q = 0;
        while (q + nl2 <= n) {
            var same2 = 1;
            var r2 = 0;
            while (r2 < nl2) {
                if (load8(buf + q + r2) != load8(nd + r2)) { same2 = 0; r2 = nl2; }
                r2 = r2 + 1;
            }
            if (same2 == 1) { found = 1; q = n; }
            q = q + 1;
        }
        hits = hits + found;
        w = w + 1;
    }
    assert_eq(hits, 4, "export carries conf, tie, bothbad, and a/b fields");
    return 0;
}

fn _t_evals_in_sweep(db, sid): i64 {
    var stmt = patra_prepare(db, "SELECT id FROM evals WHERE sweep = ?");
    patra_bind_int(stmt, 0, sid);
    var rs = patra_query_prepared(db, stmt);
    patra_finalize(stmt);
    var n = patra_result_count(rs);
    patra_result_free(rs);
    return n;
}

# int column `col` of the first eval row recorded for sweep `sid`
fn _t_first_eval_int(db, sid, col): i64 {
    var stmt = patra_prepare(db, _t_cat(_t_cat("SELECT ", col), " FROM evals WHERE sweep = ?"));
    patra_bind_int(stmt, 0, sid);
    var rs = patra_query_prepared(db, stmt);
    patra_finalize(stmt);
    var v = patra_result_get_int(rs, 0, 0);
    patra_result_free(rs);
    return v;
}

fn _t_write_spec(a, b): i64 {
    var spec = _t_cat(a, b);
    file_write_all("/tmp/ifran_t_al.cyml", spec, strlen(spec));
    return 0;
}

# 2.5: the experiment auto-loop. A [sweep.eval] template runs as a recorded
# eval after each combo's training exits 0; the sweep ranks combos by it.
fn test_sweep_eval(): i64 {
    var db = runstore_open();
    # training echoes v=N; the eval cats the training log ({log}), so the eval's
    # own metric `v` can only come from the combo it judged
    var s1 = "[sweep]\nname = \"al\"\nbin = \"/bin/echo\"\nargs = \"v={v}\"\nlogdir = \"/tmp/ifran_test_logs\"\n";
    var s2 = "[sweep.grid]\nv = \"3 7 5\"\n[sweep.eval]\nbin = \"/bin/cat\"\nargs = \"{log}\"\n";
    var s3 = "logdir = \"/tmp/ifran_test_logs\"\nmetric = \"v\"\ndirection = \"max\"\n";
    _t_write_spec(s1, _t_cat(s2, s3));
    var r0 = run_last_id();
    assert_eq(sweep_run("/tmp/ifran_t_al.cyml"), 0, "a sweep with [sweep.eval] runs clean");
    var sid = _t_last_sweep(db);
    assert_eq(_t_runs_in_sweep(db, sid), 3, "only the 3 training runs are tagged with the sweep");
    assert_eq(_t_evals_in_sweep(db, sid), 3, "one recorded eval per combo");
    assert_eq(run_last_id() - r0, 6, "3 training runs + 3 eval runs recorded");
    assert_eq(_t_first_eval_int(db, sid, "subject"), r0 + 1, "evals.subject names the training run judged");
    assert_eq(_t_first_eval_int(db, sid, "gate"), 0, "the eval's gate is recorded");
    assert_eq(sweep_last_best_run(), r0 + 3, "the sweep's own ranking (max) picks the v=7 combo");
    assert_eq(sweep_best_evals(sid), 0, "`sweep best <id>` re-ranks by the evals");
    assert_eq(sweep_last_best_run(), r0 + 3, "and agrees");
    assert_eq(sweep_best(sid, "v", 1), 0, "the log-based leaderboard is unchanged");
    assert_eq(sweep_last_best_run(), r0 + 3, "and ranks the same training runs");
    assert_eq(sweep_best_evals(1), 1, "a sweep without evals can't be ranked by them");

    # the eval template substitutes axis values, {run} and {log}
    var t1 = "[sweep]\nname = \"al\"\nbin = \"/bin/echo\"\n[sweep.grid]\nv = \"3\"\n";
    _t_write_spec(t1, "[sweep.eval]\nbin = \"/bin/echo\"\nargs = \"x={v} r={run} l={log}\"\n");
    var sw = sweep_parse("/tmp/ifran_t_al.cyml");
    assert_nonnull(sw, "an eval template without a metric parses");
    var idx = vec_new();
    var c0 = alloc(8);
    store64(c0, 0);
    vec_push(idx, c0);
    var ejs = _sw_eval_spec(load64(sw + 56), load64(sw + 8), idx, 0, 42, "/tmp/l.log");
    assert(streq(jobspec_name(ejs), "al-eval#0"), "the eval name defaults to <sweep>-eval#<k>");
    assert(streq(vec_get(jobspec_argv(ejs), 1), "x=3"), "an axis value reaches the eval's args");
    assert(streq(vec_get(jobspec_argv(ejs), 2), "r=42"), "{run} is the training run's id");
    assert(streq(vec_get(jobspec_argv(ejs), 3), "l=/tmp/l.log"), "{log} is the training run's log");

    # a failing gate fails the combo; a failed training run skips its eval
    _t_write_spec(_t_cat(s1, "[sweep.grid]\nv = \"1 2\"\n"), "[sweep.eval]\nbin = \"/bin/false\"\n");
    assert_eq(sweep_run("/tmp/ifran_t_al.cyml"), 1, "a failing eval gate fails the sweep");
    var sid2 = _t_last_sweep(db);
    assert_eq(_t_evals_in_sweep(db, sid2), 2, "both gates recorded");
    assert_eq(_t_first_eval_int(db, sid2, "gate"), 1, "with their exit code");
    var f1 = "[sweep]\nname = \"al\"\nbin = \"/bin/false\"\n[sweep.grid]\nv = \"1 2\"\n";
    _t_write_spec(f1, "[sweep.eval]\nbin = \"/bin/echo\"\n");
    assert_eq(sweep_run("/tmp/ifran_t_al.cyml"), 1, "failed training fails the sweep");
    assert_eq(_t_evals_in_sweep(db, _t_last_sweep(db)), 0, "no eval runs for failed training");

    # direction must be min or max
    _t_write_spec(t1, "[sweep.eval]\nbin = \"/bin/echo\"\nmetric = \"v\"\ndirection = \"up\"\n");
    assert_eq(sweep_parse("/tmp/ifran_t_al.cyml"), 0, "direction other than min/max is refused");
    return 0;
}

# 2.5: IFRAN_HOME roots ifran.db, ifran-store/, ifran-data/ and the keys dir.
# The environment variable is read by ifr_home(); ifr_set_home is the suite's
# override for it (the stdlib has no setenv). The binary is checked with the
# real variable by hand.
fn test_ifran_home(): i64 {
    var keep = _rs_db;
    var root = "/tmp/ifran_t_home";
    sys_unlink("/tmp/ifran_t_home/ifran.db");
    ifr_set_home(root);
    runstore_set_path(0);
    store_set_dir(0);
    dataset_set_dir(0);
    keys_set_dir(0);
    _rs_db = 0;
    assert(streq(RUNSTORE_PATH(), "/tmp/ifran_t_home/ifran.db"), "ifran.db under IFRAN_HOME");
    assert(streq(store_dir(), "/tmp/ifran_t_home/ifran-store"), "ifran-store/ under IFRAN_HOME");
    assert(streq(dataset_dir(), "/tmp/ifran_t_home/ifran-data"), "ifran-data/ under IFRAN_HOME");
    assert(streq(keys_dir(), "/tmp/ifran_t_home/.ifran"), "the keys dir under IFRAN_HOME");
    var db = runstore_open();
    assert_nonnull(db, "the db opens under IFRAN_HOME (the dir is created)");
    assert_eq(file_exists("/tmp/ifran_t_home/ifran.db"), 1, "ifran.db is written there");
    file_write_all("/tmp/ifran_t_home_corpus.txt", "a\nb\n", 4);
    var did = dataset_add("/tmp/ifran_t_home_corpus.txt", "h");
    assert_gt(did, 0, "a dataset ingests under IFRAN_HOME");
    var dp = dataset_path(did);
    assert_eq(memeq(dp, "/tmp/ifran_t_home/ifran-data/", 29), 1, "and its stored copy lands in IFRAN_HOME/ifran-data/");
    ifr_set_home("");
    assert(streq(RUNSTORE_PATH(), "ifran.db"), "an empty IFRAN_HOME means unset (the cwd)");
    assert(streq(store_dir(), "ifran-store"), "the store dir falls back to the cwd");
    patra_close(db);
    ifr_set_home(0);
    _rs_db = keep;
    runstore_set_path("/tmp/ifran_test.db");
    store_set_dir("/tmp/ifran_test_store");
    dataset_set_dir("/tmp/ifran_test_data");
    keys_set_dir("/tmp/ifran_test_keys");
    return 0;
}

# 2.5: an ifran.db written by 2.4 has no models.canonical column. The ALTER
# migration adds it; the old row reads 0 (not checked), new rows record theirs.
fn test_store_migration(): i64 {
    var keep = _rs_db;
    var mpath = "/tmp/ifran_t_migrate.db";
    sys_unlink(mpath);
    var mdb = patra_open(mpath);
    patra_exec(mdb, _t_cat("CREATE TABLE models (id INT AUTOINCREMENT, name STR, path STR, hash STR, ",
        "size INT, tensors INT, sigstat STR, ingested INT)"));
    patra_exec(mdb, _t_cat("INSERT INTO models (name, path, hash, size, tensors, sigstat, ingested) ",
        "VALUES ('old', '/tmp/x', 'h', 1, 1, 'unsigned', 0)"));
    patra_close(mdb);
    _rs_db = 0;
    runstore_set_path(mpath);
    var db = runstore_open();
    _t_make_tula_long("/tmp/ifran_t_migrate.tula", 6);
    var idm = store_add("/tmp/ifran_t_migrate.tula", "new");
    assert_gt(idm, 0, "store add works on a 2.4 models table (the ALTER adds canonical)");
    assert_eq(_t_model_int(db, 1, "canonical"), 0, "the 2.4 row reads as not checked (0)");
    assert_eq(_t_model_int(db, idm, "canonical"), 1, "the new row records canonical (1)");
    assert_eq(store_ls(), 0, "store ls over 2.4 and 2.5 rows");
    patra_close(db);
    _rs_db = keep;
    runstore_set_path("/tmp/ifran_test.db");
    return 0;
}

# 2.4: a table whose columns were created with other types (a foreign or
# damaged ifran.db; ifran's CREATE TABLE is error-ignored when the table
# already exists) reads its non-STR cells as length -1. Each reader must fail
# cleanly instead of copying -1 bytes and writing before its buffer.
fn test_foreign_db(): i64 {
    var keep = _rs_db;
    var fpath = "/tmp/ifran_t_foreign.db";
    sys_unlink(fpath);
    # runs first, so runstore_open finds it already there (args as TEXT)
    var fdb = patra_open(fpath);
    var r1 = "CREATE TABLE runs (id INT AUTOINCREMENT, name STR, bin STR, args TEXT, ";
    var r2 = "started INT, duration_ms INT, exit_code INT, status STR, log STR, sweep INT, pid INT)";
    var rsb = str_builder_new();
    str_builder_add_cstr(rsb, r1);
    str_builder_add_cstr(rsb, r2);
    patra_exec(fdb, str_cstr(str_builder_build(rsb)));
    patra_close(fdb);
    _rs_db = 0;
    runstore_set_path(fpath);
    var db = runstore_open();
    assert_nonnull(db, "foreign db opens");
    var flog = "/tmp/ifran_t_foreign.log";
    file_write_all(flog, "v=3\n", 4);
    patra_exec(db, "INSERT INTO runs (name, args, log, sweep) VALUES ('f', 'x', '/tmp/ifran_t_foreign.log', 1)");
    assert_eq(sweep_best(1, "v", 0), 0, "leaderboard over a non-STR runs.args ranks cleanly");
    # datasets + models with path as TEXT
    var d1 = "CREATE TABLE datasets (id INT AUTOINCREMENT, name STR, path TEXT, hash STR, ";
    var d2 = "nbytes INT, nlines INT, kind STR, parent INT, ingested INT)";
    var dsb = str_builder_new();
    str_builder_add_cstr(dsb, d1);
    str_builder_add_cstr(dsb, d2);
    patra_exec(db, str_cstr(str_builder_build(dsb)));
    patra_exec(db, "INSERT INTO datasets (name, path, hash) VALUES ('d', '/tmp/x', 'h')");
    assert_eq(dataset_path(1), 0, "a non-STR datasets.path resolves to 0, not a bad copy");
    var m1 = "CREATE TABLE models (id INT AUTOINCREMENT, name STR, path TEXT, hash STR, ";
    var m2 = "size INT, tensors INT, sigstat STR, ingested INT)";
    var msb = str_builder_new();
    str_builder_add_cstr(msb, m1);
    str_builder_add_cstr(msb, m2);
    patra_exec(db, str_cstr(str_builder_build(msb)));
    patra_exec(db, "INSERT INTO models (name, path, hash) VALUES ('m', '/tmp/x', 'h')");
    assert_eq(store_verify(1), 1, "a non-STR models.path fails verify cleanly");
    patra_close(db);
    _rs_db = keep;
    runstore_set_path("/tmp/ifran_test.db");
    return 0;
}

fn main(): i64 {
    alloc_init();
    test_group("jobspec");
    test_jobspec();
    test_group("run+store");
    test_run_and_store();
    test_group("keys");
    test_keys();
    test_group("model-store");
    test_model_store();
    test_group("datasets");
    test_datasets();
    test_group("sweeps");
    test_sweeps();
    test_group("evals");
    test_evals();
    test_group("prefs");
    test_prefs();
    test_group("auto-loop");
    test_sweep_eval();
    test_group("ifran-home");
    test_ifran_home();
    test_group("store-migration");
    test_store_migration();
    test_group("foreign-db");
    test_foreign_db();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
