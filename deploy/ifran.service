# ifran — mark orphaned runs (`ifran reap`), run by ifran.timer.
#
# ifran is a CLI with no daemon. Its one recurring maintenance task is the
# reaper: a run row left `running` by a crash or reboot is re-checked (a
# signal-0 probe of its recorded PID) and marked orphaned only when the PID is
# definitely gone. Live runs are left alone.
#
# Install: /etc/systemd/system/ifran.service + ifran.timer, then
#   systemctl enable --now ifran.timer
# State lives in /var/lib/ifran (ifran.db, run logs, keys under .ifran/).

[Unit]
Description=ifran: mark orphaned runs (reap)
Documentation=https://github.com/MacCracken/ifran/blob/main/docs/cli-reference.md
After=local-fs.target

[Service]
Type=oneshot
# Resolved through systemd's fixed search path (/usr/local/bin, /usr/bin, …)
ExecStart=ifran reap
User=ifran
Group=ifran
WorkingDirectory=/var/lib/ifran
# IFRAN_HOME roots ifran.db, ifran-store/, ifran-data/ and the keys (.ifran/)
Environment=IFRAN_HOME=/var/lib/ifran
Environment=HOME=/var/lib/ifran

# The reaper reads and updates ifran.db and probes PIDs. Nothing else.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ifran
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ifran
