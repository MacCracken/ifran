# ifran (عرفان) — the AGNOS training control plane. M1: the job core.
# Ported from Rust (rust-old/, reference oracle); the siblings own the math,
# ifran owns the orchestration.

# Stdlib + patra/sigil/tula auto-included via cyrius.cyml
include "src/jobspec.cyr"
include "src/runstore.cyr"
include "src/run.cyr"
include "src/keys.cyr"
include "src/store.cyr"
include "src/dataset.cyr"
include "src/sweep.cyr"
include "src/eval.cyr"
include "src/pref.cyr"

fn usage(): i64 {
    println("ifran - AGNOS training control plane");
    println("");
    println("usage: ifran <command> [args]");
    println("  run <job.cyml>   execute a job spec (spawns the sibling binary,");
    println("                   captures its output, records the run)");
    println("  runs             list recorded runs (ifran.db)");
    println("  keys init|show   operator Ed25519 keypair (~/.ifran)");
    println("  store add <file.tula> [name]   validate+verify+ingest an artifact");
    println("  store ls                       list the model store");
    println("  store verify <id>              re-check hash/structure/signature");
    println("  dataset add <file> [name]      ingest a text corpus");
    println("  dataset ls                     list datasets");
    println("  dataset dedup <id>             derive an exact-line-deduped dataset");
    println("  sweep <spec.cyml>              expand + run a parameter sweep (grid/random)");
    println("  sweeps                         list sweeps");
    println("  eval <spec.cyml>               run a gate as a recorded eval (+ metric)");
    println("  evals                          list the benchmark store");
    println("  pref new <name>                create a preference set");
    println("  pref pair <set> <prompt> <chosen> <rejected>   add a DPO/IPO pair");
    println("  pref good|bad <set> <prompt> <completion>      add a KTO thumb");
    println("  pref ls                        list sets (pair/unary counts)");
    println("  pref export <set> <out.jsonl>  export a set as JSONL");
    println("  version          print the version");
    return 0;
}

fn main(): i64 {
    alloc_init();
    args_init();
    if (argc() < 2) { usage(); return 0; }
    var cmd = argv(1);
    if (streq(cmd, "run") == 1) {
        if (argc() < 3) { println("ifran: run needs a <job.cyml>"); return 1; }
        var js = jobspec_parse(argv(2));
        if (js == 0) { return 1; }
        var rc = run_job(js);
        if (rc < 0) { return 1; }
        return rc;
    }
    if (streq(cmd, "runs") == 1) { return runstore_list(); }
    if (streq(cmd, "keys") == 1) {
        if (argc() < 3) { println("ifran: keys needs init|show"); return 1; }
        if (streq(argv(2), "init") == 1) { return keys_init(); }
        if (streq(argv(2), "show") == 1) { return keys_show(); }
        println("ifran: keys needs init|show");
        return 1;
    }
    if (streq(cmd, "store") == 1) {
        if (argc() < 3) { println("ifran: store needs add|ls|verify"); return 1; }
        if (streq(argv(2), "ls") == 1) { return store_ls(); }
        if (streq(argv(2), "add") == 1) {
            if (argc() < 4) { println("ifran: store add needs a <file.tula>"); return 1; }
            var nm = argv(4);
            if (argc() < 5) { nm = argv(3); }
            if (store_add(argv(3), nm) < 0) { return 1; }
            return 0;
        }
        if (streq(argv(2), "verify") == 1) {
            if (argc() < 4) { println("ifran: store verify needs an <id>"); return 1; }
            return store_verify(atoi(argv(3)));
        }
        println("ifran: store needs add|ls|verify");
        return 1;
    }
    if (streq(cmd, "dataset") == 1) {
        if (argc() < 3) { println("ifran: dataset needs add|ls|dedup"); return 1; }
        if (streq(argv(2), "ls") == 1) { return dataset_ls(); }
        if (streq(argv(2), "add") == 1) {
            if (argc() < 4) { println("ifran: dataset add needs a <file>"); return 1; }
            var dn = argv(4);
            if (argc() < 5) { dn = argv(3); }
            if (dataset_add(argv(3), dn) < 0) { return 1; }
            return 0;
        }
        if (streq(argv(2), "dedup") == 1) {
            if (argc() < 4) { println("ifran: dataset dedup needs an <id>"); return 1; }
            if (dataset_dedup(atoi(argv(3))) < 0) { return 1; }
            return 0;
        }
        println("ifran: dataset needs add|ls|dedup");
        return 1;
    }
    if (streq(cmd, "sweep") == 1) {
        if (argc() < 3) { println("ifran: sweep needs a <spec.cyml>"); return 1; }
        return sweep_run(argv(2));
    }
    if (streq(cmd, "sweeps") == 1) { return sweep_ls(); }
    if (streq(cmd, "eval") == 1) {
        if (argc() < 3) { println("ifran: eval needs a <spec.cyml>"); return 1; }
        return eval_run(argv(2));
    }
    if (streq(cmd, "evals") == 1) { return eval_ls(); }
    if (streq(cmd, "pref") == 1) {
        if (argc() < 3) { println("ifran: pref needs new|pair|good|bad|ls|export"); return 1; }
        var sub = argv(2);
        if (streq(sub, "ls") == 1) { return pref_ls(); }
        if (streq(sub, "new") == 1) {
            if (argc() < 4) { println("ifran: pref new needs a <name>"); return 1; }
            if (pref_new(argv(3)) < 0) { return 1; }
            return 0;
        }
        if (streq(sub, "pair") == 1) {
            if (argc() < 7) { println("ifran: pref pair needs <set> <prompt> <chosen> <rejected>"); return 1; }
            if (pref_pair(atoi(argv(3)), argv(4), argv(5), argv(6)) < 0) { return 1; }
            return 0;
        }
        if (streq(sub, "good") == 1) {
            if (argc() < 6) { println("ifran: pref good needs <set> <prompt> <completion>"); return 1; }
            if (pref_unary(atoi(argv(3)), argv(4), argv(5), 1) < 0) { return 1; }
            return 0;
        }
        if (streq(sub, "bad") == 1) {
            if (argc() < 6) { println("ifran: pref bad needs <set> <prompt> <completion>"); return 1; }
            if (pref_unary(atoi(argv(3)), argv(4), argv(5), 0 - 1) < 0) { return 1; }
            return 0;
        }
        if (streq(sub, "export") == 1) {
            if (argc() < 5) { println("ifran: pref export needs <set> <out.jsonl>"); return 1; }
            if (pref_export(atoi(argv(3)), argv(4)) < 0) { return 1; }
            return 0;
        }
        println("ifran: pref needs new|pair|good|bad|ls|export");
        return 1;
    }
    if (streq(cmd, "version") == 1) { println("ifran (cyrius port, M6)"); return 0; }
    usage();
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
