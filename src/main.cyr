# ifran (عرفان) — the AGNOS training control plane. CLI on cmdit (the
# ecosystem CLI/arg lib): verb dispatch, generated --help/--version, standard
# exit codes. The Rust tree lives in rust-old/ (reference oracle).
#
# Exit-code semantics (frozen, docs/api.md): `run` exits with the CHILD's exit
# code and `eval` with the GATE — beyond cmdit's 0/1/2 convention by design
# (CI composability); usage errors are CMDIT_EXIT_USAGE (2).

# Stdlib + patra/sigil/tula/cmdit auto-included via cyrius.cyml
include "src/jobspec.cyr"
include "src/runstore.cyr"
include "src/run.cyr"
include "src/keys.cyr"
include "src/store.cyr"
include "src/dataset.cyr"
include "src/sweep.cyr"
include "src/eval.cyr"
include "src/pref.cyr"

# Embedded version literal — bumped as part of cut mechanics (VERSION file is
# the source of truth; keep in sync at each cut).
fn IFRAN_VERSION(): i64 { return "2.0.0"; }

# slice accessor: token i of a verb-remainder argv (cstr*)
fn _cli_tok(argv, i): i64 { return load64(argv + i * 8); }

# grouped verbs: dispatch a child handle over the parent's remainder slice.
# Returns the child handle (caller reads cmdit_verb_matched + the sub-slice),
# or 0 after printing help/error (out_rc holds the exit code).
fn _cli_sub(h, child, out_rc): i64 {
    var r = cmdit_dispatch_argv(child, cmdit_verb_argc(h), cmdit_verb_argv(h));
    if (r == CMDIT_HELP) { cmdit_help(child); store64(out_rc, CMDIT_EXIT_OK); return 0; }
    if (r == CMDIT_RESULT_ERR) { cmdit_print_error(child); store64(out_rc, CMDIT_EXIT_USAGE); return 0; }
    if (cmdit_verb_matched(child) < 0) { cmdit_help(child); store64(out_rc, CMDIT_EXIT_USAGE); return 0; }
    return child;
}

fn _cli_need(child, n, what): i64 {
    if (cmdit_verb_argc(child) < n + 1) {           # +1: slice[0] = the sub-verb
        ifr_print_cstr("ifran: missing ");
        ifr_print_cstr(what);
        println("");
        return 0;
    }
    return 1;
}

fn main(): i64 {
    alloc_init();
    args_init();
    var h = cmdit_new("ifran");
    cmdit_verb(h, "run", "execute a job spec: spawn, capture, record (exit = child's)");   # 0
    cmdit_verb(h, "runs", "list recorded runs");                                           # 1
    cmdit_verb(h, "keys", "operator Ed25519 keypair: init | show");                        # 2
    cmdit_verb(h, "store", "signed model store: add <file> [name] | ls | verify <id>");    # 3
    cmdit_verb(h, "dataset", "corpora: add <file> [name] | ls | dedup <id>");              # 4
    cmdit_verb(h, "sweep", "expand + run a parameter sweep (grid / seeded random)");       # 5
    cmdit_verb(h, "sweeps", "list sweeps");                                                # 6
    cmdit_verb(h, "eval", "run a gate as a recorded eval (exit = the gate)");              # 7
    cmdit_verb(h, "evals", "list the benchmark store");                                    # 8
    cmdit_verb(h, "pref", "preferences: new | pair | good | bad | ls | export");           # 9
    cmdit_verb(h, "show", "one run's full record + log tail: <run-id>");                   # 10
    cmdit_verb(h, "reap", "mark running rows whose PID is gone as orphaned");              # 11

    var r = cmdit_dispatch(h);
    if (r == CMDIT_HELP) { cmdit_help(h); return CMDIT_EXIT_OK; }
    if (r == CMDIT_VERSION) { cmdit_version(h, IFRAN_VERSION()); return CMDIT_EXIT_OK; }
    if (r == CMDIT_RESULT_ERR) { cmdit_print_error(h); return CMDIT_EXIT_USAGE; }
    var v = cmdit_verb_matched(h);
    if (v < 0) { cmdit_help(h); return CMDIT_EXIT_OK; }
    var va = cmdit_verb_argv(h);
    var vc = cmdit_verb_argc(h);
    var rc = alloc(8);

    if (v == 0) {                                    # run <job.cyml>
        if (vc < 2) { println("ifran: run needs a <job.cyml>"); return CMDIT_EXIT_USAGE; }
        var js = jobspec_parse(_cli_tok(va, 1));
        if (js == 0) { return CMDIT_EXIT_USAGE; }
        var e = run_job(js);
        if (e < 0) { return 1; }
        return e;
    }
    if (v == 1) { return runstore_list(); }
    if (v == 10) {                                   # show <run-id>
        if (vc < 2) { println("ifran: show needs a <run-id>"); return CMDIT_EXIT_USAGE; }
        return runstore_show(atoi(_cli_tok(va, 1)));
    }
    if (v == 11) {                                   # reap
        if (runstore_reap() < 0) { return 1; }
        return 0;
    }
    if (v == 2) {                                    # keys init|show
        var kh = cmdit_new("ifran keys");
        cmdit_verb(kh, "init", "generate the operator keypair (refuses to overwrite)");
        cmdit_verb(kh, "show", "print the operator public key (hex)");
        if (_cli_sub(h, kh, rc) == 0) { return load64(rc); }
        if (cmdit_verb_matched(kh) == 0) { return keys_init(); }
        return keys_show();
    }
    if (v == 3) {                                    # store add|ls|verify
        var sh = cmdit_new("ifran store");
        cmdit_verb(sh, "add", "validate + verify + ingest a .tula artifact: <file> [name]");
        cmdit_verb(sh, "ls", "list the model store");
        cmdit_verb(sh, "verify", "re-check hash/structure/signature: <id>");
        if (_cli_sub(h, sh, rc) == 0) { return load64(rc); }
        var sv = cmdit_verb_matched(sh);
        var sa = cmdit_verb_argv(sh);
        if (sv == 0) {
            if (_cli_need(sh, 1, "<file.tula>") == 0) { return CMDIT_EXIT_USAGE; }
            var nm = _cli_tok(sa, 1);
            if (cmdit_verb_argc(sh) >= 3) { nm = _cli_tok(sa, 2); }
            if (store_add(_cli_tok(sa, 1), nm) < 0) { return 1; }
            return 0;
        }
        if (sv == 1) { return store_ls(); }
        if (_cli_need(sh, 1, "<id>") == 0) { return CMDIT_EXIT_USAGE; }
        return store_verify(atoi(_cli_tok(sa, 1)));
    }
    if (v == 4) {                                    # dataset add|ls|dedup
        var dh = cmdit_new("ifran dataset");
        cmdit_verb(dh, "add", "ingest a text corpus: <file> [name]");
        cmdit_verb(dh, "ls", "list datasets");
        cmdit_verb(dh, "dedup", "derive an exact-line-deduped child: <id>");
        if (_cli_sub(h, dh, rc) == 0) { return load64(rc); }
        var dv = cmdit_verb_matched(dh);
        var da = cmdit_verb_argv(dh);
        if (dv == 0) {
            if (_cli_need(dh, 1, "<file>") == 0) { return CMDIT_EXIT_USAGE; }
            var dn = _cli_tok(da, 1);
            if (cmdit_verb_argc(dh) >= 3) { dn = _cli_tok(da, 2); }
            if (dataset_add(_cli_tok(da, 1), dn) < 0) { return 1; }
            return 0;
        }
        if (dv == 1) { return dataset_ls(); }
        if (_cli_need(dh, 1, "<id>") == 0) { return CMDIT_EXIT_USAGE; }
        if (dataset_dedup(atoi(_cli_tok(da, 1))) < 0) { return 1; }
        return 0;
    }
    if (v == 5) {                                    # sweep <spec.cyml>
        if (vc < 2) { println("ifran: sweep needs a <spec.cyml>"); return CMDIT_EXIT_USAGE; }
        return sweep_run(_cli_tok(va, 1));
    }
    if (v == 6) { return sweep_ls(); }
    if (v == 7) {                                    # eval <spec.cyml>
        if (vc < 2) { println("ifran: eval needs a <spec.cyml>"); return CMDIT_EXIT_USAGE; }
        return eval_run(_cli_tok(va, 1));
    }
    if (v == 8) { return eval_ls(); }
    # v == 9: pref new|pair|good|bad|ls|export
    var ph = cmdit_new("ifran pref");
    cmdit_verb(ph, "new", "create a preference set: <name>");
    cmdit_verb(ph, "pair", "add a DPO/IPO pair: <set> <prompt> <chosen> <rejected>");
    cmdit_verb(ph, "good", "add a desirable KTO thumb: <set> <prompt> <completion>");
    cmdit_verb(ph, "bad", "add an undesirable KTO thumb: <set> <prompt> <completion>");
    cmdit_verb(ph, "ls", "list sets with pair/unary counts");
    cmdit_verb(ph, "export", "export a set as escaped JSONL: <set> <out.jsonl>");
    if (_cli_sub(h, ph, rc) == 0) { return load64(rc); }
    var pv = cmdit_verb_matched(ph);
    var pa = cmdit_verb_argv(ph);
    if (pv == 0) {
        if (_cli_need(ph, 1, "<name>") == 0) { return CMDIT_EXIT_USAGE; }
        if (pref_new(_cli_tok(pa, 1)) < 0) { return 1; }
        return 0;
    }
    if (pv == 1) {
        if (_cli_need(ph, 4, "<set> <prompt> <chosen> <rejected>") == 0) { return CMDIT_EXIT_USAGE; }
        if (pref_pair(atoi(_cli_tok(pa, 1)), _cli_tok(pa, 2), _cli_tok(pa, 3), _cli_tok(pa, 4)) < 0) { return 1; }
        return 0;
    }
    if (pv == 2) {
        if (_cli_need(ph, 3, "<set> <prompt> <completion>") == 0) { return CMDIT_EXIT_USAGE; }
        if (pref_unary(atoi(_cli_tok(pa, 1)), _cli_tok(pa, 2), _cli_tok(pa, 3), 1) < 0) { return 1; }
        return 0;
    }
    if (pv == 3) {
        if (_cli_need(ph, 3, "<set> <prompt> <completion>") == 0) { return CMDIT_EXIT_USAGE; }
        if (pref_unary(atoi(_cli_tok(pa, 1)), _cli_tok(pa, 2), _cli_tok(pa, 3), 0 - 1) < 0) { return 1; }
        return 0;
    }
    if (pv == 4) { return pref_ls(); }
    if (_cli_need(ph, 2, "<set> <out.jsonl>") == 0) { return CMDIT_EXIT_USAGE; }
    if (pref_export(atoi(_cli_tok(pa, 1)), _cli_tok(pa, 2)) < 0) { return 1; }
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
