# @public — M4: the sweep runner. A sweep is a job TEMPLATE plus parameter
# axes; ifran expands the combinations and drives every one through the
# ordinary M1 executor, so each combo is a first-class recorded run (tagged
# with the sweep id — "results into the store" for free).
#
#   [sweep]
#   name = "steps-sweep"            # combo runs are named <name>#<k>
#   bin  = "/path/attn11"           # + args/logdir/dataset exactly like [job];
#   args = "--corpus {dataset} --steps {steps} --lr {lr}"
#   mode = "grid"                   # grid (default) = cartesian product;
#   samples = 5                     # random = `samples` draws (uniform per axis)
#   seed = 42                       # random mode is DETERMINISTIC (LCG; same
#                                   # seed -> same combos — reproducible sweeps)
#   [sweep.grid]
#   steps = "10 20 30"              # each axis: space-separated candidates;
#   lr = "0.001 0.01"               # {axis} substitutes WITHIN tokens too
#                                   # (both "--steps {steps}" and
#                                   #  "--steps={steps}" work)
#
# Grid + seeded-random only — matching the honest Rust surface (its search was
# grid/random too); black-box optimization (GP-BO/CMA-ES) is a separately
# triggered lane, NOT smuggled in here.

# axis record: +0 name (cstr), +8 values (vec of cstr)
fn _sw_axis_name(a): i64 { return load64(a); }
fn _sw_axis_values(a): i64 { return load64(a + 8); }

var _sw_lcg = 1;
fn _sw_seed(s): i64 { _sw_lcg = s; if (s == 0) { _sw_lcg = 1; } return 0; }
fn _sw_next(n): i64 {
    _sw_lcg = (_sw_lcg * 6364136223846793005 + 1442695040888963407);
    var v = (_sw_lcg >> 33);
    if (v < 0) { v = 0 - v; }
    return v % n;
}

# parse [sweep] + [sweep.grid] (+ an optional [sweep.eval], 2.5) -> packed:
#   +0 js · +8 axes · +16 mode-cstr · +24 samples · +32 seed · +40 max_trials
#   +48 time_budget_s · +56 eval template js (0 = none) · +64 eval metric
#   (cstr, 0 = none) · +72 eval direction (1 = max, 0 = min)
fn sweep_parse(path): i64 {
    var sections = bayan_toml_parse_file(path);
    var ss = bayan_toml_get_sections_by_cstr(sections, "sweep");
    if (vec_len(ss) == 0) { println("ifran: sweep file has no [sweep] section"); return 0; }
    var pairs = bayan_toml_section_pairs(vec_get(ss, 0));
    var js = jobspec_from_pairs(pairs);
    if (js == 0) { return 0; }
    var gs = bayan_toml_get_sections_by_cstr(sections, "sweep.grid");
    if (vec_len(gs) == 0) { println("ifran: sweep file has no [sweep.grid] axes"); return 0; }
    var gpairs = bayan_toml_section_pairs(vec_get(gs, 0));
    var axes = vec_new();
    var i = 0;
    while (i < vec_len(gpairs)) {
        var pr = vec_get(gpairs, i);
        var aname = str_cstr(bayan_toml_pair_key(pr));
        var avals = vec_new();
        _js_split_args(str_cstr(bayan_toml_pair_value(pr)), avals);
        if (vec_len(avals) == 0) {
            println("ifran: sweep axis with no candidate values");
            return 0;
        }
        var ax = alloc(16);
        store64(ax, aname);
        store64(ax + 8, avals);
        vec_push(axes, ax);
        i = i + 1;
    }
    var mode = _js_get_cstr(pairs, "mode");
    if (mode == 0) { mode = "grid"; }
    var samples = 0;
    var sv = bayan_toml_get_by_cstr(pairs, "samples");
    if (sv != 0) { samples = str_to_int(sv); }
    var seed = 1;
    var seedv = bayan_toml_get_by_cstr(pairs, "seed");
    if (seedv != 0) { seed = str_to_int(seedv); }
    # budgets (2.2): max_trials caps combos RUN; time_budget_s stops launching
    # new combos once the wall clock passes (the running combo finishes; the
    # per-combo half is the job template's own timeout_s)
    var maxt = 0;
    var mtv = bayan_toml_get_by_cstr(pairs, "max_trials");
    if (mtv != 0) {
        maxt = str_to_int(mtv);
        if (maxt < 0) { println("ifran: [sweep] `max_trials` must be >= 0"); return 0; }
    }
    var tbud = 0;
    var tbv = bayan_toml_get_by_cstr(pairs, "time_budget_s");
    if (tbv != 0) {
        tbud = str_to_int(tbv);
        if (tbud < 0) { println("ifran: [sweep] `time_budget_s` must be >= 0"); return 0; }
    }
    # the experiment auto-loop (2.5): an optional per-combo eval template, the
    # [eval] keys plus `direction`; its name defaults to "<sweep name>-eval"
    var ejs = 0;
    var emetric = 0;
    var emax = 0;
    var es = bayan_toml_get_sections_by_cstr(sections, "sweep.eval");
    if (vec_len(es) > 0) {
        var epairs = bayan_toml_section_pairs(vec_get(es, 0));
        var dsb = str_builder_new();
        str_builder_add_cstr(dsb, jobspec_name(js));
        str_builder_add_cstr(dsb, "-eval");
        ejs = jobspec_from_pairs_in(epairs, "[sweep.eval]", str_cstr(str_builder_build(dsb)));
        if (ejs == 0) { return 0; }
        emetric = _js_get_cstr(epairs, "metric");
        var dir = _js_get_cstr(epairs, "direction");
        if (dir != 0) {
            if (streq(dir, "max") == 1) { emax = 1; }
            elif (streq(dir, "min") == 0) {
                println("ifran: [sweep.eval] `direction` must be min or max");
                return 0;
            }
        }
    }
    var sw = alloc(80);
    store64(sw, js);
    store64(sw + 8, axes);
    store64(sw + 16, mode);
    store64(sw + 24, samples);
    store64(sw + 32, seed);
    store64(sw + 40, maxt);
    store64(sw + 48, tbud);
    store64(sw + 56, ejs);
    store64(sw + 64, emetric);
    store64(sw + 72, emax);
    return sw;
}

fn _sw_combo_count(axes): i64 {
    var n = 1;
    var i = 0;
    while (i < vec_len(axes)) {
        n = n * vec_len(_sw_axis_values(vec_get(axes, i)));
        i = i + 1;
    }
    return n;
}

# replace every occurrence of "{name}" inside tok with value; returns a fresh
# cstr (or tok unchanged if no occurrence). Shared semantics with {dataset}.
fn sweep_subst(tok, name, value): i64 {
    var tl = strlen(tok);
    var nl = strlen(name);
    var vl = strlen(value);
    var sb = str_builder_new();
    var found = 0;
    var i = 0;
    while (i < tl) {
        var hit = 0;
        if (load8(tok + i) == 123) {                  # '{'
            if (i + nl + 1 < tl) {
                if (load8(tok + i + nl + 1) == 125) { # '}'
                    var j = 0;
                    hit = 1;
                    while (j < nl) {
                        if (load8(tok + i + 1 + j) != load8(name + j)) { hit = 0; j = nl; }
                        j = j + 1;
                    }
                }
            }
        }
        if (hit == 1) {
            var k = 0;
            while (k < vl) { str_builder_putc(sb, load8(value + k)); k = k + 1; }
            i = i + nl + 2;
            found = 1;
        } else {
            str_builder_putc(sb, load8(tok + i));
            i = i + 1;
        }
    }
    if (found == 0) { return tok; }
    return str_cstr(str_builder_build(sb));
}

# substitute every axis placeholder in `tok` with the combo's value per `idx`
# (a vec of value-indices, one per axis)
fn _sw_subst_axes(tok, axes, idx): i64 {
    var out = tok;
    var a = 0;
    while (a < vec_len(axes)) {
        var ax = vec_get(axes, a);
        out = sweep_subst(out, _sw_axis_name(ax), vec_get(_sw_axis_values(ax), load64(vec_get(idx, a))));
        a = a + 1;
    }
    return out;
}

# build a per-combo jobspec: fresh argv with axis placeholders substituted per
# `idx`, name = "<base>#<k>"
fn _sw_combo_spec(js, axes, idx, k): i64 {
    var argv = jobspec_argv(js);
    var nv = vec_new();
    var t = 0;
    while (t < vec_len(argv)) {
        vec_push(nv, _sw_subst_axes(vec_get(argv, t), axes, idx));
        t = t + 1;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, jobspec_name(js));
    str_builder_add_cstr(sb, "#");
    str_builder_add_int(sb, k);
    # the full jobspec record (src/jobspec.cyr layout): every slot is carried,
    # timeout_s included — the per-combo time limit IS the template's
    var cjs = alloc(48);
    store64(cjs, str_cstr(str_builder_build(sb)));
    store64(cjs + 8, jobspec_bin(js));
    store64(cjs + 16, nv);
    store64(cjs + 24, jobspec_logdir(js));
    store64(cjs + 32, jobspec_dataset(js));
    store64(cjs + 40, jobspec_timeout(js));
    return cjs;
}

# build combo k's eval jobspec from the [sweep.eval] template (2.5): the axis
# placeholders as for training, then {run} (the training run's id) and {log}
# (its log path). An axis named `run` or `log` is substituted first and wins.
fn _sw_eval_spec(ejs, axes, idx, k, train_id, train_log): i64 {
    var rsb = str_builder_new();
    str_builder_add_int(rsb, train_id);
    var rid = str_cstr(str_builder_build(rsb));
    var argv = jobspec_argv(ejs);
    var nv = vec_new();
    var t = 0;
    while (t < vec_len(argv)) {
        var out = _sw_subst_axes(vec_get(argv, t), axes, idx);
        out = sweep_subst(out, "run", rid);
        out = sweep_subst(out, "log", train_log);
        vec_push(nv, out);
        t = t + 1;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, jobspec_name(ejs));
    str_builder_add_cstr(sb, "#");
    str_builder_add_int(sb, k);
    var e = alloc(48);                       # the full jobspec record
    store64(e, str_cstr(str_builder_build(sb)));
    store64(e + 8, jobspec_bin(ejs));
    store64(e + 16, nv);
    store64(e + 24, jobspec_logdir(ejs));
    store64(e + 32, jobspec_dataset(ejs));
    store64(e + 40, jobspec_timeout(ejs));
    return e;
}

fn _sw_open_table(): i64 {
    var db = runstore_open();
    if (db == 0) { return 0; }
    var c1 = "CREATE TABLE sweeps (id INT AUTOINCREMENT, name STR, mode STR, combos INT, started INT, ";
    var c2 = "eval_metric STR, eval_max INT)";
    var sb = str_builder_new();
    str_builder_add_cstr(sb, c1);
    str_builder_add_cstr(sb, c2);
    patra_exec(db, str_cstr(str_builder_build(sb)));
    # schema migrations for older dbs (error-ignored when the column exists).
    # 2.5: a sweep with a [sweep.eval] metric records it and its direction, so
    # `sweep best <id>` can re-rank by the evals later
    patra_exec(db, "ALTER TABLE sweeps ADD COLUMN eval_metric STR");
    patra_exec(db, "ALTER TABLE sweeps ADD COLUMN eval_max INT");
    return db;
}

fn _sw_insert(db, name, mode, combos, emetric, emax): i64 {
    var q1 = "INSERT INTO sweeps (name, mode, combos, started, eval_metric, eval_max) ";
    var sb = str_builder_new();
    str_builder_add_cstr(sb, q1);
    str_builder_add_cstr(sb, "VALUES (?, ?, ?, ?, ?, ?)");
    var stmt = patra_prepare(db, str_cstr(str_builder_build(sb)));
    if (stmt == 0) { return 0 - 1; }
    if (emetric == 0) { emetric = ""; }
    patra_bind_text(stmt, 0, name, strlen(name));
    patra_bind_text(stmt, 1, mode, strlen(mode));
    patra_bind_int(stmt, 2, combos);
    patra_bind_int(stmt, 3, clock_epoch_secs());
    patra_bind_text(stmt, 4, emetric, strlen(emetric));
    patra_bind_int(stmt, 5, emax);
    var idp = alloc(8);
    if (patra_insert_returning(db, stmt, idp) != 0) { patra_finalize(stmt); return 0 - 1; }
    patra_finalize(stmt);
    return load64(idp);
}

# Run a sweep spec. Every combo runs (failures recorded, not aborting the
# sweep); returns 0 iff every combo exited 0.
fn sweep_run(path): i64 {
    var sw = sweep_parse(path);
    if (sw == 0) { return 1; }
    var js = load64(sw);
    var axes = load64(sw + 8);
    var mode = load64(sw + 16);
    var db = _sw_open_table();
    if (db == 0) { return 1; }
    var is_random = streq(mode, "random");
    var combos = 0;
    if (is_random == 1) {
        combos = load64(sw + 24);
        if (combos <= 0) { println("ifran: random sweep needs samples > 0"); return 1; }
    } else { combos = _sw_combo_count(axes); }
    var planned = combos;
    var maxt = load64(sw + 40);
    if (maxt > 0) { if (maxt < combos) { combos = maxt; } }
    var tbud = load64(sw + 48);
    var ejs = load64(sw + 56);
    var emetric = load64(sw + 64);
    var emax = load64(sw + 72);
    var sid = _sw_insert(db, jobspec_name(js), mode, combos, emetric, emax);
    if (sid < 0) { println("ifran: sweep record insert failed"); return 1; }
    ifr_print_cstr("sweep "); fmt_int(sid);
    ifr_print_cstr(" ("); ifr_print_cstr(mode);
    ifr_print_cstr(", "); fmt_int(combos);
    ifr_print_cstr(" combos)"); println("");
    if (combos < planned) {
        ifr_print_cstr("  max_trials cap: running "); fmt_int(combos);
        ifr_print_cstr(" of "); fmt_int(planned); println(" grid combos");
    }
    runstore_set_sweep(sid);
    var t0s = clock_epoch_secs();
    _sw_seed(load64(sw + 32));
    var na = vec_len(axes);
    var idx = vec_new();
    var a = 0;
    while (a < na) { var c0 = alloc(8); store64(c0, 0); vec_push(idx, c0); a = a + 1; }
    var failures = 0;
    var ran = 0;
    var k = 0;
    while (k < combos) {
        if (tbud > 0) {
            if (clock_epoch_secs() - t0s >= tbud) {
                ifr_print_cstr("  time budget ("); fmt_int(tbud);
                ifr_print_cstr(" s) hit after "); fmt_int(ran);
                println(" combos — stopping");
                k = combos;
            }
        }
        if (k < combos) {
            if (is_random == 1) {
                a = 0;
                while (a < na) {
                    var ax = vec_get(axes, a);
                    store64(vec_get(idx, a), _sw_next(vec_len(_sw_axis_values(ax))));
                    a = a + 1;
                }
            }
            var cjs = _sw_combo_spec(js, axes, idx, k);
            var trc = run_job(cjs);
            if (trc != 0) { failures = failures + 1; }
            elif (ejs != 0) {
                # the auto-loop (2.5): judge this combo with the eval template.
                # Eval runs are linked through evals.sweep/subject, not tagged
                # with the sweep, so the sweep's runs stay its training runs.
                var tid = run_last_id();
                var ecjs = _sw_eval_spec(ejs, axes, idx, k, tid, run_last_log());
                runstore_set_sweep(0);
                var gate = eval_run_spec(ecjs, emetric, sid, tid);
                runstore_set_sweep(sid);
                if (gate != 0) { failures = failures + 1; }
            }
            if (is_random == 0) {
                # odometer increment
                a = na - 1;
                var carry = 1;
                while (a >= 0) {
                    if (carry == 0) { a = 0 - 1; }
                    else {
                        var cell = vec_get(idx, a);
                        var v = load64(cell) + 1;
                        if (v < vec_len(_sw_axis_values(vec_get(axes, a)))) {
                            store64(cell, v);
                            carry = 0;
                        } else { store64(cell, 0); }
                        a = a - 1;
                    }
                }
            }
            ran = ran + 1;
            k = k + 1;
        }
    }
    runstore_set_sweep(0);
    ifr_print_cstr("sweep "); fmt_int(sid);
    ifr_print_cstr(" complete: "); fmt_int(ran - failures);
    ifr_print_cstr("/"); fmt_int(ran);
    if (ejs != 0) { ifr_print_cstr(" combos passed training + eval"); }
    else { ifr_print_cstr(" combos exited 0"); }
    println("");
    if (ejs != 0) { if (emetric != 0) { sweep_best_evals(sid); } }
    if (failures == 0) { return 0; }
    return 1;
}

fn sweep_ls(): i64 {
    var db = _sw_open_table();
    if (db == 0) { return 1; }
    var rs = patra_query(db, "SELECT id, name, mode, combos, started FROM sweeps");
    if (rs == 0) { println("ifran: sweeps query failed"); return 1; }
    var n = patra_result_count(rs);
    println("id | name | mode | combos | started");
    var i = 0;
    while (i < n) {
        fmt_int(patra_result_get_int(rs, i, 0)); ifr_print_cstr(" | ");
        _rs_print_str(rs, i, 1); ifr_print_cstr(" | ");
        _rs_print_str(rs, i, 2); ifr_print_cstr(" | ");
        fmt_int(patra_result_get_int(rs, i, 3)); ifr_print_cstr(" | ");
        fmt_int(patra_result_get_int(rs, i, 4));
        println("");
        i = i + 1;
    }
    patra_result_free(rs);
    return 0;
}

# ---- leaderboard (2.2): rank a sweep's combos by a log-extracted metric -------
# `ifran sweep best <sweep-id> <metric-key> [min|max]` — post-hoc: reads each
# sweep-tagged run's log, extracts the metric (the eval extractor: key then
# =/:/spaces then a numeric token), ranks by direction (default min — losses).
# Combos whose log lacks the metric are reported and skipped, loudly.
fn sweep_best(sid, key, want_max): i64 {
    var db = _sw_open_table();
    if (db == 0) { return 1; }
    var stmt = patra_prepare(db, "SELECT id, args, log FROM runs WHERE sweep = ?");
    if (stmt == 0) { return 1; }
    patra_bind_int(stmt, 0, sid);
    var rs = patra_query_prepared(db, stmt);
    patra_finalize(stmt);
    if (rs == 0) { println("ifran: query failed"); return 1; }
    var n = patra_result_count(rs);
    if (n == 0) {
        patra_result_free(rs);
        println("ifran: no runs tagged with that sweep id");
        return 1;
    }
    # gather (run id, value) rows; 24 B each: id, f64 value, args cstr
    var rows = alloc(n * 24);
    var have = 0;
    var missing = 0;
    var buf = alloc(RUN_LOG_MAX());
    var i = 0;
    while (i < n) {
        var lp = patra_result_get_str(rs, i, 2);
        var ll = patra_result_get_str_len(rs, i, 2);
        var got = 0;
        if (lp != 0) { if (ll > 0) {
                var lpath = alloc(ll + 1);
                memcpy(lpath, lp, ll);
                store8(lpath + ll, 0);
                var nread = file_read_all(lpath, buf, RUN_LOG_MAX());
                if (nread > 0) {
                    var vs = eval_extract_metric(buf, nread, key);
                    if (vs != 0) {
                        var vp = alloc(8);
                        if (f64_parse_ok(vs, vp) == 1) {
                            var row = rows + have * 24;
                            store64(row, patra_result_get_int(rs, i, 0));
                            store64(row + 8, load64(vp));
                            var ac = ifr_str_cell(rs, i, 1);
                            if (ac == 0) { ac = "?"; }      # non-STR args: show, don't copy
                            store64(row + 16, ac);
                            have = have + 1;
                            got = 1;
                        }
                    }
                }
            } }
        if (got == 0) { missing = missing + 1; }
        i = i + 1;
    }
    patra_result_free(rs);
    if (have == 0) {
        ifr_print_cstr("ifran: metric `"); ifr_print_cstr(key);
        println("` not found in any combo log");
        return 1;
    }
    return _sw_rank_print(sid, rows, have, key, want_max, missing, "");
}

# the best run of the last leaderboard printed (tests; 0 = none yet)
var _sw_best_run = 0;

fn sweep_last_best_run(): i64 { return _sw_best_run; }

# Rank `have` rows (24 B each: run id, f64 value, args cstr) by direction and
# print the leaderboard; `src` names where the values came from ("" = the run
# logs, "eval " = the sweep's evals). Returns 0.
fn _sw_rank_print(sid, rows, have, key, want_max, missing, src): i64 {
    # selection sort by direction (combo counts are small)
    var a = 0;
    while (a < have - 1) {
        var pick = a;
        var b = a + 1;
        while (b < have) {
            var vb = load64(rows + b * 24 + 8);
            var vp2 = load64(rows + pick * 24 + 8);
            var better = f64_lt(vb, vp2);
            if (want_max == 1) { better = f64_gt(vb, vp2); }
            if (better == 1) { pick = b; }
            b = b + 1;
        }
        if (pick != a) {
            var t = 0;
            while (t < 3) {
                var tmp = load64(rows + a * 24 + t * 8);
                store64(rows + a * 24 + t * 8, load64(rows + pick * 24 + t * 8));
                store64(rows + pick * 24 + t * 8, tmp);
                t = t + 1;
            }
        }
        a = a + 1;
    }
    ifr_print_cstr("sweep "); fmt_int(sid);
    ifr_print_cstr(" leaderboard by "); ifr_print_cstr(src); ifr_print_cstr("`"); ifr_print_cstr(key);
    if (want_max == 1) { ifr_print_cstr("` (max)"); } else { ifr_print_cstr("` (min)"); }
    println(":");
    println("rank | run | value | args");
    var i = 0;
    while (i < have) {
        var row2 = rows + i * 24;
        fmt_int(i + 1); ifr_print_cstr(" | ");
        fmt_int(load64(row2)); ifr_print_cstr(" | ");
        fmt_float(load64(row2 + 8), 6); ifr_print_cstr(" | ");
        ifr_print_cstr(load64(row2 + 16)); println("");
        i = i + 1;
    }
    if (missing > 0) {
        ifr_print_cstr("("); fmt_int(missing);
        ifr_print_cstr(" combos had no usable `"); ifr_print_cstr(key);
        println("` — skipped)");
    }
    _sw_best_run = load64(rows);
    ifr_print_cstr("best: run "); fmt_int(load64(rows));
    ifr_print_cstr(" ("); fmt_float(load64(rows + 8), 6);
    println(")");
    return 0;
}

# a run's args (fresh cstr), or "?" when it can't be read
fn _sw_run_args(db, run_id): i64 {
    var stmt = patra_prepare(db, "SELECT args FROM runs WHERE id = ?");
    if (stmt == 0) { return "?"; }
    patra_bind_int(stmt, 0, run_id);
    var rs = patra_query_prepared(db, stmt);
    patra_finalize(stmt);
    if (rs == 0) { return "?"; }
    var a = 0;
    if (patra_result_count(rs) > 0) { a = ifr_str_cell(rs, 0, 0); }
    patra_result_free(rs);
    if (a == 0) { return "?"; }
    return a;
}

# ---- the auto-loop's leaderboard (2.5) ----------------------------------------
# `ifran sweep best <sweep-id>` (no metric): rank the combos by the evals a
# [sweep.eval] recorded for them, in the direction the sweep recorded. An eval
# whose gate failed, or whose log had no value for the metric, is skipped.
fn sweep_best_evals(sid): i64 {
    var db = _sw_open_table();
    if (db == 0) { return 1; }
    if (_ev_open_table() == 0) { return 1; }
    var st = patra_prepare(db, "SELECT eval_metric, eval_max FROM sweeps WHERE id = ?");
    if (st == 0) { return 1; }
    patra_bind_int(st, 0, sid);
    var srs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (srs == 0) { println("ifran: query failed"); return 1; }
    if (patra_result_count(srs) == 0) {
        patra_result_free(srs);
        println("ifran: no sweep with that id");
        return 1;
    }
    var key = ifr_str_cell(srs, 0, 0);
    var want_max = patra_result_get_int(srs, 0, 1);
    patra_result_free(srs);
    if (key == 0) { key = ""; }
    if (strlen(key) == 0) {
        ifr_print_cstr("ifran: sweep "); fmt_int(sid);
        println(" has no [sweep.eval] metric (rank its run logs: sweep best <id> <metric>)");
        return 1;
    }
    var stmt = patra_prepare(db, "SELECT subject, value, gate FROM evals WHERE sweep = ?");
    if (stmt == 0) { return 1; }
    patra_bind_int(stmt, 0, sid);
    var rs = patra_query_prepared(db, stmt);
    patra_finalize(stmt);
    if (rs == 0) { println("ifran: query failed"); return 1; }
    var n = patra_result_count(rs);
    if (n == 0) {
        patra_result_free(rs);
        ifr_print_cstr("ifran: sweep "); fmt_int(sid); println(" has no evals");
        return 1;
    }
    var rows = alloc(n * 24);
    var have = 0;
    var missing = 0;
    var vp = alloc(8);
    var i = 0;
    while (i < n) {
        var got = 0;
        if (patra_result_get_int(rs, i, 2) == 0) {
            var vs = ifr_str_cell(rs, i, 1);
            if (vs != 0) {
                if (f64_parse_ok(vs, vp) == 1) {
                    var row = rows + have * 24;
                    var subj = patra_result_get_int(rs, i, 0);
                    store64(row, subj);
                    store64(row + 8, load64(vp));
                    store64(row + 16, _sw_run_args(db, subj));
                    have = have + 1;
                    got = 1;
                }
            }
        }
        if (got == 0) { missing = missing + 1; }
        i = i + 1;
    }
    patra_result_free(rs);
    if (have == 0) {
        ifr_print_cstr("ifran: no eval of sweep "); fmt_int(sid);
        ifr_print_cstr(" passed with a value for `"); ifr_print_cstr(key); println("`");
        return 1;
    }
    return _sw_rank_print(sid, rows, have, key, want_max, missing, "eval ");
}
