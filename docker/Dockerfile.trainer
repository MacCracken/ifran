# GPU job runner: ifran plus the sibling binaries its jobs run, with GPU access.
#
# The sovereign ML siblings reach the GPU through mabda, which drives DRM
# render nodes directly (amdgpu, nouveau), not CUDA. So this image needs no
# vendor runtime: pass the render node in at run time.
#
#   cp /path/to/attn11 /path/to/tarka docker/siblings/       # what your jobs' `bin` names
#   docker build -f docker/Dockerfile.trainer --build-arg VERSION="$(cat VERSION)" -t ifran-trainer .
#   docker run --rm -v ifran-data:/var/lib/ifran \
#       --device /dev/dri --group-add "$(getent group render | cut -d: -f3)" \
#       ifran-trainer run jobs/train.cyml
#
# Binaries in docker/siblings/ land in /opt/ifran/siblings (on PATH); a job
# spec names them by full path (bin = "/opt/ifran/siblings/attn11").

FROM debian:trixie-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# The toolchain pin comes from cyrius.cyml, never from this file.
COPY cyrius.cyml VERSION ./
RUN CYRIUS_VERSION="$(grep '^cyrius = ' cyrius.cyml | head -1 | sed 's/cyrius = "\(.*\)"/\1/')" \
    && echo "Installing Cyrius $CYRIUS_VERSION" \
    && curl -sSf https://raw.githubusercontent.com/MacCracken/cyrius/main/scripts/install.sh \
        | CYRIUS_VERSION="$CYRIUS_VERSION" sh
ENV PATH="/root/.cyrius/bin:${PATH}"

COPY . .
RUN cyrius deps --locked \
    && mkdir -p build \
    && cyrius build src/main.cyr build/ifran \
    && ./build/ifran --version

FROM ghcr.io/maccracken/agnosticos:latest

ARG VERSION=dev
LABEL org.opencontainers.image.title="ifran-trainer"
LABEL org.opencontainers.image.description="ifran with sibling training binaries and DRM GPU access, for running training jobs"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.source="https://github.com/MacCracken/ifran"
LABEL org.opencontainers.image.licenses="GPL-3.0-only"
LABEL org.opencontainers.image.base.name="ghcr.io/maccracken/agnosticos:latest"

USER root
RUN groupadd -g 1002 ifran \
    && useradd -u 1002 -g ifran -d /var/lib/ifran -M -s /usr/sbin/nologin ifran \
    && mkdir -p /var/lib/ifran /opt/ifran/siblings \
    && chown ifran:ifran /var/lib/ifran \
    && chmod 0750 /var/lib/ifran

COPY --from=builder /src/build/ifran /usr/local/bin/ifran
COPY docker/siblings/ /opt/ifran/siblings/
RUN rm -f /opt/ifran/siblings/README.md

USER ifran
ENV HOME=/var/lib/ifran
ENV PATH="/opt/ifran/siblings:${PATH}"
WORKDIR /var/lib/ifran
VOLUME ["/var/lib/ifran"]

ENTRYPOINT ["tini", "--", "/usr/local/bin/ifran"]
CMD ["--help"]
