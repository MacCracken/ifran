# Runtime-only image from a prebuilt ifran binary (the release job's
# build/ifran), so a release image never recompiles. The binary is static, so
# any Linux base runs it; the AGNOS base supplies tini and the ecosystem's
# runtime conventions.
#
# Expects the binary staged per architecture in the build context:
#   bin/amd64/ifran      (build/ifran from `cyrius build src/main.cyr build/ifran`)
#   bin/arm64/ifran      (from `cyrius build --aarch64 …`, when published)
#
#   mkdir -p bin/amd64 && cp build/ifran bin/amd64/ifran
#   docker build -f docker/Dockerfile.release --build-arg VERSION="$(cat VERSION)" -t ifran .
FROM ghcr.io/maccracken/agnosticos:latest

ARG VERSION=dev
ARG TARGETARCH

LABEL org.opencontainers.image.title="ifran"
LABEL org.opencontainers.image.description="The AGNOS training control plane: jobs, signed checkpoint store, datasets, sweeps, evals, preference data"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.source="https://github.com/MacCracken/ifran"
LABEL org.opencontainers.image.licenses="GPL-3.0-only"
LABEL org.opencontainers.image.base.name="ghcr.io/maccracken/agnosticos:latest"

USER root
RUN groupadd -g 1002 ifran \
    && useradd -u 1002 -g ifran -d /var/lib/ifran -M -s /usr/sbin/nologin ifran \
    && mkdir -p /var/lib/ifran \
    && chown ifran:ifran /var/lib/ifran \
    && chmod 0750 /var/lib/ifran

COPY bin/${TARGETARCH}/ifran /usr/local/bin/ifran
RUN chmod 0755 /usr/local/bin/ifran && /usr/local/bin/ifran --version

USER ifran
# IFRAN_HOME roots ifran.db, ifran-store/, ifran-data/ and the keys (.ifran/);
# a job's relative logdir lands in the working directory, the same place
ENV IFRAN_HOME=/var/lib/ifran
ENV HOME=/var/lib/ifran
WORKDIR /var/lib/ifran
VOLUME ["/var/lib/ifran"]

ENTRYPOINT ["tini", "--", "/usr/local/bin/ifran"]
CMD ["--help"]
